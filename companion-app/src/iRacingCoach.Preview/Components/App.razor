<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <link rel="stylesheet" href="@Assets["_content/iRacingCoach.UI/theme.generated.css"]" />
    <link rel="stylesheet" href="@Assets["_content/iRacingCoach.UI/coach.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script>
        window.iracingCoach = {
            scrollWorkspaceTop: function () {
                const workspace = document.getElementById('main-content');
                if (workspace) workspace.scrollTo({ top: 0, left: 0, behavior: 'auto' });
            },
            pointerFraction: function (element, clientX) {
                if (!element) return 0;
                const bounds = element.getBoundingClientRect();
                return bounds.width > 0 ? Math.max(0, Math.min(1, (clientX - bounds.left) / bounds.width)) : 0;
            },
            pointerViewBox: function (element, clientX, clientY, viewWidth, viewHeight) {
                if (!element) return [0, 0];
                const screenMatrix = element.getScreenCTM && element.getScreenCTM();
                if (screenMatrix && element.createSVGPoint) {
                    const point = element.createSVGPoint();
                    point.x = clientX;
                    point.y = clientY;
                    const mapped = point.matrixTransform(screenMatrix.inverse());
                    return [mapped.x, mapped.y];
                }
                const bounds = element.getBoundingClientRect();
                if (bounds.width <= 0 || bounds.height <= 0) return [0, 0];
                return [
                    Math.max(0, Math.min(viewWidth, (clientX - bounds.left) / bounds.width * viewWidth)),
                    Math.max(0, Math.min(viewHeight, (clientY - bounds.top) / bounds.height * viewHeight))
                ];
            },
            viewportSize: function () {
                return [window.innerWidth || 0, window.innerHeight || 0];
            },
            activeElementRect: function () {
                const element = document.activeElement;
                if (!element || !element.getBoundingClientRect) return [];
                const bounds = element.getBoundingClientRect();
                return [bounds.left || 0, bounds.top || 0, bounds.right || 0, bounds.bottom || 0];
            },
            blurActiveElement: function () {
                const element = document.activeElement;
                if (element && typeof element.blur === 'function') element.blur();
            },
            elementContainsActiveElement: function (element) {
                return !!element && !!document.activeElement && element.contains(document.activeElement);
            },
            elementSize: function (element) {
                if (!element) return [0, 0];
                const bounds = element.getBoundingClientRect();
                return [bounds.width || 0, bounds.height || 0];
            }
        };
    </script>
    <script src="@Assets["_content/iRacingCoach.UI/live-telemetry-chart.js"]"></script>
    <script src="@Assets["_content/iRacingCoach.UI/live-telemetry-tile-charts.js"]"></script>
    <script src="@Assets["_content/iRacingCoach.UI/live-telemetry-layout.js"]"></script>
    <script src="@Assets["_content/iRacingCoach.UI/analysis-telemetry-cursor.js"]"></script>
    <script src="@Assets["_content/iRacingCoach.UI/analysis-trace-layout.js"]"></script>
    <script src="@Assets["_content/iRacingCoach.UI/analysis-track-map.js"]"></script>
    <script src="@Assets["_content/iRacingCoach.UI/analysis-context-splitter.js"]"></script>
    <script src="@Assets["_content/iRacingCoach.UI/interaction-policy.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
