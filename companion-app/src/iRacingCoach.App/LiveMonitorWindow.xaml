<Window x:Class="iRacingCoach.App.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="iRacing Coach Telemetry Popout"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        SizeToContent="Manual" Background="#13191A" Foreground="{StaticResource TextPrimaryBrush}"
        Icon="Assets\iRacingCoach.ico" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MonitorAppBrush" Color="#13191A"/>
        <SolidColorBrush x:Key="MonitorSurfaceBrush" Color="#192122"/>
        <SolidColorBrush x:Key="MonitorSurface2Brush" Color="#20292A"/>
        <SolidColorBrush x:Key="MonitorSurfaceHoverBrush" Color="#293536"/>
        <SolidColorBrush x:Key="MonitorBorderBrush" Color="#344345"/>
        <SolidColorBrush x:Key="MonitorMintBrush" Color="#65D0B6"/>
        <SolidColorBrush x:Key="MonitorMintFillBrush" Color="#275F55"/>
        <SolidColorBrush x:Key="MonitorMintSubtleBrush" Color="#1E3633"/>
        <SolidColorBrush x:Key="MonitorAmberBrush" Color="#FFC857"/>
        <SolidColorBrush x:Key="MonitorGreenBrush" Color="#5DE59C"/>
        <SolidColorBrush x:Key="MonitorCoralBrush" Color="#FF6F7D"/>
        <SolidColorBrush x:Key="MonitorVioletBrush" Color="#C89CFF"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource MonitorSurfaceHoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource MonitorMintSubtleBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MonitorMintBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="Tag" Value="selected"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource MonitorMintSubtleBrush}"/><Setter Property="Foreground" Value="{StaticResource MonitorMintBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource MonitorSurface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonitorBorderBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                                <TextBlock Margin="10,0,5,0" VerticalAlignment="Center" Text="{Binding SelectionBoxItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="{StaticResource TextSecondaryBrush}" Data="M0,0 L8,0 L4,5 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="{StaticResource MonitorSurfaceHoverBrush}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource MonitorMintBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="False" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="None">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,4,0,0" Padding="4" Background="{StaticResource MonitorSurface2Brush}" BorderBrush="{StaticResource MonitorBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource MonitorSurfaceHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource MonitorMintSubtleBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger></Style.Triggers></Style>
        <Style TargetType="ToolTip"><Setter Property="Background" Value="{StaticResource MonitorSurface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MonitorBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="8,2"/></Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="78"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="{StaticResource MonitorSurface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MonitorBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" BorderBrush="{StaticResource MonitorBorderBrush}" BorderThickness="1" Background="{StaticResource MonitorAppBrush}" CornerRadius="9">
        <Grid x:Name="RootScale" RenderTransformOrigin="0,0">
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid x:Name="ControlStrip" Grid.Row="0" Background="{StaticResource MonitorSurfaceBrush}" Margin="1,1,1,0" Cursor="SizeAll" MouseLeftButtonDown="ControlStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="ConnectionDot" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource UnavailableBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="iRacing connection"/>
                <ComboBox x:Name="LayoutSelector" Grid.Column="1" MinWidth="180" Margin="0,6,8,6" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="LayoutSelector_SelectionChanged" automation:AutomationProperties.Name="Layout selector" ToolTip="Switch dashboard" Cursor="Hand"/>
                <Button x:Name="ScaleSettingsButton" Grid.Column="2" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Monitor scale" ToolTip="Change pop-out size" Click="ScaleSettingsButton_Click">
                    <Path Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M2,7 L2,2 L7,2 M2,2 L7,7 M15,10 L15,15 L10,15 M15,15 L10,10"/>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Close telemetry popout" ToolTip="Hide telemetry popout" Click="CloseButton_Click">
                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M2,2 L13,13 M13,2 L2,13"/>
                </Button>
            </Grid>

            <Grid x:Name="WorkspaceHost" Grid.Row="1" Width="540" Height="360" Margin="8" ClipToBounds="True" Background="{StaticResource MonitorAppBrush}">
                <Grid x:Name="TileGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
                <Border x:Name="ScaleSettingsSurface" Visibility="Collapsed" Background="{StaticResource MonitorSurfaceBrush}" BorderBrush="{StaticResource MonitorBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Monitor size" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Adjust the physical size of this pop-out. Dashboard proportions stay unchanged." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,22"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Scale" VerticalAlignment="Center"/>
                            <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="70" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged" automation:AutomationProperties.Name="Overall monitor scale"/>
                            <TextBlock x:Name="ScaleValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="14"/>
                        </Grid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Content="Cancel" Click="CancelScaleSettings_Click"/>
                            <Button Style="{StaticResource ActionButton}" Background="{StaticResource MonitorMintFillBrush}" BorderBrush="{StaticResource MonitorMintBrush}" Content="Done" Click="ApplyScaleSettings_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
