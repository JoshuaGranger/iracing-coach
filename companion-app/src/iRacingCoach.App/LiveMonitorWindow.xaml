<Window x:Class="iRacingCoach.App.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="iRacing Coach Telemetry Popout"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        SizeToContent="Manual" Background="{StaticResource NavigationBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        Icon="Assets\iRacingCoach.ico" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MonitorAppBrush" Color="{StaticResource NavigationColor}"/>
        <SolidColorBrush x:Key="MonitorSurfaceBrush" Color="{StaticResource Surface1Color}"/>
        <SolidColorBrush x:Key="MonitorSurface2Brush" Color="{StaticResource Surface2Color}"/>
        <SolidColorBrush x:Key="MonitorSurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
        <SolidColorBrush x:Key="MonitorBorderBrush" Color="{StaticResource BorderSubtleColor}"/>
        <SolidColorBrush x:Key="MonitorChartBrush" Color="{StaticResource ChartBackgroundColor}"/>
        <SolidColorBrush x:Key="MonitorChartGridBrush" Color="{StaticResource ChartGridColor}"/>
        <SolidColorBrush x:Key="MonitorAccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="MonitorAccentFillBrush" Color="{StaticResource AccentFillColor}"/>
        <SolidColorBrush x:Key="MonitorAccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
        <SolidColorBrush x:Key="MonitorFocusBrush" Color="{StaticResource FocusColor}"/>
        <SolidColorBrush x:Key="MonitorMintBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="MonitorAmberBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="MonitorGreenBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="MonitorCoralBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="MonitorVioletBrush" Color="{StaticResource TelemetrySteeringColor}"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource MonitorSurfaceHoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MonitorAccentSubtleBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource MonitorFocusBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="Tag" Value="selected"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MonitorAccentSubtleBrush}"/><Setter Property="Foreground" Value="{DynamicResource MonitorAccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource MonitorSurface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MonitorBorderBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                                <TextBlock Margin="10,0,5,0" VerticalAlignment="Center" Text="{Binding SelectionBoxItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="{StaticResource TextSecondaryBrush}" Data="M0,0 L8,0 L4,5 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="{StaticResource MonitorSurfaceHoverBrush}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource MonitorFocusBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="False" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="None">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,4,0,0" Padding="4" Background="{StaticResource MonitorSurface2Brush}" BorderBrush="{StaticResource MonitorBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource MonitorSurfaceHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource MonitorAccentSubtleBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger></Style.Triggers></Style>
        <Style TargetType="ToolTip"><Setter Property="Background" Value="{StaticResource MonitorSurface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MonitorBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="78"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="{StaticResource MonitorSurface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MonitorBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SizePresetButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected">
                    <Setter Property="Background" Value="{DynamicResource MonitorAccentSubtleBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MonitorAccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" BorderBrush="{StaticResource MonitorBorderBrush}" BorderThickness="1" Background="{StaticResource MonitorAppBrush}" CornerRadius="9">
        <Grid x:Name="RootScale" RenderTransformOrigin="0,0">
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid x:Name="ControlStrip" Grid.Row="0" Background="{StaticResource MonitorSurfaceBrush}" Margin="1,1,1,0" Cursor="SizeAll" MouseLeftButtonDown="ControlStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="ConnectionDot" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource UnavailableBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="iRacing connection"/>
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="10*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="LayoutSelector" Grid.Column="1" MinWidth="180" Margin="0,8" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="LayoutSelector_SelectionChanged" automation:AutomationProperties.Name="Layout selector" ToolTip="Switch dashboard" Cursor="Hand"/>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Button x:Name="ReturnToAppButton" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Return to full app" ToolTip="Return to full app" Click="ReturnToAppButton_Click">
                        <Path Width="17" Height="17" Margin="1" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M14,3 L6,3 Q3,3 3,6 L3,12 M3,12 L7,8 M3,12 L7,16"/>
                    </Button>
                    <Button x:Name="ScaleSettingsButton" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Popout size" ToolTip="Choose popout size" Click="ScaleSettingsButton_Click">
                        <Path Width="17" Height="17" Margin="1" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,7 L3,3 L7,3 M3,3 L8,8 M14,10 L14,14 L10,14 M14,14 L9,9"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Close telemetry popout" ToolTip="Return to full app" Click="CloseButton_Click">
                        <Path Width="15" Height="15" Margin="1" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L13,13 M13,2 L2,13"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="WorkspaceHost" Grid.Row="1" Width="540" Height="360" Margin="8" ClipToBounds="True" Background="{StaticResource MonitorAppBrush}">
                <Grid x:Name="TileGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
                <Border x:Name="ScaleSettingsSurface" Visibility="Collapsed" Background="{StaticResource MonitorSurfaceBrush}" BorderBrush="{StaticResource MonitorBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Popout size" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Choose a stable size. The window changes once after your click is released." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>
                        <UniformGrid Grid.Row="2" Columns="3" VerticalAlignment="Center">
                            <Button x:Name="CompactSizeButton" Style="{StaticResource SizePresetButton}" CommandParameter="0.8" Click="SizePresetButton_Click"><StackPanel><TextBlock Text="Compact" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="80%" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontFamily="Cascadia Mono, Consolas"/></StackPanel></Button>
                            <Button x:Name="StandardSizeButton" Style="{StaticResource SizePresetButton}" CommandParameter="1.0" Click="SizePresetButton_Click"><StackPanel><TextBlock Text="Standard" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="100%" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontFamily="Cascadia Mono, Consolas"/></StackPanel></Button>
                            <Button x:Name="ExpandedSizeButton" Style="{StaticResource SizePresetButton}" CommandParameter="1.25" Click="SizePresetButton_Click"><StackPanel><TextBlock Text="Expanded" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="125%" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontFamily="Cascadia Mono, Consolas"/></StackPanel></Button>
                        </UniformGrid>
                        <Button Grid.Row="3" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Content="Close" Click="CloseScaleSettings_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
