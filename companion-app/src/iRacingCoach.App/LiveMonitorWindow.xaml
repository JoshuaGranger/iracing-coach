<Window x:Class="iRacingCoach.App.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="iRacing Coach Live Monitor"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        SizeToContent="Manual" Background="{StaticResource AppBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        Icon="Assets\iRacingCoach.ico" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSubtleBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="Tag" Value="selected"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSubtleBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Margin="9,3,4,3" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{StaticResource TextPrimaryBrush}"/><Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="{StaticResource TextSecondaryBrush}" Data="M0,0 L8,0 L4,5 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,3,0,0" Padding="3" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="5"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Padding" Value="9,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger></Style.Triggers></Style>
        <Style TargetType="ToolTip"><Setter Property="Background" Value="{StaticResource Surface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="8,2"/></Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Background="{StaticResource NavigationBrush}" CornerRadius="8">
        <Grid x:Name="RootScale" RenderTransformOrigin="0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ControlStrip" Grid.Row="0" Background="{StaticResource Surface1Brush}" Margin="1,1,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DragGripButton" Grid.Column="0" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Move Live Monitor" ToolTip="Drag to move Live Monitor" PreviewMouseLeftButtonDown="DragGrip_MouseLeftButtonDown">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3,2 L5,2 L5,4 L3,4 Z M8,2 L10,2 L10,4 L8,4 Z M13,2 L15,2 L15,4 L13,4 Z M3,7 L5,7 L5,9 L3,9 Z M8,7 L10,7 L10,9 L8,9 Z M13,7 L15,7 L15,9 L13,9 Z M3,12 L5,12 L5,14 L3,14 Z M8,12 L10,12 L10,14 L8,14 Z M13,12 L15,12 L15,14 L13,14 Z"/>
                </Button>
                <Ellipse x:Name="ConnectionDot" Grid.Column="1" Width="7" Height="7" Fill="{StaticResource UnavailableBrush}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="LayoutSelector" Grid.Column="2" MinWidth="132" MaxWidth="220" Margin="0,5,8,5" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="LayoutSelector_SelectionChanged" automation:AutomationProperties.Name="Layout selector" ToolTip="Switch named layout"/>
                <Button x:Name="LockButton" Grid.Column="3" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Unlock layout editing" ToolTip="Unlock layout editing" Click="LockButton_Click">
                    <Path x:Name="LockIcon" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M5,7 L5,5 C5,1.5 11,1.5 11,5 L11,7 M3,7 L13,7 L13,15 L3,15 Z"/>
                </Button>
                <Button x:Name="GridSettingsButton" Grid.Column="4" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Grid settings" ToolTip="Rows and columns" Click="GridSettingsButton_Click">
                    <Path Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M1,1 L7,1 L7,7 L1,7 Z M10,1 L16,1 L16,7 L10,7 Z M1,10 L7,10 L7,16 L1,16 Z M10,10 L16,10 L16,16 L10,16 Z"/>
                </Button>
                <Button x:Name="ScaleSettingsButton" Grid.Column="5" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Monitor scale" ToolTip="Overall monitor size" Click="ScaleSettingsButton_Click">
                    <Path Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M2,7 L2,2 L7,2 M2,2 L7,7 M15,10 L15,15 L10,15 M15,15 L10,10"/>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="6" Style="{StaticResource IconButton}" automation:AutomationProperties.Name="Close live monitor" ToolTip="Hide Live Monitor" Click="CloseButton_Click">
                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M2,2 L13,13 M13,2 L2,13"/>
                </Button>
            </Grid>

            <Grid x:Name="WorkspaceHost" Grid.Row="1" Width="444" Height="296" Margin="8" ClipToBounds="True">
                <Grid x:Name="TileGrid" HorizontalAlignment="Center" VerticalAlignment="Center" AllowDrop="True" Drop="TileGrid_Drop" DragOver="TileGrid_DragOver" DragLeave="TileGrid_DragLeave" Background="Transparent"/>
                <Border x:Name="GridSettingsSurface" Visibility="Collapsed" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Grid" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="The panel stays the same size while its square cells adjust to fit." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="Rows" VerticalAlignment="Center"/><Slider x:Name="RowsSlider" Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="GridSlider_ValueChanged" automation:AutomationProperties.Name="Grid rows"/><TextBlock x:Name="RowsValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/></Grid>
                        <Grid Grid.Row="3" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="Columns" VerticalAlignment="Center"/><Slider x:Name="ColumnsSlider" Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="GridSlider_ValueChanged" automation:AutomationProperties.Name="Grid columns"/><TextBlock x:Name="ColumnsValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/></Grid>
                        <TextBlock x:Name="GridSettingsMessage" Grid.Row="4" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Content="Cancel" Click="CancelGridSettings_Click"/><Button Style="{StaticResource ActionButton}" Background="{StaticResource AccentFillBrush}" BorderBrush="{StaticResource AccentBrush}" Content="Done" Click="ApplyGridSettings_Click"/></StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="ScaleSettingsSurface" Visibility="Collapsed" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Monitor size" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Scale the entire pop-out without changing its dashboard grid." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions><TextBlock Text="Scale" VerticalAlignment="Center"/><Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="70" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged" automation:AutomationProperties.Name="Overall monitor scale"/><TextBlock x:Name="ScaleValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/></Grid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Content="Cancel" Click="CancelScaleSettings_Click"/><Button Style="{StaticResource ActionButton}" Background="{StaticResource AccentFillBrush}" BorderBrush="{StaticResource AccentBrush}" Content="Done" Click="ApplyScaleSettings_Click"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="EditorPanel" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="10" Height="300">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LayoutNameBox" Grid.Column="0" Margin="0,0,8,4" MaxLength="48" LostKeyboardFocus="LayoutNameBox_LostKeyboardFocus" automation:AutomationProperties.Name="Layout name"/>
                        <Button Grid.Column="1" Style="{StaticResource CompactButton}" automation:AutomationProperties.Name="Create layout" ToolTip="Create layout" Click="CreateLayout_Click"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M7,1 L7,13 M1,7 L13,7"/></Button>
                        <Button Grid.Column="2" Style="{StaticResource CompactButton}" automation:AutomationProperties.Name="Duplicate layout" ToolTip="Duplicate layout" Click="DuplicateLayout_Click"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M4,4 L13,4 L13,13 L4,13 Z M1,1 L10,1 L10,4 M1,1 L1,10 L4,10"/></Button>
                        <Button x:Name="ResetLayoutButton" Grid.Column="3" Style="{StaticResource CompactButton}" automation:AutomationProperties.Name="Reset layout to factory default" ToolTip="Reset selected layout" Click="ResetLayout_Click"><Path Width="15" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M3,4 L3,1 L1,3 M3,3 C8,-1 14,3 13,8 C12,13 6,15 2,11"/></Button>
                        <Button x:Name="DeleteLayoutButton" Grid.Column="4" Style="{StaticResource CompactButton}" automation:AutomationProperties.Name="Delete layout" ToolTip="Delete selected custom layout" Click="DeleteLayout_Click"><Path Width="14" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M2,4 L12,4 M5,1 L9,1 L10,4 M4,5 L4.7,14 L9.3,14 L10,5"/></Button>
                        <Button x:Name="UndoButton" Grid.Column="5" Style="{StaticResource CompactButton}" automation:AutomationProperties.Name="Undo layout change" ToolTip="Undo last layout change" Click="Undo_Click"><Path Width="15" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M5,3 L1,7 L5,11 M2,7 L9,7 C13,7 14,10 13,13"/></Button>
                    </Grid>
                    <TextBox x:Name="CatalogSearch" Grid.Row="1" Margin="0,4,0,6" TextChanged="CatalogSearch_TextChanged" automation:AutomationProperties.Name="Search telemetry catalog" ToolTip="Filter telemetry options"/>
                    <ListBox x:Name="CatalogList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.Name="Telemetry catalog">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="IsTabStop" Value="False"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" PreviewMouseLeftButtonDown="CatalogItem_MouseLeftButtonDown" PreviewMouseMove="CatalogItem_MouseMove">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="8,1,0,0"/></StackPanel><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StylesLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/></StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource CompactButton}" Tag="{Binding MetricId}" automation:AutomationProperties.Name="{Binding AddAccessibleName}" ToolTip="Add to grid" Click="CatalogAdd_Click"><Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M6.5,1 L6.5,12 M1,6.5 L12,6.5"/></Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EditorMessage" Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,5,2,2"/>
                    <Border x:Name="TileEditor" Grid.Row="4" Visibility="Collapsed" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,5,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="76"/><ColumnDefinition Width="58"/><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock x:Name="SelectedTileName" FontWeight="SemiBold"/><TextBlock Text="Alt+Arrow moves · Shift+Arrow resizes" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/></StackPanel>
                            <ComboBox x:Name="StyleSelector" Grid.Row="0" Grid.Column="1" Margin="4,0" SelectionChanged="TileOption_SelectionChanged" automation:AutomationProperties.Name="Tile display style" ToolTip="Display style"/>
                            <ComboBox x:Name="UnitSelector" Grid.Row="0" Grid.Column="2" Margin="4,0" SelectionChanged="TileOption_SelectionChanged" automation:AutomationProperties.Name="Tile unit" ToolTip="Unit"/>
                            <ComboBox x:Name="WidthSelector" Grid.Row="0" Grid.Column="3" Margin="4,0" SelectionChanged="TileSize_SelectionChanged" automation:AutomationProperties.Name="Tile width in grid cells" ToolTip="Width"/>
                            <ComboBox x:Name="HeightSelector" Grid.Row="0" Grid.Column="4" Margin="4,0" SelectionChanged="TileSize_SelectionChanged" automation:AutomationProperties.Name="Tile height in grid cells" ToolTip="Height"/>
                            <Button Grid.Row="0" Grid.Column="5" Style="{StaticResource CompactButton}" automation:AutomationProperties.Name="Remove tile" ToolTip="Remove tile" Click="RemoveTile_Click"><Path Width="13" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M1,4 L12,4 M4,1 L9,1 L10,4 M3,5 L4,13 L9,13 L10,5"/></Button>
                            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,7,0,0">
                                <TextBlock Text="Decimals" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,5,0"/><ComboBox x:Name="PrecisionSelector" Width="58" SelectionChanged="TileOption_SelectionChanged" automation:AutomationProperties.Name="Tile decimal precision"/>
                                <TextBlock Text="Chart history" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,5,0"/><ComboBox x:Name="TrendSelector" Width="116" SelectionChanged="TileOption_SelectionChanged" automation:AutomationProperties.Name="Chart history duration"/>
                                <TextBlock Text="Accent" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,5,0"/><ComboBox x:Name="AccentSelector" Width="92" SelectionChanged="TileOption_SelectionChanged" automation:AutomationProperties.Name="Tile accent color"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
