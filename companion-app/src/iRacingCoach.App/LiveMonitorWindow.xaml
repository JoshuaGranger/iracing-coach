<Window x:Class="iRacingCoach.App.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iRacing Coach Live Monitor"
        Width="560" Height="275" MinWidth="420" MinHeight="215" MaxWidth="900" MaxHeight="680"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        Background="#141517" Foreground="#E8E9E7" Icon="Assets\iRacingCoach.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#202328"/><Setter Property="Foreground" Value="#E8E9E7"/><Setter Property="BorderBrush" Value="#434A53"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="3,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#2D3238"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#536171"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#272B30"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    </Window.Resources>
    <Border x:Name="OuterBorder" BorderBrush="#30353B" BorderThickness="1" Background="#17191C">
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid x:Name="ChromePanel" Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#6B7480" Margin="0,0,8,0"/><TextBlock Text="LIVE MONITOR" FontSize="11" FontWeight="SemiBold" Foreground="#AAB1BC"/><TextBlock x:Name="QaFixtureText" Text="QA FIXTURE" Visibility="Collapsed" Margin="10,0,0,0" FontSize="10" FontWeight="Bold" Foreground="#E0B85C"/><TextBlock x:Name="AgeText" Margin="10,0,0,0" FontSize="11" Foreground="#727B88"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ModeButton" ToolTip="Switch compact or expanded mode" Click="ModeButton_Click">Expand</Button><Button x:Name="LockButton" ToolTip="Lock or unlock the window position" Click="LockButton_Click">Lock</Button><Button x:Name="ChromeButton" ToolTip="Hide monitor controls" Click="ChromeButton_Click">Hide controls</Button><Button ToolTip="Hide Live Monitor" Click="HideButton_Click">Hide</Button></StackPanel>
            </Grid>

            <Grid x:Name="MinimalHandle" Grid.Row="0" Visibility="Collapsed" Height="22" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"><Button HorizontalAlignment="Right" Padding="8,0" ToolTip="Show monitor controls" Click="ShowChromeButton_Click">Controls</Button></Grid>

            <Grid Grid.Row="1" Margin="0,1,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="FlagText" Text="WAITING" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="LapText" Margin="12,2,0,0" FontSize="15" Foreground="#B7BEC8"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ClassPositionText" Margin="0,2,12,0" FontSize="14" Foreground="#AAB1BC"/><TextBlock x:Name="PositionText" Text="—" FontSize="22" FontWeight="Bold"/></StackPanel>
            </Grid>

            <UniformGrid x:Name="GapPanel" Grid.Row="2" Columns="3" Margin="0,0,0,7">
                <StackPanel x:Name="LeaderGapPanel"><TextBlock Text="LEADER" FontSize="10" Foreground="#858E9A"/><TextBlock x:Name="LeaderGapText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="LeaderTrendText" FontSize="10" Foreground="#858E9A"/></StackPanel>
                <StackPanel x:Name="AheadGapPanel"><TextBlock Text="AHEAD" FontSize="10" Foreground="#858E9A"/><TextBlock x:Name="AheadGapText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AheadTrendText" FontSize="10" Foreground="#858E9A"/></StackPanel>
                <StackPanel x:Name="BehindGapPanel"><TextBlock Text="BEHIND" FontSize="10" Foreground="#858E9A"/><TextBlock x:Name="BehindGapText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="BehindTrendText" FontSize="10" Foreground="#858E9A"/></StackPanel>
            </UniformGrid>

            <UniformGrid x:Name="TimingPanel" Grid.Row="3" Columns="3" Margin="0,0,0,7">
                <StackPanel x:Name="LastLapPanel"><TextBlock Text="LAST" FontSize="10" Foreground="#858E9A"/><TextBlock x:Name="LastLapText" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                <StackPanel x:Name="TargetPanel"><TextBlock Text="PERSONAL RANGE" FontSize="10" Foreground="#858E9A"/><TextBlock x:Name="TargetText" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                <StackPanel x:Name="PitPanel"><TextBlock Text="PIT / FUEL" FontSize="10" Foreground="#858E9A"/><TextBlock x:Name="PitText" FontSize="15" FontWeight="SemiBold"/></StackPanel>
            </UniformGrid>

            <Border Grid.Row="4" x:Name="CueBorder" Background="#202328" BorderBrush="#A3ADB8" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,0,0,6"><StackPanel><TextBlock x:Name="CueText" Text="Waiting for iRacing" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="CueBasisText" FontSize="10" Foreground="#90969E" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>

            <Grid x:Name="ExpandedPanel" Grid.Row="5" Visibility="Collapsed" Margin="0,3,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <UniformGrid x:Name="ExpandedDetails" Columns="4"><StackPanel x:Name="LeaderLastPanel"><TextBlock Text="LEADER LAST" FontSize="9" Foreground="#858E9A"/><TextBlock x:Name="LeaderLastText"/></StackPanel><StackPanel x:Name="PaceDeltaPanel"><TextBlock Text="PACE Δ" FontSize="9" Foreground="#858E9A"/><TextBlock x:Name="PaceDeltaText"/></StackPanel><StackPanel x:Name="TirePhasePanel"><TextBlock Text="TIRE PHASE" FontSize="9" Foreground="#858E9A"/><TextBlock x:Name="TirePhaseText"/></StackPanel><StackPanel x:Name="WeatherPanel"><TextBlock Text="TRACK / AIR" FontSize="9" Foreground="#858E9A"/><TextBlock x:Name="WeatherText"/></StackPanel></UniformGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0"><Button x:Name="ClickThroughButton" Click="ClickThroughButton_Click">Click-through off</Button><Button Click="ResetButton_Click">Reset position</Button><TextBlock Text="Opacity" Margin="12,6,6,0" Foreground="#929BA7"/><Slider x:Name="OpacitySlider" Width="110" Minimum="0.55" Maximum="1" ValueChanged="OpacitySlider_ValueChanged"/></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
