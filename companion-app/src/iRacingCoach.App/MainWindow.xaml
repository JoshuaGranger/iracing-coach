<Window x:Class="iRacingCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:iRacingCoach.UI;assembly=iRacingCoach.UI"
        Title="iRacing Coach"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets\iRacingCoach.ico"
        Background="{StaticResource AppBrush}">
    <blazor:BlazorWebView HostPage="wwwroot\index.html"
                          Services="{DynamicResource services}"
                          BlazorWebViewInitializing="OnBlazorWebViewInitializing"
                          UrlLoading="OnBlazorUrlLoading">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:CompanionShell}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
