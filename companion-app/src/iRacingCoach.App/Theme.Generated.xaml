<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Generated from config/theme.dark.json. -->
    <Color x:Key="AppColor">#0B1015</Color>
    <Color x:Key="NavigationColor">#0F161C</Color>
    <Color x:Key="Surface1Color">#151E25</Color>
    <Color x:Key="Surface2Color">#1B2630</Color>
    <Color x:Key="Surface3Color">#25333D</Color>
    <Color x:Key="SurfaceHoverColor">#30414D</Color>
    <Color x:Key="BorderSubtleColor">#334752</Color>
    <Color x:Key="BorderStrongColor">#4C6572</Color>
    <Color x:Key="TextPrimaryColor">#F6F8FA</Color>
    <Color x:Key="TextSecondaryColor">#D0D8DC</Color>
    <Color x:Key="TextMutedColor">#96A6AE</Color>
    <Color x:Key="TextDisabledColor">#6F7E85</Color>
    <Color x:Key="AccentColor">#5CE8C3</Color>
    <Color x:Key="AccentFillColor">#167A66</Color>
    <Color x:Key="AccentHoverColor">#20947B</Color>
    <Color x:Key="AccentSubtleColor">#153832</Color>
    <Color x:Key="FocusColor">#9FF8DF</Color>
    <Color x:Key="SuccessColor">#57EEA0</Color>
    <Color x:Key="WarningColor">#FFD05C</Color>
    <Color x:Key="DangerColor">#FF7187</Color>
    <Color x:Key="InfoColor">#61DAF3</Color>
    <Color x:Key="UnavailableColor">#8E98A5</Color>
    <Color x:Key="ChartBackgroundColor">#172028</Color>
    <Color x:Key="ChartGridColor">#354853</Color>
    <Color x:Key="ChartReferenceColor">#728892</Color>
    <Color x:Key="TelemetrySpeedColor">#61C8F5</Color>
    <Color x:Key="TelemetryThrottleColor">#5DE59C</Color>
    <Color x:Key="TelemetryBrakeColor">#FF6F7D</Color>
    <Color x:Key="TelemetrySteeringColor">#C89CFF</Color>
    <Color x:Key="TelemetryFuelColor">#FFC857</Color>
    <SolidColorBrush x:Key="AppBrush" Color="{StaticResource AppColor}" />
    <SolidColorBrush x:Key="NavigationBrush" Color="{StaticResource NavigationColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="UnavailableBrush" Color="{StaticResource UnavailableColor}" />
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="{StaticResource ChartBackgroundColor}" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}" />
    <SolidColorBrush x:Key="ChartReferenceBrush" Color="{StaticResource ChartReferenceColor}" />
    <SolidColorBrush x:Key="TelemetrySpeedBrush" Color="{StaticResource TelemetrySpeedColor}" />
    <SolidColorBrush x:Key="TelemetryThrottleBrush" Color="{StaticResource TelemetryThrottleColor}" />
    <SolidColorBrush x:Key="TelemetryBrakeBrush" Color="{StaticResource TelemetryBrakeColor}" />
    <SolidColorBrush x:Key="TelemetrySteeringBrush" Color="{StaticResource TelemetrySteeringColor}" />
    <SolidColorBrush x:Key="TelemetryFuelBrush" Color="{StaticResource TelemetryFuelColor}" />
</ResourceDictionary>
