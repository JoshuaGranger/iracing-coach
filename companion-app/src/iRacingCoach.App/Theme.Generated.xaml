<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppColor">#141517</Color>
    <Color x:Key="Surface1Color">#1B1D20</Color>
    <Color x:Key="TextPrimaryColor">#E8E9E7</Color>
    <Color x:Key="TextSecondaryColor">#B9BDC2</Color>
    <Color x:Key="AccentColor">#A3ADB8</Color>
    <SolidColorBrush x:Key="AppBrush" Color="{StaticResource AppColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
</ResourceDictionary>
