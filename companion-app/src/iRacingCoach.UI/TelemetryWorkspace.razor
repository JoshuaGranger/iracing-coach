@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS

<section class="telemetry-workspace" aria-labelledby="telemetry-heading">
    <div class="analysis-section-heading">
        <div><span class="eyebrow">Telemetry</span><h2 id="telemetry-heading">Compare laps</h2></div>
    </div>

    @if (Workspace.Traces.Count == 0)
    {
        <div class="empty-state compact-empty"><h3>Detailed traces were not recorded</h3><p>Enable iRacing disk telemetry to record speed, controls, and load traces in future races.</p></div>
    }
    else
    {
        <div class="telemetry-workstation-grid">
        <aside class="lap-rail" aria-label="Runs and laps">
            <div class="lap-rail-header">
                <strong>Laps &amp; runs</strong><span>@Selected.Count selected</span>
                <label class="clean-lap-filter"><input type="checkbox" checked="@CleanLapsOnly" @onchange="CleanLapFilterChanged" /> Clean laps</label>
            </div>
            <div class="lap-rail-scroll">
                @foreach (var indexedGroup in LapGroups.Select((group, index) => new { Group = group, Index = index }))
                {
                    var group = indexedGroup.Group;
                    <details class="lap-run-group @(indexedGroup.Index > 0 ? "separated" : null)" open>
                        <summary>
                            <span class="run-summary-name">@group.Label</span>
                            @if (group.Run is { } summaryRun)
                            {
                                <span class="run-summary-metrics">@summaryRun.GreenLaps green · @summaryRun.CautionLaps caution</span>
                                <span class="run-insight" tabindex="0" aria-label="Run @summaryRun.Number details" @onclick:stopPropagation="true">i<span class="run-tooltip" role="tooltip"><strong>Run @summaryRun.Number · laps @LapRange(summaryRun.Laps)</strong>@if (HasOfficialPace(summaryRun)) { <span>Early pace <b>@LapTime(summaryRun.EarlyAverageLapSeconds)</b></span><span>Late pace <b>@LapTime(summaryRun.LateAverageLapSeconds)</b></span><span>Pace trend <b>@PaceTrend(summaryRun)</b></span> } else { <span>Observed green pace <b>@ObservedPaceRange(summaryRun)</b></span><span>Coaching comparison <b>Excluded</b></span> }@if (summaryRun.FuelUsedGallons.HasValue) { <span>Fuel used <b>@summaryRun.FuelUsedGallons.Value.ToString("0.00") gal</b></span> }@if (summaryRun.TireRemainingPercent.HasValue) { <span>Lowest tire <b>@summaryRun.TireName @summaryRun.TireRemainingPercent.Value.ToString("0.0")%</b></span> }<small>@(HasOfficialPace(summaryRun) ? ControlChange(summaryRun) : summaryRun.Status)</small></span></span>
                            }
                            else
                            {
                                <small>@group.Traces.Count laps</small>
                            }
                        </summary>
                        @foreach (var trace in group.Traces)
                        {
                            var run = RunForLap(trace.Lap);
                            var pitLap = trace.PitTimeSeconds.GetValueOrDefault() > 0;
                            var isFastest = trace.LapTimeSeconds.HasValue && Math.Abs(trace.LapTimeSeconds.Value - FastestLapTime) < .0001;
                            <button class="lap-rail-row @(Selected.Contains(trace.Lap) ? "selected" : null) @(pitLap ? "pit-lap" : null)" style="@($"--lap-color:{LapColor(trace.Lap)}")" aria-pressed="@Selected.Contains(trace.Lap)" @onclick="() => SelectLap(trace.Lap)">
                                <span class="lap-flag @LapFlagClass(trace)" title="@LapFlagLabel(trace)" aria-label="@LapFlagLabel(trace)"><ProductIcon Name="race" Size="12" /></span>
                                <span class="lap-identity"><b>@trace.Lap</b><i class="lap-trace-color" aria-hidden="true"></i></span>
                                <span class="lap-time @(isFastest ? "fastest" : null)">@LapTime(trace.LapTimeSeconds)@if (ShowPaceDelta(trace, isFastest)) { <small>(+@((trace.LapTimeSeconds!.Value - FastestLapTime).ToString("0.000")))</small> }</span>
                                <span class="lap-sector-column">
                                    @if (SectorStarts.Count > 1)
                                    {
                                    <span class="sector-squares" aria-label="Sector performance">
                                        @for (var sector = 0; sector < SectorStarts.Count; sector++)
                                        {
                                            var sectorState = SectorState(trace, sector);
                                            <i class="sector-square @sectorState.Class" title="@sectorState.Title"></i>
                                        }
                                    </span>
                                    }
                                </span>
                                <span class="lap-incident-column">
                                    @if (IncidentPoints(trace.Lap) is var points && points > 0) { <span class="incident-badge severity-@IncidentSeverity(points)" title="@($"{points} incident point{(points == 1 ? string.Empty : "s")} on lap {trace.Lap}")">@($"x{points}")</span> }
                                </span>
                                <span class="lap-pit-column">
                                    @if (pitLap) { <span class="pit-badge" @onmouseenter="args => ShowPitPopover(args, trace.Lap)" @onmouseleave="HidePitPopover" @onclick:stopPropagation="true">PIT</span> }
                                </span>
                                @if (pitLap && run is not null && ActivePitLap == trace.Lap)
                                {
                                    <span class="pit-lap-popover" style="@PitPopoverStyle" role="tooltip">
                                        <span class="pit-popover-heading"><strong>Pit lap @trace.Lap</strong><small>@PitServiceTime(run)</small></span>
                                        <span class="pit-popover-row"><span>Tires changed</span><b>@ChangedTires(run)</b></span>
                                        <span class="pit-popover-label">Recorded tire wear</span>
                                        <span class="pit-wear-grid">
                                            <span>LF <b>@TireWear(run.PitStop?.LeftFrontTireWearPercent)</b></span>
                                            <span>RF <b>@TireWear(run.PitStop?.RightFrontTireWearPercent)</b></span>
                                            <span>LR <b>@TireWear(run.PitStop?.LeftRearTireWearPercent)</b></span>
                                            <span>RR <b>@TireWear(run.PitStop?.RightRearTireWearPercent)</b></span>
                                        </span>
                                        <span class="pit-popover-row"><span>Fuel added</span><b>@FuelAdded(run)</b></span>
                                        <span class="pit-popover-row"><span>Fuel range at stop</span><b>@FuelRangeAtStop(run)</b></span>
                                        <span class="pit-popover-row"><span>Race remaining</span><b>@RaceLapsRemaining(trace.Lap)</b></span>
                                        @if (run.PitStop?.DamageRepairedSeconds is { } repaired) { <span class="pit-popover-row"><span>Damage repaired</span><b>@repaired.ToString("0.0") s</b></span> }
                                        @if (run.PitStop?.PenaltyServedSeconds is { } penalty) { <span class="pit-popover-row"><span>Penalty served</span><b>@penalty.ToString("0.0") s</b></span> }
                                    </span>
                                }
                            </button>
                        }
                    </details>
                }
            </div>
            <div class="lap-rail-footer"><button class="text-button" @onclick="ResetSelection">Best three</button><button class="text-button" @onclick="ShowAllLaps">Show all</button></div>
        </aside>

        <div class="telemetry-grid">
            <div class="track-panel">
                <div class="panel-title track-panel-title"><div><strong>@(Workspace.GeometryMode == "track_shape" ? "Track position" : "Lap distance")</strong><span>Lap @PrimaryTrace.Lap</span></div><label class="track-color-control"><span>Color</span><select @bind="Mode">@foreach (var option in Modes) { <option value="@option.Key">@option.Label</option> }</select></label></div>
                <svg @ref="TrackElement" class="track-map" viewBox="@TrackViewBox" role="img" aria-label="Track telemetry map" @onmousemove="TrackMoved">
                    @if (Workspace.TrackShape.Count >= 3)
                    {
                        @foreach (var segment in MapSegments)
                        {
                            <line x1="@F(segment.A.X)" y1="@F(segment.A.Y)" x2="@F(segment.B.X)" y2="@F(segment.B.Y)" stroke="@segment.Color" stroke-width="8" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                        }
                        <circle cx="@F(CursorMapPoint.X)" cy="@F(CursorMapPoint.Y)" r="8" class="map-cursor-halo" />
                        <circle cx="@F(CursorMapPoint.X)" cy="@F(CursorMapPoint.Y)" r="4" class="map-cursor" />
                    }
                    else
                    {
                        <line x1="28" y1="140" x2="392" y2="140" class="distance-base" />
                        @foreach (var segment in StripSegments)
                        {
                            <line x1="@F(segment.X1)" y1="140" x2="@F(segment.X2)" y2="140" stroke="@segment.Color" stroke-width="14" stroke-linecap="round" />
                        }
                        @foreach (var zone in Workspace.Segments)
                        {
                            <line x1="@F(28 + zone.StartPercent * 364)" y1="113" x2="@F(28 + zone.StartPercent * 364)" y2="167" class="zone-marker" />
                            <svg:text x="@F(28 + zone.StartPercent * 364)" y="99" class="chart-label">@FriendlyZone(zone)</svg:text>
                        }
                        <line x1="@F(28 + Cursor * 364)" y1="104" x2="@F(28 + Cursor * 364)" y2="176" class="map-cursor-line" />
                        <svg:text x="28" y="205" class="chart-label">Start / finish</svg:text><svg:text x="392" y="205" text-anchor="end" class="chart-label">100%</svg:text>
                    }
                </svg>
                <div class="cursor-readout"><strong>@((Cursor * 100).ToString("0.0"))%</strong><span>@CursorSummary</span></div>
            </div>

            <div class="trace-panel">
                <div class="panel-title"><strong>Aligned traces</strong><span>@Selected.Count selected · hover to compare</span></div>
                <svg @ref="ChartElement" class="trace-chart" viewBox="@($"0 0 {F(_chartWidth)} {ChartHeight}")" style="height:@($"{ChartHeight}px")" preserveAspectRatio="none" role="img" aria-label="Synchronized speed, time delta, controls, gear, RPM, steering, rotation, and acceleration traces" @onmouseenter="ShowChartCursor" @onmouseleave="HideChartCursor" @onmousemove="ChartMoved" @onwheel="ChartWheel" @onwheel:preventDefault>
                    @for (var row = 0; row < VisiblePanels.Count; row++)
                    {
                        var panel = VisiblePanels[row]; var top = ChartTop + row * ChartRowHeight;
                        <rect x="@PlotLeft" y="@top" width="@PlotWidth" height="@ChartPlotHeight" class="chart-row" />
                        <line x1="@PlotLeft" y1="@(top + ChartPlotHeight / 2)" x2="@PlotRight" y2="@(top + ChartPlotHeight / 2)" class="chart-grid-line" />
                        <svg:text x="8" y="@(top + 18)" class="chart-title">@panel.Label</svg:text>
                        <svg:text x="8" y="@(top + 38)" class="chart-unit">@panel.Unit</svg:text>
                        @foreach (var trace in SelectedTraces)
                        {
                            <path d="@TracePath(trace, panel, top, false)" fill="none" stroke="@LapColor(trace.Lap)" stroke-width="1.35" vector-effect="non-scaling-stroke" />
                            @if (panel.Second is not null)
                            {
                                <path d="@TracePath(trace, panel, top, true)" fill="none" stroke="@LapColor(trace.Lap)" stroke-width="1.05" stroke-dasharray="4 3" opacity=".72" vector-effect="non-scaling-stroke" />
                            }
                            @if (ChartHovered && PanelCursorY(panel, trace, top) is { } markerY) { <circle cx="@CursorChartX" cy="@markerY" r="3.4" fill="@LapColor(trace.Lap)" class="trace-cursor-marker" /> }
                        }
                        @if (ChartHovered)
                        {
                        <g class="trace-cursor-tooltip">
                            <rect x="@TooltipX" y="@(top + 4)" width="@TooltipWidth" height="@(14 + TooltipTraces.Count * 20)" rx="4" />
                            @foreach (var trace in TooltipTraces.Select((value, index) => new { value, index }))
                            {
                                <svg:text x="@(TooltipX + 8)" y="@(top + 22 + trace.index * 20)" class="trace-tooltip-lap">@trace.value.Lap</svg:text>
                                <rect x="@(TooltipX + 30)" y="@(top + 13 + trace.index * 20)" width="10" height="10" rx="1" fill="@LapColor(trace.value.Lap)" />
                                <svg:text x="@(TooltipX + 47)" y="@(top + 22 + trace.index * 20)" class="trace-tooltip-value">@CursorValue(panel, trace.value)</svg:text>
                            }
                        </g>
                        }
                    }
                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var x = PlotLeft + tick * (PlotWidth / 4d);
                        <line x1="@x" y1="@ChartTop" x2="@x" y2="@ChartBottom" class="chart-grid-vertical" />
                        <svg:text x="@x" y="@(ChartHeight - 7)" text-anchor="middle" class="chart-label">@(tick * 25)%</svg:text>
                    }
                    @if (ChartHovered) { <line x1="@CursorChartX" y1="@ChartTop" x2="@CursorChartX" y2="@ChartBottom" class="shared-cursor" /> }
                </svg>
            </div>
        </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    private readonly HashSet<int> Selected = [];
    private string? _analysisId;
    private string Mode { get; set; } = "speed";
    private bool CleanLapsOnly { get; set; }
    private bool ChartHovered { get; set; }
    private int? ActivePitLap { get; set; }
    private double PitPopoverX { get; set; }
    private double PitPopoverY { get; set; }
    private double Cursor { get; set; } = .25;
    private ElementReference ChartElement;
    private ElementReference TrackElement;
    private bool _chartMovePending;
    private bool _trackMovePending;
    private double _chartWidth = 1000;
    private int _tooltipLapOffset;
    private const double PlotLeft = 126;
    private const int ChartTop = 12;
    private const int ChartRowHeight = 82;
    private const int ChartPlotHeight = 68;
    private const int TooltipRowHeight = 20;
    private const int TooltipWidth = 164;
    private static readonly (string Key, string Label)[] Modes = [("speed", "Speed"), ("throttle", "Throttle"), ("brake", "Brake"), ("steering", "Steering"), ("stress", "Tire load")];
    private static readonly PanelSpec[] Panels =
    [
        new("speed", "Speed", "mph", p => p.SpeedMph),
        new("delta", "Time Delta", "s", _ => null),
        new("controls", "Throttle / brake", "%", p => p.Throttle, p => p.Brake),
        new("gear", "Gear", "selected gear", p => p.Gear),
        new("rpm", "RPM", "rpm", p => p.Rpm),
        new("steering", "Steering", "left / right", p => p.SteeringRadians * 180 / Math.PI),
        new("rotation", "Slip / yaw", "deg / deg/s", p => p.SlipAngleDegrees, p => p.YawRateDegreesPerSecond),
        new("acceleration", "Lateral / long. G", "g", p => p.LateralG, p => p.LongitudinalG)
    ];

    protected override void OnParametersSet()
    {
        if (_analysisId == Workspace.AnalysisId) return;
        _analysisId = Workspace.AnalysisId;
        ResetSelection();
        _tooltipLapOffset = 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await MeasureChart();

    private IEnumerable<AnalysisLapTrace> SelectedTraces => Workspace.Traces.Where(trace => Selected.Contains(trace.Lap));
    private IEnumerable<LapGroup> LapGroups
    {
        get
        {
            var eligible = Workspace.Traces.Where(trace => !CleanLapsOnly || IsClean(trace)).OrderBy(trace => trace.Lap).ToArray();
            var runs = Workspace.Runs.Where(run => run.Laps.Count > 0).OrderBy(run => run.Laps.Min()).ToArray();
            if (runs.Length == 0)
            {
                if (eligible.Length > 0) yield return new LapGroup("Recorded laps", eligible, null);
                yield break;
            }
            for (var index = 0; index < runs.Length; index++)
            {
                var start = index == 0 ? int.MinValue : runs[index].Laps.Min();
                var end = index + 1 < runs.Length ? runs[index + 1].Laps.Min() : int.MaxValue;
                var traces = eligible.Where(trace => trace.Lap >= start && trace.Lap < end).ToArray();
                if (traces.Length > 0) yield return new LapGroup($"Run {runs[index].Number}", traces, runs[index]);
            }
        }
    }
    private double FastestLapTime => Workspace.Traces.Where(trace => IsClean(trace) && trace.LapTimeSeconds.HasValue).Select(trace => trace.LapTimeSeconds!.Value).DefaultIfEmpty(double.MaxValue).Min();
    private IReadOnlyList<PanelSpec> VisiblePanels => Panels.Where(HasPanelData).ToArray();
    private AnalysisLapTrace PrimaryTrace => SelectedTraces.FirstOrDefault() ?? Workspace.Traces[0];
    private AnalysisLapTrace ReferenceTrace => SelectedTraces.Where(IsClean).OrderBy(trace => trace.LapTimeSeconds ?? double.MaxValue).FirstOrDefault() ?? PrimaryTrace;
    private int ChartBottom => ChartTop + VisiblePanels.Count * ChartRowHeight - (ChartRowHeight - ChartPlotHeight);
    private int ChartHeight => ChartBottom + 24;
    private double PlotWidth => Math.Max(300, _chartWidth - PlotLeft - 20);
    private double PlotRight => PlotLeft + PlotWidth;
    private double CursorChartX => PlotLeft + Cursor * PlotWidth;
    private double TooltipX => CursorChartX - TooltipWidth - 12 >= PlotLeft ? CursorChartX - TooltipWidth - 12 : CursorChartX + 12;
    private int TooltipCapacity => Math.Max(1, (ChartRowHeight - 18) / TooltipRowHeight);
    private int EffectiveTooltipOffset => Math.Clamp(_tooltipLapOffset, 0, Math.Max(0, SelectedTraces.Count() - TooltipCapacity));
    private IReadOnlyList<AnalysisLapTrace> TooltipTraces => SelectedTraces.Skip(EffectiveTooltipOffset).Take(TooltipCapacity).ToArray();
    private string CursorSummary
    {
        get
        {
            var point = Nearest(PrimaryTrace, Cursor);
            var delta = point is null ? null : TimeDelta(PrimaryTrace, point);
            return point is null ? "No sample" : $"{point.SpeedMph:0} mph · {point.Throttle * 100:0}% throttle · {point.Brake * 100:0}% brake" + (delta.HasValue ? $" · {delta.Value:+0.000;-0.000;0.000} s" : string.Empty);
        }
    }

    private void ToggleLap(int lap)
    {
        if (!Selected.Remove(lap)) { if (Selected.Count >= 5) Selected.Remove(Selected.First()); Selected.Add(lap); }
        if (Selected.Count == 0) Selected.Add(lap);
    }
    private void SelectLap(int lap) => ToggleLap(lap);
    private void ShowAllLaps() => CleanLapsOnly = false;
    private void CleanLapFilterChanged(ChangeEventArgs args)
    {
        CleanLapsOnly = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (!CleanLapsOnly) return;
        Selected.RemoveWhere(lap => Workspace.Traces.FirstOrDefault(trace => trace.Lap == lap) is not { } trace || !IsClean(trace));
        if (Selected.Count == 0)
        {
            var fastestClean = Workspace.Traces.Where(IsClean).OrderBy(trace => trace.LapTimeSeconds ?? double.MaxValue).FirstOrDefault();
            if (fastestClean is not null) Selected.Add(fastestClean.Lap);
        }
    }
    private void ResetSelection()
    {
        Selected.Clear();
        foreach (var trace in Workspace.Traces.Where(IsClean).OrderBy(trace => trace.LapTimeSeconds ?? double.MaxValue).Take(3)) Selected.Add(trace.Lap);
        if (Selected.Count == 0) foreach (var trace in Workspace.Traces.Take(3)) Selected.Add(trace.Lap);
    }
    private bool ShowPaceDelta(AnalysisLapTrace trace, bool isFastest) =>
        !isFastest && trace.LapTimeSeconds.HasValue && FastestLapTime < double.MaxValue &&
        (trace.Complete || trace.Lap != Workspace.Traces.Max(item => item.Lap));
    private static bool HasOfficialPace(AnalysisRun run) =>
        run.EarlyAverageLapSeconds.HasValue || run.LateAverageLapSeconds.HasValue || run.PaceSlopeSecondsPerLap.HasValue;
    private string ObservedPaceRange(AnalysisRun run)
    {
        var times = Workspace.Traces
            .Where(trace => run.Laps.Contains(trace.Lap) && trace.Complete && !IsCaution(trace) && trace.PitTimeSeconds.GetValueOrDefault() <= 0 && trace.LapTimeSeconds.HasValue)
            .Select(trace => trace.LapTimeSeconds!.Value)
            .ToArray();
        if (times.Length == 0) return "Unavailable";
        if (times.Length == 1) return LapTime(times[0]);
        return $"{LapTime(times.Min())}–{LapTime(times.Max())}";
    }
    private async Task ShowPitPopover(MouseEventArgs args, int lap)
    {
        var viewport = await JS.InvokeAsync<double[]>("iracingCoach.viewportSize");
        var width = viewport.Length > 0 ? viewport[0] : 1280;
        var height = viewport.Length > 1 ? viewport[1] : 800;
        PitPopoverX = Math.Clamp(args.ClientX + 14, 12, Math.Max(12, width - 326));
        PitPopoverY = args.ClientY > height / 2
            ? Math.Max(12, args.ClientY - 350)
            : Math.Min(args.ClientY + 14, Math.Max(12, height - 370));
        ActivePitLap = lap;
    }
    private void HidePitPopover() => ActivePitLap = null;
    private string PitPopoverStyle => $"left:{F(PitPopoverX)}px;top:{F(PitPopoverY)}px";
    private AnalysisRun? RunForLap(int lap)
    {
        var exact = Workspace.Runs.FirstOrDefault(run => run.Laps.Contains(lap));
        if (exact is not null) return exact;
        return Workspace.Runs
            .Where(run => run.PitStop is not null && run.Laps.Count > 0 && lap >= run.Laps.Max() && lap - run.Laps.Max() <= 2)
            .OrderByDescending(run => run.Laps.Max())
            .FirstOrDefault();
    }
    private bool IsClean(AnalysisLapTrace trace) => trace.Complete && trace.PitTimeSeconds.GetValueOrDefault() <= 0 && IncidentPoints(trace.Lap) == 0 && !trace.FlagState.Contains("caution", StringComparison.OrdinalIgnoreCase) && !trace.FlagState.Contains("yellow", StringComparison.OrdinalIgnoreCase);
    private static string LapFlagLabel(AnalysisLapTrace trace) => !trace.Complete ? "Incomplete lap" : IsCaution(trace) ? "Caution lap" : "Green-flag lap";
    private static string LapFlagClass(AnalysisLapTrace trace) => !trace.Complete ? "incomplete" : IsCaution(trace) ? "yellow" : "green";
    private static bool IsCaution(AnalysisLapTrace trace) => trace.FlagState.Contains("caution", StringComparison.OrdinalIgnoreCase) || trace.FlagState.Contains("yellow", StringComparison.OrdinalIgnoreCase);
    private async Task ShowChartCursor()
    {
        ChartHovered = true;
        await MeasureChart();
    }
    private void HideChartCursor() => ChartHovered = false;
    private void ChartWheel(WheelEventArgs args)
    {
        var maximum = Math.Max(0, SelectedTraces.Count() - TooltipCapacity);
        if (maximum == 0 || Math.Abs(args.DeltaY) < .01) return;
        _tooltipLapOffset = Math.Clamp(EffectiveTooltipOffset + (args.DeltaY > 0 ? 1 : -1), 0, maximum);
    }
    private async Task ChartMoved(MouseEventArgs args)
    {
        if (_chartMovePending) return;
        _chartMovePending = true;
        try
        {
            await MeasureChart();
            var pointer = await JS.InvokeAsync<double>("iracingCoach.pointerFraction", ChartElement, args.ClientX);
            Cursor = Math.Clamp((pointer * _chartWidth - PlotLeft) / PlotWidth, 0, 1);
        }
        finally { _chartMovePending = false; }
    }
    private async Task MeasureChart()
    {
        if (Workspace.Traces.Count == 0) return;
        var size = await JS.InvokeAsync<double[]>("iracingCoach.elementSize", ChartElement);
        if (size.Length == 0 || size[0] < 400 || Math.Abs(size[0] - _chartWidth) < .5) return;
        _chartWidth = size[0];
        StateHasChanged();
    }
    private async Task TrackMoved(MouseEventArgs args)
    {
        if (_trackMovePending) return;
        _trackMovePending = true;
        try
        {
            var pointer = await JS.InvokeAsync<double[]>("iracingCoach.pointerViewBox", TrackElement, args.ClientX, args.ClientY, 420, 280);
            if (Workspace.TrackShape.Count < 3) { Cursor = Math.Clamp((pointer[0] - 28) / 364d, 0, 1); return; }
            Cursor = ProjectedMapPercent(pointer[0], pointer[1]);
        }
        finally { _trackMovePending = false; }
    }

    private IReadOnlyList<MapPoint> MapPoints
    {
        get
        {
            var minX = Workspace.TrackShape.Min(p => p.X); var maxX = Workspace.TrackShape.Max(p => p.X);
            var minY = Workspace.TrackShape.Min(p => p.Y); var maxY = Workspace.TrackShape.Max(p => p.Y);
            var scale = Math.Min(350 / Math.Max(.0001, maxX - minX), 218 / Math.Max(.0001, maxY - minY));
            return Workspace.TrackShape.OrderBy(p => p.LapPercent).Select(p => new MapPoint(WrapPercent(p.LapPercent), 210 + (p.X - (minX + maxX) / 2) * scale, 140 - (p.Y - (minY + maxY) / 2) * scale)).ToArray();
        }
    }
    private string TrackViewBox
    {
        get
        {
            if (Workspace.TrackShape.Count < 3) return "0 0 420 280";
            var points = MapPoints;
            const double padding = 18;
            var minX = points.Min(point => point.X) - padding;
            var minY = points.Min(point => point.Y) - padding;
            var width = points.Max(point => point.X) - points.Min(point => point.X) + padding * 2;
            var height = points.Max(point => point.Y) - points.Min(point => point.Y) + padding * 2;
            return $"{F(minX)} {F(minY)} {F(width)} {F(height)}";
        }
    }
    private MapPoint CursorMapPoint => MapPointAt(Cursor);
    private IEnumerable<MapSegment> MapSegments
    {
        get
        {
            var points = MapPoints;
            for (var index = 0; index < points.Count; index++)
            {
                var a = points[index]; var b = points[(index + 1) % points.Count];
                yield return new MapSegment(a, b, MetricColor(MetricAt(SegmentPercent(a.Percent, b.Percent, .5))));
            }
        }
    }
    private double ProjectedMapPercent(double pointerX, double pointerY)
    {
        var points = MapPoints;
        var bestDistance = double.MaxValue;
        var bestPercent = Cursor;
        for (var index = 0; index < points.Count; index++)
        {
            var a = points[index];
            var b = points[(index + 1) % points.Count];
            var dx = b.X - a.X;
            var dy = b.Y - a.Y;
            var lengthSquared = dx * dx + dy * dy;
            var t = lengthSquared <= .000001 ? 0 : Math.Clamp(((pointerX - a.X) * dx + (pointerY - a.Y) * dy) / lengthSquared, 0, 1);
            var projectedX = a.X + dx * t;
            var projectedY = a.Y + dy * t;
            var distance = Math.Pow(pointerX - projectedX, 2) + Math.Pow(pointerY - projectedY, 2);
            if (distance >= bestDistance) continue;
            bestDistance = distance;
            bestPercent = SegmentPercent(a.Percent, b.Percent, t);
        }
        return bestPercent;
    }
    private MapPoint MapPointAt(double percent)
    {
        var points = MapPoints;
        if (points.Count == 0) return new MapPoint(WrapPercent(percent), 210, 140);
        var target = WrapPercent(percent);
        for (var index = 0; index < points.Count; index++)
        {
            var a = points[index];
            var b = points[(index + 1) % points.Count];
            var start = a.Percent;
            var end = b.Percent <= start ? b.Percent + 1 : b.Percent;
            var adjustedTarget = target < start ? target + 1 : target;
            if (adjustedTarget > end + .000001) continue;
            var t = Math.Abs(end - start) < .000001 ? 0 : (adjustedTarget - start) / (end - start);
            return new MapPoint(target, a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t);
        }
        return points.MinBy(point => CircularDistance(point.Percent, target))!;
    }
    private static double SegmentPercent(double start, double end, double t)
    {
        var adjustedEnd = end <= start ? end + 1 : end;
        return WrapPercent(start + (adjustedEnd - start) * t);
    }
    private static double WrapPercent(double value)
    {
        var wrapped = value % 1;
        return wrapped < 0 ? wrapped + 1 : wrapped;
    }
    private static double CircularDistance(double first, double second)
    {
        var distance = Math.Abs(first - second);
        return Math.Min(distance, 1 - distance);
    }
    private IEnumerable<StripSegment> StripSegments
    {
        get
        {
            const int count = 80;
            for (var index = 0; index < count; index++)
            {
                var start = index / (double)count; var end = (index + 1) / (double)count;
                yield return new StripSegment(28 + start * 364, 28 + end * 364, MetricColor(MetricAt((start + end) / 2)));
            }
        }
    }
    private double? MetricAt(double percent)
    {
        var point = Nearest(PrimaryTrace, percent);
        return Mode switch { "throttle" => point?.Throttle, "brake" => point?.Brake, "steering" => point?.SteeringPeakRadians, "stress" => point?.TireStressProxy, _ => point?.SpeedMph };
    }
    private string MetricColor(double? value)
    {
        if (value is null) return "#4A515A";
        if (Mode == "speed")
        {
            var level = Math.Clamp((value.Value - 45) / 125, 0, 1);
            return $"hsl({F(42 + level * 176)} 78% {F(57 + level * 8)}%)";
        }
        var normalized = Mode == "steering" ? Math.Clamp(Math.Abs(value.Value) / .55, 0, 1) : Math.Clamp(value.Value, 0, 1);
        if (normalized < .015) return "#3B424A";
        return Mode switch
        {
            "brake" => $"hsl({F(20 - normalized * 16)} 82% {F(65 - normalized * 8)}%)",
            "throttle" => $"hsl({F(158 - normalized * 14)} 64% {F(51 + normalized * 9)}%)",
            "steering" => $"hsl({F(285 - normalized * 22)} 68% {F(66 - normalized * 7)}%)",
            "stress" => $"hsl({F(112 - normalized * 102)} 76% 59%)",
            _ => "#78A7EF"
        };
    }
    private static AnalysisTracePoint? Nearest(AnalysisLapTrace trace, double percent) => trace.Points.MinBy(point => Math.Abs(point.LapPercent - percent));
    private bool HasPanelData(PanelSpec panel)
    {
        if (panel.Key == "delta") return Workspace.Traces.Any(trace => trace.Points.Any(point => point.SessionTimeSeconds.HasValue));
        return Workspace.Traces.Any(trace => trace.Points.Any(point => panel.First(point).HasValue || panel.Second?.Invoke(point).HasValue == true));
    }
    private double? PanelPointValue(PanelSpec panel, AnalysisLapTrace trace, AnalysisTracePoint point, bool useSecond)
    {
        if (panel.Key == "delta") return useSecond ? null : TimeDelta(trace, point);
        return useSecond ? panel.Second?.Invoke(point) : panel.First(point);
    }
    private double? TimeDelta(AnalysisLapTrace trace, AnalysisTracePoint point)
    {
        if (!point.SessionTimeSeconds.HasValue) return null;
        var traceStart = trace.Points.FirstOrDefault(item => item.SessionTimeSeconds.HasValue)?.SessionTimeSeconds;
        var reference = ReferenceTrace;
        var referencePoint = Nearest(reference, point.LapPercent);
        var referenceStart = reference.Points.FirstOrDefault(item => item.SessionTimeSeconds.HasValue)?.SessionTimeSeconds;
        if (!traceStart.HasValue || referencePoint?.SessionTimeSeconds is not double referenceTime || !referenceStart.HasValue) return null;
        return (point.SessionTimeSeconds.Value - traceStart.Value) - (referenceTime - referenceStart.Value);
    }
    private string CursorValue(PanelSpec panel, AnalysisLapTrace trace)
    {
        var point = Nearest(trace, Cursor);
        if (point is null) return "—";
        var first = PanelPointValue(panel, trace, point, false);
        var second = PanelPointValue(panel, trace, point, true);
        if (!first.HasValue && !second.HasValue) return "—";
        return panel.Key switch
        {
            "delta" => $"{first.GetValueOrDefault():+0.000;-0.000;0.000} s",
            "gear" => $"Gear {first:0}",
            "rpm" => $"{first:0} rpm",
            "speed" => $"{first:0.0} mph",
            "controls" => $"T {first.GetValueOrDefault() * 100:0}% · B {second.GetValueOrDefault() * 100:0}%",
            "steering" => DirectionalDegrees(first),
            "rotation" => $"{first:0.0}° · {second:0.0}°/s",
            "acceleration" => $"{first:0.00} · {second:0.00} g",
            _ => second.HasValue ? $"{first:0.000} / {second:0.000}" : $"{first:0.000}"
        };
    }
    private static string DirectionalDegrees(double? value) => value is null ? "—" : Math.Abs(value.Value) < .05 ? "Center 0°" : value.Value > 0 ? $"Left {Math.Abs(value.Value):0.0}°" : $"Right {Math.Abs(value.Value):0.0}°";
    private (double Min, double Max) PanelRange(PanelSpec panel)
    {
        var values = SelectedTraces.SelectMany(trace => trace.Points.SelectMany(point => new[] { PanelPointValue(panel, trace, point, false), PanelPointValue(panel, trace, point, true) })).Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        if (values.Length == 0) return (-.5, .5);
        if (panel.Key == "delta" || panel.Key == "steering")
        {
            var magnitude = Math.Max(panel.Key == "delta" ? .05 : 1, values.Max(value => Math.Abs(value)));
            return (-magnitude, magnitude);
        }
        var min = values.Min(); var max = values.Max();
        if (Math.Abs(max - min) < .0001) { min -= .5; max += .5; }
        return (min, max);
    }
    private string TracePath(AnalysisLapTrace trace, PanelSpec panel, double top, bool useSecond)
    {
        if (!trace.Points.Any(point => PanelPointValue(panel, trace, point, useSecond).HasValue)) return string.Empty;
        var (min, max) = PanelRange(panel);
        var started = false;
        var commands = new List<string>(trace.Points.Count);
        for (var index = 0; index < trace.Points.Count; index++)
        {
            var value = SmoothedValue(panel, trace, index, useSecond);
            if (!value.HasValue) { started = false; continue; }
            var x = PlotLeft + trace.Points[index].LapPercent * PlotWidth;
            var y = top + ChartPlotHeight - 4 - (value.Value - min) / (max - min) * (ChartPlotHeight - 8);
            commands.Add($"{(started ? "L" : "M")}{F(x)},{F(y)}");
            started = true;
        }
        return string.Join(" ", commands);
    }
    private double? SmoothedValue(PanelSpec panel, AnalysisLapTrace trace, int index, bool useSecond)
    {
        var current = PanelPointValue(panel, trace, trace.Points[index], useSecond);
        if (!current.HasValue || panel.Key == "gear") return current;
        var neighborWeight = panel.Key == "controls" ? .10 : .16;
        var currentWeight = 1 - neighborWeight * 2;
        var sum = current.Value * currentWeight;
        var weight = currentWeight;
        if (index > 0 && PanelPointValue(panel, trace, trace.Points[index - 1], useSecond) is { } previous) { sum += previous * neighborWeight; weight += neighborWeight; }
        if (index + 1 < trace.Points.Count && PanelPointValue(panel, trace, trace.Points[index + 1], useSecond) is { } next) { sum += next * neighborWeight; weight += neighborWeight; }
        return sum / weight;
    }
    private double? PanelCursorY(PanelSpec panel, AnalysisLapTrace trace, double top)
    {
        if (trace.Points.Count == 0) return null;
        var nearestIndex = 0;
        var nearestDistance = double.MaxValue;
        for (var index = 0; index < trace.Points.Count; index++)
        {
            var distance = Math.Abs(trace.Points[index].LapPercent - Cursor);
            if (distance >= nearestDistance) continue;
            nearestDistance = distance;
            nearestIndex = index;
        }
        if (SmoothedValue(panel, trace, nearestIndex, false) is not { } value) return null;
        var (min, max) = PanelRange(panel);
        return top + ChartPlotHeight - 4 - (value - min) / (max - min) * (ChartPlotHeight - 8);
    }
    private static string LapRange(IReadOnlyList<int> laps) => laps.Count == 0 ? "—" : laps.Count == 1 ? laps[0].ToString() : $"{laps.Min()}–{laps.Max()}";
    private static string PaceTrend(AnalysisRun run) => run.PaceSlopeSecondsPerLap is null ? "—" : run.PaceSlopeSecondsPerLap > .005 ? $"+{run.PaceSlopeSecondsPerLap:0.000} s/lap" : run.PaceSlopeSecondsPerLap < -.005 ? $"{run.PaceSlopeSecondsPerLap:0.000} s/lap" : "Stable";
    private static string ControlChange(AnalysisRun run)
    {
        var parts = new List<string>();
        if (run.EarlyBrakeVsLatePercent.HasValue) parts.Add($"brake work {run.EarlyBrakeVsLatePercent.Value:+0;-0;0}%");
        if (run.EarlySteerVsLatePercent.HasValue) parts.Add($"steering work {run.EarlySteerVsLatePercent.Value:+0;-0;0}%");
        return parts.Count > 0 ? string.Join(" · ", parts) : "Control-load comparison unavailable";
    }
    private static string PitServiceTime(AnalysisRun run) => run.PitStop?.ServiceSeconds is { } seconds ? $"{seconds:0.0}s service" : "Recorded stop";
    private static string ChangedTires(AnalysisRun run)
    {
        var tires = run.PitStop?.TiresChanged;
        if (tires is null || tires.Count == 0) return "None recorded";
        return new[] { "LF", "RF", "LR", "RR" }.All(tire => tires.Contains(tire, StringComparer.OrdinalIgnoreCase)) ? "All four" : string.Join(", ", tires);
    }
    private static string TireWear(double? wear) => wear.HasValue ? $"{wear.Value:0.0}%" : "—";
    private static string FuelAdded(AnalysisRun run) => run.PitStop?.FuelAddedGallons switch
    {
        null => "Not recorded",
        < .005 => "None",
        var gallons => $"{gallons.Value:0.00} gal"
    };
    private string FuelRangeAtStop(AnalysisRun run)
    {
        if (run.PitStop?.EstimatedFuelLapsRemaining is not { } range) return "Not available";
        if (Workspace.ScheduledLaps <= 0 || run.Laps.Count == 0) return $"{range:0.0} laps estimated";
        var lapsToFinish = Math.Max(0, Workspace.ScheduledLaps - run.Laps.Max());
        var margin = range - lapsToFinish;
        return margin >= 0 ? $"{range:0.0} laps · enough (+{margin:0.0})" : $"{range:0.0} laps · {-margin:0.0} short";
    }
    private string RaceLapsRemaining(int lap)
    {
        if (Workspace.ScheduledLaps <= 0) return "Not recorded";
        var remaining = Math.Max(0, Workspace.ScheduledLaps - lap);
        return $"{remaining} lap{(remaining == 1 ? string.Empty : "s")}";
    }
    private int IncidentPoints(int lap) => Workspace.Damage.Incidents?.Where(item => item.Lap == lap).Sum(item => item.Points) ?? 0;
    private static string IncidentSeverity(int points) => points >= 4 ? "high" : points >= 2 ? "medium" : "low";
    private IReadOnlyList<double> SectorStarts => Workspace.SectorStartPercents?.Where(value => value >= 0 && value < 1).Distinct().Order().ToArray() ?? [];
    private SectorStatus SectorState(AnalysisLapTrace trace, int sector)
    {
        var duration = SectorDuration(trace, sector);
        if (!duration.HasValue) return new SectorStatus("unavailable", $"S{sector + 1}: not recorded");
        if (!IsClean(trace)) return new SectorStatus("neutral", $"S{sector + 1}: {duration.Value:0.000} s · lap excluded from clean comparison");
        var comparable = Workspace.Traces.Where(IsClean)
            .Select(item => new { Trace = item, Duration = SectorDuration(item, sector) })
            .Where(item => item.Duration.HasValue)
            .ToArray();
        var sessionBest = comparable.Select(item => item.Duration!.Value).DefaultIfEmpty(double.MaxValue).Min();
        if (Math.Abs(duration.Value - sessionBest) < .0005)
            return new SectorStatus("session-fastest", $"S{sector + 1}: {duration.Value:0.000} s · session fastest");
        var priorBest = comparable.Where(item => item.Trace.Lap < trace.Lap).Select(item => item.Duration!.Value).DefaultIfEmpty(double.MaxValue).Min();
        if (duration.Value < priorBest)
            return new SectorStatus("new-best", $"S{sector + 1}: {duration.Value:0.000} s · new best at this point");
        return new SectorStatus("neutral", $"S{sector + 1}: {duration.Value:0.000} s");
    }
    private double? SectorDuration(AnalysisLapTrace trace, int sector)
    {
        if (trace.Points.Count < 2) return null;
        if (sector < 0 || sector >= SectorStarts.Count) return null;
        var startPercent = SectorStarts[sector];
        var endPercent = sector + 1 < SectorStarts.Count ? SectorStarts[sector + 1] : 1d;
        var start = TimeAtPercent(trace.Points, startPercent);
        var end = TimeAtPercent(trace.Points, endPercent);
        return start.HasValue && end.HasValue && end.Value >= start.Value ? end.Value - start.Value : null;
    }
    private static double? TimeAtPercent(IReadOnlyList<AnalysisTracePoint> points, double target)
    {
        var usable = points.Where(point => point.SessionTimeSeconds.HasValue).OrderBy(point => point.LapPercent).ToArray();
        if (usable.Length == 0) return null;
        if (target <= usable[0].LapPercent) return usable[0].SessionTimeSeconds;
        if (target >= usable[^1].LapPercent) return usable[^1].SessionTimeSeconds;
        for (var index = 1; index < usable.Length; index++)
        {
            if (usable[index].LapPercent < target) continue;
            var before = usable[index - 1];
            var after = usable[index];
            var span = after.LapPercent - before.LapPercent;
            if (span <= .000001) return after.SessionTimeSeconds;
            var fraction = (target - before.LapPercent) / span;
            return before.SessionTimeSeconds!.Value + (after.SessionTimeSeconds!.Value - before.SessionTimeSeconds.Value) * fraction;
        }
        return null;
    }
    private static string FriendlyZone(TrackSegment zone) => string.IsNullOrWhiteSpace(zone.Label) || zone.Label.StartsWith("Load zone", StringComparison.OrdinalIgnoreCase) ? $"C{zone.Number}" : zone.Label;
    private string LapColor(int lap)
    {
        var trace = Workspace.Traces.FirstOrDefault(item => item.Lap == lap);
        if (trace?.LapTimeSeconds is { } lapTime && Math.Abs(lapTime - FastestLapTime) < .0001)
            return "#F05CDB";
        var laps = Workspace.Traces.Select(trace => trace.Lap).Distinct().OrderBy(value => value).ToArray();
        var index = Array.IndexOf(laps, lap);
        var fraction = laps.Length <= 1 ? 0 : Math.Max(0, index) / (double)(laps.Length - 1);
        var hue = 280 * fraction;
        return $"hsl({hue.ToString("0.##", CultureInfo.InvariantCulture)} 82% 62%)";
    }
    private static string LapTime(double? seconds) => seconds is null ? "—" : TimeSpan.FromSeconds(seconds.Value).ToString(@"m\:ss\.fff");
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private sealed record PanelSpec(string Key, string Label, string Unit, Func<AnalysisTracePoint, double?> First, Func<AnalysisTracePoint, double?>? Second = null);
    private sealed record MapPoint(double Percent, double X, double Y);
    private sealed record MapSegment(MapPoint A, MapPoint B, string Color);
    private sealed record StripSegment(double X1, double X2, string Color);
    private sealed record LapGroup(string Label, IReadOnlyList<AnalysisLapTrace> Traces, AnalysisRun? Run);
    private sealed record SectorStatus(string Class, string Title);
}
