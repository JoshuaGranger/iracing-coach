    private bool ShowPaceDelta(AnalysisLapTrace trace, bool isFastest) =>
        !isFastest && trace.LapTimeSeconds.HasValue && FastestLapTime < double.MaxValue &&
        (trace.Complete || trace.Lap != Workspace.Traces.Max(item => item.Lap));
    private static bool HasOfficialPace(AnalysisRun run) => run.ComparisonEligible &&
        (run.EarlyAverageLapSeconds.HasValue || run.LateAverageLapSeconds.HasValue || run.PaceSlopeSecondsPerLap.HasValue);
    private string ObservedPaceRange(AnalysisRun run)
    {
        var times = Workspace.Traces
            .Where(trace => run.Laps.Contains(trace.Lap) && trace.Complete && !IsCaution(trace) && trace.PitTimeSeconds.GetValueOrDefault() <= 0 && trace.LapTimeSeconds.HasValue)
            .Select(trace => trace.LapTimeSeconds!.Value)
            .ToArray();
        if (times.Length == 0) return "Unavailable";
        if (times.Length == 1) return LapTime(times[0]);
        return $"{LapTime(times.Min())}–{LapTime(times.Max())}";
    }
    private async Task ShowPitPopover(MouseEventArgs args, int lap, string direction) =>
        await ShowPitPopoverAt(args.ClientX, args.ClientY, lap, direction);
    private async Task ShowPitPopoverFromFocus(int lap, string direction)
    {
        var rect = await InteropArrayOrEmptyAsync("iracingCoach.activeElementRect");
        var x = rect.Length >= 4 ? rect[2] : 24;
        var y = rect.Length >= 4 ? (rect[1] + rect[3]) / 2 : 120;
        await ShowPitPopoverAt(x, y, lap, direction);
    }
    private async Task ShowPitPopoverAt(double clientX, double clientY, int lap, string direction)
    {
        var trace = Workspace.Traces.FirstOrDefault(item => item.Lap == lap);
        if (trace is null || trace.PitServiceFor(Workspace.Runs, direction)?.PitStop is null) return;
        KeepPitPopoverOpen();

        // Do not make visibility depend on optional browser geometry. The safe
        // fallback is rendered immediately, then moved beside the trigger when
        // WebView supplies a valid viewport.
        PitPopoverX = 12;
        PitPopoverY = 12;
        PitPopoverAbove = false;
        PitPopoverAvailableHeight = 680;
        ActivePitLap = lap;
        ActivePitDirection = direction;
        await InvokeAsync(StateHasChanged);

        var viewport = await InteropArrayOrEmptyAsync("iracingCoach.viewportSize");
        if (!PitPopoverIsActive(lap, direction) || viewport.Length < 2) return;
        ApplyPitPopoverPlacement(clientX, clientY, viewport[0], viewport[1]);
        await InvokeAsync(StateHasChanged);
    }
    private void ApplyPitPopoverPlacement(double clientX, double clientY, double viewportWidth, double viewportHeight)
    {
        var width = double.IsFinite(viewportWidth) ? Math.Max(320, viewportWidth) : 1280;
        var height = double.IsFinite(viewportHeight) ? Math.Max(240, viewportHeight) : 800;
        var x = double.IsFinite(clientX) && clientX > 0 ? clientX : 24;
        var y = double.IsFinite(clientY) && clientY > 0 ? clientY : 120;
        var popoverWidth = Math.Min(540, Math.Max(280, width - 24));
        PitPopoverX = Math.Clamp(x + 14, 12, Math.Max(12, width - popoverWidth - 12));
        PitPopoverAbove = y > height / 2;
        PitPopoverY = PitPopoverAbove ? y - 12 : y + 12;
        PitPopoverAvailableHeight = Math.Max(96, PitPopoverAbove ? y - 24 : height - y - 24);
    }
    private async Task<double[]> InteropArrayOrEmptyAsync(string identifier)
    {
        try
        {
            return await JS.InvokeAsync<double[]>(identifier);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException)
        {
            return [];
        }
    }
    private bool PitPopoverIsActive(int lap, string direction) =>
        ActivePitLap == lap && string.Equals(ActivePitDirection, direction, StringComparison.OrdinalIgnoreCase);
    private static string PitPopoverId(int lap, string direction) => $"pit-details-{lap}-{direction}";
    private void KeepPitPopoverOpen()
    {
        _pitPopoverHideCancellation?.Cancel();
        _pitPopoverHideCancellation?.Dispose();
        _pitPopoverHideCancellation = null;
    }
    private async Task SchedulePitPopoverHide()
    {
        KeepPitPopoverOpen();
        var cancellation = new CancellationTokenSource();
        _pitPopoverHideCancellation = cancellation;
        try
        {
            await Task.Delay(180, cancellation.Token);
            if (cancellation.IsCancellationRequested) return;
            ActivePitLap = null;
            ActivePitDirection = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(_pitPopoverHideCancellation, cancellation))
                _pitPopoverHideCancellation = null;
            cancellation.Dispose();
        }
    }
    private string PitPopoverStyle => $"left:{F(PitPopoverX)}px;top:{F(PitPopoverY)}px;max-height:{F(PitPopoverAvailableHeight)}px;transform:{(PitPopoverAbove ? "translateY(-100%)" : "none")}";
