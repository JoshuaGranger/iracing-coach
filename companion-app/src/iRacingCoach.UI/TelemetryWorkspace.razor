    private string ObservedPaceRange(AnalysisRun run)
    {
        var times = Workspace.Traces
            .Where(trace => run.Laps.Contains(trace.Lap) && trace.Complete && !IsCaution(trace) && trace.PitTimeSeconds.GetValueOrDefault() <= 0 && trace.LapTimeSeconds.HasValue)
            .Select(trace => trace.LapTimeSeconds!.Value)
            .ToArray();
        if (times.Length == 0) return "Unavailable";
        if (times.Length == 1) return LapTime(times[0]);
        return $"{LapTime(times.Min())}–{LapTime(times.Max())}";
    }
