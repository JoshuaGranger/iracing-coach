@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="telemetry-workspace" aria-label="Telemetry lap comparison" @onkeydown="HandleWorkspaceKeyDown" @onclick="CloseSpotlightMenu">
    <div class="analysis-section-heading @(IsRaceWorkspace ? "context-only" : null)">
        @if (!IsRaceWorkspace)
        {
            <div><span class="eyebrow">Telemetry</span><h2>Compare laps</h2></div>
        }
        @if (IsRaceWorkspace)
        {
            <div class="analysis-context-toggles" role="group" aria-label="Telemetry context panels" @onclick:stopPropagation="true">
                <button type="button"
                        class="context-toggle-chip @(!TrackPanelCollapsed ? "active" : null)"
                        data-context-toggle="track"
                        aria-controls="race-track-panel-content"
                        aria-pressed="@AriaBoolean(!TrackPanelCollapsed)"
                        @onclick="ToggleTrackPanel"><ProductIcon Name="analysis" Size="14" /><span>Track position</span></button>
                <button type="button"
                        class="context-toggle-chip @(!LapRailCollapsed ? "active" : null)"
                        data-context-toggle="laps"
                        aria-controls="race-lap-rail-content"
                        aria-pressed="@AriaBoolean(!LapRailCollapsed)"
                        @onclick="ToggleLapRail"><ProductIcon Name="race" Size="14" /><span>Laps &amp; runs</span></button>
            </div>
        }
    </div>

    @if (Workspace.Traces.Count == 0)
    {
        <div class="empty-state compact-empty"><h3>Detailed traces were not recorded</h3><p>Enable iRacing disk telemetry to record speed, controls, and load traces in future races.</p></div>
    }
    else
    {
        <div class="telemetry-workstation-grid @(IsRaceWorkspace ? "race-workstation" : "qualifying-workstation") @ContextColumnState">
        <div @ref="ContextColumnElement" class="telemetry-context-column">
        <section class="track-panel telemetry-context-panel @(TrackPanelCollapsed ? "collapsed" : null)"
                 aria-labelledby="track-panel-title"
                 aria-hidden="@(IsRaceWorkspace && TrackPanelCollapsed ? "true" : null)"
                 inert="@(IsRaceWorkspace && TrackPanelCollapsed ? string.Empty : null)">
            <div class="panel-title track-panel-title">
                @if (IsRaceWorkspace)
                {
                    <div class="context-heading-static"><strong id="track-panel-title">@(Workspace.GeometryMode == "track_shape" ? "Track position" : "Lap distance")</strong><span>Average of selected laps</span></div>
                }
                else
                {
                    <div class="context-heading-static"><strong id="track-panel-title">@(Workspace.GeometryMode == "track_shape" ? "Track position" : "Lap distance")</strong><span>Average of selected laps</span></div>
                }
                <div class="track-panel-actions">
                    <label class="track-color-control"><span>Type</span><select @ref="MapTypeElement" data-map-type value="@Mode" @onchange="ChangeMapMode">@foreach (var option in Modes) { <option value="@option.Key">@option.Label</option> }</select></label>
                    <button type="button" class="track-fit-button" title="Fit track" aria-label="Fit track" @onclick="FitTrackMap"><ProductIcon Name="contract" Size="13" /><span>Fit track</span></button>
                </div>
            </div>
            <div id="race-track-panel-content"
                 class="track-panel-content"
                 aria-hidden="@AriaBoolean(TrackPanelCollapsed)"
                 inert="@(TrackPanelCollapsed ? string.Empty : null)">
                <svg @ref="TrackElement" class="track-map rich-analysis-map" data-analysis-track-map data-map-type="@Mode" viewBox="@TrackViewBox" role="img" aria-label="Track telemetry map">
                    @if (HasMapGeometry)
                    {
                        var startFinishLine = StartFinishLine;
                        @if (Mode == "traces")
                        {
                            <path d="@TrackRibbonPath" class="track-main-ribbon-halo" data-map-layer="main" />
                            <path d="@TrackRibbonPath" class="track-main-ribbon" data-map-layer="main" />
                            @foreach (var tracePath in MapTracePaths)
                            {
                                <path d="@tracePath.Path" stroke="@tracePath.Color" class="track-lap-trace" data-map-layer="lap-trace" data-laps="@tracePath.Laps" />
                            }
                        }
                        else
                        {
                            <path d="@TrackRibbonPath" class="track-metric-route" data-map-layer="main" />
                            @foreach (var segment in MetricRibbonSegments)
                            {
                                <path d="@segment.Path" fill="@segment.Color" stroke="@segment.Color" class="track-metric-ribbon-segment" data-map-layer="@Mode" data-width-start="@F(segment.StartWidth)" data-width-end="@F(segment.EndWidth)" />
                            }
                        }
                        @foreach (var layer in PitMapLayers)
                        {
                            @if (!string.IsNullOrWhiteSpace(layer.PitRoad)) { <path d="@layer.PitRoad" class="track-pit-road-halo" data-map-layer="pit-road" /><path d="@layer.PitRoad" class="track-pit-road" data-map-layer="pit-road" /> }
                            @if (!string.IsNullOrWhiteSpace(layer.Entry)) { <path d="@layer.Entry" class="track-pit-entry" data-map-layer="pit-entry" /> }
                            @if (!string.IsNullOrWhiteSpace(layer.Exit)) { <path d="@layer.Exit" class="track-pit-exit" data-map-layer="pit-exit" /> }
                            @if (layer.EntryCommitment is { } entryCommitment) { <line x1="@F(entryCommitment.X1)" y1="@F(entryCommitment.Y1)" x2="@F(entryCommitment.X2)" y2="@F(entryCommitment.Y2)" class="track-pit-commitment entry" data-map-layer="commitment" /> }
                            @if (layer.ExitCommitment is { } exitCommitment) { <line x1="@F(exitCommitment.X1)" y1="@F(exitCommitment.Y1)" x2="@F(exitCommitment.X2)" y2="@F(exitCommitment.Y2)" class="track-pit-commitment exit" data-map-layer="commitment" /> }
                        }
                        <line x1="@F(startFinishLine.X1)" y1="@F(startFinishLine.Y1)" x2="@F(startFinishLine.X2)" y2="@F(startFinishLine.Y2)" class="track-start-line-halo" data-map-layer="start-finish" />
                        <line x1="@F(startFinishLine.X1)" y1="@F(startFinishLine.Y1)" x2="@F(startFinishLine.X2)" y2="@F(startFinishLine.Y2)" class="track-start-line" data-map-layer="start-finish" />
                        <circle data-analysis-track-cursor-point data-map-cursor-radius="8" cx="@F(CursorMapPoint.X)" cy="@F(CursorMapPoint.Y)" r="8" class="map-cursor-halo" />
                        <circle data-analysis-track-cursor-point data-map-cursor-radius="4" cx="@F(CursorMapPoint.X)" cy="@F(CursorMapPoint.Y)" r="4" class="map-cursor" />
                    }
                    else
                    {
                        <line x1="28" y1="140" x2="392" y2="140" class="distance-base" />
                        @foreach (var segment in StripSegments)
                        {
                            <line x1="@F(segment.X1)" y1="140" x2="@F(segment.X2)" y2="140" stroke="@segment.Color" stroke-width="14" stroke-linecap="round" />
                        }
                        @foreach (var zone in Workspace.Segments)
                        {
                            <line x1="@F(28 + zone.StartPercent * 364)" y1="113" x2="@F(28 + zone.StartPercent * 364)" y2="167" class="zone-marker" />
                            <svg:text x="@F(28 + zone.StartPercent * 364)" y="99" class="chart-label">@FriendlyZone(zone)</svg:text>
                        }
                        <line x1="28" y1="124" x2="28" y2="156" class="track-start-line-halo" />
                        <line x1="28" y1="124" x2="28" y2="156" class="track-start-line" />
                        <circle data-analysis-track-cursor-point data-map-cursor-radius="8" cx="@F(28 + Cursor * 364)" cy="140" r="8" class="map-cursor-halo" />
                        <circle data-analysis-track-cursor-point data-map-cursor-radius="4" cx="@F(28 + Cursor * 364)" cy="140" r="4" class="map-cursor" />
                        <svg:text x="28" y="205" class="chart-label">Start / finish</svg:text><svg:text x="392" y="205" text-anchor="end" class="chart-label">100%</svg:text>
                    }
                </svg>
                @if (Mode != "traces")
                {
                    <div class="track-map-legend" data-map-legend data-mode="@Mode">
                        <span class="map-scale-copy"><b>@MapLegendMinimum</b><i class="map-scale-gradient @Mode"></i><b>@MapLegendMaximum</b></span>
                    </div>
                }
                <div class="cursor-readout"><strong data-analysis-track-percent>@((Cursor * 100).ToString("0.0"))%</strong><span data-analysis-track-summary>@CursorSummary</span></div>
            </div>
        </section>

        @if (IsRaceWorkspace)
        {
            <div @ref="ContextSplitterElement"
                 class="analysis-context-splitter"
                 data-analysis-context-splitter
                 role="separator"
                 aria-label="Resize Track position and Laps and runs"
                 aria-orientation="horizontal"
                 aria-valuemin="33"
                 aria-valuemax="67"
                 aria-valuenow="43"
                 tabindex="0"><span aria-hidden="true"></span></div>
        }

        <aside class="lap-rail telemetry-context-panel @(LapRailCollapsed ? "collapsed" : null)"
               aria-labelledby="lap-rail-title"
               aria-hidden="@(IsRaceWorkspace && LapRailCollapsed ? "true" : null)"
               inert="@(IsRaceWorkspace && LapRailCollapsed ? string.Empty : null)">
            <div class="lap-rail-header">
                @if (IsRaceWorkspace)
                {
                    <div class="context-heading-static"><strong id="lap-rail-title">Laps &amp; runs</strong><span>@Selected.Count selected</span></div>
                }
                else
                {
                    <button type="button"
                            class="context-heading-button"
                            aria-controls="race-lap-rail-content"
                            aria-expanded="@AriaBoolean(!LapRailCollapsed)"
                            aria-label="@(LapRailCollapsed ? "Show Laps and runs" : "Hide Laps and runs")"
                            @onclick="ToggleLapRail">
                        <span class="context-heading-copy"><strong id="lap-rail-title">Laps &amp; runs</strong><span>@Selected.Count selected</span></span>
                        <ProductIcon Name="chevron-up" Size="15" />
                    </button>
                }
                <div class="lap-filter-controls" aria-label="Lap filters">
                    <label class="green-lap-filter"><input type="checkbox" checked="@GreenLapsOnly" @onchange="GreenLapFilterChanged" /> Green laps</label>
                    <label class="clean-lap-filter"><input type="checkbox" checked="@CleanLapsOnly" @onchange="CleanLapFilterChanged" /> Clean laps</label>
                </div>
            </div>
            <div id="race-lap-rail-content"
                 class="lap-rail-content"
                 aria-hidden="@AriaBoolean(LapRailCollapsed)"
                 inert="@(LapRailCollapsed ? string.Empty : null)">
            <div class="lap-rail-scroll">
                @foreach (var indexedGroup in LapGroups.Select((group, index) => new { Group = group, Index = index }))
                {
                    var group = indexedGroup.Group;
                    <details class="lap-run-group @(indexedGroup.Index > 0 ? "separated" : null)" open>
                        <summary>
                            <span class="run-summary-name">@group.Label</span>
                            @if (group.Run is { } summaryRun)
                            {
                                <span class="run-summary-metrics"><span><i class="metric-dot green" aria-hidden="true"></i>@summaryRun.GreenLaps green</span><span><i class="metric-dot yellow" aria-hidden="true"></i>@summaryRun.CautionLaps caution</span></span>
                                <span class="run-insight" tabindex="0" aria-label="Run @summaryRun.Number details" @onclick:stopPropagation="true">i<span class="run-tooltip" role="tooltip"><strong>Run @summaryRun.Number · laps @LapRange(summaryRun.Laps)</strong>@if (HasOfficialPace(summaryRun)) { <span>Early pace <b>@LapTime(summaryRun.EarlyAverageLapSeconds)</b></span><span>Late pace <b>@LapTime(summaryRun.LateAverageLapSeconds)</b></span><span>Pace trend <b>@PaceTrend(summaryRun)</b></span> } else { <span>Observed green pace <b>@ObservedPaceRange(summaryRun)</b></span><span>Coaching comparison <b>Excluded</b></span> }@if (summaryRun.FuelUsedGallons.HasValue) { <span>Fuel used <b>@summaryRun.FuelUsedGallons.Value.ToString("0.00") gal</b></span> }@if (summaryRun.TireRemainingPercent.HasValue) { <span>Lowest tire <b>@summaryRun.TireName @summaryRun.TireRemainingPercent.Value.ToString("0.0")%</b></span> }<small>@(HasOfficialPace(summaryRun) ? ControlChange(summaryRun) : summaryRun.Status)</small></span></span>
                            }
                            else
                            {
                                <small>@group.Traces.Count laps</small>
                            }
                        </summary>
                        @foreach (var trace in group.Traces)
                        {
                            var pitDirections = PitDirections(trace);
                            var pitLap = pitDirections.Count > 0 || trace.PitTimeSeconds.GetValueOrDefault() > 0;
                            var lapIncidents = LapIncidents(trace.Lap);
                            var incidentPoints = lapIncidents.Sum(incident => incident.Points);
                            var activePitRun = ActivePitLap == trace.Lap && !string.IsNullOrWhiteSpace(ActivePitDirection)
                                ? trace.PitServiceFor(Workspace.Runs, ActivePitDirection)
                                : null;
                            var isFastest = trace.LapTimeSeconds.HasValue && Math.Abs(trace.LapTimeSeconds.Value - FastestLapTime) < .0001;
                            <div class="lap-rail-row @(Selected.Contains(trace.Lap) ? "selected" : null) @(pitLap ? "pit-lap" : null)" style="@($"--lap-color:{LapColor(trace.Lap)}")" @onclick="() => SelectLap(trace.Lap)">
                                <button type="button" class="lap-select-button" aria-label="@($"Select lap {trace.Lap}, {LapTime(trace.LapTimeSeconds)}")" aria-pressed="@AriaBoolean(Selected.Contains(trace.Lap))" @onclick:stopPropagation="true" @onclick="() => SelectLap(trace.Lap)"></button>
                                <span class="lap-flags" aria-label="Recorded lap flags">
                                    @foreach (var flag in LapFlags(trace))
                                    {
                                        <span class="lap-flag @flag.Class" title="@flag.Label" aria-label="@flag.Label"><ProductIcon Name="race" Size="12" /></span>
                                    }
                                </span>
                                <span class="lap-identity"><b>@trace.Lap</b><i class="lap-trace-color" aria-hidden="true"></i></span>
                                <span class="lap-time condition-hover @(isFastest ? "fastest" : null)" title="Lap weather and track conditions" @onmouseenter="args => ShowConditionsPopover(args, trace.Lap)" @onmouseleave="HideConditionsPopover"><span class="lap-pace-value">@LapTime(trace.LapTimeSeconds)</span>@if (ShowPaceDelta(trace, isFastest)) { <small>(@((trace.LapTimeSeconds!.Value - FastestLapTime).ToString("+0.000;-0.000;0.000")))</small> }</span>
                                <span class="lap-sector-column">
                                    @if (SectorStarts.Count > 1)
                                    {
                                    <span class="sector-squares" aria-label="Sector performance">
                                        @for (var sector = 0; sector < SectorStarts.Count; sector++)
                                        {
                                            var sectorState = SectorState(trace, sector);
                                            <span class="sector-square @sectorState.Class" title="@sectorState.Title" aria-hidden="true"></span>
                                        }
                                    </span>
                                    }
                                </span>
                                <span class="lap-fuel-column" title="@FuelConsumedTitle(trace)">@FuelConsumed(trace)</span>
                                <span class="lap-incident-column">
                                    @if (lapIncidents.Count > 0)
                                    {
                                        <button type="button"
                                                class="incident-badge severity-@IncidentSeverity(incidentPoints)"
                                                aria-haspopup="true"
                                                aria-expanded="@AriaBoolean(ActiveIncidentLap == trace.Lap)"
                                                aria-controls="@IncidentPopoverId(trace.Lap)"
                                                aria-label="@($"Lap {trace.Lap}, x{incidentPoints} incident details")"
                                                @onmouseenter="args => ShowIncidentPopover(args, trace.Lap)"
                                                @onmouseleave="HideIncidentPopover"
                                                @onfocus="() => ShowIncidentPopoverFromFocus(trace.Lap)"
                                                @onblur="HideIncidentPopover"
                                                @onclick:stopPropagation="true"
                                                @onkeydown:stopPropagation="true">@($"x{incidentPoints}")</button>
                                    }
                                </span>
                                <span class="lap-pit-column">
                                    @foreach (var direction in pitDirections)
                                    {
                                        <button type="button"
                                                class="pit-badge"
                                                aria-haspopup="dialog"
                                                aria-expanded="@AriaBoolean(PitPopoverIsActive(trace.Lap, direction))"
                                                aria-controls="@PitPopoverId(trace.Lap, direction)"
                                                aria-label="@($"Pit {(direction == "in" ? "entry" : "exit")} details")"
                                                title="@(direction == "in" ? "Pit entry" : "Pit exit")"
                                                @onmouseenter="args => ShowPitPopover(args, trace.Lap, direction)"
                                                @onmouseleave="SchedulePitPopoverHide"
                                                 @onfocus="() => ShowPitPopoverFromFocus(trace.Lap, direction)"
                                                 @onblur="SchedulePitPopoverHide"
                                                 @onclick="args => ShowPitPopover(args, trace.Lap, direction)"
                                                 @onclick:stopPropagation="true"
                                                 @onkeydown:stopPropagation="true">@(direction == "in" ? "Pit entry" : "Pit exit")</button>
                                    }
                                </span>
                                @if (pitLap && activePitRun?.PitStop is not null)
                                {
                                    var tireConditions = PitTireConditions(activePitRun.PitStop);
                                    <span id="@PitPopoverId(trace.Lap, ActivePitDirection!)"
                                          class="pit-lap-popover"
                                          style="@PitPopoverStyle"
                                          role="dialog"
                                          aria-label="@($"Pit lap {trace.Lap} details")"
                                          tabindex="0"
                                          @onmouseenter="KeepPitPopoverOpen"
                                          @onmouseleave="SchedulePitPopoverHide"
                                          @onfocus="KeepPitPopoverOpen"
                                          @onblur="SchedulePitPopoverHide"
                                          @onclick:stopPropagation="true"
                                          @onkeydown:stopPropagation="true"
                                          @onwheel:stopPropagation="true">
                                        <span class="pit-popover-heading"><strong>Pit lap @trace.Lap</strong><small>@PitServiceWindow(activePitRun)</small></span>
                                        <span class="pit-popover-row"><span>Confirmed tires changed</span><b>@ChangedTires(activePitRun)</b></span>
                                        @if (tireConditions.Count > 0)
                                        {
                                            <span class="pit-popover-label">Measured tire condition</span>
                                            <span class="pit-tire-grid">
                                                @foreach (var tire in tireConditions)
                                                {
                                                    var bandLabels = TireBandLabels(tire.Corner);
                                                    <span class="pit-tire-card">
                                                        <span class="pit-tire-heading"><strong>@tire.Corner</strong>@if (TireChanged(activePitRun, tire.Corner)) { <em>Changed</em> }@if (tire.AverageWearPercent.HasValue) { <small>@tire.AverageWearPercent.Value.ToString("0.0")% avg wear</small> }</span>
                                                        @if (HasBandValues(tire.WearPercent))
                                                        {
                                                            <span class="pit-band-row pit-band-head"><span></span>@foreach (var label in bandLabels) { <b>@label</b> }</span>
                                                            <span class="pit-band-row"><span>Wear</span>@foreach (var value in OrientedBands(tire.Corner, tire.WearPercent)) { <b>@BandPercent(value)</b> }</span>
                                                        }
                                                        @if (HasBandValues(tire.CarcassTemperatureF))
                                                        {
                                                            <span class="pit-band-row"><span>Carcass</span>@foreach (var value in OrientedBands(tire.Corner, tire.CarcassTemperatureF)) { <b>@BandTemperature(value)</b> }</span>
                                                        }
                                                        @if (HasBandValues(tire.SurfaceTemperatureF))
                                                        {
                                                            <span class="pit-band-row"><span>Surface</span>@foreach (var value in OrientedBands(tire.Corner, tire.SurfaceTemperatureF)) { <b>@BandTemperature(value)</b> }</span>
                                                        }
                                                        @if (tire.PressurePsi.HasValue)
                                                        {
                                                            <span class="pit-tire-pressure"><span>@PressureKind(tire.PressureKind) pressure</span><b>@tire.PressurePsi.Value.ToString("0.0") psi</b></span>
                                                        }
                                                    </span>
                                                }
                                            </span>
                                            <small class="pit-tire-note">Bands read outside-to-inside across the car: O/M/I on the left, I/M/O on the right. Values are the recorded stop snapshot.</small>
                                        }
                                        <span class="pit-popover-row"><span>Fuel added</span><b>@FuelAdded(activePitRun)</b></span>
                                        <span class="pit-popover-row"><span>Fuel range at stop</span><b>@FuelRangeAtStop(activePitRun)</b></span>
                                        <span class="pit-popover-row"><span>Race remaining</span><b>@RaceLapsRemaining(trace.Lap)</b></span>
                                        @if (activePitRun.PitStop.DamageRepairedSeconds is { } repaired) { <span class="pit-popover-row"><span>Recorded repair work</span><b>@repaired.ToString("0.0") s</b></span> }
                                        @if (activePitRun.PitStop.PenaltyServedSeconds is { } penalty) { <span class="pit-popover-row"><span>Penalty served</span><b>@penalty.ToString("0.0") s</b></span> }
                                    </span>
                                }
                                @if (ActiveConditionsLap == trace.Lap && trace.Conditions is { } conditions)
                                {
                                    <span class="lap-conditions-popover" style="@ConditionsPopoverStyle" role="tooltip">
                                        <span class="conditions-popover-heading"><strong>Lap @trace.Lap conditions</strong><small>@LapTime(trace.LapTimeSeconds)</small></span>
                                        <span class="conditions-grid">
                                            <span class="condition-item sky"><ProductIcon Name="weather" Size="17" /><b>@Sky(conditions)</b></span>
                                            <span class="condition-item track-temp"><ProductIcon Name="temperature" Size="17" /><b>@Temperature(conditions.TrackTemperatureF)</b></span>
                                            <span class="condition-item air-temp"><ProductIcon Name="air-temperature" Size="17" /><b>@Temperature(conditions.AirTemperatureF)</b></span>
                                            <span class="condition-item wind"><ProductIcon Name="wind" Size="17" /><b>@Wind(conditions)</b></span>
                                            <span class="condition-item humidity"><ProductIcon Name="humidity" Size="17" /><b>@Percent(conditions.RelativeHumidityPercent)</b></span>
                                            <span class="condition-item fog"><ProductIcon Name="fog" Size="17" /><b>@Percent(conditions.FogPercent)</b></span>
                                            <span class="condition-item pressure"><ProductIcon Name="pressure" Size="17" /><b>@Pressure(conditions.AirPressureInHg)</b></span>
                                            <span class="condition-item density"><ProductIcon Name="density" Size="17" /><b>@Density(conditions.AirDensityPoundsPerCubicFoot)</b></span>
                                            <span class="condition-item precipitation"><ProductIcon Name="precipitation" Size="17" /><b>@Percent(conditions.PrecipitationPercent)</b></span>
                                        </span>
                                        <span class="track-usage-row"><i aria-hidden="true"></i><strong>@TrackUsage(conditions)</strong></span>
                                    </span>
                                }
                                 @if (ActiveIncidentLap == trace.Lap && lapIncidents.Count > 0)
                                 {
                                     <span id="@IncidentPopoverId(trace.Lap)" class="incident-popover" style="@IncidentPopoverStyle" role="tooltip">
                                         <strong>@($"Lap {trace.Lap} · x{incidentPoints}")</strong>
                                         @foreach (var incident in lapIncidents)
                                         {
                                             var description = IncidentEventDescription(incident, lapIncidents.Count > 1);
                                             @if (!string.IsNullOrWhiteSpace(description))
                                             {
                                                 <span>@description</span>
                                             }
                                         }
                                     </span>
                                 }
                            </div>
                        }
                    </details>
                }
            </div>
            <div class="lap-rail-footer"><button class="text-button" @onclick="SelectFastest">Fastest</button><button class="text-button" @onclick="ResetSelection">Best three</button><button class="text-button" @onclick="ClearSelection">Clear</button><button class="text-button" @onclick="ShowAllLaps">Show all</button></div>
            </div>
        </aside>
        </div>

        <div class="telemetry-grid">
            <div @ref="TraceStudioElement"
                 class="trace-panel analysis-trace-studio @(TraceExpanded ? "trace-panel-expanded" : null) @(TraceToolboxOpen ? "editing toolbox-open" : "viewing toolbox-closed")"
                 data-analysis-trace-studio
                 tabindex="-1">
                <div class="panel-title trace-panel-title">
                    <div class="trace-panel-summary"><strong>Aligned traces</strong><span>@Selected.Count selected · hover to compare</span></div>
                    <div @ref="SpotlightControlElement" class="trace-spotlight-control" @onfocusout="HandleSpotlightFocusOut" @onclick:stopPropagation="true">
                        <button @ref="SpotlightTriggerElement" type="button"
                                class="spotlight-menu-trigger"
                                data-pointer-no-focus
                                aria-label="Spotlight lap"
                                aria-haspopup="listbox"
                                aria-expanded="@AriaBoolean(SpotlightMenuOpen)"
                                @onclick="ToggleSpotlightMenu"><span>Spotlight lap</span><ProductIcon Name="chevron-down" Size="13" /></button>
                        @if (SpotlightMenuOpen)
                        {
                            <div class="spotlight-menu" role="listbox" aria-label="Spotlight lap choices">
                                @foreach (var trace in SpotlightCandidates)
                                {
                                    var spotlightFastest = trace.LapTimeSeconds.HasValue && Math.Abs(trace.LapTimeSeconds.Value - FastestLapTime) < .0001;
                                    <button type="button"
                                            class="spotlight-option @(SpotlightLap == trace.Lap ? "selected" : null)"
                                            role="option"
                                            aria-selected="@AriaBoolean(SpotlightLap == trace.Lap)"
                                            style="@($"--lap-color:{LapColor(trace.Lap)}")"
                                            @onmousedown:preventDefault="true"
                                            @onclick="() => SelectSpotlight(trace.Lap)">
                                        <span class="spotlight-lap"><b>@trace.Lap</b><i class="lap-trace-color" aria-hidden="true"></i></span>
                                        <span class="spotlight-time @(spotlightFastest ? "fastest" : null)">@LapTime(trace.LapTimeSeconds)@(spotlightFastest ? " · Fastest" : string.Empty)</span>
                                        <span class="sector-squares" aria-label="Sector performance">
                                            @for (var sector = 0; sector < SectorStarts.Count; sector++)
                                            {
                                                var sectorState = SectorState(trace, sector);
                                                <span class="sector-square @sectorState.Class" title="@sectorState.Title" aria-hidden="true"></span>
                                            }
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        @if (SpotlightLap.HasValue)
                        {
                            <span class="spotlight-active-chip" style="@($"--lap-color:{LapColor(SpotlightLap.Value)}")"><i></i>Lap @SpotlightLap</span>
                            <button type="button" class="spotlight-clear" @onclick="ClearSpotlight">Clear</button>
                        }
                    </div>
                    <div class="trace-panel-actions">
                        <button @ref="TraceToolboxButtonElement" type="button" class="trace-toolbox-button" title="Customize trace charts" aria-label="Customize trace charts" aria-expanded="@AriaBoolean(TraceToolboxOpen)" aria-controls="analysis-trace-toolbox" @onclick="ToggleTraceToolbox">
                            <ProductIcon Name="setup" Size="15" /><span>Customize</span>
                        </button>
                        <button @ref="TraceExpandButtonElement" type="button" class="trace-expand-button" title="@(TraceExpanded ? "Exit full screen (Esc)" : "View traces full screen")" aria-label="@(TraceExpanded ? "Exit full-screen traces" : "View traces full screen")" aria-pressed="@AriaBoolean(TraceExpanded)" @onclick="() => ToggleTraceExpanded(false)">
                            <ProductIcon Name="@(TraceExpanded ? "contract" : "expand")" Size="16" />
                        </button>
                    </div>
                </div>
                <aside id="analysis-trace-toolbox"
                       class="analysis-trace-toolbox @(TraceToolboxOpen ? "open" : null)"
                       aria-hidden="@AriaBoolean(!TraceToolboxOpen)"
                       inert="@(!TraceToolboxOpen ? string.Empty : null)"
                       aria-label="Race analysis trace toolbox">
                    <header class="trace-toolbox-heading">
                        <div><span class="eyebrow">Race analysis</span><h2>Customize traces</h2><p>Drag telemetry onto a chart. Drag a chart title to reorder.</p></div>
                        <button type="button" class="trace-toolbox-close" aria-label="Hide trace toolbox" title="Hide toolbox" @onclick="() => CloseTraceToolbox(false)"><ProductIcon Name="close" Size="17" /></button>
                    </header>
                    <div class="analysis-trace-toolbox-body">
                        <section class="trace-toolbox-layout-section">
                            <div class="toolbox-section-heading"><div><span class="toolbox-kicker">Trace layout</span><strong>@ActiveTraceLayout.Named.Name</strong></div><span>@TraceRows.Count / @AnalysisTraceLayouts.MaximumRows</span></div>
                            <div class="analysis-layout-library">
                                <label class="analysis-layout-select"><span class="sr-only">Race Analysis trace layout</span><select data-analysis-layout-select value="@TraceLayoutPreferences.ActiveLayoutId" @onchange="ChangeTraceLayout">@foreach (var choice in TraceLayoutChoices) { <option value="@choice.Named.Id">@choice.Named.Name</option> }</select></label>
                                <button type="button" data-analysis-layout-new title="Create a trace layout" @onclick="CreateTraceLayout"><ProductIcon Name="plus" Size="15" /> New</button>
                                <button type="button" data-analysis-layout-duplicate title="Duplicate this trace layout" @onclick="DuplicateTraceLayout"><ProductIcon Name="duplicate" Size="15" /> Copy</button>
                                <button type="button" data-analysis-layout-delete class="danger" disabled="@ActiveTraceLayout.IsFactory" title="Delete this custom trace layout" @onclick="DeleteTraceLayout"><ProductIcon Name="trash" Size="15" /> Delete</button>
                            </div>
                            @if (ActiveTraceLayout.IsFactory)
                            {
                                <div class="analysis-layout-default-note" data-analysis-layout-default><ProductIcon Name="check" Size="14" /><span>Default is protected. Editing creates a copy.</span></div>
                            }
                            else
                            {
                                <label class="analysis-layout-name"><span>Name</span><input data-analysis-layout-rename value="@ActiveTraceLayout.Named.Name" maxlength="40" @onchange="RenameTraceLayout" /></label>
                            }
                        </section>
                        @if (SelectedTraceRow is { } selectedRow && PanelFor(selectedRow) is { } selectedPanel)
                        {
                            var renderedSignalIds = selectedPanel.Signals.Where(HasSignalData).Select(signal => signal.Id).ToArray();
                            <section class="trace-toolbox-inspector-section">
                                <div class="toolbox-section-heading"><div><span class="toolbox-kicker">Selected chart</span><strong>@RowLabel(selectedPanel)</strong></div><span>@selectedPanel.Signals.Count trace@(selectedPanel.Signals.Count == 1 ? string.Empty : "s")</span></div>
                                <div class="trace-selected-signals">
                                    @foreach (var indexedSignal in selectedPanel.Signals.Select((signal, index) => new { Signal = signal, Index = index }))
                                    {
                                        var renderedIndex = Array.IndexOf(renderedSignalIds, indexedSignal.Signal.Id);
                                        var traceStyle = renderedIndex < 0 ? "unavailable" : renderedIndex == 0 ? "solid" : "dashed";
                                        var traceStyleTitle = renderedIndex < 0 ? "Not recorded in this race" : renderedIndex == 0 ? "Solid trace" : "Dashed trace";
                                        <div class="trace-selected-signal">
                                            <i class="@traceStyle" title="@traceStyleTitle" aria-hidden="true"></i>
                                            <span><strong>@indexedSignal.Signal.Name</strong><small>@indexedSignal.Signal.Unit</small></span>
                                            <button type="button" data-analysis-no-drag aria-label="Remove @indexedSignal.Signal.Name from this chart" title="Remove this trace" @onclick="() => RemoveTraceSignal(selectedRow.Id, indexedSignal.Signal.Id)"><ProductIcon Name="close" Size="14" /></button>
                                        </div>
                                    }
                                </div>
                                <button type="button" class="toolbox-remove-widget" data-analysis-no-drag disabled="@(TraceRows.Count <= 1)" @onclick="() => RemoveTraceRow(selectedRow.Id)"><ProductIcon Name="trash" Size="16" /> Remove chart</button>
                            </section>
                        }
                        <section class="toolbox-metric-catalog analysis-trace-catalog">
                            <div class="toolbox-section-heading"><div><span class="toolbox-kicker">Trace library</span><strong>Add telemetry</strong></div><span>@FilteredTraceSignals.Count</span></div>
                            <label class="toolbox-search"><span class="sr-only">Search trace telemetry</span><ProductIcon Name="search" Size="16" /><input type="search" placeholder="Search speed, pedals, load..." @bind="_traceSignalSearch" @bind:event="oninput" /></label>
                            <div class="toolbox-metric-list" role="list" aria-label="Telemetry traces">
                                @if (FilteredTraceSignals.Count == 0)
                                {
                                    <div class="toolbox-search-empty"><strong>No matching telemetry</strong><span>Try a shorter name or unit.</span></div>
                                }
                                @foreach (var group in TraceSignalGroups)
                                {
                                    <section class="trace-signal-category" aria-labelledby="@($"trace-category-{CategorySlug(group.Key)}")">
                                        <h3 id="@($"trace-category-{CategorySlug(group.Key)}")">@group.Key</h3>
                                        @foreach (var signal in group.OrderByDescending(SignalRecordedInRace).ThenBy(signal => signal.Name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            var recorded = SignalRecordedInRace(signal);
                                            <article class="toolbox-metric-card analysis-trace-metric-card @(!recorded ? "unavailable" : null)"
                                                     role="listitem"
                                                     tabindex="0"
                                                     data-analysis-drag-signal="@signal.Id"
                                                     data-signal-id="@signal.Id"
                                                     data-signal-name="@signal.Name"
                                                     aria-label="@($"{signal.Name}, {signal.Unit}. Drag onto a chart, or press Enter to pair or replace it in the selected chart.")"
                                                     @onkeydown="args => HandleTraceSignalKeyDown(signal.Id, args)"
                                                     title="@(recorded ? $"Drag {signal.Name} onto a chart" : $"{signal.Name} was not recorded in this race; the saved chart will activate when data is available")">
                                                <span class="metric-drag-handle" aria-hidden="true"><ProductIcon Name="grip" Size="15" /></span>
                                                <div><strong>@signal.Name</strong><small>@signal.Unit@(!recorded ? " · not recorded" : string.Empty)</small></div>
                                                <button type="button" class="metric-add-button" data-analysis-no-drag disabled="@(TraceRows.Count >= AnalysisTraceLayouts.MaximumRows)" aria-label="Add @signal.Name as a new chart" title="Add as a new chart" @onkeydown:stopPropagation="true" @onclick="() => AddTraceSignal(signal.Id)"><ProductIcon Name="plus" Size="16" /></button>
                                            </article>
                                        }
                                    </section>
                                }
                            </div>
                        </section>
                    </div>
                    <footer class="trace-toolbox-footer"><span>Drop between charts to add</span><span>Drop on a chart to pair</span><span><kbd>Alt</kbd> + arrow reorders</span></footer>
                </aside>
                <div class="trace-chart-frame" style="@TraceChartFrameStyle">
                @if (Selected.Count == 0)
                {
                    <div class="telemetry-empty-selection"><strong>No laps selected</strong><span>Select Fastest, Best three, or a lap to display telemetry.</span></div>
                }
                else
                {
                    <div class="trace-label-column" aria-label="Trace chart labels">
                        @foreach (var panel in TraceRows)
                        {
                            var helpId = $"trace-row-help-{panel.Preferences.Id}";
                            <div class="trace-row-label-shell"
                                 @key="panel.Preferences.Id"
                                 data-analysis-row-target="label"
                                 data-row-id="@panel.Preferences.Id"
                                 data-row-index="@TraceLayout.Rows.FindIndex(row => row.Id == panel.Preferences.Id)"
                                 data-row-name="@RowLabel(panel)"
                                 data-primary-name="@panel.Signals[0].Name"
                                 data-secondary-name="@(panel.Signals.Count > 1 ? panel.Signals[1].Name : string.Empty)">
                                <div class="trace-row-label-trigger"
                                     tabindex="0"
                                     role="group"
                                     data-analysis-drag-row="@panel.Preferences.Id"
                                     data-row-id="@panel.Preferences.Id"
                                     data-row-name="@RowLabel(panel)"
                                     aria-describedby="@helpId"
                                     aria-label="@($"{RowLabel(panel)} chart")"
                                     title=""
                                     @onfocus="() => ActivateTraceRow(panel.Preferences.Id)"
                                     @onkeydown="args => HandleTraceRowKeyDown(panel.Preferences.Id, args)">
                                    <ProductIcon Name="grip" Size="14" Class="trace-row-grip" />
                                    <span class="trace-row-label-copy"><strong>@RowLabel(panel)</strong><span class="trace-row-unit">@RowUnit(panel)</span></span>
                                    @if (TraceToolboxOpen)
                                    {
                                        <button type="button"
                                                class="trace-row-remove"
                                                data-analysis-no-drag
                                                disabled="@(TraceRows.Count <= 1)"
                                                title="Remove chart"
                                                aria-label="Remove @RowLabel(panel) chart"
                                                @onclick:stopPropagation="true"
                                                @onkeydown:stopPropagation="true"
                                                @onclick="() => RemoveTraceRow(panel.Preferences.Id)"><ProductIcon Name="close" Size="13" /></button>
                                    }
                                </div>
                                <span id="@helpId" class="trace-row-label-tooltip" role="tooltip">@RowHelp(panel)</span>
                            </div>
                        }
                    </div>
                <svg @ref="ChartElement" class="trace-chart configurable-trace-chart" data-analysis-trace-chart viewBox="@($"0 0 {F(_chartWidth)} {F(ChartHeight)}")" preserveAspectRatio="none" role="img" aria-label="Configurable synchronized telemetry traces">
                    @for (var row = 0; row < TraceRows.Count; row++)
                    {
                        var panel = TraceRows[row]; var top = ChartTop + row * ChartRowHeight;
                        <svg:g @key="panel.Preferences.Id" data-analysis-render-row data-row-id="@panel.Preferences.Id">
                        <rect data-analysis-chart-row data-analysis-row-target="chart" data-row-id="@panel.Preferences.Id" data-row-index="@row" data-row-name="@RowLabel(panel)" data-primary-name="@panel.Signals[0].Name" data-secondary-name="@(panel.Signals.Count > 1 ? panel.Signals[1].Name : string.Empty)" x="@PlotLeft" y="@top" width="@PlotWidth" height="@ChartPlotHeight" class="chart-row" />
                        <line data-analysis-horizontal-grid x1="@PlotLeft" y1="@(top + ChartPlotHeight / 2)" x2="@PlotRight" y2="@(top + ChartPlotHeight / 2)" class="chart-grid-line" />
                        @if (!panel.Signals.Any(HasSignalData))
                        {
                            <svg:text x="@(PlotLeft + 12)" y="@(top + ChartPlotHeight / 2 + 4)" class="chart-unavailable">Not recorded for this race</svg:text>
                        }
                        <svg:g data-analysis-trace-render-layer>
                        @foreach (var indexedSignal in panel.Signals.Where(HasSignalData).Select((signal, index) => new { Signal = signal, Index = index }))
                        {
                            @foreach (var traceGroup in ChartTracePaths(panel, indexedSignal.Signal, indexedSignal.Index, top))
                            {
                                <path data-analysis-trace-path data-row="@row" data-signal="@indexedSignal.Signal.Id" data-laps="@traceGroup.Laps" data-spotlight="@AriaBoolean(traceGroup.Spotlight)" d="@traceGroup.Path" fill="none" stroke="@traceGroup.Color" stroke-width="@traceGroup.StrokeWidth" stroke-dasharray="@(indexedSignal.Index == 0 ? null : "4 3")" opacity="@traceGroup.Opacity" vector-effect="non-scaling-stroke" />
                            }
                        }
                        </svg:g>
                        </svg:g>
                    }
                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var x = PlotLeft + tick * (PlotWidth / 4d);
                        <line data-analysis-vertical-grid="@tick" x1="@x" y1="@ChartTop" x2="@x" y2="@ChartBottom" class="chart-grid-vertical" />
                        <svg:text data-analysis-x-tick="@tick" x="@x" y="@(ChartHeight - 7)" text-anchor="middle" class="chart-label">@(tick * 25)%</svg:text>
                    }
                    <g data-analysis-cursor-layer class="analysis-cursor-layer" style="display:none" aria-hidden="true"></g>
                </svg>
                <div class="analysis-cursor-tooltips" data-analysis-cursor-tooltips aria-hidden="true"></div>
                }
                </div>
            </div>
        </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    [Parameter] public bool IsRaceWorkspace { get; set; }
    private readonly HashSet<int> Selected = [];
    private string? _analysisId;
    private AnalysisWorkspace? _workspaceReference;
    private string Mode { get; set; } = "traces";
    private bool CleanLapsOnly { get; set; }
    private bool GreenLapsOnly { get; set; }
    private bool LapRailCollapsed { get; set; }
    private bool TrackPanelCollapsed { get; set; }
    private int? SpotlightLap { get; set; }
    private bool SpotlightMenuOpen { get; set; }
    private bool TraceExpanded { get; set; }
    private bool TraceToolboxOpen { get; set; }
    private string _traceSignalSearch = string.Empty;
    private string? _selectedTraceRowId;
    private int? ActivePitLap { get; set; }
    private string? ActivePitDirection { get; set; }
    private int? ActiveConditionsLap { get; set; }
    private int? ActiveIncidentLap { get; set; }
    private double PitPopoverX { get; set; }
    private double PitPopoverY { get; set; }
    private double PitPopoverAvailableHeight { get; set; } = 680;
    private bool PitPopoverAbove { get; set; }
    private double ConditionsPopoverX { get; set; }
    private double ConditionsPopoverY { get; set; }
    private bool ConditionsPopoverAbove { get; set; }
    private double IncidentPopoverX { get; set; }
    private double IncidentPopoverY { get; set; }
    private bool IncidentPopoverAbove { get; set; }
    private bool IncidentPopoverLeft { get; set; }
    private CancellationTokenSource? _pitPopoverHideCancellation;
    private IReadOnlyList<MapPoint>? _mapPoints;
    private IReadOnlyList<AnalysisVectorPoint> _canonicalGeometryPoints = [];
    private IReadOnlyList<AnalysisTracePoint> _allRecordedGpsPoints = [];
    private VectorProjection? _vectorProjection;
    private GpsBounds? _gpsBounds;
    private MapBounds? _mapBounds;
    private string _trackViewBox = "0 0 420 280";
    private string _trackRibbonPath = string.Empty;
    private MapLine _startFinishLine = new(210, 127, 210, 153);
    private IReadOnlyList<PitMapLayer> _pitMapLayers = [];
    private IReadOnlyList<MapTracePath>? _mapTracePaths;
    private string _mapTracePathsSignature = string.Empty;
    private readonly Dictionary<int, IReadOnlyList<ProjectedTracePoint>> _projectedTracePoints = [];
    private IReadOnlyDictionary<int, string> _lapColorCache = new Dictionary<int, string>();
    private double _fastestLapTime = double.MaxValue;
    private readonly Dictionary<string, IReadOnlyList<MetricRibbonSegment>> _metricRibbonCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<StripSegment>> _stripSegmentCache = new(StringComparer.Ordinal);
    private double Cursor { get; set; } = .25;
    private ElementReference ChartElement;
    private ElementReference TrackElement;
    private ElementReference MapTypeElement;
    private ElementReference ContextColumnElement;
    private ElementReference ContextSplitterElement;
    private ElementReference TraceStudioElement;
    private ElementReference TraceToolboxButtonElement;
    private ElementReference TraceExpandButtonElement;
    private ElementReference SpotlightControlElement;
    private ElementReference SpotlightTriggerElement;
    private DotNetObjectReference<TelemetryWorkspace>? _traceLayoutDotNetReference;
    private bool _cursorInteropAttached;
    private bool _traceLayoutInteropAttached;
    private bool _trackMapInteropAttached;
    private bool _contextSplitterInteropAttached;
    private double _chartWidth = 1000;
    private string _cursorInteropSignature = string.Empty;
    private object? _cursorConfigurationCache;
    private string _cursorConfigurationCacheKey = string.Empty;
    private string _traceLayoutInteropSignature = string.Empty;
    private readonly Dictionary<AnalysisTracePoint, double?> _calculatedWearByPoint = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<AnalysisTracePoint, double?> _timeDeltaByPoint = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<int, double?> _traceStartTimeByLap = new();
    private readonly Dictionary<string, (double Min, double Max)> _traceRangeCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _tracePathCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<ChartTracePath>> _chartTraceGroupCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, (double Min, double Max)> _trackRangeCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _signalAvailabilityCache = new(StringComparer.Ordinal);
    private AnalysisLapTrace? _referenceTraceCache;
    private string _selectionSignature = string.Empty;
    private const double PlotLeft = 126;
    private const int ChartTop = 12;
    private const double TraceRowsHeight = 820;
    private const int TooltipRowHeight = 20;
    private const double TooltipCharacterWidth = 7.1;
    private const int CursorSampleBins = AnalysisRenderBudget.CursorSampleBins;
    private const int CursorComparisonBudget = AnalysisRenderBudget.CursorComparisonBudget;
    private static readonly (string Key, string Label)[] Modes = [("traces", "Traces"), ("speed", "Speed"), ("throttle", "Throttle"), ("brake", "Brake"), ("stress", "Tire load")];
    private static readonly HeatStop[] SpeedHeatmapStops =
    [
        new(0.00, 232, 66, 78),
        new(0.34, 248, 132, 64),
        new(0.58, 242, 203, 76),
        new(0.78, 116, 222, 108),
        new(1.00, 34, 220, 116)
    ];
    private static readonly string[] TracePalette =
    [
        "#63F5D2", "#FF62D5", "#FFD45B", "#69A7FF", "#A879FF",
        "#FF7B72", "#66F06A", "#54D6FF", "#FF9D4D", "#E78BFF",
        "#8EF0FF", "#F5F56B", "#4FE0A4", "#FF6A9A", "#7F8CFF",
        "#B8F25D", "#FFB56B", "#54ECE5", "#D58CFF", "#F07B67"
    ];

    protected override void OnParametersSet()
    {
        State.Settings.RaceAnalysisTraces ??= new AnalysisTraceLayout();
        State.Settings.RaceAnalysisTraceLayouts ??= new AnalysisTraceLayoutSet();
        _ = AnalysisTraceLayoutSets.ValidateAndRepair(State.Settings.RaceAnalysisTraceLayouts, State.Settings.RaceAnalysisTraces);
        if (_analysisId == Workspace.AnalysisId && ReferenceEquals(_workspaceReference, Workspace)) return;
        KeepPitPopoverOpen();
        ActivePitLap = null;
        ActivePitDirection = null;
        ActiveIncidentLap = null;
        _analysisId = Workspace.AnalysisId;
        _workspaceReference = Workspace;
        Mode = "traces";
        SpotlightLap = null;
        SpotlightMenuOpen = false;
        LapRailCollapsed = false;
        TrackPanelCollapsed = false;
        ResetSelection();
        RebuildMapRenderCache();
        RebuildCalculatedTireWear();
        _selectedTraceRowId = TraceLayout.Rows.FirstOrDefault()?.Id;
        InvalidateTraceRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Layout editing is independent of lap selection. Keep drag/drop and
        // keyboard reordering available after Clear leaves the chart empty.
        await ConfigureTraceLayoutInteropAsync();
        await ConfigureTrackMapInteropAsync();
        await ConfigureContextSplitterInteropAsync();
        if (Selected.Count == 0) return;
        if (!_cursorInteropAttached && await MeasureChart()) return;
        var signature = CursorInteropSignature;
        if (!_cursorInteropAttached || !string.Equals(signature, _cursorInteropSignature, StringComparison.Ordinal))
        {
            await JS.InvokeVoidAsync("iracingCoachAnalysisCursor.initialize", ChartElement, TrackElement, BuildCursorInteropConfiguration());
            _cursorInteropAttached = true;
            _cursorInteropSignature = signature;
        }
        else
        {
            await JS.InvokeVoidAsync("iracingCoachAnalysisCursor.sync", ChartElement, TrackElement);
        }
    }

    private async Task ConfigureTrackMapInteropAsync()
    {
        if (!HasMapGeometry) return;
        try
        {
            await JS.InvokeVoidAsync("iracingCoachAnalysisTrackMap.initialize", TrackElement, Workspace.AnalysisId, TrackViewBox);
            _trackMapInteropAttached = true;
        }
        catch (JSDisconnectedException)
        {
            _trackMapInteropAttached = false;
        }
        catch (InvalidOperationException)
        {
            // Static prerender has no browser yet; the next interactive render retries.
            _trackMapInteropAttached = false;
        }
    }

    private async Task ChangeMapMode(ChangeEventArgs args)
    {
        var requested = args.Value?.ToString();
        Mode = Modes.Any(option => string.Equals(option.Key, requested, StringComparison.Ordinal)) ? requested! : "traces";
        try { await JS.InvokeVoidAsync("iracingCoachAnalysisTrackMap.blur", MapTypeElement); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task FitTrackMap()
    {
        if (!HasMapGeometry) return;
        try { await JS.InvokeVoidAsync("iracingCoachAnalysisTrackMap.fit", TrackElement); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task ConfigureContextSplitterInteropAsync()
    {
        if (!IsRaceWorkspace) return;
        try
        {
            await JS.InvokeVoidAsync("iracingCoachAnalysisContextSplitter.initialize", ContextColumnElement, ContextSplitterElement);
            _contextSplitterInteropAttached = true;
        }
        catch (JSDisconnectedException)
        {
            _contextSplitterInteropAttached = false;
        }
        catch (InvalidOperationException)
        {
            // Static prerender has no browser yet; the next interactive render retries.
            _contextSplitterInteropAttached = false;
        }
    }

    private async Task ToggleTraceExpanded(bool restoreKeyboardFocus)
    {
        TraceExpanded = !TraceExpanded;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (TraceExpanded) await TraceStudioElement.FocusAsync();
        else if (restoreKeyboardFocus) await TraceExpandButtonElement.FocusAsync();
    }
    private string ContextColumnState => IsRaceWorkspace
        ? (!TrackPanelCollapsed, !LapRailCollapsed) switch
        {
            (true, true) => "context-both",
            (true, false) => "context-track",
            (false, true) => "context-laps",
            _ => "context-none"
        }
        : $"{(LapRailCollapsed ? "laps-collapsed" : "laps-open")} {(TrackPanelCollapsed ? "track-collapsed" : "track-open")}";
    private void ToggleLapRail()
    {
        LapRailCollapsed = !LapRailCollapsed;
        CloseSpotlightMenu();
    }
    private void ToggleTrackPanel()
    {
        TrackPanelCollapsed = !TrackPanelCollapsed;
        CloseSpotlightMenu();
    }
    private void ToggleTraceToolbox()
    {
        TraceToolboxOpen = !TraceToolboxOpen;
        if (TraceToolboxOpen && SelectedTraceRow is null) _selectedTraceRowId = TraceLayout.Rows.FirstOrDefault()?.Id;
    }

    private async Task CloseTraceToolbox(bool restoreKeyboardFocus)
    {
        if (!TraceToolboxOpen) return;
        TraceToolboxOpen = false;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (restoreKeyboardFocus) await TraceToolboxButtonElement.FocusAsync();
    }

    private async Task HandleWorkspaceKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (SpotlightMenuOpen)
        {
            SpotlightMenuOpen = false;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            await SpotlightTriggerElement.FocusAsync();
        }
        else if (TraceToolboxOpen) await CloseTraceToolbox(true);
        else if (TraceExpanded) await ToggleTraceExpanded(true);
    }

    private void RebuildCalculatedTireWear()
    {
        _calculatedWearByPoint.Clear();
        var calculated = CalculatedTireWear.Build(Workspace.Traces, Workspace.Runs);
        foreach (var trace in Workspace.Traces)
        {
            if (!calculated.TryGetValue(trace.Lap, out var values)) continue;
            for (var index = 0; index < Math.Min(trace.Points.Count, values.Count); index++)
                _calculatedWearByPoint[trace.Points[index]] = values[index];
        }
    }

