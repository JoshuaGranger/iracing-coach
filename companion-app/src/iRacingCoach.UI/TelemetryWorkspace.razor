    private string FuelRangeAtStop(AnalysisRun run)
    {
        if (run.PitStop?.EstimatedFuelLapsRemaining is not { } range) return "Not available";
        if (Workspace.ScheduledLaps <= 0 || run.Laps.Count == 0) return $"{range:0.0} laps estimated";
        var lapsToFinish = Math.Max(0, Workspace.ScheduledLaps - run.Laps.Max());
        var margin = range - lapsToFinish;
        return margin >= 0 ? $"{range:0.0} laps · enough (+{margin:0.0})" : $"{range:0.0} laps · {-margin:0.0} short";
    }
    private string RaceLapsRemaining(int lap)
    {
        if (Workspace.ScheduledLaps <= 0) return "Not recorded";
        var remaining = Math.Max(0, Workspace.ScheduledLaps - lap);
        return $"{remaining} lap{(remaining == 1 ? string.Empty : "s")}";
    }
    private int IncidentPoints(int lap) => Workspace.Damage.Incidents?.Where(item => item.Lap == lap).Sum(item => item.Points) ?? 0;
    private static string IncidentSeverity(int points) => points >= 4 ? "high" : points >= 2 ? "medium" : "low";
    private IReadOnlyList<double> SectorStarts => Workspace.SectorStartPercents?.Where(value => value >= 0 && value < 1).Distinct().Order().ToArray() ?? [];
    private SectorStatus SectorState(AnalysisLapTrace trace, int sector)
    {
        var duration = SectorDuration(trace, sector);
        var title = duration.HasValue ? $"S{sector + 1} · {duration.Value:0.000} s" : $"S{sector + 1} · —";
        if (!duration.HasValue) return new SectorStatus("unavailable", title);
        if (!IsClean(trace)) return new SectorStatus("neutral", title);
        var comparable = Workspace.Traces.Where(IsClean)
            .Select(item => new { Trace = item, Duration = SectorDuration(item, sector) })
            .Where(item => item.Duration.HasValue)
            .ToArray();
        var sessionBest = comparable.Select(item => item.Duration!.Value).DefaultIfEmpty(double.MaxValue).Min();
        if (Math.Abs(duration.Value - sessionBest) < .0005)
            return new SectorStatus("session-fastest", title);
        var priorBest = comparable.Where(item => item.Trace.Lap < trace.Lap).Select(item => item.Duration!.Value).DefaultIfEmpty(double.MaxValue).Min();
        if (duration.Value < priorBest)
            return new SectorStatus("new-best", title);
        return new SectorStatus("neutral", title);
    }
    private double? SectorDuration(AnalysisLapTrace trace, int sector)
    {
        if (trace.Points.Count < 2) return null;
        if (sector < 0 || sector >= SectorStarts.Count) return null;
        var startPercent = SectorStarts[sector];
        var endPercent = sector + 1 < SectorStarts.Count ? SectorStarts[sector + 1] : 1d;
        var start = TimeAtPercent(trace.Points, startPercent);
        var end = TimeAtPercent(trace.Points, endPercent);
        return start.HasValue && end.HasValue && end.Value >= start.Value ? end.Value - start.Value : null;
    }
    private static double? TimeAtPercent(IReadOnlyList<AnalysisTracePoint> points, double target)
    {
        var usable = points.Where(point => point.SessionTimeSeconds.HasValue).OrderBy(point => point.LapPercent).ToArray();
        if (usable.Length == 0) return null;
        if (target <= usable[0].LapPercent) return usable[0].SessionTimeSeconds;
        if (target >= usable[^1].LapPercent) return usable[^1].SessionTimeSeconds;
        for (var index = 1; index < usable.Length; index++)
        {
            if (usable[index].LapPercent < target) continue;
            var before = usable[index - 1];
            var after = usable[index];
            var span = after.LapPercent - before.LapPercent;
            if (span <= .000001) return after.SessionTimeSeconds;
            var fraction = (target - before.LapPercent) / span;
            return before.SessionTimeSeconds!.Value + (after.SessionTimeSeconds!.Value - before.SessionTimeSeconds.Value) * fraction;
        }
        return null;
    }
    private static string FriendlyZone(TrackSegment zone) => string.IsNullOrWhiteSpace(zone.Label) || zone.Label.StartsWith("Load zone", StringComparison.OrdinalIgnoreCase) ? $"C{zone.Number}" : zone.Label;
    private string LapColor(int lap)
    {
        var trace = Workspace.Traces.FirstOrDefault(item => item.Lap == lap);
        if (trace?.LapTimeSeconds is { } lapTime && Math.Abs(lapTime - FastestLapTime) < .0001)
            return "#F05CDB";
        var laps = Workspace.Traces.Select(trace => trace.Lap).Distinct().OrderBy(value => value).ToArray();
        var index = Array.IndexOf(laps, lap);
        var fraction = laps.Length <= 1 ? 0 : Math.Max(0, index) / (double)(laps.Length - 1);
        var hue = 280 * fraction;
        return $"hsl({hue.ToString("0.##", CultureInfo.InvariantCulture)} 82% 62%)";
    }
    private static string LapTime(double? seconds) => seconds is null ? "—" : TimeSpan.FromSeconds(seconds.Value).ToString(@"m\:ss\.fff");
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
