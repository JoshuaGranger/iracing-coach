    private async Task ConfigureTraceLayoutInteropAsync()
    {
        var signature = $"{TraceToolboxOpen}|{TraceExpanded}|{State.Settings.UseReducedMotion}|{string.Join(',', TraceLayout.Rows.Select(row => $"{row.Id}:{row.PrimarySignalId}:{row.SecondarySignalId}"))}";
        if (!_traceLayoutInteropAttached)
        {
            _traceLayoutDotNetReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("iracingCoachAnalysisTraceLayout.initialize", TraceStudioElement, _traceLayoutDotNetReference, TraceLayoutInteractionOptions());
            _traceLayoutInteropAttached = true;
            _traceLayoutInteropSignature = signature;
            return;
        }
        if (string.Equals(signature, _traceLayoutInteropSignature, StringComparison.Ordinal)) return;
        await JS.InvokeVoidAsync("iracingCoachAnalysisTraceLayout.configure", TraceStudioElement, TraceLayoutInteractionOptions());
        _traceLayoutInteropSignature = signature;
    }
    private object TraceLayoutInteractionOptions() => new
    {
        editing = TraceToolboxOpen,
        reducedMotion = State.Settings.UseReducedMotion,
        rowCount = TraceLayout.Rows.Count,
        maximumRows = AnalysisTraceLayouts.MaximumRows
