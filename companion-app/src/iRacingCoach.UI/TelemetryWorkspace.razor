    private void HandleTraceRowKeyDown(string rowId, KeyboardEventArgs args)
    {
        if (!TraceToolboxOpen) return;
        if (args.Key == "Delete") { RemoveTraceRow(rowId); return; }
        if (!args.AltKey || args.Key is not ("ArrowUp" or "ArrowDown")) return;
        var layout = EditableTraceLayout;
        var index = layout.Rows.FindIndex(row => string.Equals(row.Id, rowId, StringComparison.Ordinal));
        var target = index + (args.Key == "ArrowUp" ? -1 : 1);
        if (AnalysisTraceLayouts.MoveRowToIndex(layout, rowId, target))
        {
            _selectedTraceRowId = rowId;
            SaveTraceLayout();
        }
    }
    private void HandleTraceSignalKeyDown(string signalId, KeyboardEventArgs args)
    {
        if (args.Key is not ("Enter" or " " or "Spacebar") || SelectedTraceRow is not { } selectedRow) return;
        if (!AnalysisTraceLayouts.PlaceSignal(EditableTraceLayout, selectedRow.Id, signalId)) return;
        _selectedTraceRowId = selectedRow.Id;
        SaveTraceLayout();
    }
