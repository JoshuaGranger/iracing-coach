    }
    private bool IsActiveDropTarget(string rowId, TraceDropSlot slot) =>
        _draggedTraceSignalId is not null &&
        string.Equals(_activeTraceDropRowId, rowId, StringComparison.Ordinal) &&
        _activeTraceDropSlot == slot;
    private bool CanUseAsSecondSignal(AnalysisTraceRow row) =>
        _draggedTraceSignalId is not null &&
        !string.Equals(row.PrimarySignalId, _draggedTraceSignalId, StringComparison.Ordinal);
    private string TraceDropTargetClass(AnalysisTraceRow row, TraceDropSlot slot)
    {
        var classes = new List<string> { "trace-signal-drop-target", slot == TraceDropSlot.Primary ? "primary" : "secondary" };
        if (_draggedTraceSignalId is null) return string.Join(' ', classes);
        var available = slot == TraceDropSlot.Primary || CanUseAsSecondSignal(row);
        classes.Add(available ? "drop-available" : "drop-duplicate");
        if (IsActiveDropTarget(row.Id, slot)) classes.Add("drop-active");
        return string.Join(' ', classes);
    }
    private void DropTraceSignal(string rowId, TraceDropSlot slot)
    {
        if (_draggedTraceSignalId is not { } signalId || AnalysisTraceLayouts.Signal(signalId) is not { } signal ||
            TraceLayout.Rows.FirstOrDefault(row => string.Equals(row.Id, rowId, StringComparison.Ordinal)) is not { } row)
        {
            EndTraceSignalDrag();
            return;
        }
        if (slot == TraceDropSlot.Secondary && !CanUseAsSecondSignal(row))
        {
            _traceDropRejected = true;
            _traceDropFeedback = $"{signal.Name} is already the primary signal. Choose a different second signal.";
            EndTraceSignalDrag();
            return;
        }

        var changed = false;
        if (slot == TraceDropSlot.Primary)
        {
            var priorSecondary = row.SecondarySignalId;
            changed = AnalysisTraceLayouts.SetPrimary(TraceLayout, rowId, signalId);
            var removedSecondary = !string.IsNullOrWhiteSpace(priorSecondary) && string.IsNullOrWhiteSpace(row.SecondarySignalId);
            _traceDropFeedback = removedSecondary
                ? $"{signal.Name} is now primary. The duplicate second signal was removed."
                : $"{signal.Name} is now the primary signal for this row.";
        }
        else
        {
            changed = AnalysisTraceLayouts.SetSecondary(TraceLayout, rowId, signalId);
            _traceDropFeedback = $"{signal.Name} was added as the second signal for this row.";
        }
        _traceDropRejected = !changed;
        if (!changed) _traceDropFeedback = $"{signal.Name} could not be added to this row.";
        EndTraceSignalDrag();
        if (changed) SaveTraceLayout();
    }
