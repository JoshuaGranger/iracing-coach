    private object BuildCursorInteropConfiguration()
    {
        var cacheKey = CursorInteropSignature;
        if (_cursorConfigurationCache is not null && string.Equals(cacheKey, _cursorConfigurationCacheKey, StringComparison.Ordinal))
            return _cursorConfigurationCache;
        var panels = TraceRows;
        var availableSignals = panels
            .Select(panel => panel.Signals.Where(HasSignalData).ToArray())
            .ToArray();
        var allTraces = CursorSelectedTraces.ToArray();
        var traces = BoundedCursorTraces(allTraces);
        var percents = Enumerable.Range(0, CursorSampleBins)
            .Select(index => index / (double)(CursorSampleBins - 1))
            .ToArray();
        var rows = panels.Select((panel, index) => new
        {
            top = ChartTop + index * ChartRowHeight,
            plotHeight = ChartPlotHeight,
            signals = availableSignals[index].Select(signal =>
            {
                var range = SignalRange(signal);
                return new
                {
                    id = signal.Id,
                    shortLabel = signal.ShortLabel,
                    unit = signal.Unit,
                    minimum = InteropNumber(range.Min) ?? -.5,
                    maximum = InteropNumber(range.Max) ?? .5
                };
            }).ToArray()
        }).ToArray();
        var traceData = traces.Select(trace =>
        {
            var pointIndices = trace.Points.Count == 0
                ? Enumerable.Repeat(-1, percents.Length).ToArray()
                : percents.Select(percent => NearestIndex(trace.Points, percent)).ToArray();
            var points = pointIndices
                .Select(index => index >= 0 ? trace.Points[index] : null)
                .ToArray();
            return new
            {
                lap = trace.Lap,
                color = LapColor(trace.Lap),
                percents,
                rowValues = availableSignals.Select(signals => signals.Select(signal =>
                    pointIndices.Select(index => InteropNumber(index < 0 ? null : SmoothedValue(signal, trace, index))).ToArray()).ToArray()).ToArray(),
                summary = new
                {
                    speed = points.Select(point => InteropNumber(point?.SpeedMph)).ToArray(),
                    throttle = points.Select(point => InteropNumber(point?.Throttle)).ToArray(),
                    brake = points.Select(point => InteropNumber(point?.Brake)).ToArray(),
                    delta = points.Select(point => InteropNumber(point is null ? null : TimeDelta(trace, point))).ToArray()
                }
            };
        }).ToArray();
        var aggregatePoints = percents.Select(percent => allTraces
            .Select(trace => new { Trace = trace, Point = Nearest(trace, percent) })
            .Where(sample => sample.Point is not null)
            .ToArray()).ToArray();
        var result = new
        {
            key = cacheKey,
            initialFraction = Cursor,
            elementWidth = _chartWidth,
            chartHeight = ChartHeight,
            plotLeft = PlotLeft,
            plotWidth = PlotWidth,
            chartTop = ChartTop,
            chartBottom = ChartBottom,
            tooltipCapacity = TooltipCapacity,
            tooltipRowHeight = TooltipRowHeight,
            tooltipCharacterWidth = TooltipCharacterWidth,
            rows,
            traces = traceData,
            logicalTraceCount = allTraces.Length,
            logicalLaps = allTraces.Select(trace => trace.Lap).ToArray(),
            aggregate = new
            {
                percents,
                summary = new
                {
                    speed = aggregatePoints.Select(samples => InteropNumber(Average(samples.Select(sample => sample.Point!.SpeedMph)))).ToArray(),
                    throttle = aggregatePoints.Select(samples => InteropNumber(Average(samples.Select(sample => sample.Point!.Throttle)))).ToArray(),
                    brake = aggregatePoints.Select(samples => InteropNumber(Average(samples.Select(sample => sample.Point!.Brake)))).ToArray(),
                    delta = aggregatePoints.Select(samples => InteropNumber(Average(samples.Select(sample => TimeDelta(sample.Trace, sample.Point!))))).ToArray()
                }
            },
            trackPoints = HasMapGeometry
                ? MapPoints.Select(point => new { percent = point.Percent, x = point.X, y = point.Y }).ToArray()
                : [],
            distanceStrip = !HasMapGeometry
        };
        _cursorConfigurationCacheKey = cacheKey;
        return _cursorConfigurationCache = result;
    }
    private IReadOnlyList<AnalysisLapTrace> BoundedCursorTraces(IReadOnlyList<AnalysisLapTrace> traces)
    {
        if (traces.Count <= CursorComparisonBudget) return traces;
        var chosen = new Dictionary<int, AnalysisLapTrace>();
        void Add(AnalysisLapTrace? trace)
        {
            if (trace is not null) chosen.TryAdd(trace.Lap, trace);
        }
        Add(SpotlightLap.HasValue ? traces.FirstOrDefault(trace => trace.Lap == SpotlightLap.Value) : null);
        Add(traces.FirstOrDefault(trace => trace.Lap == ReferenceTrace.Lap));
        Add(traces[0]);
        Add(traces[^1]);
        foreach (var index in AnalysisRenderBudget.RepresentativeIndices(traces.Count, CursorComparisonBudget))
            Add(traces[index]);
        return chosen.Values
            .OrderBy(trace => SpotlightLap == trace.Lap ? 0 : 1)
            .ThenBy(trace => trace.Lap)
            .Take(CursorComparisonBudget)
            .ToArray();
    }
    private static double? InteropNumber(double? value) => value is { } number && double.IsFinite(number) ? number : null;
    private void RebuildMapRenderCache()
    {
        _canonicalGeometryPoints = CompleteVectorGeometry is { } vector
            ? vector.MainPath.ToArray()
            : [];
        // The verified closed main loop owns projection and Fit bounds. Pit
        // geometry is an overlay from the same provenance and must never make
        // a short entry/exit path become the apparent track.
        _vectorProjection = CreateVectorProjection(_canonicalGeometryPoints);
        _allRecordedGpsPoints = Workspace.Traces
            .SelectMany(trace => trace.Points)
            .Where(HasUsableRecordedGps)
            .ToArray();
        _gpsBounds = CreateGpsBounds(_allRecordedGpsPoints);
        _fastestLapTime = Workspace.Traces
            .Where(trace => IsClean(trace) && trace.LapTimeSeconds.HasValue)
            .Select(trace => trace.LapTimeSeconds!.Value)
            .DefaultIfEmpty(double.MaxValue)
            .Min();
        var laps = Workspace.Traces.Select(trace => trace.Lap).Distinct().OrderBy(value => value).ToArray();
        _lapColorCache = laps.Select((lap, index) =>
        {
            var trace = Workspace.Traces.FirstOrDefault(item => item.Lap == lap);
            if (trace?.LapTimeSeconds is { } lapTime && Math.Abs(lapTime - _fastestLapTime) < .0001)
                return new KeyValuePair<int, string>(lap, "#F05CDB");
            return new KeyValuePair<int, string>(lap, TracePalette[index % TracePalette.Length]);
        }).ToDictionary(pair => pair.Key, pair => pair.Value);

        _mapPoints = BuildMapPoints();
        _mapBounds = CreateMapBounds(_mapPoints);
        _projectedTracePoints.Clear();
        foreach (var trace in Workspace.Traces)
        {
            _projectedTracePoints[trace.Lap] = trace.Points
                .Where(HasUsableRecordedGps)
                .Select(point => new ProjectedTracePoint(WrapPercent(point.LapPercent), ProjectGpsPoint(point), point))
                .OrderBy(point => point.Percent)
                .ToArray();
        }
        _trackRibbonPath = SvgPath(_mapPoints, HasMapGeometry);
        _trackViewBox = BuildTrackViewBox();
        _startFinishLine = BuildStartFinishLine();
        _pitMapLayers = BuildPitMapLayers();
        _mapTracePaths = null;
        _mapTracePathsSignature = string.Empty;
        _metricRibbonCache.Clear();
        _stripSegmentCache.Clear();
    }

    private IReadOnlyList<MapPoint> BuildMapPoints()
    {
        if (CompleteVectorGeometry is { } vector)
            return vector.MainPath
                .Select((point, index) => ProjectVectorPoint(point with { LapPercent = point.LapPercent ?? index / (double)vector.MainPath.Count }))
                .ToArray();
        if (!HasCompleteTrackShape) return [];
        var minX = Workspace.TrackShape.Min(point => point.X); var maxX = Workspace.TrackShape.Max(point => point.X);
        var minY = Workspace.TrackShape.Min(point => point.Y); var maxY = Workspace.TrackShape.Max(point => point.Y);
        var scale = Math.Min(350 / Math.Max(.0001, maxX - minX), 218 / Math.Max(.0001, maxY - minY));
        return Workspace.TrackShape.OrderBy(point => point.LapPercent)
            .Select(point => new MapPoint(WrapPercent(point.LapPercent), 210 + (point.X - (minX + maxX) / 2) * scale, 140 - (point.Y - (minY + maxY) / 2) * scale))
            .ToArray();
    }

    private IReadOnlyList<MapPoint> MapPoints => _mapPoints ?? [];
    private AnalysisTrackGeometry? CompleteVectorGeometry => Workspace.VectorGeometry is
    {
        MainPath.Count: >= 3,
        Quality.MainLoopComplete: true
    } vector
        && !vector.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase)
        && AnalysisTrackMapGeometry.IsCanonicalMainLoop(vector.MainPath)
            ? vector
            : null;
    private bool HasCompleteTrackShape => IsCompleteTrackShape(Workspace.TrackShape);
    private bool HasMapGeometry => CompleteVectorGeometry is not null || HasCompleteTrackShape;
    private string TrackViewBox => _trackViewBox;
    private string BuildTrackViewBox()
    {
        if (!HasMapGeometry) return "0 0 420 280";
        var points = MapPoints;
        if (points.Count == 0) return "0 0 420 280";
        const double padding = 18;
        var minX = points.Min(point => point.X) - padding;
        var minY = points.Min(point => point.Y) - padding;
        var width = points.Max(point => point.X) - points.Min(point => point.X) + padding * 2;
        var height = points.Max(point => point.Y) - points.Min(point => point.Y) + padding * 2;
        return $"{F(minX)} {F(minY)} {F(width)} {F(height)}";
    }
    private MapPoint CursorMapPoint => MapPointAt(Cursor);
    private MapLine StartFinishLine => _startFinishLine;
    private MapLine BuildStartFinishLine()
    {
        if (CompleteVectorGeometry is { } vector
            && vector.StartFinishLine is { } recorded
            && AnalysisTrackMapGeometry.IsPlausibleOverlayLine(vector.MainPath, recorded))
        {
            var first = ProjectVectorPoint(recorded.A);
            var second = ProjectVectorPoint(recorded.B);
            return new MapLine(first.X, first.Y, second.X, second.Y);
        }
        var points = MapPoints;
        var center = MapPointAt(0, points);
        var before = MapPointAt(.995, points);
        var after = MapPointAt(.005, points);
        var tangentX = after.X - before.X;
        var tangentY = after.Y - before.Y;
        var length = Math.Sqrt(tangentX * tangentX + tangentY * tangentY);
        if (length < .0001) return new MapLine(center.X, center.Y - 13, center.X, center.Y + 13);
        const double halfLength = 13;
        var normalX = -tangentY / length * halfLength;
        var normalY = tangentX / length * halfLength;
        return new MapLine(center.X - normalX, center.Y - normalY, center.X + normalX, center.Y + normalY);
    }
    private string TrackRibbonPath => _trackRibbonPath;
    private IReadOnlyList<MapTracePath> MapTracePaths
    {
        get
        {
            if (_mapTracePaths is not null && string.Equals(_mapTracePathsSignature, SelectionSignature, StringComparison.Ordinal)) return _mapTracePaths;
            _mapTracePathsSignature = SelectionSignature;
            var selected = RenderedSelectedTraces.ToArray();
            if (_allRecordedGpsPoints.Count < 3) return _mapTracePaths = [];
            return _mapTracePaths = selected
                .Select(trace => new { Trace = trace, Points = _projectedTracePoints.GetValueOrDefault(trace.Lap) ?? [] })
                .Where(item => item.Points.Count >= 3)
                .GroupBy(item => LapColor(item.Trace.Lap))
                .Select(group => new MapTracePath(
                    string.Join(',', group.Select(item => item.Trace.Lap)),
                    group.Key,
                    string.Join(' ', group.Select(item =>
                    {
                        var budget = AnalysisRenderBudget.PointBudgetPerTrace(selected.Length, 420);
                        var points = AnalysisRenderBudget.RepresentativeIndices(item.Points.Count, budget)
                            .Select(index => item.Points[index].Point)
                            .ToArray();
                        return SvgPath(points, item.Trace.Complete);
                    }))))
                .ToArray();
        }
    }
    private IReadOnlyList<PitMapLayer> PitMapLayers => _pitMapLayers;
    private IReadOnlyList<PitMapLayer> BuildPitMapLayers()
    {
        if (CompleteVectorGeometry is not { } vector) return [];
        var pitRoad = AnalysisTrackMapGeometry.IsPlausibleOverlayPath(vector.MainPath, vector.PitLane)
            ? VectorPath(vector.PitLane)
            : string.Empty;
        var entry = AnalysisTrackMapGeometry.IsPlausibleOverlayPath(vector.MainPath, vector.PitEntryPath)
            ? VectorPath(vector.PitEntryPath)
            : string.Empty;
        var exit = AnalysisTrackMapGeometry.IsPlausibleOverlayPath(vector.MainPath, vector.PitExitPath)
            ? VectorPath(vector.PitExitPath)
            : string.Empty;
        var commitment = AnalysisTrackMapGeometry.IsPlausibleOverlayLine(vector.MainPath, vector.PitCommitmentLine)
            ? ProjectVectorLine(vector.PitCommitmentLine!)
            : null;
        var merge = AnalysisTrackMapGeometry.IsPlausibleOverlayLine(vector.MainPath, vector.PitMergeLine)
            ? ProjectVectorLine(vector.PitMergeLine!)
            : null;
        if (pitRoad.Length == 0 && entry.Length == 0 && exit.Length == 0 && commitment is null && merge is null) return [];
        return [new PitMapLayer(pitRoad, entry, exit, commitment, merge)];
    }
    private string VectorPath(IReadOnlyList<AnalysisVectorPoint> points) => points.Count < 2 ? string.Empty : SvgPath(points.Select(ProjectVectorPoint).ToArray(), false);
    private MapLine ProjectVectorLine(AnalysisVectorLine line)
    {
        var first = ProjectVectorPoint(line.A); var second = ProjectVectorPoint(line.B);
        return new MapLine(first.X, first.Y, second.X, second.Y);
    }
    private MapPoint ProjectVectorPoint(AnalysisVectorPoint point)
    {
        if (_vectorProjection is not { } projection) return new MapPoint(WrapPercent(point.LapPercent ?? 0), point.X, point.Y);
        return new MapPoint(WrapPercent(point.LapPercent ?? 0), 210 + (point.X - projection.CenterX) * projection.Scale, 140 + (point.Y - projection.CenterY) * projection.Scale);
    }
    private bool HasUsableRecordedGps(AnalysisTracePoint point)
    {
        if (point.Latitude is not { } latitude || !double.IsFinite(latitude)
            || point.Longitude is not { } longitude || !double.IsFinite(longitude)
            || (Math.Abs(latitude) <= 1e-9 && Math.Abs(longitude) <= 1e-9))
            return false;
        if (CompleteVectorGeometry is not { } vector) return true;
        var transform = vector.Transform ?? vector.GeometryProvenance?.NormalizationTransform;
        return transform?.TryNormalize(longitude, latitude, out var normalizedX, out var normalizedY) != true
            || AnalysisTrackMapGeometry.IsPlausibleNormalizedPoint(vector.MainPath, normalizedX, normalizedY);
    }
    private MapPoint ProjectGpsPoint(AnalysisTracePoint point)
    {
        if (_gpsBounds is not { } gps) return MapPointAt(point.LapPercent);
        if (_vectorProjection is not null)
        {
            var transform = CompleteVectorGeometry?.Transform ?? CompleteVectorGeometry?.GeometryProvenance?.NormalizationTransform;
            if (transform?.TryNormalize(point.Longitude!.Value, point.Latitude!.Value, out var normalizedX, out var normalizedY) == true)
                return ProjectVectorPoint(new AnalysisVectorPoint(normalizedX, normalizedY, point.LapPercent));

            // Legacy geometry did not retain the raw-coordinate transform. Keep
            // those archives usable, but never replace a valid canonical transform
            // with bounds inferred from only the currently loaded trace subset.
            var normalizationScale = Math.Max(gps.MaximumLongitude - gps.MinimumLongitude, gps.MaximumLatitude - gps.MinimumLatitude);
            var fallbackNormalizedX = (point.Longitude!.Value - gps.MinimumLongitude) / Math.Max(.000000001, normalizationScale);
            var fallbackNormalizedY = (gps.MaximumLatitude - point.Latitude!.Value) / Math.Max(.000000001, normalizationScale);
            return ProjectVectorPoint(new AnalysisVectorPoint(fallbackNormalizedX, fallbackNormalizedY, point.LapPercent));
        }
        if (_mapBounds is not { } map) return MapPointAt(point.LapPercent);
        var longitudeFraction = (point.Longitude!.Value - gps.MinimumLongitude) / Math.Max(.000000001, gps.MaximumLongitude - gps.MinimumLongitude);
        var latitudeFraction = (point.Latitude!.Value - gps.MinimumLatitude) / Math.Max(.000000001, gps.MaximumLatitude - gps.MinimumLatitude);
        return new MapPoint(WrapPercent(point.LapPercent), map.MinimumX + longitudeFraction * (map.MaximumX - map.MinimumX), map.MaximumY - latitudeFraction * (map.MaximumY - map.MinimumY));
    }
    private static VectorProjection? CreateVectorProjection(IReadOnlyList<AnalysisVectorPoint> points)
    {
        if (points.Count == 0) return null;
        var minimumX = points.Min(point => point.X); var maximumX = points.Max(point => point.X);
        var minimumY = points.Min(point => point.Y); var maximumY = points.Max(point => point.Y);
        var scale = Math.Min(350 / Math.Max(.0001, maximumX - minimumX), 218 / Math.Max(.0001, maximumY - minimumY));
        return new VectorProjection((minimumX + maximumX) / 2, (minimumY + maximumY) / 2, scale);
    }
    private static GpsBounds? CreateGpsBounds(IReadOnlyList<AnalysisTracePoint> points) => points.Count == 0 ? null : new GpsBounds(
        points.Min(point => point.Longitude!.Value), points.Max(point => point.Longitude!.Value),
        points.Min(point => point.Latitude!.Value), points.Max(point => point.Latitude!.Value));
    private static MapBounds? CreateMapBounds(IReadOnlyList<MapPoint> points) => points.Count == 0 ? null : new MapBounds(
        points.Min(point => point.X), points.Max(point => point.X), points.Min(point => point.Y), points.Max(point => point.Y));
    private static bool IsCompleteTrackShape(IReadOnlyList<TrackShapePoint> points)
    {
        if (points.Count < 3) return false;
        var ordered = points
            .Where(point => double.IsFinite(point.LapPercent) && double.IsFinite(point.X) && double.IsFinite(point.Y))
            .OrderBy(point => WrapPercent(point.LapPercent))
            .ToArray();
        if (ordered.Length < 3) return false;
        var maximumGap = WrapPercent(ordered[0].LapPercent) + 1 - WrapPercent(ordered[^1].LapPercent);
        for (var index = 1; index < ordered.Length; index++)
            maximumGap = Math.Max(maximumGap, WrapPercent(ordered[index].LapPercent) - WrapPercent(ordered[index - 1].LapPercent));
        var width = ordered.Max(point => point.X) - ordered.Min(point => point.X);
        var height = ordered.Max(point => point.Y) - ordered.Min(point => point.Y);
        var span = Math.Max(width, height);
        var closure = Math.Sqrt(Math.Pow(ordered[0].X - ordered[^1].X, 2) + Math.Pow(ordered[0].Y - ordered[^1].Y, 2));
        return maximumGap <= .05 && span > 0 && closure <= span * .15;
    }
    private static string SvgPath(IReadOnlyList<MapPoint> points, bool close)
    {
        if (points.Count == 0) return string.Empty;
        var path = $"M {F(points[0].X)} {F(points[0].Y)}";
        for (var index = 1; index < points.Count; index++) path += $" L {F(points[index].X)} {F(points[index].Y)}";
        return close ? path + " Z" : path;
    }
    private IReadOnlyList<MetricRibbonSegment> MetricRibbonSegments
    {
        get
        {
            var key = $"{Mode}|{SelectionSignature}";
            if (_metricRibbonCache.TryGetValue(key, out var cached)) return cached;
            var samples = BuildMetricRibbonSamples();
            if (samples.Count < 2) return _metricRibbonCache[key] = [];
            var segments = new MetricRibbonSegment[samples.Count];
            for (var index = 0; index < samples.Count; index++)
            {
                var a = samples[index];
                var b = samples[(index + 1) % samples.Count];
                var leftA = new MapPoint(a.Percent, a.Center.X + a.NormalX * a.Width / 2, a.Center.Y + a.NormalY * a.Width / 2);
                var rightA = new MapPoint(a.Percent, a.Center.X - a.NormalX * a.Width / 2, a.Center.Y - a.NormalY * a.Width / 2);
                var leftB = new MapPoint(b.Percent, b.Center.X + b.NormalX * b.Width / 2, b.Center.Y + b.NormalY * b.Width / 2);
                var rightB = new MapPoint(b.Percent, b.Center.X - b.NormalX * b.Width / 2, b.Center.Y - b.NormalY * b.Width / 2);
                var path = $"M {F(leftA.X)} {F(leftA.Y)} L {F(leftB.X)} {F(leftB.Y)} L {F(rightB.X)} {F(rightB.Y)} L {F(rightA.X)} {F(rightA.Y)} Z";
                segments[index] = new MetricRibbonSegment(path, MetricColor(Median([a.Metric, b.Metric])), a.Width, b.Width);
            }
            return _metricRibbonCache[key] = segments;
        }
    }

    private IReadOnlyList<MetricRibbonSample> BuildMetricRibbonSamples()
    {
        const int bins = 160;
        var selected = RenderedSelectedTraces.ToArray();
        var seeds = new MetricRibbonSeed[bins];
        for (var index = 0; index < bins; index++)
        {
            var percent = index / (double)bins;
            var observed = selected
                .Select(trace => _projectedTracePoints.TryGetValue(trace.Lap, out var points) ? NearestProjected(points, percent) : null)
                .Where(point => point is not null)
                .Cast<ProjectedTracePoint>()
                .ToArray();
            var center = observed.Length == 0
                ? MapPointAt(percent)
                : new MapPoint(percent, Median(observed.Select(point => (double?)point.Point.X)) ?? MapPointAt(percent).X, Median(observed.Select(point => (double?)point.Point.Y)) ?? MapPointAt(percent).Y);
            seeds[index] = new MetricRibbonSeed(percent, center, observed.Select(point => point.Point).ToArray(), MedianMetricAt(percent));
        }

        var samples = new MetricRibbonSample[bins];
        for (var index = 0; index < bins; index++)
        {
            var seed = seeds[index];
            var before = seeds[(index - 1 + bins) % bins].Center;
            var after = seeds[(index + 1) % bins].Center;
            var tangentX = after.X - before.X;
            var tangentY = after.Y - before.Y;
            var tangentLength = Math.Sqrt(tangentX * tangentX + tangentY * tangentY);
            var normalX = tangentLength < .000001 ? 0 : -tangentY / tangentLength;
            var normalY = tangentLength < .000001 ? 1 : tangentX / tangentLength;
            var offsets = seed.ObservedPoints
                .Select(point => (point.X - seed.Center.X) * normalX + (point.Y - seed.Center.Y) * normalY)
                .ToArray();
            var minimumOffset = offsets.Length == 0 ? 0 : offsets.Min();
            var maximumOffset = offsets.Length == 0 ? 0 : offsets.Max();
            var envelopeCenter = (minimumOffset + maximumOffset) / 2;
            var center = new MapPoint(seed.Percent, seed.Center.X + normalX * envelopeCenter, seed.Center.Y + normalY * envelopeCenter);
            var width = Math.Max(1, maximumOffset - minimumOffset);
            samples[index] = new MetricRibbonSample(seed.Percent, center, normalX, normalY, width, seed.Metric);
        }
        return samples;
    }

    private static ProjectedTracePoint? NearestProjected(IReadOnlyList<ProjectedTracePoint> points, double percent)
    {
        if (points.Count == 0) return null;
        var target = WrapPercent(percent);
        var low = 0;
        var high = points.Count - 1;
        while (low <= high)
        {
            var middle = low + (high - low) / 2;
            if (points[middle].Percent < target) low = middle + 1;
            else if (points[middle].Percent > target) high = middle - 1;
            else return points[middle];
        }
        var after = low >= points.Count ? points[0] : points[low];
        var before = high < 0 ? points[^1] : points[high];
        return CircularDistance(after.Percent, target) < CircularDistance(before.Percent, target) ? after : before;
    }
    private MapPoint MapPointAt(double percent) => MapPointAt(percent, MapPoints);
    private static MapPoint MapPointAt(double percent, IReadOnlyList<MapPoint> points)
    {
        if (points.Count == 0) return new MapPoint(WrapPercent(percent), 210, 140);
        var target = WrapPercent(percent);
        for (var index = 0; index < points.Count; index++)
        {
            var a = points[index];
            var b = points[(index + 1) % points.Count];
            var start = a.Percent;
            var end = b.Percent <= start ? b.Percent + 1 : b.Percent;
            var adjustedTarget = target < start ? target + 1 : target;
            if (adjustedTarget > end + .000001) continue;
            var t = Math.Abs(end - start) < .000001 ? 0 : (adjustedTarget - start) / (end - start);
            return new MapPoint(target, a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t);
        }
        return points.MinBy(point => CircularDistance(point.Percent, target))!;
    }
    private static double SegmentPercent(double start, double end, double t)
    {
        var adjustedEnd = end <= start ? end + 1 : end;
        return WrapPercent(start + (adjustedEnd - start) * t);
    }
    private static double WrapPercent(double value)
    {
        var wrapped = value % 1;
        return wrapped < 0 ? wrapped + 1 : wrapped;
    }
    private static double CircularDistance(double first, double second)
    {
        var distance = Math.Abs(first - second);
        return Math.Min(distance, 1 - distance);
    }
    private IReadOnlyList<StripSegment> StripSegments
    {
        get
        {
            var key = $"{Mode}|{SelectionSignature}";
            if (_stripSegmentCache.TryGetValue(key, out var cached)) return cached;
            const int count = 80;
            var segments = new StripSegment[count];
            for (var index = 0; index < count; index++)
            {
                var start = index / (double)count; var end = (index + 1) / (double)count;
                segments[index] = new StripSegment(28 + start * 364, 28 + end * 364, MetricColor(MetricAt((start + end) / 2)));
            }
            return _stripSegmentCache[key] = segments;
        }
    }
    private double? MetricAt(double percent)
    {
        return MedianMetricAt(percent);
    }
    private double? MedianMetricAt(double percent)
    {
        return Median(RenderedSelectedTraces.Select(trace => Nearest(trace, percent)).Where(point => point is not null).Select(point => MetricValue(point!)));
    }
    private double? MetricValue(AnalysisTracePoint point)
    {
        return Mode switch
        {
            "throttle" => point.Throttle,
            "brake" => point.Brake,
            "stress" => point.TireStressProxy,
            _ => point.SpeedMph
        };
    }
    private static double? Median(IEnumerable<double?> values)
    {
        var recorded = values.Where(value => value.HasValue && double.IsFinite(value.Value)).Select(value => value!.Value).Order().ToArray();
        if (recorded.Length == 0) return null;
        var middle = recorded.Length / 2;
        return recorded.Length % 2 == 0 ? (recorded[middle - 1] + recorded[middle]) / 2 : recorded[middle];
    }
    private string MetricColor(double? value)
    {
        if (value is null) return "#56616D";
        var (minimum, maximum) = TrackMetricRange();
        var plottedValue = Mode == "steering" ? Math.Abs(value.Value) : value.Value;
        var normalized = Math.Clamp((plottedValue - minimum) / Math.Max(.000001, maximum - minimum), 0, 1);
        normalized = Math.Pow(normalized, .72);
        if (Mode != "speed" && normalized < .015) return "#48515B";
        return Mode switch
        {
            "speed" => HeatmapColor(normalized, SpeedHeatmapStops),
            "brake" => MixColor(normalized, (72, 79, 88), (255, 69, 86)),
            "throttle" => MixColor(normalized, (72, 79, 88), (42, 226, 126)),
            "stress" => MixColor(normalized, (247, 210, 74), (247, 65, 76)),
            _ => "#75AFFF"
        };
    }
    private static string MixColor(double amount, (int Red, int Green, int Blue) low, (int Red, int Green, int Blue) high)
    {
        var blend = Math.Clamp(amount, 0, 1);
        return $"rgb({(int)Math.Round(low.Red + (high.Red - low.Red) * blend)} {(int)Math.Round(low.Green + (high.Green - low.Green) * blend)} {(int)Math.Round(low.Blue + (high.Blue - low.Blue) * blend)})";
    }
    private static string HeatmapColor(double normalized, IReadOnlyList<HeatStop> stops)
    {
        var amount = Math.Clamp(normalized, 0, 1);
        var upperIndex = 1;
        while (upperIndex < stops.Count - 1 && amount > stops[upperIndex].Position) upperIndex++;
        var lower = stops[Math.Max(0, upperIndex - 1)];
        var upper = stops[upperIndex];
        var blend = Math.Abs(upper.Position - lower.Position) < .000001 ? 0 : (amount - lower.Position) / (upper.Position - lower.Position);
        var red = (int)Math.Round(lower.Red + (upper.Red - lower.Red) * blend);
        var green = (int)Math.Round(lower.Green + (upper.Green - lower.Green) * blend);
        var blue = (int)Math.Round(lower.Blue + (upper.Blue - lower.Blue) * blend);
        return $"rgb({red} {green} {blue})";
    }
    private (double Min, double Max) TrackMetricRange()
    {
        var key = $"{Mode}|{SelectionSignature}";
        if (_trackRangeCache.TryGetValue(key, out var cached)) return cached;
        if (Mode is "throttle" or "brake") return _trackRangeCache[key] = (0, 1);
        if (Mode == "stress")
        {
            var loads = SelectedTraces.SelectMany(trace => trace.Points)
                .Select(point => point.TireStressProxy)
                .Where(value => value.HasValue && double.IsFinite(value.Value))
                .Select(value => value!.Value)
                .ToArray();
            if (loads.Length == 0) return _trackRangeCache[key] = (0, 1);
            var minimum = loads.Min();
            var maximum = loads.Max();
            if (maximum - minimum < .001)
            {
                minimum = Math.Max(0, minimum - .01);
                maximum = Math.Min(1, maximum + .01);
            }
            return _trackRangeCache[key] = (minimum, Math.Max(minimum + .001, maximum));
        }
        if (Mode == "steering")
        {
            var maximum = SelectedTraces.SelectMany(trace => trace.Points)
                .Select(point => point.SteeringPeakRadians).Where(value => value.HasValue)
                .Select(value => Math.Abs(value!.Value)).DefaultIfEmpty(.55).Max();
            return _trackRangeCache[key] = (0, Math.Max(.05, maximum));
        }
        var values = SelectedTraces.SelectMany(trace => trace.Points).Select(point => point.SpeedMph)
            .Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        if (values.Length == 0) return _trackRangeCache[key] = (0, 180);
        var min = values.Min();
        var max = values.Max();
        if (max - min < 5) { min -= 2.5; max += 2.5; }
        return _trackRangeCache[key] = (min, max);
    }
    private string MapLegendMinimum
    {
        get
        {
            var range = TrackMetricRange();
            return Mode switch { "speed" => $"{range.Min:0} mph", "throttle" or "brake" or "stress" => "0%", _ => string.Empty };
        }
    }
    private string MapLegendMaximum
    {
        get
        {
            var range = TrackMetricRange();
            return Mode switch { "speed" => $"{range.Max:0} mph", "throttle" or "brake" or "stress" => "100%", _ => string.Empty };
        }
