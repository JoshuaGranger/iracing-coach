    {
        _selectionSignature = string.Join(",", Selected.Order());
        _referenceTraceCache = null;
        _timeDeltaByPoint.Clear();
        _traceStartTimeByLap.Clear();
        _traceRangeCache.Clear();
        _tracePathCache.Clear();
        _chartTraceGroupCache.Clear();
        _cursorConfigurationCache = null;
        _cursorConfigurationCacheKey = string.Empty;
        _trackRangeCache.Clear();
        _signalAvailabilityCache.Clear();
        _mapTracePaths = null;
        _mapTracePathsSignature = string.Empty;
        _metricRibbonCache.Clear();
        _stripSegmentCache.Clear();
    }
