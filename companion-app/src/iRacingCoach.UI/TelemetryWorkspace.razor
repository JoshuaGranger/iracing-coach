    private static string RowUnit(TracePanelRow panel) =>
        string.Join(" / ", panel.Signals.Select(signal => signal.Unit).Distinct(StringComparer.OrdinalIgnoreCase));
    private string RowHelp(TracePanelRow panel)
    {
        var rendered = panel.Signals
            .Select((signal, index) => new { Signal = signal, Index = index })
            .Where(item => HasSignalData(item.Signal))
            .ToArray();
        var missing = panel.Signals.Where(signal => !HasSignalData(signal)).ToArray();
        var parts = new List<string>();
        if (rendered.Length == 1)
        {
            var item = rendered[0];
            parts.Add(item.Index == 0
                ? $"{item.Signal.Name} ({item.Signal.Unit})."
                : $"Dashed: {item.Signal.Name} ({item.Signal.Unit}).");
        }
        else if (rendered.Length > 1)
        {
            parts.Add($"Solid: {rendered[0].Signal.Name} ({rendered[0].Signal.Unit}).");
            parts.Add($"Dashed: {rendered[1].Signal.Name} ({rendered[1].Signal.Unit}).");
            parts.Add("Each line uses its own vertical scale.");
        }
        if (missing.Length > 0) parts.Add($"Not recorded for the selected laps: {string.Join(", ", missing.Select(signal => signal.Name))}.");
        if (parts.Count == 0) parts.Add("No values were recorded for the selected laps.");
        return string.Join('\n', parts);
    }
    private (double Min, double Max) SignalRange(AnalysisTraceSignalDefinition signal)
    {
        var key = $"{SelectionSignature}|{signal.Id}";
        if (_traceRangeCache.TryGetValue(key, out var cached)) return cached;
        var values = SelectedTraces.SelectMany(trace => trace.Points.Select(point => SignalPointValue(signal, trace, point)))
            .Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        if (values.Length == 0) return (-.5, .5);
        if (signal.Id is "throttle" or "brake") return _traceRangeCache[key] = (0, 1);
        if (signal.Unit == "on / off") return _traceRangeCache[key] = (0, 1);
        if (signal.Id == "tire-wear") return _traceRangeCache[key] = (0, Math.Max(.01, values.Max() * 1.05));
        if (signal.Id is "delta" or "steering" or "slip" or "yaw")
        {
            var minimumMagnitude = signal.Id == "delta" ? .05 : 1;
            var magnitude = Math.Max(minimumMagnitude, values.Max(value => Math.Abs(value)));
            return _traceRangeCache[key] = (-magnitude, magnitude);
        }
        var min = values.Min(); var max = values.Max();
        if (Math.Abs(max - min) < .0001) { min -= .5; max += .5; }
        return _traceRangeCache[key] = (min, max);
    }
    private string TracePath(AnalysisLapTrace trace, TracePanelRow panel, AnalysisTraceSignalDefinition signal, double top)
    {
        var pointBudget = AnalysisRenderBudget.PointBudgetPerTrace(
            Selected.Count,
            PlotWidth,
            SpotlightLap == trace.Lap);
        var cacheKey = $"{SelectionSignature}|{SpotlightLap}|{pointBudget}|{panel.Signature}|{signal.Id}|{trace.Lap}|{F(_chartWidth)}|{F(top)}|{F(ChartPlotHeight)}";
        if (_tracePathCache.TryGetValue(cacheKey, out var cached)) return cached;
        if (!trace.Points.Any(point => SignalPointValue(signal, trace, point).HasValue)) return _tracePathCache[cacheKey] = string.Empty;
        var (min, max) = SignalRange(signal);
        var started = false;
        var sampledIndices = AnalysisRenderBudget.RepresentativeIndices(trace.Points.Count, pointBudget);
        var commands = new List<string>(sampledIndices.Count);
        foreach (var index in sampledIndices)
        {
            var value = SmoothedValue(signal, trace, index);
            if (!value.HasValue) { started = false; continue; }
            var x = PlotLeft + trace.Points[index].LapPercent * PlotWidth;
            var y = top + ChartPlotHeight - 4 - (value.Value - min) / (max - min) * (ChartPlotHeight - 8);
            commands.Add($"{(started ? "L" : "M")}{F(x)},{F(y)}");
            started = true;
        }
        return _tracePathCache[cacheKey] = string.Join(" ", commands);
    }
    private double? SmoothedValue(AnalysisTraceSignalDefinition signal, AnalysisLapTrace trace, int index)
    {
        var current = SignalPointValue(signal, trace, trace.Points[index]);
        if (!current.HasValue || IsStepSignal(signal)) return current;
        var neighborWeight = signal.Id is "throttle" or "brake" ? .10 : .16;
        var currentWeight = 1 - neighborWeight * 2;
        var sum = current.Value * currentWeight;
        var weight = currentWeight;
        if (index > 0 && SignalPointValue(signal, trace, trace.Points[index - 1]) is { } previous) { sum += previous * neighborWeight; weight += neighborWeight; }
        if (index + 1 < trace.Points.Count && SignalPointValue(signal, trace, trace.Points[index + 1]) is { } next) { sum += next * neighborWeight; weight += neighborWeight; }
        return sum / weight;
    }
    private static bool IsStepSignal(AnalysisTraceSignalDefinition signal) =>
        signal.Id is "gear" or "tire-wear" or "overall-position" or "class-position" or "track-wetness" or "track-surface" ||
        signal.Unit is "on / off" or "state" or "position";
    private static string LapRange(IReadOnlyList<int> laps) => laps.Count == 0 ? "—" : laps.Count == 1 ? laps[0].ToString() : $"{laps.Min()}–{laps.Max()}";
    private static string AriaBoolean(bool value) => value ? "true" : "false";
    private static string PaceTrend(AnalysisRun run) => run.PaceSlopeSecondsPerLap is null ? "—" : run.PaceSlopeSecondsPerLap > .005 ? $"+{run.PaceSlopeSecondsPerLap:0.000} s/lap" : run.PaceSlopeSecondsPerLap < -.005 ? $"{run.PaceSlopeSecondsPerLap:0.000} s/lap" : "Stable";
    private static string ControlChange(AnalysisRun run)
    {
        var parts = new List<string>();
        if (run.EarlyBrakeVsLatePercent.HasValue) parts.Add($"brake work {run.EarlyBrakeVsLatePercent.Value:+0;-0;0}%");
        if (run.EarlySteerVsLatePercent.HasValue) parts.Add($"steering work {run.EarlySteerVsLatePercent.Value:+0;-0;0}%");
        return parts.Count > 0 ? string.Join(" · ", parts) : "Control-load comparison unavailable";
    }
    private static string PitServiceWindow(AnalysisRun run) => run.PitStop?.ServiceSeconds is { } seconds ? $"{seconds:0.0}s detected service window" : "Recorded stop";
    private static string ChangedTires(AnalysisRun run)
    {
        var tires = run.PitStop?.TiresChanged;
        if (tires is null || tires.Count == 0) return "None recorded";
        return new[] { "LF", "RF", "LR", "RR" }.All(tire => tires.Contains(tire, StringComparer.OrdinalIgnoreCase)) ? "All four" : string.Join(", ", tires);
    }
    private static IReadOnlyList<AnalysisTireCondition> PitTireConditions(AnalysisPitStop pit)
    {
        var order = new[] { "LF", "RF", "LR", "RR" };
        if (pit.TireConditions is { Count: > 0 })
            return order.Where(pit.TireConditions.ContainsKey).Select(corner => pit.TireConditions[corner]).ToArray();

        var legacy = new Dictionary<string, double?>
        {
            ["LF"] = pit.LeftFrontTireWearPercent,
            ["RF"] = pit.RightFrontTireWearPercent,
            ["LR"] = pit.LeftRearTireWearPercent,
            ["RR"] = pit.RightRearTireWearPercent
        };
        var emptyBands = new AnalysisTireBands(null, null, null);
        return order
            .Where(corner => legacy[corner].HasValue)
            .Select(corner => new AnalysisTireCondition(corner, legacy[corner], emptyBands, emptyBands, emptyBands, null, string.Empty))
            .ToArray();
    }
    private static bool TireChanged(AnalysisRun run, string corner) =>
        run.PitStop?.TiresChanged.Contains(corner, StringComparer.OrdinalIgnoreCase) == true;
