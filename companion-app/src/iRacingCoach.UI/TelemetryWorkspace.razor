    private string TraceStrokeWidth(AnalysisLapTrace trace, int signalIndex)
    {
        if (!SpotlightLap.HasValue) return signalIndex == 0 ? "1.35" : "1.05";
        if (SpotlightLap == trace.Lap) return signalIndex == 0 ? "2.35" : "1.8";
        return signalIndex == 0 ? "1.15" : ".95";
    }
    private string TraceOpacity(AnalysisLapTrace trace, int signalIndex)
    {
        if (!SpotlightLap.HasValue) return signalIndex == 0 ? "1" : ".72";
        if (SpotlightLap == trace.Lap) return signalIndex == 0 ? "1" : ".82";
        return signalIndex == 0 ? ".42" : ".30";
    }
    private IReadOnlyList<ChartTracePath> ChartTracePaths(
        TracePanelRow panel,
        AnalysisTraceSignalDefinition signal,
        int signalIndex,
        double top)
    {
        var key = $"{SelectionSignature}|{SpotlightLap}|{panel.Signature}|{signal.Id}|{signalIndex}|{F(_chartWidth)}|{F(top)}|{F(ChartPlotHeight)}";
        if (_chartTraceGroupCache.TryGetValue(key, out var cached)) return cached;
        var result = RenderedSelectedTraces
            .Where(trace => trace.Points.Any(point => SignalPointValue(signal, trace, point).HasValue))
            .GroupBy(trace => new { Color = LapColor(trace.Lap), Spotlight = SpotlightLap == trace.Lap })
            .Select(group =>
            {
                var representative = group.First();
                return new ChartTracePath(
                    string.Join(',', group.Select(trace => trace.Lap)),
                    group.Key.Color,
                    string.Join(' ', group.Select(trace => TracePath(trace, panel, signal, top)).Where(path => path.Length > 0)),
                    TraceStrokeWidth(representative, signalIndex),
                    TraceOpacity(representative, signalIndex),
                    group.Key.Spotlight);
            })
            .Where(group => group.Path.Length > 0)
            .OrderBy(group => group.Spotlight)
            .ThenBy(group => group.Color, StringComparer.Ordinal)
            .ToArray();
        return _chartTraceGroupCache[key] = result;
    }
    private string CursorSummary
    {
        get
        {
            var sample = AverageAt(Cursor);
            if (sample.Count == 0) return "No sample";
            var values = new List<string>();
            if (sample.SpeedMph.HasValue) values.Add($"{sample.SpeedMph.Value:0} mph");
            if (sample.Throttle.HasValue) values.Add($"{sample.Throttle.Value * 100:0}% throttle");
            if (sample.Brake.HasValue) values.Add($"{sample.Brake.Value * 100:0}% brake");
            if (sample.TimeDeltaSeconds.HasValue) values.Add($"{sample.TimeDeltaSeconds.Value:+0.000;-0.000;0.000} s");
            return values.Count == 0 ? "No recorded values" : string.Join(" · ", values);
        }
    }

