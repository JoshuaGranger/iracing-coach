    private AnalysisRun? RunForLap(int lap)
    {
        var exact = Workspace.Runs.FirstOrDefault(run => run.Laps.Contains(lap));
        if (exact is not null) return exact;
        return Workspace.Runs
            .Where(run => run.PitStop is not null && run.Laps.Count > 0 && lap >= run.Laps.Max() && lap - run.Laps.Max() <= 2)
            .OrderByDescending(run => run.Laps.Max())
            .FirstOrDefault();
    }
    private bool IsClean(AnalysisLapTrace trace) => trace.Complete && trace.PitTimeSeconds.GetValueOrDefault() <= 0 && IncidentPoints(trace.Lap) == 0 && !trace.FlagState.Contains("caution", StringComparison.OrdinalIgnoreCase) && !trace.FlagState.Contains("yellow", StringComparison.OrdinalIgnoreCase);
    private IReadOnlyList<LapFlag> LapFlags(AnalysisLapTrace trace)
    {
        // iRacing keeps the finish state active across timing boundaries. A partial
        // post-finish recording is not another checkered lap, and the checkered lap
        // itself must not retain the preceding white flag.
        if (!trace.Complete) return [new LapFlag("incomplete", "Incomplete lap")];
        var states = new List<string>(trace.FlagStates ?? []);
        if (trace.GreenFraction.GetValueOrDefault() > .001 && !states.Contains("green", StringComparer.OrdinalIgnoreCase)) states.Insert(0, "green");
        if (trace.CautionFraction.GetValueOrDefault() > .001 && !states.Any(value => value.Equals("yellow", StringComparison.OrdinalIgnoreCase) || value.Equals("caution", StringComparison.OrdinalIgnoreCase))) states.Add("yellow");
        if (states.Any(value => value.Equals("checkered", StringComparison.OrdinalIgnoreCase) || value.Equals("checker", StringComparison.OrdinalIgnoreCase)))
            states.RemoveAll(value => value.Equals("white", StringComparison.OrdinalIgnoreCase));
        if (states.Count == 0) states.Add(IsCaution(trace) ? "yellow" : "green");
        return states
            .Select(state => state.ToLowerInvariant() switch
            {
                "green" => new LapFlag("green", "Green flag"),
                "yellow" or "caution" => new LapFlag("yellow", "Yellow flag"),
                "black" => new LapFlag("black", "Black flag"),
                "white" => new LapFlag("white", "White flag"),
                "checkered" or "checker" => new LapFlag("checkered", "Checkered flag"),
                _ => new LapFlag("incomplete", "Incomplete lap")
            })
            .DistinctBy(flag => flag.Class)
            .ToArray();
    }
    private IReadOnlyList<string> PitDirections(AnalysisLapTrace trace)
    {
        var ordered = Workspace.Traces.OrderBy(item => item.Lap).ToArray();
        if (ordered.Length > 0 && trace.Lap == ordered[0].Lap &&
            (trace.PitEntry || trace.PitExit || trace.PitTimeSeconds.GetValueOrDefault() > 0))
            return ["out"];
        var directions = new List<string>();
        if (trace.PitEntry) directions.Add("in");
        if (trace.PitExit) directions.Add("out");
        if (directions.Count > 0 || trace.PitTimeSeconds.GetValueOrDefault() <= 0) return directions;
        var index = Array.FindIndex(ordered, item => item.Lap == trace.Lap);
        var previousWasPit = index > 0 && ordered[index - 1].PitTimeSeconds.GetValueOrDefault() > 0;
        var nextIsPit = index >= 0 && index + 1 < ordered.Length && ordered[index + 1].PitTimeSeconds.GetValueOrDefault() > 0;
        if (!previousWasPit) directions.Add("in");
        if (!nextIsPit) directions.Add("out");
        return directions;
    }
