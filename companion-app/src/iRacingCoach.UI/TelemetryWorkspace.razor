        IncidentPoints(trace.Lap) == 0;
    private static bool IsGreenLap(AnalysisLapTrace trace) =>
        trace.Complete &&
        trace.CautionFraction.GetValueOrDefault() <= .001 &&
        !trace.FlagState.Contains("yellow", StringComparison.OrdinalIgnoreCase) &&
        !trace.FlagState.Contains("caution", StringComparison.OrdinalIgnoreCase) &&
