@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="telemetry-workspace" aria-labelledby="telemetry-heading" @onkeydown="HandleWorkspaceKeyDown">
    <div class="analysis-section-heading">
        <div><span class="eyebrow">Telemetry</span><h2 id="telemetry-heading">Compare laps</h2></div>
    </div>

    @if (Workspace.Traces.Count == 0)
    {
        <div class="empty-state compact-empty"><h3>Detailed traces were not recorded</h3><p>Enable iRacing disk telemetry to record speed, controls, and load traces in future races.</p></div>
    }
    else
    {
        <div class="telemetry-workstation-grid">
        <aside class="lap-rail" aria-label="Runs and laps">
            <div class="lap-rail-header">
                <strong>Laps &amp; runs</strong><span>@Selected.Count selected</span>
                <label class="clean-lap-filter"><input type="checkbox" checked="@CleanLapsOnly" @onchange="CleanLapFilterChanged" /> Clean laps</label>
            </div>
            <div class="lap-rail-scroll">
                @foreach (var indexedGroup in LapGroups.Select((group, index) => new { Group = group, Index = index }))
                {
                    var group = indexedGroup.Group;
                    <details class="lap-run-group @(indexedGroup.Index > 0 ? "separated" : null)" open>
                        <summary>
                            <span class="run-summary-name">@group.Label</span>
                            @if (group.Run is { } summaryRun)
                            {
                                <span class="run-summary-metrics">@summaryRun.GreenLaps green · @summaryRun.CautionLaps caution</span>
                                <span class="run-insight" tabindex="0" aria-label="Run @summaryRun.Number details" @onclick:stopPropagation="true">i<span class="run-tooltip" role="tooltip"><strong>Run @summaryRun.Number · laps @LapRange(summaryRun.Laps)</strong>@if (HasOfficialPace(summaryRun)) { <span>Early pace <b>@LapTime(summaryRun.EarlyAverageLapSeconds)</b></span><span>Late pace <b>@LapTime(summaryRun.LateAverageLapSeconds)</b></span><span>Pace trend <b>@PaceTrend(summaryRun)</b></span> } else { <span>Observed green pace <b>@ObservedPaceRange(summaryRun)</b></span><span>Coaching comparison <b>Excluded</b></span> }@if (summaryRun.FuelUsedGallons.HasValue) { <span>Fuel used <b>@summaryRun.FuelUsedGallons.Value.ToString("0.00") gal</b></span> }@if (summaryRun.TireRemainingPercent.HasValue) { <span>Lowest tire <b>@summaryRun.TireName @summaryRun.TireRemainingPercent.Value.ToString("0.0")%</b></span> }<small>@(HasOfficialPace(summaryRun) ? ControlChange(summaryRun) : summaryRun.Status)</small></span></span>
                            }
                            else
                            {
                                <small>@group.Traces.Count laps</small>
                            }
                        </summary>
                        @foreach (var trace in group.Traces)
                        {
                            var run = RunForLap(trace.Lap);
                            var pitDirections = PitDirections(trace);
                            var pitLap = pitDirections.Count > 0 || trace.PitTimeSeconds.GetValueOrDefault() > 0;
                            var isFastest = trace.LapTimeSeconds.HasValue && Math.Abs(trace.LapTimeSeconds.Value - FastestLapTime) < .0001;
                            <button class="lap-rail-row @(Selected.Contains(trace.Lap) ? "selected" : null) @(pitLap ? "pit-lap" : null)" style="@($"--lap-color:{LapColor(trace.Lap)}")" aria-pressed="@Selected.Contains(trace.Lap)" @onclick="() => SelectLap(trace.Lap)">
                                <span class="lap-flags" aria-label="Recorded lap flags">
                                    @foreach (var flag in LapFlags(trace))
                                    {
                                        <span class="lap-flag @flag.Class" title="@flag.Label" aria-label="@flag.Label"><ProductIcon Name="race" Size="12" /></span>
                                    }
                                </span>
                                <span class="lap-identity"><b>@trace.Lap</b><i class="lap-trace-color" aria-hidden="true"></i></span>
                                <span class="lap-time condition-hover @(isFastest ? "fastest" : null)" title="Lap weather and track conditions" @onmouseenter="args => ShowConditionsPopover(args, trace.Lap)" @onmouseleave="HideConditionsPopover"><span class="lap-pace-value">@LapTime(trace.LapTimeSeconds)</span>@if (ShowPaceDelta(trace, isFastest)) { <small>(+@((trace.LapTimeSeconds!.Value - FastestLapTime).ToString("0.000")))</small> }</span>
                                <span class="lap-sector-column">
                                    @if (SectorStarts.Count > 1)
                                    {
                                    <span class="sector-squares" aria-label="Sector performance">
                                        @for (var sector = 0; sector < SectorStarts.Count; sector++)
                                        {
                                            var sectorState = SectorState(trace, sector);
                                            <span class="sector-square @sectorState.Class" title="@sectorState.Title" aria-hidden="true"></span>
                                        }
                                    </span>
                                    }
                                </span>
                                <span class="lap-fuel-column" title="@FuelConsumedTitle(trace)">@FuelConsumed(trace)</span>
                                <span class="lap-incident-column">
                                    @if (IncidentPoints(trace.Lap) is var points && points > 0) { <span class="incident-badge severity-@IncidentSeverity(points)" title="@($"{points} incident point{(points == 1 ? string.Empty : "s")} on lap {trace.Lap}")">@($"x{points}")</span> }
                                </span>
                                <span class="lap-pit-column">
                                    @foreach (var direction in pitDirections)
                                    {
                                        <span class="pit-badge" @onmouseenter="args => ShowPitPopover(args, trace.Lap)" @onmouseleave="HidePitPopover" @onclick:stopPropagation="true">Pit (@direction)</span>
                                    }
                                </span>
                                @if (pitLap && run is not null && ActivePitLap == trace.Lap)
                                {
                                    <span class="pit-lap-popover" style="@PitPopoverStyle" role="tooltip">
                                        <span class="pit-popover-heading"><strong>Pit lap @trace.Lap</strong><small>@PitServiceTime(run)</small></span>
                                        <span class="pit-popover-row"><span>Tires changed</span><b>@ChangedTires(run)</b></span>
                                        <span class="pit-popover-label">Recorded tire wear</span>
                                        <span class="pit-wear-grid">
                                            <span>LF <b>@TireWear(run.PitStop?.LeftFrontTireWearPercent)</b></span>
                                            <span>RF <b>@TireWear(run.PitStop?.RightFrontTireWearPercent)</b></span>
                                            <span>LR <b>@TireWear(run.PitStop?.LeftRearTireWearPercent)</b></span>
                                            <span>RR <b>@TireWear(run.PitStop?.RightRearTireWearPercent)</b></span>
                                        </span>
                                        <span class="pit-popover-row"><span>Fuel added</span><b>@FuelAdded(run)</b></span>
                                        <span class="pit-popover-row"><span>Fuel range at stop</span><b>@FuelRangeAtStop(run)</b></span>
                                        <span class="pit-popover-row"><span>Race remaining</span><b>@RaceLapsRemaining(trace.Lap)</b></span>
                                        @if (run.PitStop?.DamageRepairedSeconds is { } repaired) { <span class="pit-popover-row"><span>Damage repaired</span><b>@repaired.ToString("0.0") s</b></span> }
                                        @if (run.PitStop?.PenaltyServedSeconds is { } penalty) { <span class="pit-popover-row"><span>Penalty served</span><b>@penalty.ToString("0.0") s</b></span> }
                                    </span>
                                }
                                @if (ActiveConditionsLap == trace.Lap && trace.Conditions is { } conditions)
                                {
                                    <span class="lap-conditions-popover" style="@ConditionsPopoverStyle" role="tooltip">
                                        <span class="conditions-popover-heading"><strong>Lap @trace.Lap conditions</strong><small>@LapTime(trace.LapTimeSeconds)</small></span>
                                        <span class="conditions-grid">
                                            <span class="condition-item sky"><ProductIcon Name="weather" Size="17" /><b>@Sky(conditions)</b></span>
                                            <span class="condition-item track-temp"><ProductIcon Name="temperature" Size="17" /><b>@Temperature(conditions.TrackTemperatureF)</b></span>
                                            <span class="condition-item air-temp"><ProductIcon Name="air-temperature" Size="17" /><b>@Temperature(conditions.AirTemperatureF)</b></span>
                                            <span class="condition-item wind"><ProductIcon Name="wind" Size="17" /><b>@Wind(conditions)</b></span>
                                            <span class="condition-item humidity"><ProductIcon Name="humidity" Size="17" /><b>@Percent(conditions.RelativeHumidityPercent)</b></span>
                                            <span class="condition-item fog"><ProductIcon Name="fog" Size="17" /><b>@Percent(conditions.FogPercent)</b></span>
                                            <span class="condition-item pressure"><ProductIcon Name="pressure" Size="17" /><b>@Pressure(conditions.AirPressureInHg)</b></span>
                                            <span class="condition-item density"><ProductIcon Name="density" Size="17" /><b>@Density(conditions.AirDensityPoundsPerCubicFoot)</b></span>
                                            <span class="condition-item precipitation"><ProductIcon Name="precipitation" Size="17" /><b>@Percent(conditions.PrecipitationPercent)</b></span>
                                        </span>
                                        <span class="track-usage-row"><i aria-hidden="true"></i><strong>@TrackUsage(conditions)</strong></span>
                                    </span>
                                }
                            </button>
                        }
                    </details>
                }
            </div>
            <div class="lap-rail-footer"><button class="text-button" @onclick="ResetSelection">Best three</button><button class="text-button" @onclick="ClearSelection">Clear</button><button class="text-button" @onclick="ShowAllLaps">Show all</button></div>
        </aside>

        @if (Selected.Count == 0)
        {
            <div class="telemetry-empty-selection"><strong>No laps selected</strong><span>Select a lap, Best three, or Show all to display telemetry.</span></div>
        }
        else
        {
        <div class="telemetry-grid">
            <div class="track-panel">
                <div class="panel-title track-panel-title"><div><strong>@(Workspace.GeometryMode == "track_shape" ? "Track position" : "Lap distance")</strong><span>Average of selected laps</span></div><label class="track-color-control"><span>Color</span><select @bind="Mode">@foreach (var option in Modes) { <option value="@option.Key">@option.Label</option> }</select></label></div>
                <svg @ref="TrackElement" class="track-map" viewBox="@TrackViewBox" role="img" aria-label="Track telemetry map" @onmousemove="TrackMoved">
                    @if (Workspace.TrackShape.Count >= 3)
                    {
                        @foreach (var segment in MapSegments)
                        {
                            <line x1="@F(segment.A.X)" y1="@F(segment.A.Y)" x2="@F(segment.B.X)" y2="@F(segment.B.Y)" stroke="@segment.Color" stroke-width="8" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                        }
                        <circle data-analysis-track-cursor-point cx="@F(CursorMapPoint.X)" cy="@F(CursorMapPoint.Y)" r="8" class="map-cursor-halo" />
                        <circle data-analysis-track-cursor-point cx="@F(CursorMapPoint.X)" cy="@F(CursorMapPoint.Y)" r="4" class="map-cursor" />
                    }
                    else
                    {
                        <line x1="28" y1="140" x2="392" y2="140" class="distance-base" />
                        @foreach (var segment in StripSegments)
                        {
                            <line x1="@F(segment.X1)" y1="140" x2="@F(segment.X2)" y2="140" stroke="@segment.Color" stroke-width="14" stroke-linecap="round" />
                        }
                        @foreach (var zone in Workspace.Segments)
                        {
                            <line x1="@F(28 + zone.StartPercent * 364)" y1="113" x2="@F(28 + zone.StartPercent * 364)" y2="167" class="zone-marker" />
                            <svg:text x="@F(28 + zone.StartPercent * 364)" y="99" class="chart-label">@FriendlyZone(zone)</svg:text>
                        }
                        <line data-analysis-track-cursor-line x1="@F(28 + Cursor * 364)" y1="104" x2="@F(28 + Cursor * 364)" y2="176" class="map-cursor-line" />
                        <svg:text x="28" y="205" class="chart-label">Start / finish</svg:text><svg:text x="392" y="205" text-anchor="end" class="chart-label">100%</svg:text>
                    }
                </svg>
                <div class="cursor-readout"><strong data-analysis-track-percent>@((Cursor * 100).ToString("0.0"))%</strong><span data-analysis-track-summary>@CursorSummary</span></div>
            </div>

            <div class="trace-panel @(TraceExpanded ? "trace-panel-expanded" : null)">
                <div class="panel-title trace-panel-title">
                    <strong>Aligned traces</strong>
                    <div class="trace-panel-actions">
                        <span>@Selected.Count selected · hover to compare</span>
                        <button type="button" class="trace-toolbox-button" title="Choose trace rows" aria-label="Choose trace rows" aria-expanded="@TraceToolboxOpen" @onclick="ToggleTraceToolbox">
                            <ProductIcon Name="settings" Size="16" />
                        </button>
                        <button type="button" class="trace-expand-button" title="@(TraceExpanded ? "Exit full screen (Esc)" : "View traces full screen")" aria-label="@(TraceExpanded ? "Exit full-screen traces" : "View traces full screen")" aria-pressed="@TraceExpanded" @onclick="ToggleTraceExpanded">
                            <ProductIcon Name="@(TraceExpanded ? "contract" : "expand")" Size="16" />
                        </button>
                    </div>
                </div>
                @if (TraceToolboxOpen)
                {
                    <aside class="analysis-trace-toolbox" aria-label="Trace row toolbox">
                        <div class="trace-toolbox-heading"><div><strong>Trace rows</strong><span>@TraceRows.Count of @AnalysisTraceLayouts.MaximumRows</span></div><button type="button" class="trace-toolbox-close" aria-label="Close trace row toolbox" @onclick="ToggleTraceToolbox"><ProductIcon Name="close" Size="15" /></button></div>
                        <div class="trace-signal-library" role="list" aria-label="Draggable telemetry signals">
                            <span class="trace-signal-library-label">Drag a signal to a row</span>
                            <div class="trace-signal-library-items">
                                @foreach (var signal in AnalysisTraceLayouts.Signals)
                                {
                                    <button type="button" role="listitem" draggable="true" class="trace-signal-chip @(SignalRecordedInRace(signal) ? null : "unavailable")" data-group="@signal.AccentGroup" title="@(SignalRecordedInRace(signal) ? $"Drag {signal.Name} to a primary slot or pair it with any different signal" : $"{signal.Name} was not recorded in this race; the saved row will become active when it is available")" @ondragstart="() => BeginTraceSignalDrag(signal.Id)" @ondragend="EndTraceSignalDrag">
                                        <i aria-hidden="true"></i><span>@signal.ShortLabel</span>
                                    </button>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_traceDropFeedback))
                        {
                            <div class="trace-drop-feedback @(_traceDropRejected ? "rejected" : "accepted")" role="status">@_traceDropFeedback</div>
                        }
                        <div class="trace-row-editor-list">
                            @foreach (var indexed in TraceLayout.Rows.Select((row, index) => new { Row = row, Index = index }))
                            {
                                <article class="trace-row-editor" @key="indexed.Row.Id">
                                    <span class="trace-row-number">@(indexed.Index + 1)</span>
                                    <label class="@TraceDropTargetClass(indexed.Row, TraceDropSlot.Primary)" @ondragenter="() => EnterTraceDropTarget(indexed.Row.Id, TraceDropSlot.Primary)" @ondragover:preventDefault @ondrop="() => DropTraceSignal(indexed.Row.Id, TraceDropSlot.Primary)">
                                        <span class="trace-drop-slot-label">Primary</span>
                                        <span class="sr-only">Primary signal for row @(indexed.Index + 1)</span><select value="@indexed.Row.PrimarySignalId" @onchange="args => ChangePrimarySignal(indexed.Row.Id, args.Value?.ToString())">@foreach (var signal in AnalysisTraceLayouts.Signals) { <option value="@signal.Id">@SignalOption(signal)</option> }</select>
                                        @if (IsActiveDropTarget(indexed.Row.Id, TraceDropSlot.Primary)) { <span class="trace-drop-target-status">Replace primary</span> }
                                    </label>
                                    <label class="@TraceDropTargetClass(indexed.Row, TraceDropSlot.Secondary)" @ondragenter="() => EnterTraceDropTarget(indexed.Row.Id, TraceDropSlot.Secondary)" @ondragover:preventDefault @ondrop="() => DropTraceSignal(indexed.Row.Id, TraceDropSlot.Secondary)">
                                        <span class="trace-drop-slot-label">Second</span>
                                        <span class="sr-only">Second signal for row @(indexed.Index + 1)</span><select value="@indexed.Row.SecondarySignalId" @onchange="args => ChangeSecondarySignal(indexed.Row.Id, args.Value?.ToString())"><option value="">One signal</option>@foreach (var signal in AnalysisTraceLayouts.SecondarySignalOptions(indexed.Row.PrimarySignalId)) { <option value="@signal.Id">@SignalOption(signal)</option> }</select>
                                        @if (IsActiveDropTarget(indexed.Row.Id, TraceDropSlot.Secondary)) { <span class="trace-drop-target-status">@(CanUseAsSecondSignal(indexed.Row) ? "Add second signal" : "Already primary")</span> }
                                    </label>
                                    <span class="trace-row-editor-actions">
                                        <button type="button" disabled="@(indexed.Index == 0)" aria-label="Move row @(indexed.Index + 1) up" @onclick="() => MoveTraceRow(indexed.Row.Id, -1)">Up</button>
                                        <button type="button" disabled="@(indexed.Index == TraceLayout.Rows.Count - 1)" aria-label="Move row @(indexed.Index + 1) down" @onclick="() => MoveTraceRow(indexed.Row.Id, 1)">Down</button>
                                        <button type="button" disabled="@(TraceLayout.Rows.Count <= 1)" aria-label="Remove row @(indexed.Index + 1)" @onclick="() => RemoveTraceRow(indexed.Row.Id)"><ProductIcon Name="trash" Size="14" /></button>
                                    </span>
                                </article>
                            }
                        </div>
                        <button type="button" class="trace-row-add" disabled="@(TraceLayout.Rows.Count >= AnalysisTraceLayouts.MaximumRows)" @onclick="AddTraceRow"><ProductIcon Name="plus" Size="14" /> Add row</button>
                    </aside>
                }
                <svg @ref="ChartElement" class="trace-chart configurable-trace-chart" viewBox="@($"0 0 {F(_chartWidth)} {F(ChartHeight)}")" style="height:@($"{F(ChartHeight)}px")" preserveAspectRatio="none" role="img" aria-label="Configurable synchronized telemetry traces">
                    @for (var row = 0; row < TraceRows.Count; row++)
                    {
                        var panel = TraceRows[row]; var top = ChartTop + row * ChartRowHeight;
                        <rect data-analysis-chart-row x="@PlotLeft" y="@top" width="@PlotWidth" height="@ChartPlotHeight" class="chart-row" />
                        <line data-analysis-horizontal-grid x1="@PlotLeft" y1="@(top + ChartPlotHeight / 2)" x2="@PlotRight" y2="@(top + ChartPlotHeight / 2)" class="chart-grid-line" />
                        <svg:text x="8" y="@(top + 18)" class="chart-title">@RowLabel(panel)</svg:text>
                        <svg:text x="8" y="@(top + 38)" class="chart-unit">@RowSubtitle(panel)</svg:text>
                        @if (!panel.Signals.Any(HasSignalData))
                        {
                            <svg:text x="@(PlotLeft + 12)" y="@(top + ChartPlotHeight / 2 + 4)" class="chart-unavailable">Not recorded for this race</svg:text>
                        }
                        @foreach (var trace in SelectedTraces)
                        {
                            @foreach (var indexedSignal in panel.Signals.Where(HasSignalData).Select((signal, index) => new { Signal = signal, Index = index }))
                            {
                                <path data-analysis-trace-path data-row="@row" data-lap="@trace.Lap" data-signal="@indexedSignal.Signal.Id" d="@TracePath(trace, panel, indexedSignal.Signal, top)" fill="none" stroke="@LapColor(trace.Lap)" stroke-width="@(indexedSignal.Index == 0 ? "1.35" : "1.05")" stroke-dasharray="@(indexedSignal.Index == 0 ? null : "4 3")" opacity="@(indexedSignal.Index == 0 ? "1" : ".72")" vector-effect="non-scaling-stroke" />
                            }
                        }
                    }
                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var x = PlotLeft + tick * (PlotWidth / 4d);
                        <line data-analysis-vertical-grid="@tick" x1="@x" y1="@ChartTop" x2="@x" y2="@ChartBottom" class="chart-grid-vertical" />
                        <svg:text data-analysis-x-tick="@tick" x="@x" y="@(ChartHeight - 7)" text-anchor="middle" class="chart-label">@(tick * 25)%</svg:text>
                    }
                    <g data-analysis-cursor-layer class="analysis-cursor-layer" style="display:none" aria-hidden="true"></g>
                </svg>
            </div>
        </div>
        }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    private readonly HashSet<int> Selected = [];
    private string? _analysisId;
    private string Mode { get; set; } = "speed";
    private bool CleanLapsOnly { get; set; }
    private bool TraceExpanded { get; set; }
    private bool TraceToolboxOpen { get; set; }
    private string? _draggedTraceSignalId;
    private string? _activeTraceDropRowId;
    private TraceDropSlot? _activeTraceDropSlot;
    private string? _traceDropFeedback;
    private bool _traceDropRejected;
    private int? ActivePitLap { get; set; }
    private int? ActiveConditionsLap { get; set; }
    private double PitPopoverX { get; set; }
    private double PitPopoverY { get; set; }
    private bool PitPopoverAbove { get; set; }
    private double ConditionsPopoverX { get; set; }
    private double ConditionsPopoverY { get; set; }
    private bool ConditionsPopoverAbove { get; set; }
    private double Cursor { get; set; } = .25;
    private ElementReference ChartElement;
    private ElementReference TrackElement;
    private bool _trackMovePending;
    private bool _cursorInteropAttached;
    private double _chartWidth = 1000;
    private string _cursorInteropSignature = string.Empty;
    private readonly Dictionary<AnalysisTracePoint, double?> _calculatedWearByPoint = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<string, (double Min, double Max)> _traceRangeCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _tracePathCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, (double Min, double Max)> _trackRangeCache = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _signalAvailabilityCache = new(StringComparer.Ordinal);
    private string _selectionSignature = string.Empty;
    private const double PlotLeft = 126;
    private const int ChartTop = 12;
    private const double TraceRowsHeight = 820;
    private const int TooltipRowHeight = 20;
    private const double TooltipCharacterWidth = 7.1;
    private static readonly (string Key, string Label)[] Modes = [("speed", "Speed"), ("throttle", "Throttle"), ("brake", "Brake"), ("steering", "Steering"), ("stress", "Tire load")];
    private static readonly HeatStop[] SpeedHeatmapStops =
    [
        new(0.00, 71, 103, 232),
        new(0.25, 56, 189, 248),
        new(0.50, 66, 226, 154),
        new(0.75, 244, 211, 94),
        new(1.00, 255, 111, 105)
    ];

    protected override void OnParametersSet()
    {
        State.Settings.RaceAnalysisTraces ??= new AnalysisTraceLayout();
        _ = AnalysisTraceLayouts.ValidateAndRepair(State.Settings.RaceAnalysisTraces);
        if (_analysisId == Workspace.AnalysisId) return;
        _analysisId = Workspace.AnalysisId;
        ResetSelection();
        RebuildCalculatedTireWear();
        InvalidateTraceRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Selected.Count == 0) return;
        if (!_cursorInteropAttached && await MeasureChart()) return;
        var signature = CursorInteropSignature;
        if (!_cursorInteropAttached || !string.Equals(signature, _cursorInteropSignature, StringComparison.Ordinal))
        {
            await JS.InvokeVoidAsync("iracingCoachAnalysisCursor.initialize", ChartElement, TrackElement, BuildCursorInteropConfiguration());
            _cursorInteropAttached = true;
            _cursorInteropSignature = signature;
            return;
        }
        await JS.InvokeVoidAsync("iracingCoachAnalysisCursor.sync", ChartElement, TrackElement);
    }

    private void ToggleTraceExpanded()
    {
        TraceExpanded = !TraceExpanded;
    }
    private void ToggleTraceToolbox()
    {
        TraceToolboxOpen = !TraceToolboxOpen;
        if (!TraceToolboxOpen) EndTraceSignalDrag();
    }

    private void HandleWorkspaceKeyDown(KeyboardEventArgs args)
    {
        if (TraceExpanded && args.Key == "Escape") ToggleTraceExpanded();
    }

    private void RebuildCalculatedTireWear()
    {
        _calculatedWearByPoint.Clear();
        var calculated = CalculatedTireWear.Build(Workspace.Traces, Workspace.Runs);
        foreach (var trace in Workspace.Traces)
        {
            if (!calculated.TryGetValue(trace.Lap, out var values)) continue;
            for (var index = 0; index < Math.Min(trace.Points.Count, values.Count); index++)
                _calculatedWearByPoint[trace.Points[index]] = values[index];
        }
    }

    private IEnumerable<AnalysisLapTrace> SelectedTraces => Workspace.Traces.Where(trace => Selected.Contains(trace.Lap));
    private IEnumerable<LapGroup> LapGroups
    {
        get
        {
            var eligible = Workspace.Traces.Where(trace => !CleanLapsOnly || IsClean(trace)).OrderBy(trace => trace.Lap).ToArray();
            var runs = Workspace.Runs.Where(run => run.Laps.Count > 0).OrderBy(run => run.Laps.Min()).ToArray();
            if (runs.Length == 0)
            {
                if (eligible.Length > 0) yield return new LapGroup("Recorded laps", eligible, null);
                yield break;
            }
            for (var index = 0; index < runs.Length; index++)
            {
                var start = index == 0 ? int.MinValue : runs[index].Laps.Min();
                var end = index + 1 < runs.Length ? runs[index + 1].Laps.Min() : int.MaxValue;
                var traces = eligible.Where(trace => trace.Lap >= start && trace.Lap < end).ToArray();
                if (traces.Length > 0) yield return new LapGroup($"Run {runs[index].Number}", traces, runs[index]);
            }
        }
    }
    private double FastestLapTime => Workspace.Traces.Where(trace => IsClean(trace) && trace.LapTimeSeconds.HasValue).Select(trace => trace.LapTimeSeconds!.Value).DefaultIfEmpty(double.MaxValue).Min();
