    private AggregateSample AverageAt(double percent)
    {
        var samples = SelectedTraces
            .Select(trace => new { Trace = trace, Point = Nearest(trace, percent) })
            .Where(sample => sample.Point is not null)
            .ToArray();
        if (samples.Length == 0) return new AggregateSample(0, null, null, null, null, null, null);
        return new AggregateSample(
            samples.Length,
            Average(samples.Select(sample => sample.Point!.SpeedMph)),
            Average(samples.Select(sample => sample.Point!.Throttle)),
            Average(samples.Select(sample => sample.Point!.Brake)),
            Average(samples.Select(sample => sample.Point!.SteeringPeakRadians)),
            Average(samples.Select(sample => sample.Point!.TireStressProxy)),
            Average(samples.Select(sample => TimeDelta(sample.Trace, sample.Point!))));
    }
    private static double? Average(IEnumerable<double?> values)
    {
        var recorded = values.Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        return recorded.Length == 0 ? null : recorded.Average();
    }
    private static AnalysisTracePoint? Nearest(AnalysisLapTrace trace, double percent)
    {
        var points = trace.Points;
        if (points.Count == 0) return null;
        return points[NearestIndex(points, percent)];
    }
    private static int NearestIndex(IReadOnlyList<AnalysisTracePoint> points, double percent)
    {
        var low = 0;
        var high = points.Count - 1;
        while (low <= high)
        {
            var middle = low + (high - low) / 2;
            if (points[middle].LapPercent < percent) low = middle + 1;
            else high = middle - 1;
        }
        if (low <= 0) return 0;
        if (low >= points.Count) return points.Count - 1;
        return Math.Abs(points[low].LapPercent - percent) < Math.Abs(points[low - 1].LapPercent - percent) ? low : low - 1;
    }
    private bool SignalRecordedInRace(AnalysisTraceSignalDefinition signal)
    {
        var key = $"race|{signal.Id}";
        if (_signalAvailabilityCache.TryGetValue(key, out var cached)) return cached;
        return _signalAvailabilityCache[key] = Workspace.Traces.Any(trace => trace.Points.Any(point => SignalPointValue(signal, trace, point).HasValue));
    }
    private bool HasSignalData(AnalysisTraceSignalDefinition signal)
    {
        var key = $"selected|{SelectionSignature}|{signal.Id}";
        if (_signalAvailabilityCache.TryGetValue(key, out var cached)) return cached;
        return _signalAvailabilityCache[key] = SelectedTraces.Any(trace => trace.Points.Any(point => SignalPointValue(signal, trace, point).HasValue));
    }
    private double? SignalPointValue(AnalysisTraceSignalDefinition signal, AnalysisLapTrace trace, AnalysisTracePoint point) => signal.Id switch
    {
        "speed" => point.SpeedMph,
        "delta" => TimeDelta(trace, point),
        "throttle" => point.Throttle,
        "brake" => point.Brake,
        "tire-wear" => _calculatedWearByPoint.GetValueOrDefault(point),
        "gear" => point.Gear,
        "rpm" => point.Rpm,
        "steering" => point.SteeringRadians * 180 / Math.PI,
        "slip" => point.SlipAngleDegrees,
        "yaw" => point.YawRateDegreesPerSecond,
        "lateral-g" => point.LateralG,
        "longitudinal-g" => point.LongitudinalG,
        _ => point.AdditionalSignals is { } additional && additional.TryGetValue(signal.Id, out var value) && double.IsFinite(value)
            ? value
            : null
    };
    private double? TimeDelta(AnalysisLapTrace trace, AnalysisTracePoint point)
    {
        if (_timeDeltaByPoint.TryGetValue(point, out var cached)) return cached;
        if (!point.SessionTimeSeconds.HasValue) return _timeDeltaByPoint[point] = null;
        var traceStart = TraceStartTime(trace);
        var reference = ReferenceTrace;
        var referencePoint = Nearest(reference, point.LapPercent);
        var referenceStart = TraceStartTime(reference);
        if (!traceStart.HasValue || referencePoint?.SessionTimeSeconds is not double referenceTime || !referenceStart.HasValue)
            return _timeDeltaByPoint[point] = null;
        return _timeDeltaByPoint[point] =
            (point.SessionTimeSeconds.Value - traceStart.Value) - (referenceTime - referenceStart.Value);
    }
    private double? TraceStartTime(AnalysisLapTrace trace)
    {
        if (_traceStartTimeByLap.TryGetValue(trace.Lap, out var cached)) return cached;
        return _traceStartTimeByLap[trace.Lap] =
            trace.Points.FirstOrDefault(item => item.SessionTimeSeconds.HasValue)?.SessionTimeSeconds;
    }
