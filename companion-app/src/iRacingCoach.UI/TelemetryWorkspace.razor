    private void CleanLapFilterChanged(ChangeEventArgs args)
    {
        CleanLapsOnly = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        ApplyLapFilters();
    }
    private void GreenLapFilterChanged(ChangeEventArgs args)
    {
        GreenLapsOnly = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        ApplyLapFilters();
    }
    private bool PassesLapFilters(AnalysisLapTrace trace) =>
        (!CleanLapsOnly || IsClean(trace)) && (!GreenLapsOnly || IsGreenLap(trace));
    private void ApplyLapFilters()
    {
        Selected.RemoveWhere(lap => Workspace.Traces.FirstOrDefault(trace => trace.Lap == lap) is not { } trace || !PassesLapFilters(trace));
        if (SpotlightLap is { } spotlight && !Selected.Contains(spotlight)) SpotlightLap = null;
        if (Selected.Count == 0)
        {
            var fastestEligible = Workspace.Traces.Where(PassesLapFilters).Where(HasUsableLapTime).OrderBy(trace => trace.LapTimeSeconds).ThenBy(trace => trace.Lap).FirstOrDefault();
            if (fastestEligible is not null) Selected.Add(fastestEligible.Lap);
        }
        InvalidateTraceRender();
    }
    private void ResetSelection()
    {
        SpotlightLap = null;
        SpotlightMenuOpen = false;
        Selected.Clear();
        foreach (var trace in Workspace.Traces.Where(IsClean).Where(HasUsableLapTime).OrderBy(trace => trace.LapTimeSeconds!.Value).ThenBy(trace => trace.Lap).Take(3))
            Selected.Add(trace.Lap);
        if (Selected.Count == 0)
            foreach (var trace in Workspace.Traces.Where(HasUsableLapTime).OrderBy(trace => trace.LapTimeSeconds!.Value).ThenBy(trace => trace.Lap).Take(3))
                Selected.Add(trace.Lap);
        InvalidateTraceRender();
    }

