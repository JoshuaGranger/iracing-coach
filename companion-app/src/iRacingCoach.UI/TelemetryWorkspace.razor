    private void BeginTraceSignalDrag(string signalId)
    {
        if (AnalysisTraceLayouts.Signal(signalId) is null) return;
        _draggedTraceSignalId = signalId;
        _activeTraceDropRowId = null;
        _activeTraceDropSlot = null;
        _traceDropFeedback = null;
        _traceDropRejected = false;
    }
    private void EndTraceSignalDrag()
    {
        _draggedTraceSignalId = null;
        _activeTraceDropRowId = null;
        _activeTraceDropSlot = null;
    }
    private void EnterTraceDropTarget(string rowId, TraceDropSlot slot)
    {
        if (_draggedTraceSignalId is null) return;
        _activeTraceDropRowId = rowId;
