    private async Task ShowIncidentPopover(MouseEventArgs args, int lap) =>
        await ShowIncidentPopoverAt(args.ClientX, args.ClientY, lap);
    private async Task ShowIncidentPopoverFromFocus(int lap)
    {
        var rect = await InteropArrayOrEmptyAsync("iracingCoach.activeElementRect");
        var x = rect.Length >= 4 ? rect[2] : 24;
        var y = rect.Length >= 4 ? (rect[1] + rect[3]) / 2 : 120;
        await ShowIncidentPopoverAt(x, y, lap);
    }
    private async Task ShowIncidentPopoverAt(double clientX, double clientY, int lap)
    {
        if (LapIncidents(lap).Count == 0) return;
        ActiveIncidentLap = lap;
        IncidentPopoverX = 12;
        IncidentPopoverY = 12;
        IncidentPopoverAbove = false;
        IncidentPopoverLeft = false;
        await InvokeAsync(StateHasChanged);

        var viewport = await InteropArrayOrEmptyAsync("iracingCoach.viewportSize");
        if (ActiveIncidentLap != lap || viewport.Length < 2) return;
        var width = Math.Max(320, viewport[0]);
        var height = Math.Max(240, viewport[1]);
        var x = double.IsFinite(clientX) && clientX > 0 ? clientX : 24;
        var y = double.IsFinite(clientY) && clientY > 0 ? clientY : 120;
        const double popoverWidth = 330;
        IncidentPopoverLeft = x + popoverWidth + 24 > width;
        IncidentPopoverX = Math.Clamp(x + (IncidentPopoverLeft ? -12 : 12), 12, width - 12);
        IncidentPopoverAbove = y > height / 2;
        IncidentPopoverY = Math.Clamp(y + (IncidentPopoverAbove ? -12 : 12), 12, height - 12);
        await InvokeAsync(StateHasChanged);
    }
