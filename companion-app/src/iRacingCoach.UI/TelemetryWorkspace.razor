    private string CursorInteropSignature => string.Join('|',
        _analysisId,
        SelectionSignature,
        F(_chartWidth),
        Workspace.Traces.Sum(trace => trace.Points.Count),
        string.Join(',', TraceRows.Select(row => row.Signature)));
    private object BuildCursorInteropConfiguration()
    {
        var panels = TraceRows;
        var availableSignals = panels
            .Select(panel => panel.Signals.Where(HasSignalData).ToArray())
            .ToArray();
        var traces = SelectedTraces.ToArray();
        var rows = panels.Select((panel, index) => new
        {
            top = ChartTop + index * ChartRowHeight,
            plotHeight = ChartPlotHeight,
            signals = availableSignals[index].Select(signal =>
            {
                var range = SignalRange(signal);
                return new
                {
                    id = signal.Id,
                    shortLabel = signal.ShortLabel,
                    minimum = InteropNumber(range.Min) ?? -.5,
                    maximum = InteropNumber(range.Max) ?? .5
                };
            }).ToArray()
        }).ToArray();
        var traceData = traces.Select(trace =>
        {
            var points = trace.Points.ToArray();
            return new
            {
                lap = trace.Lap,
                color = LapColor(trace.Lap),
                percents = points.Select(point => double.IsFinite(point.LapPercent) ? Math.Clamp(point.LapPercent, 0, 1) : 0).ToArray(),
                rowValues = availableSignals.Select(signals => signals.Select(signal =>
                    points.Select((_, pointIndex) => InteropNumber(SmoothedValue(signal, trace, pointIndex))).ToArray()).ToArray()).ToArray(),
                summary = new
                {
                    speed = points.Select(point => InteropNumber(point.SpeedMph)).ToArray(),
                    throttle = points.Select(point => InteropNumber(point.Throttle)).ToArray(),
                    brake = points.Select(point => InteropNumber(point.Brake)).ToArray(),
                    delta = points.Select(point => InteropNumber(TimeDelta(trace, point))).ToArray()
                }
            };
        }).ToArray();
        return new
        {
            key = CursorInteropSignature,
            initialFraction = Cursor,
            elementWidth = _chartWidth,
            chartHeight = ChartHeight,
            plotLeft = PlotLeft,
            plotWidth = PlotWidth,
            chartTop = ChartTop,
            chartBottom = ChartBottom,
            tooltipCapacity = TooltipCapacity,
            tooltipRowHeight = TooltipRowHeight,
            tooltipCharacterWidth = TooltipCharacterWidth,
            rows,
            traces = traceData,
            trackPoints = Workspace.TrackShape.Count >= 3
                ? MapPoints.Select(point => new { percent = point.Percent, x = point.X, y = point.Y }).ToArray()
                : [],
            distanceStrip = Workspace.TrackShape.Count < 3
        };
    }
    private static double? InteropNumber(double? value) => value is { } number && double.IsFinite(number) ? number : null;
    private async Task TrackMoved(MouseEventArgs args)
    {
        if (_trackMovePending) return;
        _trackMovePending = true;
        try
        {
            var pointer = await JS.InvokeAsync<double[]>("iracingCoach.pointerViewBox", TrackElement, args.ClientX, args.ClientY, 420, 280);
            if (Workspace.TrackShape.Count < 3) { Cursor = Math.Clamp((pointer[0] - 28) / 364d, 0, 1); return; }
            Cursor = ProjectedMapPercent(pointer[0], pointer[1]);
        }
        finally { _trackMovePending = false; }
    }

    private IReadOnlyList<MapPoint> MapPoints
    {
        get
        {
            var minX = Workspace.TrackShape.Min(p => p.X); var maxX = Workspace.TrackShape.Max(p => p.X);
            var minY = Workspace.TrackShape.Min(p => p.Y); var maxY = Workspace.TrackShape.Max(p => p.Y);
            var scale = Math.Min(350 / Math.Max(.0001, maxX - minX), 218 / Math.Max(.0001, maxY - minY));
            return Workspace.TrackShape.OrderBy(p => p.LapPercent).Select(p => new MapPoint(WrapPercent(p.LapPercent), 210 + (p.X - (minX + maxX) / 2) * scale, 140 - (p.Y - (minY + maxY) / 2) * scale)).ToArray();
        }
    }
    private string TrackViewBox
    {
        get
        {
            if (Workspace.TrackShape.Count < 3) return "0 0 420 280";
            var points = MapPoints;
            const double padding = 18;
            var minX = points.Min(point => point.X) - padding;
            var minY = points.Min(point => point.Y) - padding;
            var width = points.Max(point => point.X) - points.Min(point => point.X) + padding * 2;
            var height = points.Max(point => point.Y) - points.Min(point => point.Y) + padding * 2;
            return $"{F(minX)} {F(minY)} {F(width)} {F(height)}";
        }
    }
    private MapPoint CursorMapPoint => MapPointAt(Cursor);
    private IEnumerable<MapSegment> MapSegments
    {
        get
        {
            var points = MapPoints;
            for (var index = 0; index < points.Count; index++)
            {
                var a = points[index]; var b = points[(index + 1) % points.Count];
                yield return new MapSegment(a, b, MetricColor(MetricAt(SegmentPercent(a.Percent, b.Percent, .5))));
            }
        }
    }
    private double ProjectedMapPercent(double pointerX, double pointerY)
    {
        var points = MapPoints;
        var bestDistance = double.MaxValue;
        var bestPercent = Cursor;
        for (var index = 0; index < points.Count; index++)
        {
            var a = points[index];
            var b = points[(index + 1) % points.Count];
            var dx = b.X - a.X;
            var dy = b.Y - a.Y;
            var lengthSquared = dx * dx + dy * dy;
            var t = lengthSquared <= .000001 ? 0 : Math.Clamp(((pointerX - a.X) * dx + (pointerY - a.Y) * dy) / lengthSquared, 0, 1);
            var projectedX = a.X + dx * t;
            var projectedY = a.Y + dy * t;
            var distance = Math.Pow(pointerX - projectedX, 2) + Math.Pow(pointerY - projectedY, 2);
            if (distance >= bestDistance) continue;
            bestDistance = distance;
            bestPercent = SegmentPercent(a.Percent, b.Percent, t);
        }
        return bestPercent;
    }
    private MapPoint MapPointAt(double percent)
    {
        var points = MapPoints;
        if (points.Count == 0) return new MapPoint(WrapPercent(percent), 210, 140);
        var target = WrapPercent(percent);
        for (var index = 0; index < points.Count; index++)
        {
            var a = points[index];
            var b = points[(index + 1) % points.Count];
            var start = a.Percent;
            var end = b.Percent <= start ? b.Percent + 1 : b.Percent;
            var adjustedTarget = target < start ? target + 1 : target;
            if (adjustedTarget > end + .000001) continue;
            var t = Math.Abs(end - start) < .000001 ? 0 : (adjustedTarget - start) / (end - start);
            return new MapPoint(target, a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t);
        }
        return points.MinBy(point => CircularDistance(point.Percent, target))!;
    }
    private static double SegmentPercent(double start, double end, double t)
    {
        var adjustedEnd = end <= start ? end + 1 : end;
        return WrapPercent(start + (adjustedEnd - start) * t);
    }
    private static double WrapPercent(double value)
    {
        var wrapped = value % 1;
        return wrapped < 0 ? wrapped + 1 : wrapped;
    }
    private static double CircularDistance(double first, double second)
    {
        var distance = Math.Abs(first - second);
        return Math.Min(distance, 1 - distance);
    }
    private IEnumerable<StripSegment> StripSegments
    {
        get
        {
            const int count = 80;
            for (var index = 0; index < count; index++)
            {
                var start = index / (double)count; var end = (index + 1) / (double)count;
                yield return new StripSegment(28 + start * 364, 28 + end * 364, MetricColor(MetricAt((start + end) / 2)));
            }
        }
    }
    private double? MetricAt(double percent)
    {
        var sample = AverageAt(percent);
        return Mode switch { "throttle" => sample.Throttle, "brake" => sample.Brake, "steering" => sample.SteeringRadians, "stress" => sample.TireStress, _ => sample.SpeedMph };
    }
    private string MetricColor(double? value)
    {
        if (value is null) return "#56616D";
        var (minimum, maximum) = TrackMetricRange();
        var plottedValue = Mode == "steering" ? Math.Abs(value.Value) : value.Value;
        var normalized = Math.Clamp((plottedValue - minimum) / Math.Max(.000001, maximum - minimum), 0, 1);
        normalized = Math.Pow(normalized, .72);
        if (Mode != "speed" && normalized < .015) return "#222A33";
        return Mode switch
        {
            "speed" => HeatmapColor(normalized, SpeedHeatmapStops),
            "brake" => $"hsl({F(18 - normalized * 16)} {F(76 + normalized * 20)}% {F(33 + normalized * 31)}%)",
            "throttle" => $"hsl({F(160 - normalized * 25)} {F(70 + normalized * 24)}% {F(31 + normalized * 32)}%)",
            "steering" => $"hsl({F(302 - normalized * 34)} {F(72 + normalized * 22)}% {F(34 + normalized * 31)}%)",
            "stress" => $"hsl({F(58 - normalized * 53)} {F(78 + normalized * 18)}% {F(34 + normalized * 30)}%)",
            _ => "#75AFFF"
        };
    }
    private static string HeatmapColor(double normalized, IReadOnlyList<HeatStop> stops)
    {
        var amount = Math.Clamp(normalized, 0, 1);
        var upperIndex = 1;
        while (upperIndex < stops.Count - 1 && amount > stops[upperIndex].Position) upperIndex++;
        var lower = stops[Math.Max(0, upperIndex - 1)];
        var upper = stops[upperIndex];
        var blend = Math.Abs(upper.Position - lower.Position) < .000001 ? 0 : (amount - lower.Position) / (upper.Position - lower.Position);
        var red = (int)Math.Round(lower.Red + (upper.Red - lower.Red) * blend);
        var green = (int)Math.Round(lower.Green + (upper.Green - lower.Green) * blend);
        var blue = (int)Math.Round(lower.Blue + (upper.Blue - lower.Blue) * blend);
        return $"rgb({red} {green} {blue})";
    }
    private (double Min, double Max) TrackMetricRange()
    {
        var key = $"{Mode}|{SelectionSignature}";
        if (_trackRangeCache.TryGetValue(key, out var cached)) return cached;
        if (Mode is "throttle" or "brake" or "stress") return _trackRangeCache[key] = (0, 1);
        if (Mode == "steering")
        {
            var maximum = SelectedTraces.SelectMany(trace => trace.Points)
                .Select(point => point.SteeringPeakRadians).Where(value => value.HasValue)
                .Select(value => Math.Abs(value!.Value)).DefaultIfEmpty(.55).Max();
            return _trackRangeCache[key] = (0, Math.Max(.05, maximum));
        }
        var values = SelectedTraces.SelectMany(trace => trace.Points).Select(point => point.SpeedMph)
            .Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        if (values.Length == 0) return _trackRangeCache[key] = (0, 180);
        var min = values.Min();
        var max = values.Max();
        if (max - min < 5) { min -= 2.5; max += 2.5; }
        return _trackRangeCache[key] = (min, max);
    }
    private AggregateSample AverageAt(double percent)
    {
        var samples = SelectedTraces
            .Select(trace => new { Trace = trace, Point = Nearest(trace, percent) })
            .Where(sample => sample.Point is not null)
            .ToArray();
        if (samples.Length == 0) return new AggregateSample(0, null, null, null, null, null, null);
        return new AggregateSample(
            samples.Length,
            Average(samples.Select(sample => sample.Point!.SpeedMph)),
            Average(samples.Select(sample => sample.Point!.Throttle)),
            Average(samples.Select(sample => sample.Point!.Brake)),
            Average(samples.Select(sample => sample.Point!.SteeringPeakRadians)),
            Average(samples.Select(sample => sample.Point!.TireStressProxy)),
            Average(samples.Select(sample => TimeDelta(sample.Trace, sample.Point!))));
    }
    private static double? Average(IEnumerable<double?> values)
    {
        var recorded = values.Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        return recorded.Length == 0 ? null : recorded.Average();
    }
    private static AnalysisTracePoint? Nearest(AnalysisLapTrace trace, double percent)
    {
        var points = trace.Points;
        if (points.Count == 0) return null;
        return points[NearestIndex(points, percent)];
    }
    private static int NearestIndex(IReadOnlyList<AnalysisTracePoint> points, double percent)
    {
        var low = 0;
        var high = points.Count - 1;
        while (low <= high)
        {
            var middle = low + (high - low) / 2;
            if (points[middle].LapPercent < percent) low = middle + 1;
            else high = middle - 1;
        }
        if (low <= 0) return 0;
        if (low >= points.Count) return points.Count - 1;
        return Math.Abs(points[low].LapPercent - percent) < Math.Abs(points[low - 1].LapPercent - percent) ? low : low - 1;
    }
    private bool SignalRecordedInRace(AnalysisTraceSignalDefinition signal)
    {
        var key = $"race|{signal.Id}";
        if (_signalAvailabilityCache.TryGetValue(key, out var cached)) return cached;
        return _signalAvailabilityCache[key] = Workspace.Traces.Any(trace => trace.Points.Any(point => SignalPointValue(signal, trace, point).HasValue));
    }
    private bool HasSignalData(AnalysisTraceSignalDefinition signal)
    {
        var key = $"selected|{SelectionSignature}|{signal.Id}";
        if (_signalAvailabilityCache.TryGetValue(key, out var cached)) return cached;
        return _signalAvailabilityCache[key] = SelectedTraces.Any(trace => trace.Points.Any(point => SignalPointValue(signal, trace, point).HasValue));
    }
    private double? SignalPointValue(AnalysisTraceSignalDefinition signal, AnalysisLapTrace trace, AnalysisTracePoint point) => signal.Id switch
    {
        "speed" => point.SpeedMph,
        "delta" => TimeDelta(trace, point),
        "throttle" => point.Throttle,
        "brake" => point.Brake,
        "tire-wear" => _calculatedWearByPoint.GetValueOrDefault(point),
        "gear" => point.Gear,
        "rpm" => point.Rpm,
        "steering" => point.SteeringRadians * 180 / Math.PI,
        "slip" => point.SlipAngleDegrees,
        "yaw" => point.YawRateDegreesPerSecond,
        "lateral-g" => point.LateralG,
        "longitudinal-g" => point.LongitudinalG,
        _ => null
    };
    private double? TimeDelta(AnalysisLapTrace trace, AnalysisTracePoint point)
    {
        if (!point.SessionTimeSeconds.HasValue) return null;
        var traceStart = trace.Points.FirstOrDefault(item => item.SessionTimeSeconds.HasValue)?.SessionTimeSeconds;
        var reference = ReferenceTrace;
        var referencePoint = Nearest(reference, point.LapPercent);
        var referenceStart = reference.Points.FirstOrDefault(item => item.SessionTimeSeconds.HasValue)?.SessionTimeSeconds;
        if (!traceStart.HasValue || referencePoint?.SessionTimeSeconds is not double referenceTime || !referenceStart.HasValue) return null;
        return (point.SessionTimeSeconds.Value - traceStart.Value) - (referenceTime - referenceStart.Value);
    }
    private string RowLabel(TracePanelRow panel)
    {
        var available = panel.Signals.Where(HasSignalData).ToArray();
        var labels = available.Length > 0 ? available : panel.Signals;
        return string.Join(" / ", labels.Select(signal => signal.Name));
    }
    private string RowSubtitle(TracePanelRow panel)
    {
        var available = panel.Signals.Where(HasSignalData).ToArray();
        var missing = panel.Signals.Where(signal => !HasSignalData(signal)).ToArray();
        if (available.Length == 0) return "No selected-lap values";
        var scales = available.Length > 1
            ? $"solid {available[0].ShortLabel} ({available[0].Unit}) · dashed {available[1].ShortLabel} ({available[1].Unit}) · independent scales"
            : available[0].Unit;
        return missing.Length > 0 ? $"{scales} · {string.Join(", ", missing.Select(signal => signal.ShortLabel))} not recorded" : scales;
    }
    private (double Min, double Max) SignalRange(AnalysisTraceSignalDefinition signal)
    {
        var key = $"{SelectionSignature}|{signal.Id}";
        if (_traceRangeCache.TryGetValue(key, out var cached)) return cached;
        var values = SelectedTraces.SelectMany(trace => trace.Points.Select(point => SignalPointValue(signal, trace, point)))
            .Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        if (values.Length == 0) return (-.5, .5);
        if (signal.Id is "throttle" or "brake") return _traceRangeCache[key] = (0, 1);
        if (signal.Id == "tire-wear") return _traceRangeCache[key] = (0, Math.Max(.01, values.Max() * 1.05));
        if (signal.Id is "delta" or "steering" or "slip" or "yaw")
        {
            var minimumMagnitude = signal.Id == "delta" ? .05 : 1;
            var magnitude = Math.Max(minimumMagnitude, values.Max(value => Math.Abs(value)));
            return _traceRangeCache[key] = (-magnitude, magnitude);
        }
        var min = values.Min(); var max = values.Max();
        if (Math.Abs(max - min) < .0001) { min -= .5; max += .5; }
        return _traceRangeCache[key] = (min, max);
    }
    private string TracePath(AnalysisLapTrace trace, TracePanelRow panel, AnalysisTraceSignalDefinition signal, double top)
    {
        var cacheKey = $"{SelectionSignature}|{panel.Signature}|{signal.Id}|{trace.Lap}|{F(_chartWidth)}|{F(top)}|{F(ChartPlotHeight)}";
        if (_tracePathCache.TryGetValue(cacheKey, out var cached)) return cached;
        if (!trace.Points.Any(point => SignalPointValue(signal, trace, point).HasValue)) return _tracePathCache[cacheKey] = string.Empty;
        var (min, max) = SignalRange(signal);
        var started = false;
        var commands = new List<string>(trace.Points.Count);
        for (var index = 0; index < trace.Points.Count; index++)
        {
            var value = SmoothedValue(signal, trace, index);
            if (!value.HasValue) { started = false; continue; }
            var x = PlotLeft + trace.Points[index].LapPercent * PlotWidth;
            var y = top + ChartPlotHeight - 4 - (value.Value - min) / (max - min) * (ChartPlotHeight - 8);
            commands.Add($"{(started ? "L" : "M")}{F(x)},{F(y)}");
            started = true;
        }
        return _tracePathCache[cacheKey] = string.Join(" ", commands);
    }
    private double? SmoothedValue(AnalysisTraceSignalDefinition signal, AnalysisLapTrace trace, int index)
    {
        var current = SignalPointValue(signal, trace, trace.Points[index]);
        if (!current.HasValue || signal.Id is "gear" or "tire-wear") return current;
        var neighborWeight = signal.Id is "throttle" or "brake" ? .10 : .16;
        var currentWeight = 1 - neighborWeight * 2;
        var sum = current.Value * currentWeight;
        var weight = currentWeight;
        if (index > 0 && SignalPointValue(signal, trace, trace.Points[index - 1]) is { } previous) { sum += previous * neighborWeight; weight += neighborWeight; }
        if (index + 1 < trace.Points.Count && SignalPointValue(signal, trace, trace.Points[index + 1]) is { } next) { sum += next * neighborWeight; weight += neighborWeight; }
        return sum / weight;
    }
    private static string LapRange(IReadOnlyList<int> laps) => laps.Count == 0 ? "—" : laps.Count == 1 ? laps[0].ToString() : $"{laps.Min()}–{laps.Max()}";
    private static string PaceTrend(AnalysisRun run) => run.PaceSlopeSecondsPerLap is null ? "—" : run.PaceSlopeSecondsPerLap > .005 ? $"+{run.PaceSlopeSecondsPerLap:0.000} s/lap" : run.PaceSlopeSecondsPerLap < -.005 ? $"{run.PaceSlopeSecondsPerLap:0.000} s/lap" : "Stable";
