@using System.Globalization
@using static iRacingCoach.UI.InvestigationPresentation

<section class="ri-view" data-ri-view="@View" aria-label="Race investigation">
    @if (Investigation.UnavailableReason is { } reason)
    {
        <div class="ri-empty ri-panel"><strong>This investigation could not be read</strong><span>@reason</span>
            @if (OnRefresh.HasDelegate) { <button type="button" class="ri-button" @onclick="() => OnRefresh.InvokeAsync()">Refresh analysis</button> }</div>
    }
    else if (View == "runs")
    {
        @if (Investigation.Runs is null)
        {
            <LegacyNotice OnRefresh="OnRefresh" />
        }
        else
        {
            <div class="ri-panel ri-fill"><RunOverlayChart Investigation="Investigation" Selected="Selected" /></div>
        }
    }
    else if (View == "sections")
    {
        @if (!Investigation.HasSectionInspection || Selected?.Inspection is null)
        {
            @if (Investigation.Runs is null) { <LegacyNotice OnRefresh="OnRefresh" /> }
            else { <div class="ri-empty ri-panel"><strong>No track sections to inspect</strong><span>@(Investigation.Sections?.UnavailableReason ?? "Select a comparison with recorded traces.")</span></div> }
        }
        else
        {
            var section = SelectedSection;
            var action = section is null ? null : Selected.Actions.FirstOrDefault(item => item.SectionId == section.Id);
            <SectionInspectionPanel Pair="SelectedPair" SectionLabel="@(section?.Label ?? "")" Sections="SectionChoices"
                                    SelectedSectionId="@section?.Id" OnSelectSection="SelectSection" Geometry="Geometry"
                                    ModeNote="@ModeNote" EmptyDetail="@PairUnavailable">
                <Footer>
                    <div class="ri-test-strip">
                        @if (action is not null)
                        {
                            <TrialAction Action="action" ComparisonId="@Selected.Id" Eligibility="@Selected.Eligibility" State="State" AnalysisId="@AnalysisId" Compact="true" />
                        }
                        else
                        {
                            <span class="ri-muted">No test is suggested for section @section?.Label in this comparison.</span>
                        }
                        <button type="button" class="ri-link" @onclick="OpenTracesForSection">Open in Traces</button>
                    </div>
                </Footer>
            </SectionInspectionPanel>
        }
    }
    else
    {
        <div class="ri-race-view">
            <div class="ri-panel ri-fill"><RaceProgressionChart Investigation="Investigation" Selected="Selected" /></div>
            <div class="ri-race-bottom">
                <nav class="ri-panel ri-comparisons" aria-label="Pace comparisons">
                    <div class="ri-panel-label"><strong>Comparisons</strong><span>Later − earlier, median</span></div>
                    @foreach (var choice in Investigation.Comparisons)
                    {
                        var selected = choice.Id == Selected?.Id;
                        <button type="button" class="ri-comparison @(selected ? "selected" : null)" aria-pressed="@(selected ? "true" : "false")"
                                data-comparison="@choice.Id" title="@(choice.PaceComparable ? null : choice.Summary)" @onclick="() => SelectComparison(choice.Id)">
                            <span class="ri-comparison-title">@choice.Title</span>
                            <span class="ri-comparison-laps">@Laps(choice.Baseline.LapNumbers) → @Laps(choice.Compared.LapNumbers)@if (!choice.PaceComparable) { <em> · no pace result</em> } else if (choice.Eligibility != "eligible") { <em> · @ExcludedSummary(choice)</em> }</span>
                            <strong class="@PaceTone(choice)">@(HasPaceResult(choice) ? Signed(choice.DeltaSeconds) : "—")</strong>
                        </button>
                    }
                    @if (Investigation.Comparisons.Count == 0) { <p class="ri-muted">@Investigation.Summary</p> }
                </nav>
                @if (Selected is { } comparison)
                {
                    <section class="ri-panel ri-card" data-selected-comparison="@comparison.Id">
                        <header><h2>@comparison.Title</h2><strong class="@PaceTone(comparison)">@PaceResult(comparison)</strong></header>
                        @if (!comparison.PaceComparable)
                        {
                            <p class="ri-unusable" data-pace-unusable>@comparison.Summary</p>
                        }
                        <div class="ri-cohorts">
                            @foreach (var (cohort, role) in new[] { (comparison.Baseline, "Earlier"), (comparison.Compared, "Later") })
                            {
                                <div class="ri-cohort">
                                    <span class="ri-role"><svg width="14" height="8" aria-hidden="true"><line x1="0" y1="4" x2="14" y2="4" stroke="@RunColor(cohort.RunNumber)" stroke-width="2.5" stroke-dasharray="@RunDash(cohort.RunNumber)" /></svg>@role</span>
                                    <b>@CohortIdentity(cohort)</b>
                                    <span>@CohortExposure(cohort)</span>
                                    <span>@(cohort.FuelStartGallons is { } fuel ? fuel.ToString("0.0", CultureInfo.CurrentCulture) + " gal" : "fuel —")</span>
                                    <span>@(cohort.TrackTemperatureF is { } temperature ? temperature.ToString("0", CultureInfo.CurrentCulture) + " °F track" : "track °F —")</span>
                                    <span class="ri-median">@LapTime(cohort.MedianLapSeconds) s</span>
                                    @if (cohort.ExcludedLaps.Count > 0)
                                    {
                                        <small class="ri-excluded" title="@string.Join("; ", cohort.ExcludedLaps.Select(lap => $"Lap {lap.Lap}: {Reasons(lap.Reasons)}"))">@cohort.ExcludedLaps.Count excluded: @Reasons(cohort.ExcludedLaps.SelectMany(lap => lap.Reasons).ToArray())</small>
                                    }
                                </div>
                            }
                        </div>
                        @if (Changes(comparison) is { Count: > 0 } changes)
                        {
                            <div class="ri-changes"><span>Changed</span>@foreach (var metric in changes) { <b title="@metric.Detail">@metric.Label @Number(metric.Baseline, Digits(metric.Unit)) → @Number(metric.Compared, Digits(metric.Unit)) @metric.Unit</b> }</div>
                        }
                        @if (comparison.PaceComparable && comparison.Hypotheses.Count > 0)
                        {
                            <div class="ri-explanations">
                                <span>Explanations</span>
                                @foreach (var hypothesis in comparison.Hypotheses)
                                {
                                    <b class="ri-hypothesis @hypothesis.Status" title="@HypothesisTitle(hypothesis)">@hypothesis.Label<small>@HypothesisStatus(hypothesis.Status)</small></b>
                                }
                                <details><summary>Evidence</summary>
                                    @foreach (var hypothesis in comparison.Hypotheses)
                                    {
                                        <p><b>@hypothesis.Label.</b> @string.Join(" ", hypothesis.Supporting.Concat(hypothesis.Contradicting).Concat(hypothesis.Unknown))</p>
                                    }
                                    @if (Investigation.TrackEvolution is { } track) { <p><b>Track.</b> @track.Summary</p> }
                                </details>
                            </div>
                        }
                        @if (comparison.Actions.OrderBy(item => item.Priority).FirstOrDefault() is { } lead)
                        {
                            <TrialAction Action="lead" ComparisonId="@comparison.Id" Eligibility="@comparison.Eligibility" State="State" AnalysisId="@AnalysisId"
                                         OnInspect="() => InspectAction(lead)" />
                        }
                    </section>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public RaceInvestigation Investigation { get; set; } = null!;
    [Parameter] public AnalysisTrackGeometry? Geometry { get; set; }
    [Parameter] public CompanionState? State { get; set; }
    [Parameter] public string AnalysisId { get; set; } = "";
    [Parameter] public string View { get; set; } = "race";
    [Parameter] public string? ComparisonId { get; set; }
    [Parameter] public string? SectionId { get; set; }
    [Parameter] public EventCallback<(string View, string? ComparisonId, string? SectionId)> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<RaceInvestigationInspection> OnOpenTraces { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private RaceInvestigationComparison? Selected =>
        Investigation.Comparisons.FirstOrDefault(item => item.Id == ComparisonId)
        ?? Investigation.Comparisons.FirstOrDefault(item => item.Id == Investigation.DefaultComparisonId)
        ?? Investigation.Comparisons.FirstOrDefault();

    private RaceReviewSection? SelectedSection
    {
        get
        {
            var sections = Investigation.Sections?.Sections ?? [];
            var pairs = Selected?.Inspection?.Sections;
            return sections.FirstOrDefault(section => section.Id == SectionId)
                ?? sections.FirstOrDefault(section => section.Id == Selected?.Actions.OrderBy(action => action.Priority).FirstOrDefault(action => action.SectionId is not null)?.SectionId)
                ?? sections.FirstOrDefault(section => section.Id == Selected?.Corners.FirstOrDefault()?.Id)
                ?? sections.FirstOrDefault(section => pairs?.ContainsKey(section.Id) == true)
                ?? sections.FirstOrDefault();
        }
    }

    private RacePassPair? SelectedPair => SelectedSection is { } section && Selected?.Inspection?.Sections.TryGetValue(section.Id, out var pair) == true ? pair : null;

    private string PairUnavailable => SelectedSection is null ? "" : "Too few laps in this comparison have complete timing across the section and its approach.";

    private IReadOnlyList<SectionInspectionPanel.SectionChoice> SectionChoices =>
        (Investigation.Sections?.Sections ?? []).Select(section =>
        {
            var corner = Selected?.Corners.FirstOrDefault(item => item.Id == section.Id);
            var title = $"{section.Provenance} {(corner is null ? "Not enough covered laps for a group median." : $"{corner.BaselineCount} earlier and {corner.ComparedCount} later laps.")}";
            return new SectionInspectionPanel.SectionChoice(section.Id, section.Label, section.StartPct, section.EndPct, corner?.DeltaSeconds,
                section.BoundaryStatus == "driver_confirmed_grouping", title.Trim());
        }).ToArray();

    private string ModeNote => Selected?.Inspection is not { } inspection ? ""
        : inspection.Mode == "matched_pool_extremes"
            ? $"Fastest and slowest pass of the {inspection.PoolLaps.Count} compared laps"
            : "Median pass of each group";

    private Task Notify(string view, string? comparison, string? section) =>
        OnSelectionChanged.InvokeAsync((view, comparison, section));

    private Task SelectComparison(string id) => Notify(View, id, SectionId);
    private Task SelectSection(string id) => Notify("sections", Selected?.Id, id);

    private Task InspectAction(RaceInvestigationAction action) =>
        action.SectionId is { } section ? Notify("sections", Selected?.Id, section) : OnOpenTraces.InvokeAsync(new RaceInvestigationInspection(action.LapNumbers, action.StartPct, action.EndPct, action.SignalKeys));

    private Task OpenTracesForSection()
    {
        if (SelectedPair is not { } pair) return Task.CompletedTask;
        return OnOpenTraces.InvokeAsync(new RaceInvestigationInspection(new[] { pair.A.Lap, pair.B.Lap }, pair.ContextStartPct, pair.EndPct,
            ["speed", "throttle", "brake", "steering"]));
    }

    private static string ExcludedSummary(RaceInvestigationComparison comparison)
    {
        var excluded = comparison.Baseline.ExcludedLaps.Concat(comparison.Compared.ExcludedLaps).ToArray();
        var total = comparison.Baseline.LapCount + comparison.Compared.LapCount;
        return $"{excluded.Length} of {total} laps excluded: {Reasons(excluded.SelectMany(lap => lap.Reasons).ToArray())}";
    }

    private static readonly Dictionary<string, double> ChangeThresholds = new()
    {
        ["brake"] = 1, ["throttle"] = 2, ["steering"] = 2, ["corrections"] = 1, ["fuel"] = .5,
        ["track_temperature"] = 1, ["track_usage"] = .1, ["brake_bias"] = .1, ["traffic"] = 1
    };

    private static IReadOnlyList<RaceInvestigationMetric> Changes(RaceInvestigationComparison comparison) => comparison.Metrics
        .Where(metric => metric.Delta is { } delta && ChangeThresholds.TryGetValue(metric.Key, out var threshold) && Math.Abs(delta) >= threshold)
        .Take(5).ToArray();

    private static int Digits(string unit) => unit switch { "gal" => 1, "setting" => 2, "°F" => 0, "%" => 0, "per lap" => 1, _ => 1 };

    private static string HypothesisTitle(RaceInvestigationHypothesis hypothesis) =>
        string.Join("\n", hypothesis.Supporting.Select(text => "+ " + text)
            .Concat(hypothesis.Contradicting.Select(text => "− " + text))
            .Concat(hypothesis.Unknown.Select(text => "? " + text)));
}
