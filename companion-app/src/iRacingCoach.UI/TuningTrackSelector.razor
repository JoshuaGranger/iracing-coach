@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS

<section class="tuning-turn-map" aria-labelledby="tuning-map-heading">
    <header class="tuning-turn-map-header">
        <div>
            <span class="eyebrow">Track feedback</span>
            <h2 id="tuning-map-heading">@Workspace.Track <small>@Workspace.Layout</small></h2>
        </div>
        <div class="tuning-map-source" title="@SourceTitle">
            <span class="status-label @(Resolution.Verified ? "success" : "neutral")">@(Resolution.Verified ? "Map ready" : "Verify turns")</span>
        </div>
    </header>

    <div class="tuning-map-stage">
        @if (Projection.Available)
        {
            <svg @ref="_mapElement"
                 class="tuning-map-svg @(_correctionOpen ? "correction-mode" : null)"
                 viewBox="@Projection.ViewBox"
                 preserveAspectRatio="xMidYMid meet"
                 role="img"
                 aria-label="@MapAccessibleName"
                 @onclick="SetCorrectionFromPointer">
                <path d="@Projection.MainPathData" class="tuning-map-track-halo" />
                <path d="@Projection.MainPathData" class="tuning-map-track" />

                @if (!string.IsNullOrWhiteSpace(Projection.PitLaneData))
                {
                    <path d="@Projection.PitLaneData" class="tuning-map-pit-halo" />
                    <path d="@Projection.PitLaneData" class="tuning-map-pit" />
                }
                @if (!string.IsNullOrWhiteSpace(Projection.PitEntryData))
                {
                    <path d="@Projection.PitEntryData" class="tuning-map-pit-entry" />
                }
                @if (!string.IsNullOrWhiteSpace(Projection.PitExitData))
                {
                    <path d="@Projection.PitExitData" class="tuning-map-pit-exit" />
                }

                @foreach (var turn in Turns)
                {
                    var path = ProgressiveTrackProjection.PathForRange(Projection.MainPath, turn.StartPct, turn.EndPct);
                    var marker = ProgressiveTrackProjection.PointAt(Projection.MainPath, turn.ApexPct);
                    if (!string.IsNullOrWhiteSpace(path))
                    {
                        <path d="@path" class="tuning-turn-segment @TurnStateClass(turn)" aria-hidden="true" />
                        <path d="@path"
                              class="tuning-turn-hit"
                              role="button"
                              tabindex="0"
                              aria-label="@TurnAccessibleName(turn)"
                              aria-pressed="@AriaBoolean(IsSelected(turn))"
                              @onclick="args => HandleTurnClick(args, turn)"
                              @onclick:stopPropagation="true"
                              @onmouseenter="() => Hover(turn.CornerId)"
                              @onmouseleave="ClearHover"
                              @onfocus="() => Hover(turn.CornerId)"
                              @onblur="ClearHover"
                              @onkeydown="args => HandleTurnKeyDown(args, turn)" />
                        <g class="tuning-turn-marker @TurnStateClass(turn)" aria-hidden="true">
                            <circle cx="@F(marker.X)" cy="@F(marker.Y)" r="15" />
                            <svg:text x="@F(marker.X)" y="@F(marker.Y + 4)" text-anchor="middle">@ShortLabel(turn.Label)</svg:text>
                        </g>
                    }
                }

                @if (_correctionOpen && SelectedTurn is not null)
                {
                    @foreach (var handle in CorrectionHandles)
                    {
                        <g class="tuning-correction-handle @(_activeCorrectionHandle == handle.Key ? "active" : null)"
                           role="button"
                           tabindex="0"
                           aria-label="@($"Adjust {handle.Label.ToLowerInvariant()} point")"
                           @onclick="() => ActivateCorrectionHandle(handle.Key)"
                           @onclick:stopPropagation="true"
                           @onkeydown="args => HandleCorrectionKeyDown(args, handle.Key)">
                            <circle cx="@F(handle.Point.X)" cy="@F(handle.Point.Y)" r="12" />
                            <svg:text x="@F(handle.Point.X)" y="@F(handle.Point.Y + 4)" text-anchor="middle">@handle.ShortLabel</svg:text>
                        </g>
                    }
                }

                @if (Projection.StartFinish is { } startFinish)
                {
                    <line x1="@F(startFinish.X1)" y1="@F(startFinish.Y1)" x2="@F(startFinish.X2)" y2="@F(startFinish.Y2)" class="tuning-map-start-halo" />
                    <line x1="@F(startFinish.X1)" y1="@F(startFinish.Y1)" x2="@F(startFinish.X2)" y2="@F(startFinish.Y2)" class="tuning-map-start" />
                }
            </svg>
        }
        else
        {
            <div class="tuning-map-empty">
                <ProductIcon Name="analysis" Size="24" />
                <strong>Track shape unavailable</strong>
                <span>Select a load zone from the list when recorded zones are available.</span>
            </div>
        }

        <div class="tuning-turn-list" role="list" aria-label="Selectable corners and load zones">
            @if (Turns.Count > 0)
            {
                @foreach (var turn in Turns)
                {
                    <button type="button"
                            role="listitem"
                            class="@(IsSelected(turn) ? "selected" : null)"
                            aria-pressed="@AriaBoolean(IsSelected(turn))"
                            title="@TurnAccessibleName(turn)"
                            @onmouseenter="() => Hover(turn.CornerId)"
                            @onmouseleave="ClearHover"
                            @onfocus="() => Hover(turn.CornerId)"
                            @onblur="ClearHover"
                            @onclick="() => Select(turn)">
                        <strong>@turn.Label</strong>
                        <small>@TurnListDetail(turn)</small>
                    </button>
                }
            }
            else
            {
                <span class="tuning-turn-list-empty">No selectable zones</span>
            }
        </div>
    </div>

    <footer class="tuning-map-footer">
        <div class="tuning-map-key" aria-label="Map key">
            <span><i class="pit"></i>Pit road</span>
            <span><i class="entry"></i>Pit entry</span>
            <span><i class="exit"></i>Pit exit</span>
            <span><i class="start"></i>Start / finish</span>
        </div>
        @if (!Resolution.Verified)
        {
            <button type="button" class="text-button tuning-correction-toggle" disabled="@(SelectedTurn is null)" @onclick="OpenCorrection">
                Correct selected zone
            </button>
        }
    </footer>

    @if (_correctionOpen && SelectedTurn is { } correctionTurn)
    {
        <form class="tuning-turn-correction" @onsubmit="SaveCorrection" @onsubmit:preventDefault="true">
            <div class="tuning-correction-heading">
                <div><strong>Verify this turn</strong><small>Saved in your Coach folder.</small></div>
                <button type="button" aria-label="Close correction" @onclick="CloseCorrection"><ProductIcon Name="close" Size="15" /></button>
            </div>
            <p class="tuning-correction-instruction">Click the track for <strong>@CorrectionHandleLabel(_activeCorrectionHandle)</strong>. Select a handle to adjust it again.</p>
            <label>Corner label<input maxlength="48" autocomplete="off" @bind="_correctionLabel" /></label>
            <div class="tuning-boundary-fields">
                <label>Entry <input type="range" min="0" max="99.9" step="0.1" @bind="_correctionStart" @bind:event="oninput" @bind:after="ClearCorrectionError" /><output>@_correctionStart.ToString("0.0")%</output></label>
                <label>Apex <input type="range" min="0" max="99.9" step="0.1" @bind="_correctionApex" @bind:event="oninput" @bind:after="ClearCorrectionError" /><output>@_correctionApex.ToString("0.0")%</output></label>
                <label>Exit <input type="range" min="0" max="99.9" step="0.1" @bind="_correctionEnd" @bind:event="oninput" @bind:after="ClearCorrectionError" /><output>@_correctionEnd.ToString("0.0")%</output></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_correctionError))
            {
                <p class="tuning-correction-error" role="alert">@_correctionError</p>
            }
            <button type="submit" class="button secondary compact" disabled="@string.IsNullOrWhiteSpace(_correctionLabel)">Save correction</button>
        </form>
    }
</section>

@code {
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    [Parameter] public TuningMapView? Map { get; set; }
    [Parameter] public string Selected { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public EventCallback<TuningTurn> TurnSelected { get; set; }
    [Parameter] public Func<ProgressiveTurnCorrectionRequest, Task<bool>>? CorrectionRequested { get; set; }
    [Parameter] public EventCallback<bool> CorrectionModeChanged { get; set; }
    [Parameter] public IReadOnlyList<ProgressiveTuningFeedback> Feedback { get; set; } = [];
    [Parameter] public string ActiveRunPhase { get; set; } = "early";
    [Parameter] public string PriorityCornerId { get; set; } = string.Empty;

    private ProgressiveProjectedTrack Projection { get; set; } = new(false, "Geometry unavailable", "0 0 720 420", [], [], [], [], null);
    private ProgressiveTurnMapResolution Resolution { get; set; } = new("", "telemetry-derived", "Recorded telemetry", null, "low", false, false, "", []);
    private IReadOnlyList<ProgressiveTurnAnnotation> Turns { get; set; } = [];
    private ElementReference _mapElement;
    private string? _hoveredCornerId;
    private bool _correctionOpen;
    private string _correctionLabel = string.Empty;
    private double _correctionStart;
    private double _correctionApex;
    private double _correctionEnd;
    private string _activeCorrectionHandle = "entry";
    private string _correctionError = string.Empty;

    protected override void OnParametersSet()
    {
        Projection = ProgressiveTrackProjection.Create(Workspace);
        Resolution = Map is null ? ProgressiveTurnCatalog.Default.Resolve(Workspace) : FromContract(Map);
        Turns = Resolution.Turns;
        if (SelectedTurn is null) _correctionOpen = false;
    }

    private ProgressiveTurnAnnotation? SelectedTurn => Turns.FirstOrDefault(IsSelected);
    private string? ActiveCornerId => _hoveredCornerId ?? SelectedTurn?.CornerId;
    private string SourceTitle => $"{Resolution.SourceLabel}. {Resolution.StatusMessage}";
    private string MapAccessibleName => $"{Workspace.Track} {Workspace.Layout} track map. {Resolution.StatusMessage}";

    private static ProgressiveTurnMapResolution FromContract(TuningMapView map) => new(
        map.MapIdentity,
        map.SourceType,
        map.SourceLabel,
        map.SourceUrl,
        map.Confidence,
        map.IsVerified,
        false,
        map.IsVerified
            ? "Corner labels verified for this exact configuration."
            : map.VerificationMessage ?? "Corner labels need local verification.",
        map.Turns.Select(turn => new ProgressiveTurnAnnotation(
            turn.CornerId,
            turn.Label,
            turn.StartPct,
            turn.ApexPct,
            turn.EndPct,
            map.SourceType,
            turn.Confidence,
            turn.IsOfficial,
            turn.CorrectionHint,
            turn.UserVerified)).ToArray());

    private bool IsSelected(ProgressiveTurnAnnotation turn) =>
        string.Equals(Selected, turn.CornerId, StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Selected, turn.Label, StringComparison.OrdinalIgnoreCase);

    private string TurnStateClass(ProgressiveTurnAnnotation turn)
    {
        var states = new List<string>();
        if (string.Equals(ActiveCornerId, turn.CornerId, StringComparison.OrdinalIgnoreCase)) states.Add("active");
        if (IsSelected(turn)) states.Add("selected");
        if (!Resolution.Verified && !turn.UserVerified) states.Add("unverified");
        if (string.Equals(PriorityCornerId, turn.CornerId, StringComparison.Ordinal)) states.Add("priority");
        var feedback = ActiveFeedback(turn);
        if (feedback.Count > 0)
        {
            var primary = feedback.Where(item => item.SymptomId is "tight" or "good" or "loose").ToArray();
            var hasTight = primary.Any(item => item.SymptomId == "tight");
            var hasComfortable = primary.Any(item => item.SymptomId == "good");
            var hasLoose = primary.Any(item => item.SymptomId == "loose");
            states.Add(hasTight && hasLoose ? "feedback-mixed"
                : hasTight ? "feedback-tight"
                : hasLoose ? "feedback-loose"
                : hasComfortable ? "feedback-comfortable"
                : "feedback-detail");
            states.Add($"feedback-level-{Math.Clamp(feedback.Max(item => item.Severity), 1, 5)}");
        }
        return string.Join(" ", states);
    }

    private IReadOnlyList<ProgressiveTuningFeedback> ActiveFeedback(ProgressiveTurnAnnotation turn) => Feedback
        .Where(item => string.Equals(item.CornerId, turn.CornerId, StringComparison.Ordinal)
            && string.Equals(item.RunPhase, ActiveRunPhase, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private string TurnListDetail(ProgressiveTurnAnnotation turn)
    {
        var feedback = ActiveFeedback(turn);
        if (feedback.Count == 0) return TurnStatus(turn);
        var details = feedback
            .Where(item => item.SymptomId is "tight" or "good" or "loose")
            .SelectMany(item => (item.CornerPhases.Count == 0 ? ["whole"] : item.CornerPhases)
                .Select(phase => $"{PhaseLabel(phase)} {BalanceLabel(item.SymptomId)}"))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(2)
            .ToArray();
        return details.Length > 0
            ? string.Join(" · ", details)
            : $"{feedback.Count} detail{(feedback.Count == 1 ? string.Empty : "s")}";
    }

    private async Task Select(ProgressiveTurnAnnotation turn)
    {
        Selected = turn.CornerId;
        await SelectedChanged.InvokeAsync(Selected);
        await TurnSelected.InvokeAsync(new TuningTurn(
            turn.CornerId,
            turn.Label,
            turn.StartPct,
            turn.ApexPct,
            turn.EndPct,
            turn.IsOfficial,
            turn.Confidence,
            turn.CorrectionNote,
            turn.UserVerified,
            turn.UserVerified ? "Driver correction" : string.Empty));
    }

    private async Task HandleTurnClick(MouseEventArgs args, ProgressiveTurnAnnotation turn)
    {
        if (_correctionOpen && IsSelected(turn))
        {
            await SetCorrectionFromPointer(args);
            return;
        }
        await Select(turn);
    }

    private async Task HandleTurnKeyDown(KeyboardEventArgs args, ProgressiveTurnAnnotation turn)
    {
        if (args.Key is "Enter" or " ") await Select(turn);
    }

    private void Hover(string cornerId) => _hoveredCornerId = cornerId;
    private void ClearHover() => _hoveredCornerId = null;

    private async Task OpenCorrection()
    {
        if (SelectedTurn is not { } turn) return;
        _correctionLabel = turn.Label;
        _correctionStart = turn.StartPct * 100;
        _correctionApex = turn.ApexPct * 100;
        _correctionEnd = turn.EndPct * 100;
        _activeCorrectionHandle = "entry";
        _correctionError = string.Empty;
        _correctionOpen = true;
        await CorrectionModeChanged.InvokeAsync(true);
    }

    private async Task CloseCorrection()
    {
        _correctionOpen = false;
        _correctionError = string.Empty;
        await CorrectionModeChanged.InvokeAsync(false);
    }

    private void ClearCorrectionError() => _correctionError = string.Empty;

    private IReadOnlyList<CorrectionHandle> CorrectionHandles =>
    [
        new("entry", "Entry", "E", ProgressiveTrackProjection.PointAt(Projection.MainPath, _correctionStart / 100)),
        new("apex", "Apex", "A", ProgressiveTrackProjection.PointAt(Projection.MainPath, _correctionApex / 100)),
        new("exit", "Exit", "X", ProgressiveTrackProjection.PointAt(Projection.MainPath, _correctionEnd / 100))
    ];

    private void ActivateCorrectionHandle(string handle) => _activeCorrectionHandle = handle;

    private void HandleCorrectionKeyDown(KeyboardEventArgs args, string handle)
    {
        if (args.Key is "Enter" or " ") ActivateCorrectionHandle(handle);
    }

    private async Task SetCorrectionFromPointer(MouseEventArgs args)
    {
        if (!_correctionOpen || Projection.MainPath.Count == 0) return;
        _correctionError = string.Empty;
        var coordinates = await JS.InvokeAsync<double[]>("iracingCoach.pointerViewBox", _mapElement, args.ClientX, args.ClientY, 720, 420);
        if (coordinates.Length < 2) return;
        var nearest = Projection.MainPath.MinBy(point => Math.Pow(point.X - coordinates[0], 2) + Math.Pow(point.Y - coordinates[1], 2));
        if (nearest is null) return;
        var value = nearest.Percent * 100;
        switch (_activeCorrectionHandle)
        {
            case "entry":
                _correctionStart = value;
                _activeCorrectionHandle = "apex";
                break;
            case "apex":
                _correctionApex = value;
                _activeCorrectionHandle = "exit";
                break;
            default:
                _correctionEnd = value;
                _activeCorrectionHandle = "entry";
                break;
        }
    }

    private async Task SaveCorrection()
    {
        if (SelectedTurn is not { } turn || string.IsNullOrWhiteSpace(_correctionLabel)) return;
        var start = _correctionStart / 100;
        var apex = _correctionApex / 100;
        var end = _correctionEnd / 100;
        if (!ProgressiveTurnBounds.TryValidate(start, apex, end, out _correctionError)) return;
        var corrected = turn with
        {
            Label = _correctionLabel.Trim(),
            StartPct = start,
            ApexPct = apex,
            EndPct = end,
            SourceType = string.Equals(_correctionLabel.Trim(), turn.Label, StringComparison.Ordinal)
                ? turn.SourceType
                : "verified-manual",
            Confidence = "user-verified",
            IsOfficial = string.Equals(_correctionLabel.Trim(), turn.Label, StringComparison.Ordinal) && turn.IsOfficial,
            CorrectionNote = "Driver-verified local turn label and bounds.",
            UserVerified = true
        };
        if (CorrectionRequested is null || !await CorrectionRequested(new ProgressiveTurnCorrectionRequest(
                Resolution.MapIdentity,
                corrected.CornerId,
                corrected.Label,
                corrected.StartPct,
                corrected.ApexPct,
                corrected.EndPct)))
            return;
        _correctionOpen = false;
        _correctionError = string.Empty;
        await CorrectionModeChanged.InvokeAsync(false);
        await Select(corrected);
    }

    private static string ShortLabel(string label)
    {
        if (label.StartsWith("Turn ", StringComparison.OrdinalIgnoreCase)) return label[5..];
        if (label.StartsWith("Load zone ", StringComparison.OrdinalIgnoreCase)) return $"Z{label[10..]}";
        return label.Length <= 4 ? label : label[..4];
    }

    private string TurnAccessibleName(ProgressiveTurnAnnotation turn) =>
        $"{turn.Label}, {turn.StartPct:P0} to {turn.EndPct:P0}, {TurnListDetail(turn).ToLowerInvariant()}";
    private static string TurnStatus(ProgressiveTurnAnnotation turn) => turn.UserVerified
        ? "Bounds verified"
        : turn.IsOfficial
            ? "Official label · bounds unverified"
            : "Recorded zone · bounds unverified";
    private static string PhaseLabel(string phase) => phase switch
    {
        "entry" => "Entry",
        "center" => "Center",
        "exit" => "Exit",
        _ => "Whole"
    };
    private static string BalanceLabel(string symptom) => symptom == "good" ? "comfortable" : symptom;
    private static string AriaBoolean(bool value) => value ? "true" : "false";
    private static string CorrectionHandleLabel(string handle) => handle switch { "entry" => "entry", "apex" => "apex", _ => "exit" };
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private sealed record CorrectionHandle(string Key, string Label, string ShortLabel, ProgressiveMapPoint Point);
}
