@using System.Globalization
<div class="planning-page plan-compact" data-plan>
    <section class="surface-card planning-setup-card" aria-labelledby="planning-context-title">
        <div class="planning-setup-heading">
            <h1 id="planning-context-title">Plan</h1>
            @if (State.SelectedPlanRace is { } selected)
            {
                <div class="planning-reference-summary">
                    <span>Based on</span>
                    <strong>@selected.Track@(string.IsNullOrWhiteSpace(selected.Layout) ? string.Empty : $" · {selected.Layout}")</strong>
                    <span>@selected.Car</span>
                    <small>@ReferenceFacts(selected)</small>
                </div>
            }
            else
            {
                <p class="planning-reference-missing">No matching recording. Enter fuel use and start fuel below for an estimate.</p>
            }
            <button class="@(State.PlanGenerated ? "button secondary compact" : "button primary compact")" disabled="@(!State.CanBuildPlan)" @onclick="BuildPlan">@(State.PlanBusy ? "Building…" : State.PlanGenerated ? "Rebuild plan" : "Build plan")</button>
        </div>

        <div class="planning-setup-grid">
            <div class="planning-distance-fields">
                <label>Race distance<input type="number" min="1" max="1000" step="@DistanceInputStep" placeholder="Required" value="@DistanceInputValue" @onchange="ChangeDistance" /></label>
                <label><span class="sr-only">Distance unit</span><select aria-label="Distance unit" @bind="State.PlanDistanceMode"><option>Laps</option><option>Minutes</option></select></label>
            </div>
            <label>Green fuel / lap (gal)<input type="number" min="0.001" step="0.01" @bind="State.PlanGreenBurnGallons" placeholder="@(State.SelectedPlanRace is null ? "Required" : "From recording")" /></label>
            <label>Start fuel (gal)<input type="number" min="0.01" step="0.1" @bind="State.PlanStartFuelGallons" placeholder="@(State.SelectedPlanRace is null ? "Required" : "From recording")" /></label>
            <label>Lap time (s)<input type="number" min="1" step="0.1" @bind="State.PlanLapSeconds" placeholder="For timed races" /></label>
            <details class="planning-context-change">
                <summary>Change car, track or reference</summary>
                <div class="planning-context-grid">
                    <label>Car
                        <select value="@State.SelectedPlanCarId" @onchange="ChangeCar">
                            <option value="">Choose a car</option>
                            @foreach (var car in State.Cars) { <option value="@car.Id">@car.Name</option> }
                        </select>
                    </label>
                    <label>Track and layout
                        <select value="@State.SelectedPlanTrack" @onchange="ChangeTrack">
                            <option value="">Choose a track and layout</option>
                            @foreach (var track in PlanTracks) { <option value="@track.Key">@track.Label</option> }
                        </select>
                    </label>
                    <label>Setup
                        <select value="@State.PlanSetupType" @onchange="ChangeSetupType"><option>Fixed</option><option>Open</option></select>
                    </label>
                    <label>Reference recording
                        <select value="@State.SelectedPlanRaceId" @onchange="ChangeReference">
                            <option value="">Estimates only</option>
                            @foreach (var race in MatchingRaces) { <option value="@race.Id">@ReferenceLabel(race)</option> }
                        </select>
                    </label>
                </div>
            </details>
        </div>
        <p class="planning-note">Blank fuel fields use the reference recording. One green lap of fuel is always held in reserve.</p>
        @if (!State.PlanBusy && !string.IsNullOrWhiteSpace(State.PlanMessage)) { <p class="planning-status" role="status">@State.PlanMessage</p> }
    </section>

    @if (State.PlanBusy)
    {
        <section class="surface-card planning-building" data-plan-building aria-busy="true" role="status">
            <span class="activity-spinner" aria-hidden="true"></span>
            <div><strong>Building the plan</strong><span>@BuildingDetail</span></div>
        </section>
    }

    @if (State.PlanGenerated && State.PlanBriefing is { } plan)
    {
        <section class="surface-card plan-briefing planning-results" data-assumption-count="@plan.Assumptions.Count">
            <div class="planning-decision-hero" data-planning-decision>
                <div>
                    <span class="ri-label">Fuel plan · @plan.DistanceLabel</span>
                    <strong>@OpeningPlan(plan)</strong>
                    <p>@OpeningPlanExplanation(plan)</p>
                </div>
                <span class="status-label @(plan.Confidence.Equals("Recorded reference", StringComparison.OrdinalIgnoreCase) ? "success" : "warning")">@plan.Confidence</span>
            </div>

            @if (plan.FuelPlan is { IsUsable: true, ScheduledLaps: > 0, AllGreenRangeLaps: > 0 } decision)
            {
                var distance = decision.ScheduledLaps!.Value;
                var range = decision.AllGreenRangeLaps!.Value;
                var scale = Math.Max(distance, Math.Min(range, distance * 1.5));
                <div class="plan-strip" role="img" aria-label="@StripDescription(decision)">
                    <div class="plan-strip-track">
                        <i class="plan-reach" style="left:0;width:@Pct(Math.Min(range, scale), scale)" title="Full-tank all-green reach after the reserve: @range.ToString("0.0", CultureInfo.CurrentCulture) laps"></i>
                        @foreach (var window in decision.StopWindows ?? [])
                        {
                            <i class="plan-window" style="left:@Pct(window.EarliestLap, scale);width:@Pct(window.LatestLap - window.EarliestLap, scale)" title="Stop @window.Stop fuel window"></i>
                        }
                        @foreach (var target in decision.EqualStintPitTargets)
                        {
                            <i class="plan-split" style="left:@Pct(target, scale)" title="Equal fuel split, lap @target.ToString("0.#", CultureInfo.CurrentCulture)"></i>
                        }
                        <i class="plan-finish" style="left:@Pct(distance, scale)" title="Finish, lap @distance.ToString("0.#", CultureInfo.CurrentCulture)"></i>
                    </div>
                    <div class="plan-strip-labels">
                        <span style="left:0">Lap 0</span>
                        @foreach (var window in decision.StopWindows ?? [])
                        {
                            <span class="window" style="left:@Pct((window.EarliestLap + window.LatestLap) / 2, scale)">Stop @window.Stop: laps @Lap(window.EarliestLap)–@Lap(window.LatestLap)</span>
                        }
                        <span class="finish" style="left:@Pct(distance, scale)">Finish · @Lap(distance)</span>
                    </div>
                    <div class="plan-strip-legend"><span><i class="plan-reach"></i>Reach on a full tank</span>@if ((decision.StopWindows ?? []).Count > 0) { <span><i class="plan-window"></i>Fuel window for the stop</span> }@if (decision.EqualStintPitTargets.Count > 0) { <span><i class="plan-split"></i>Equal fuel split</span> }</div>
                </div>
            }

            <div class="briefing-metrics planning-briefing-metrics">
                <div><span>Fuel decision</span><strong>@FuelDecision(plan)</strong><small>@FuelMargin(plan)</small></div>
                <div><span>Stops</span><strong>@PlannedStops(plan)</strong><small>@PitWindowSummary(plan)</small></div>
                <div><span>Range after reserve</span><strong>@ConservativeRangeLabel(plan)</strong><small>@StartFuelLabel(plan)</small></div>
                @if (plan.GreenFuelGallonsPerLap.HasValue) { <div><span>Green fuel use</span><strong>@plan.GreenFuelGallonsPerLap.Value.ToString("0.000")</strong><small>gal/lap@(plan.CautionFuelGallonsPerLap.HasValue ? $" · caution {plan.CautionFuelGallonsPerLap.Value:0.000}" : "")</small></div> }
            </div>

            @if (plan.Assumptions.Count > 0 || plan.FuelPlan?.Limitations.Count > 0)
            {
                <details class="planning-assumptions"><summary>Planning assumptions</summary><ul>@foreach (var assumption in plan.Assumptions.Concat(plan.FuelPlan?.Limitations ?? [])) { <li>@assumption</li> }</ul></details>
            }
            @if (State.StrategyScenarios.Count > 0)
            {
                <details class="planning-history"><summary>@ScenarioCountMessage</summary>
                    <div class="scenario-grid">@foreach (var run in State.StrategyScenarios) { <article class="scenario-card"><div class="scenario-title"><strong>@FriendlyScenarioLabel(run.Label)</strong></div>@if (!string.IsNullOrWhiteSpace(run.Window)) { <b>@FriendlyWindow(run.Window)</b> }@if (!string.IsNullOrWhiteSpace(run.Stops)) { <span>@run.Stops</span> }@if (!string.IsNullOrWhiteSpace(run.Fuel)) { <span>@run.Fuel</span> }@if (UsefulScenarioNote(run.Note)) { <small>@run.Note</small> }</article> }</div>
                </details>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private CompanionState? _initializedState;
    private string? _distanceAppliedFor;
    private IEnumerable<(string Key, string Label)> PlanTracks => State.PlanTrackOptions;
    private IEnumerable<RecentRace> MatchingRaces => State.Races.OfType<RecentRace>().Where(race =>
        string.Equals(State.SelectedPlanCarId, race.CarPath.Length > 0 ? race.CarPath : race.Car, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(State.SelectedPlanTrack, $"{race.Track}|{race.Layout}", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(State.PlanSetupType, race.SetupType, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_initializedState, State))
        {
            _initializedState = State;
            _distanceAppliedFor = null;
        }
        // A reference carried in from the investigation brings its own distance once.
        if (State.SelectedPlanRace is null || _distanceAppliedFor == State.SelectedPlanRaceId) return;
        UseReferenceDistance(onlyWhenUnchangedDefault: _distanceAppliedFor is null);
        _distanceAppliedFor = State.SelectedPlanRaceId;
    }

    private void ChangeCar(ChangeEventArgs args) { State.SelectPlanCar(args.Value?.ToString()); UseReferenceDistance(); _distanceAppliedFor = State.SelectedPlanRaceId; }
    private void ChangeTrack(ChangeEventArgs args) { State.SelectPlanTrack(args.Value?.ToString()); UseReferenceDistance(); _distanceAppliedFor = State.SelectedPlanRaceId; }
    private void ChangeSetupType(ChangeEventArgs args) { State.SelectPlanSetupType(args.Value?.ToString()); UseReferenceDistance(); _distanceAppliedFor = State.SelectedPlanRaceId; }
    private string DistanceInputValue => State.PlanDistanceValue > 0
        ? State.PlanDistanceValue.ToString("0.#", CultureInfo.InvariantCulture)
        : string.Empty;
    private string DistanceInputStep => State.PlanDistanceMode.Equals("Minutes", StringComparison.OrdinalIgnoreCase) ? "0.1" : "1";
    private void ChangeDistance(ChangeEventArgs args) => State.PlanDistanceValue =
        double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && value > 0 ? value : 0;
    private void ChangeReference(ChangeEventArgs args)
    {
        State.SelectedPlanRaceId = args.Value?.ToString()?.Trim() ?? string.Empty;
        UseReferenceDistance();
        _distanceAppliedFor = State.SelectedPlanRaceId;
    }
    private void UseReferenceDistance(bool onlyWhenUnchangedDefault = false)
    {
        if (State.SelectedPlanRace is null) return;
        var overview = State.SelectedPlanRace?.Overview;
        var laps = overview?.ScheduledLaps;
        var minutes = overview?.ScheduledMinutes;
        if (laps is > 0 && (!onlyWhenUnchangedDefault || State.PlanDistanceValue <= 0))
        {
            State.PlanDistanceValue = laps.Value;
            State.PlanDistanceMode = "Laps";
        }
        else if (minutes is > 0 && (!onlyWhenUnchangedDefault || State.PlanDistanceValue <= 0))
        {
            State.PlanDistanceValue = minutes.Value;
            State.PlanDistanceMode = "Minutes";
        }
        else if (!onlyWhenUnchangedDefault || State.PlanDistanceValue <= 0)
        {
            State.PlanDistanceValue = 0;
            State.PlanDistanceMode = "Laps";
        }
    }
    private Task BuildPlan() => State.GeneratePlanAsync();

    // Every input defaults from the reference recording, so the plan builds as soon as it can;
    // Build plan stays for rebuilding after the driver changes a value.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!State.PlanReadyToBuildFromDefaults) return;
        try { await State.BuildPlanFromDefaultsAsync(); }
        catch (Exception error) { State.ReportUnhandledException("race planning", error); }
    }

    private string BuildingDetail => State.SelectedPlanRace is { } race
        ? $"Fuel and pace from {race.Track}, {race.Date}"
        : "From the fuel values entered above";
    private static string ReferenceLabel(RecentRace race) => $"{race.Date} · {race.Track}{(string.IsNullOrWhiteSpace(race.Layout) ? string.Empty : $" · {race.Layout}")}";
    private static string ReferenceFacts(RecentRace race)
    {
        var facts = new List<string> { $"{race.SetupType} setup", race.Date };
        if (DeclaredDistance(race.Overview) is { } declaredDistance) facts.Insert(0, declaredDistance);
        if (race.Overview?.RecordedLaps is > 0) facts.Insert(0, $"{race.Overview.RecordedLaps} laps recorded");
        if (race.StartPosition > 0 && race.FinishPosition > 0) facts.Add($"P{race.StartPosition} → P{race.FinishPosition}");
        return string.Join(" · ", facts);
    }
    private static string? DeclaredDistance(RaceOverview? overview) => overview switch
    {
        { DeclaredLapLimit: > 0, DeclaredTimeLimitMinutes: > 0 } => $"{overview.DeclaredLapLimit} laps / {overview.DeclaredTimeLimitMinutes:0.#} minutes configured",
        { DeclaredLapLimit: > 0 } => $"{overview.DeclaredLapLimit} laps scheduled",
        { DeclaredTimeLimitMinutes: > 0 } => $"{overview.DeclaredTimeLimitMinutes:0.#} minutes scheduled",
        _ => null
    };
    private static string FriendlyWindow(string value) => DateTimeOffset.TryParse(value, out var date) ? date.ToLocalTime().ToString("MMM d · h:mm tt") : value;
    private string ScenarioCountMessage => State.StrategyScenarios.Count switch
    {
        1 => "1 comparable recorded race",
        var count => $"{count} comparable recorded races"
    };
    private static string FriendlyScenarioLabel(string value) => value.Replace("Recorded ", string.Empty, StringComparison.OrdinalIgnoreCase).Trim();
    private static bool UsefulScenarioNote(string value) => !string.IsNullOrWhiteSpace(value)
        && !value.Contains("local race history", StringComparison.OrdinalIgnoreCase)
        && !value.Contains("recorded source", StringComparison.OrdinalIgnoreCase);
    private static string Pct(double value, double scale) => (Math.Clamp(value / Math.Max(1e-9, scale), 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private static string Lap(double value) => Math.Round(value).ToString("0", CultureInfo.CurrentCulture);
    private static double? ConservativeRange(RacePlanBriefing plan) => plan.FuelPlan?.AllGreenRangeLaps;
    private static int? AuthoritativeStops(RacePlanBriefing plan) =>
        plan.FuelPlan is { IsUsable: true } decision ? decision.MinimumStops : null;
    private static bool NoStopAuthorized(RacePlanBriefing plan) =>
        plan.FuelPlan is { IsUsable: true, MinimumStops: 0, NoStopLanguagePermitted: true };
    private static IReadOnlyList<RacePlanStopWindow> StopWindows(RacePlanBriefing plan) =>
        plan.FuelPlan is { IsUsable: true } decision ? decision.StopWindows ?? [] : [];

    /// <summary>The one executable decision: how many stops and where fuel allows each.</summary>
    private static string OpeningPlan(RacePlanBriefing plan)
    {
        if (NoStopAuthorized(plan)) return "No fuel stop · start full";
        if (AuthoritativeStops(plan) is not (> 0 and var stops)) return "Add fuel use and race distance to calculate stops";
        var windows = StopWindows(plan);
        return windows.Count == stops
            ? $"{stops} stop{(stops == 1 ? "" : "s")} · " + string.Join(" · ", windows.Select(window => $"{(stops == 1 ? "" : $"stop {window.Stop} ")}between laps {Lap(window.EarliestLap)} and {Lap(window.LatestLap)}"))
            : $"At least {stops} stop{(stops == 1 ? string.Empty : "s")}";
    }
    private static string OpeningPlanExplanation(RacePlanBriefing plan)
    {
        if (plan.FuelPlan is not { IsUsable: true } decision) return plan.FuelPlan?.UnavailableReason
            ?? "Add the race distance and fuel use to calculate a stop plan.";
        if (NoStopAuthorized(plan)) return decision.FinalStintMarginLaps is { } margin
            ? $"A full tank covers the distance with {margin:0.0} laps to spare. Reassess if fuel use rises."
            : "The plan covers the race without a scheduled fuel stop.";
        return decision.EqualStintPitTargets.Count > 0
            ? $"Anywhere inside the window reaches the finish on all-green fuel. The equal split is lap {decision.EqualStintPitTargets[0]:0.#}; tire wear, cautions and track position decide where in the window to stop."
            : "The plan requires a stop, but no equal-stint target is available.";
    }
    private static string StripDescription(RacePlanDecisionView decision) =>
        $"Race of {decision.ScheduledLaps:0.#} laps; full-tank reach {decision.AllGreenRangeLaps:0.0} laps; " +
        string.Join("; ", (decision.StopWindows ?? []).Select(window => $"stop {window.Stop} between laps {Lap(window.EarliestLap)} and {Lap(window.LatestLap)}"));
    private static string ConservativeRangeLabel(RacePlanBriefing plan) => ConservativeRange(plan) is { } range ? $"{range:0.0} laps" : "Not available";
    private static string StartFuelLabel(RacePlanBriefing plan) => plan.FuelPlan?.MaximumStartFuelLiters is { } liters
        ? $"from {liters / 3.785411784:0.0} gal start fuel"
        : "start fuel from inputs";
    private static string FuelDecision(RacePlanBriefing plan)
    {
        if (NoStopAuthorized(plan)) return "No fuel stop needed";
        return AuthoritativeStops(plan) switch
        {
            1 => "1 stop",
            > 1 and var stops => $"{stops} stops",
            _ => "Decision unavailable"
        };
    }
    private static string FuelMargin(RacePlanBriefing plan)
    {
        if (plan.FuelPlan is not { IsUsable: true } decision) return "Fuel margin unavailable";
        return decision.FinalStintMarginLaps is { } margin
            ? decision.MinimumStops > 0
                ? $"+{margin:0.0} laps of total capacity across {decision.Stints} stints"
                : $"+{margin:0.0} laps after the final stint"
            : "Fuel margin unavailable";
    }
    private static string PlannedStops(RacePlanBriefing plan) => AuthoritativeStops(plan)?.ToString(CultureInfo.InvariantCulture) ?? "—";
    private static string PitWindowSummary(RacePlanBriefing plan) => AuthoritativeStops(plan) switch
    {
        null => "Add the missing fuel or pace inputs",
        0 when NoStopAuthorized(plan) => "No scheduled fuel stop",
        _ when PlanPitTargets(plan).Count > 0 => "equal split at " + string.Join(" · ", PlanPitTargets(plan).Select(lap => $"lap {lap:0.#}")),
        _ => "Window needs live fuel use"
    };
    private static IReadOnlyList<double> PlanPitTargets(RacePlanBriefing plan) =>
        plan.FuelPlan is { IsUsable: true } decision ? decision.EqualStintPitTargets : [];
}
