<div class="planning-page">
    <div class="page-heading compact-heading planning-heading">
        <div><span class="eyebrow">Race planning</span><h1>Next race</h1></div>
    </div>

    @if (State.Races.Count == 0)
    {
        <section class="surface-card compact-empty-surface"><div class="empty-state"><span class="empty-icon"><ProductIcon Name="planning" Size="22" /></span><h2>Finish a recorded race first</h2><p>Planning uses the recorded car, track, setup type, and distance.</p><button class="button primary" @onclick='() => State.Navigate("analysis")'>Open Race Analysis</button></div></section>
    }
    else
    {
        <div class="planning-workspace @(State.PlanGenerated ? "has-results" : "setup-only")">
            <section class="surface-card planning-setup-card" aria-labelledby="planning-context-title">
                <div class="planning-setup-heading">
                    <div><span class="eyebrow">Next event</span><h2 id="planning-context-title">Race details</h2></div>
                    <button class="button primary compact" disabled="@(State.SelectedPlanRace is null)" @onclick="BuildPlan">Build plan</button>
                </div>

                <div class="planning-setup-grid">
                    <label>Car
                        <select value="@State.SelectedPlanCarId" @onchange="ChangeCar">
                            @foreach (var car in State.Cars) { <option value="@car.Id">@car.Name</option> }
                        </select>
                    </label>
                    <label>Track and layout
                        <select value="@State.SelectedPlanTrack" @onchange="ChangeTrack">
                            @foreach (var track in PlanTracks) { <option value="@track.Key">@track.Label</option> }
                        </select>
                    </label>
                    <label class="planning-setup-type">Setup
                        <select value="@State.PlanSetupType" @onchange="ChangeSetupType"><option>Fixed</option><option>Open</option></select>
                    </label>
                    <div class="planning-distance-fields">
                        <label>Distance<input type="number" min="1" max="1000" @bind="State.PlanDistanceValue" /></label>
                        <label><span class="sr-only">Distance unit</span><select aria-label="Distance unit" @bind="State.PlanDistanceMode"><option>Laps</option><option>Minutes</option></select></label>
                    </div>
                    <label class="planning-reference-field">Based on
                        <select value="@State.SelectedPlanRaceId" @onchange="ChangeReference">
                            <option value="">Choose a recorded race</option>
                            @foreach (var race in MatchingRaces) { <option value="@race.Id">@ReferenceLabel(race)</option> }
                        </select>
                    </label>
                </div>

                @if (State.SelectedPlanRace is { } selected)
                {
                    <div class="planning-reference-summary">
                        <span class="status-label success">Ready to build</span>
                        <strong>@selected.Track@(string.IsNullOrWhiteSpace(selected.Layout) ? string.Empty : $" · {selected.Layout}")</strong>
                        <span>@selected.Car</span>
                        <small>@ReferenceFacts(selected)</small>
                    </div>
                }
                else
                {
                    <p class="planning-reference-missing">Choose a matching race to build the plan.</p>
                }
            </section>

            @if (State.PlanGenerated)
            {
                <div class="planning-results">
                    @if (State.PlanBriefing is { } plan)
                    {
                        <section class="surface-card plan-briefing" data-assumption-count="@plan.Assumptions.Count">
                            <div class="analysis-section-heading"><div><span class="eyebrow">Race briefing</span><h2>@plan.Track · @plan.Car</h2></div><span class="status-label @(plan.Confidence.Equals("Low", StringComparison.OrdinalIgnoreCase) ? "warning" : "success")">@plan.Confidence confidence</span></div>
                            <div class="planning-decision-hero" data-planning-decision>
                                <div>
                                    <span class="eyebrow">Recommended opening plan</span>
                                    <strong>@OpeningPlan(plan)</strong>
                                    <p>@OpeningPlanExplanation(plan)</p>
                                </div>
                                <div class="planning-decision-distance">
                                    <span><small>Race</small><b>@plan.ScheduledLaps laps</b></span>
                                    <i style="--distance-marker:@DistanceMarker(plan)"><b></b><em></em></i>
                                    <span><small>Conservative range</small><b>@ConservativeRangeLabel(plan)</b></span>
                                </div>
                            </div>
                            <div class="briefing-metrics planning-briefing-metrics">
                                <div><span>Fuel decision</span><strong>@FuelDecision(plan)</strong><small>@FuelMargin(plan)</small></div>
                                <div><span>Planned stops</span><strong>@PlannedStops(plan)</strong><small>@PitWindowSummary(plan)</small></div>
                                @if (plan.GreenFuelGallonsPerLap.HasValue) { <div><span>Green fuel use</span><strong>@plan.GreenFuelGallonsPerLap.Value.ToString("0.000")</strong><small>gal/lap</small></div> }
                                @if (plan.CautionFuelGallonsPerLap.HasValue) { <div><span>Caution fuel use</span><strong>@plan.CautionFuelGallonsPerLap.Value.ToString("0.000")</strong><small>gal/lap</small></div> }
                            </div>
                            @if (plan.PitTargets.Count > 0) { <div class="pit-target"><ProductIcon Name="planning" Size="18" /><span>Equal-stint windows</span><strong>@string.Join(" · ", plan.PitTargets.Select(lap => $"Lap {lap}"))</strong></div> }
                            @if (plan.Priorities.Any(UsefulPriority) || UsefulTireGuidance(plan.TireGuidance) || plan.Triggers.Any(item => UsefulTrigger(plan, item)))
                            {
                                <div class="briefing-columns">
                                    @if (plan.Priorities.Any(UsefulPriority)) { <div><h3>Race priorities</h3>@foreach (var action in plan.Priorities.Where(UsefulPriority).Take(4)) { <article class="briefing-action"><span>@action.Label</span><p>@action.Claim.Text</p></article> }</div> }
                                    @if (UsefulTireGuidance(plan.TireGuidance) || plan.Triggers.Any(item => UsefulTrigger(plan, item))) { <div><h3>Tires and long-run approach</h3>@if (UsefulTireGuidance(plan.TireGuidance)) { <p class="tire-guidance">@plan.TireGuidance</p> }@if (plan.Triggers.Any(item => UsefulTrigger(plan, item))) { <h3>Respond during the race</h3>@foreach (var trigger in plan.Triggers.Where(item => UsefulTrigger(plan, item))) { <article class="briefing-trigger"><strong>@trigger.Label</strong><span>@FriendlyTrigger(plan, trigger)</span></article> } }</div> }
                                </div>
                            }
                            @if (plan.Corners.Any(HasSupportedPhase)) { <div class="plan-corners"><h3>Corner evidence by run phase</h3>@foreach (var corner in plan.Corners.Where(HasSupportedPhase)) { <article><strong>@corner.Zone</strong>@if (UsefulCornerPhase(corner.Early)) { <span><b>Early</b> @FriendlyCornerText(corner.Early.Text)</span> }@if (UsefulCornerPhase(corner.Middle)) { <span><b>Middle</b> @FriendlyCornerText(corner.Middle.Text)</span> }@if (UsefulCornerPhase(corner.Late)) { <span><b>Late</b> @FriendlyCornerText(corner.Late.Text)</span> }</article> }</div> }
                        </section>
                    }
                    <section class="surface-card planning-history">
                        <div class="card-header"><div><span class="eyebrow">Race comparisons</span><h2>Comparable races</h2></div></div>
                        <p class="section-copy">@ScenarioCountMessage</p>
                        @if (State.StrategyScenarios.Count == 0)
                        {
                            <div class="empty-state compact-empty"><span class="empty-icon"><ProductIcon Name="planning" Size="22" /></span><h3>No comparable runs yet</h3><p>Analyze more races with the same car, layout, setup type, and distance.</p></div>
                        }
                        else
                        {
                            <div class="scenario-grid">@foreach (var run in State.StrategyScenarios) { <article class="scenario-card"><div class="scenario-title"><strong>@FriendlyScenarioLabel(run.Label)</strong></div>@if (!string.IsNullOrWhiteSpace(run.Window)) { <b>@FriendlyWindow(run.Window)</b> }@if (!string.IsNullOrWhiteSpace(run.Stops)) { <span>@run.Stops</span> }@if (!string.IsNullOrWhiteSpace(run.Fuel)) { <span>@run.Fuel</span> }@if (UsefulScenarioNote(run.Note)) { <small>@run.Note</small> }</article> }</div>
                        }
                    </section>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private CompanionState? _initializedState;
    private bool _initialDistanceApplied;
    private IEnumerable<(string Key, string Label)> PlanTracks => State.Races.OfType<RecentRace>()
        .Where(race => !string.IsNullOrWhiteSpace(race.Track))
        .Select(race => ($"{race.Track}|{race.Layout}", string.IsNullOrWhiteSpace(race.Layout) ? race.Track : $"{race.Track} · {race.Layout}"))
        .DistinctBy(item => item.Item1, StringComparer.OrdinalIgnoreCase)
        .OrderBy(item => item.Item2, StringComparer.CurrentCultureIgnoreCase)
        .Select(item => (item.Item1, item.Item2));
    private IEnumerable<RecentRace> MatchingRaces => State.Races.OfType<RecentRace>().Where(race =>
        string.Equals(State.SelectedPlanCarId, race.CarPath.Length > 0 ? race.CarPath : race.Car, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(State.SelectedPlanTrack, $"{race.Track}|{race.Layout}", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(State.PlanSetupType, race.SetupType, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_initializedState, State))
        {
            _initializedState = State;
            _initialDistanceApplied = false;
        }
        if (_initialDistanceApplied || State.SelectedPlanRace is null) return;
        UseReferenceDistance(onlyWhenUnchangedDefault: true);
        _initialDistanceApplied = true;
    }

    private void ChangeCar(ChangeEventArgs args) { State.SelectPlanCar(args.Value?.ToString()); UseReferenceDistance(); }
    private void ChangeTrack(ChangeEventArgs args) { State.SelectPlanTrack(args.Value?.ToString()); UseReferenceDistance(); }
    private void ChangeSetupType(ChangeEventArgs args) { State.SelectPlanSetupType(args.Value?.ToString()); UseReferenceDistance(); }
    private void ChangeReference(ChangeEventArgs args)
    {
        State.SelectedPlanRaceId = args.Value?.ToString()?.Trim() ?? string.Empty;
        UseReferenceDistance();
    }
    private void UseReferenceDistance(bool onlyWhenUnchangedDefault = false)
    {
        var laps = State.SelectedPlanRace?.Overview?.RecordedLaps;
        if (laps is > 0 && (!onlyWhenUnchangedDefault || State.PlanDistanceValue is <= 0 or 50))
        {
            State.PlanDistanceValue = laps.Value;
            State.PlanDistanceMode = "Laps";
        }
    }
    private Task BuildPlan() => State.GeneratePlanAsync();
    private static string ReferenceLabel(RecentRace race) => $"{race.Date} · {race.Track}{(string.IsNullOrWhiteSpace(race.Layout) ? string.Empty : $" · {race.Layout}")}";
    private static string ReferenceFacts(RecentRace race)
    {
        var facts = new List<string> { $"{race.SetupType} setup", race.Date };
        if (race.Overview?.RecordedLaps is > 0) facts.Insert(0, $"{race.Overview.RecordedLaps} laps");
        if (race.StartPosition > 0 && race.FinishPosition > 0) facts.Add($"P{race.StartPosition} → P{race.FinishPosition}");
        return string.Join(" · ", facts);
    }
    private static string FriendlyWindow(string value) => DateTimeOffset.TryParse(value, out var date) ? date.ToLocalTime().ToString("MMM d · h:mm tt") : value;
    private string ScenarioCountMessage => State.StrategyScenarios.Count switch
    {
        0 => "No comparable race is available yet.",
        1 => "One comparable race can inform this plan.",
        var count => $"{count} comparable races can inform this plan."
    };
    private static string FriendlyScenarioLabel(string value) => value.Replace("Recorded ", string.Empty, StringComparison.OrdinalIgnoreCase).Trim();
    private static bool UsefulScenarioNote(string value) => !string.IsNullOrWhiteSpace(value)
        && !value.Contains("local race history", StringComparison.OrdinalIgnoreCase)
        && !value.Contains("recorded source", StringComparison.OrdinalIgnoreCase);
    private static bool Supported(EvidenceText claim) => CapabilityRegistry.IsSupported(claim) && !claim.Text.Contains("No eligible lap", StringComparison.OrdinalIgnoreCase) && !claim.Text.Contains("enough samples", StringComparison.OrdinalIgnoreCase);
    private static bool UsefulPriority(RaceAction action) => Supported(action.Claim)
        && !System.Text.RegularExpressions.Regex.IsMatch(action.Claim.Text, @"\b(?:positive|negative) (?:value )?(?:is|means)|\b(?:higher|lower) (?:means|indicates)", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant)
        && !action.Claim.Text.Contains("rollback", StringComparison.OrdinalIgnoreCase)
        && !action.Claim.Text.Contains("change one setup system", StringComparison.OrdinalIgnoreCase)
        && !action.Claim.Text.Contains("match this wear pattern", StringComparison.OrdinalIgnoreCase)
        && !action.Claim.Text.Contains("before assigning cause", StringComparison.OrdinalIgnoreCase)
        && !action.Label.Contains("adjust", StringComparison.OrdinalIgnoreCase);
    private static bool UsefulTireGuidance(string value) => !string.IsNullOrWhiteSpace(value)
        && !value.Contains("Use the recorded early-, middle-, and late-run comparison", StringComparison.OrdinalIgnoreCase);
    private static bool UsefulCornerPhase(EvidenceText claim) => Supported(claim)
        && !claim.Text.Contains("repeatability check", StringComparison.OrdinalIgnoreCase)
        && !claim.Text.Contains("match this wear pattern", StringComparison.OrdinalIgnoreCase)
        && !claim.Text.Contains("no external target", StringComparison.OrdinalIgnoreCase)
        && !claim.Text.Contains("before assigning cause", StringComparison.OrdinalIgnoreCase);
    private static bool HasSupportedPhase(CornerCoachingRow row) => UsefulCornerPhase(row.Early) || UsefulCornerPhase(row.Middle) || UsefulCornerPhase(row.Late);
    private static string FriendlyCornerText(string value) => System.Text.RegularExpressions.Regex.Replace(value, @"([0-9]+(?:\.[0-9]+)?) rad median steering", match =>
        double.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var radians)
            ? $"{radians * 180d / Math.PI:0.0}° median steering"
            : match.Value);
    private static double? ConservativeRange(RacePlanBriefing plan)
    {
        var match = System.Text.RegularExpressions.Regex.Match(plan.FuelRange, @"\d+(?:\.\d+)?");
        return match.Success && double.TryParse(match.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? value
            : null;
    }
    private static int CalculatedStops(RacePlanBriefing plan)
    {
        var range = ConservativeRange(plan);
        return range is > 0 && plan.ScheduledLaps > 0 ? Math.Max(0, (int)Math.Ceiling(plan.ScheduledLaps / range.Value) - 1) : plan.PitTargets.Count;
    }
    private static string OpeningPlan(RacePlanBriefing plan) => plan.ScheduledLaps <= 0
        ? "Use the recorded run as the planning baseline"
        : CalculatedStops(plan) == 0
            ? $"Start with a no-stop plan for {plan.ScheduledLaps} laps"
            : $"Start with a {CalculatedStops(plan)}-stop all-green plan";
    private static string OpeningPlanExplanation(RacePlanBriefing plan)
    {
        var range = ConservativeRange(plan);
        if (range is null || plan.ScheduledLaps <= 0) return "Use the recorded fuel burn as the baseline and update the call if live consumption moves outside it.";
        if (range >= plan.ScheduledLaps) return $"The conservative recorded range clears this race by {range.Value - plan.ScheduledLaps:0.0} laps. There is no useful fuel pit window unless conditions change.";
        return plan.PitTargets.Count > 0
            ? $"The measured range cannot cover the full distance. The first balanced window opens around lap {plan.PitTargets[0]}."
            : "The measured range cannot cover the full distance; use live burn to establish the safest stop window.";
    }
    private static string ConservativeRangeLabel(RacePlanBriefing plan) => ConservativeRange(plan) is { } range ? $"{range:0.0} laps" : "Not available";
    private static string DistanceMarker(RacePlanBriefing plan)
    {
        var range = ConservativeRange(plan) ?? 0;
        var scale = Math.Max(range, plan.ScheduledLaps);
        var percent = scale <= 0 ? 0 : Math.Clamp(plan.ScheduledLaps / scale * 100, 0, 100);
        return percent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }
    private static string FuelDecision(RacePlanBriefing plan) => CalculatedStops(plan) == 0 ? "Stay out" : $"{CalculatedStops(plan)} stop{(CalculatedStops(plan) == 1 ? string.Empty : "s")}";
    private static string FuelMargin(RacePlanBriefing plan)
    {
        var range = ConservativeRange(plan);
        if (range is null || plan.ScheduledLaps <= 0) return "Range needs another clean sample";
        var margin = range.Value - plan.ScheduledLaps;
        return margin >= 0 ? $"+{margin:0.0} laps beyond the finish" : $"{-margin:0.0} laps beyond one tank";
    }
    private static string PlannedStops(RacePlanBriefing plan) => CalculatedStops(plan).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static string PitWindowSummary(RacePlanBriefing plan) => plan.PitTargets.Count > 0 ? string.Join(" · ", plan.PitTargets.Select(lap => $"lap {lap}")) : "No scheduled fuel stop";
    private static bool UsefulTrigger(RacePlanBriefing plan, RaceTrigger trigger) => CapabilityRegistry.IsSupported(trigger.Claim)
        && !trigger.Label.Contains("adjust", StringComparison.OrdinalIgnoreCase)
        && !trigger.Label.Contains("rollback", StringComparison.OrdinalIgnoreCase)
        && !(CalculatedStops(plan) == 0 && trigger.Label.Contains("pit", StringComparison.OrdinalIgnoreCase));
    private static string FriendlyTrigger(RacePlanBriefing plan, RaceTrigger trigger)
    {
        if (trigger.Label.Contains("pit", StringComparison.OrdinalIgnoreCase) && CalculatedStops(plan) == 0)
            return "No planned stop. Reconsider only if live fuel use removes the finish margin.";
        return trigger.Claim.Text;
    }
}
