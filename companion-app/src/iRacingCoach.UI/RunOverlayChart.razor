@inherits MeasuredChart
@using System.Globalization
@using static iRacingCoach.UI.InvestigationPresentation

<div class="ri-runs" data-ri-runs>
    <div class="ri-chart-head">
        <div class="ri-run-legend">
            @foreach (var run in Runs)
            {
                <span class="ri-run-key" data-run="@run.RunNumber" title="@RunTitle(run)">
                    <svg width="20" height="8" aria-hidden="true"><line x1="0" y1="4" x2="20" y2="4" stroke="@RunColor(run.RunNumber)" stroke-width="2.5" stroke-dasharray="@RunDash(run.RunNumber)" /></svg>
                    <b>Run @run.RunNumber</b><small>laps @run.FirstLap–@run.LastLap · @run.PlottedLapCount plotted</small>
                    @if (_showFit && run.Fit is { } fit) { <small class="ri-fit-text">fit @Signed(fit.SlopeSecondsPerGreenLap * 10, 2) s / 10 green · @fit.EligibleCount screened laps · @Number(fit.DomainStart)–@Number(fit.DomainEnd)</small> }
                </span>
            }
        </div>
        <button type="button" class="ri-toggle" aria-pressed="@(_showFit ? "true" : "false")" title="Least-squares line through screened laps only, drawn across their exposure range" @onclick="() => _showFit = !_showFit">Screened fit</button>
        <output class="ri-readout" aria-live="polite">@Readout</output>
    </div>
    <div class="ri-plot" @ref="Target">
        @if (Points.Count == 0)
        {
            <div class="ri-empty"><strong>No plotted laps with known run exposure</strong><span>Runs need complete green laps to place them on a shared axis.</span></div>
        }
        else
        {
            var plot = Scale;
            <svg class="ri-plot-svg" viewBox="0 0 @N(Width) @N(Height)" role="group" aria-label="Lap time against green laps into each run, runs overlaid">
                @foreach (var tick in Ticks(plot.YMin, plot.YMax, 4))
                {
                    <line x1="@N(plot.Left)" x2="@N(plot.Right)" y1="@N(plot.Y(tick))" y2="@N(plot.Y(tick))" class="ri-grid" />
                    <g><text x="@N(plot.Left - 6)" y="@N(plot.Y(tick) + 4)" text-anchor="end" class="ri-axis">@tick.ToString("0.0", CultureInfo.CurrentCulture)</text></g>
                }
                @foreach (var tick in Ticks(0, plot.XMax, 6))
                {
                    <g><text x="@N(plot.X(tick))" y="@N(plot.Bottom + 16)" text-anchor="middle" class="ri-axis">@tick.ToString("0", CultureInfo.CurrentCulture)</text></g>
                }
                <g><text x="@N(plot.Left)" y="12" class="ri-axis-title">Lap time · s</text></g>
                <g><text x="@N(plot.Right)" y="@N(plot.Bottom + 32)" text-anchor="end" class="ri-axis-title">Green laps into run</text></g>
                @if (Selected is { } comparison)
                {
                    foreach (var cohort in new[] { comparison.Baseline, comparison.Compared })
                    {
                        if (cohort.GreenAgeStart is { } start && cohort.GreenAgeEnd is { } end)
                        {
                            <path d="M@(N(plot.X(start))),@(N(plot.Bottom + 3))V@(N(plot.Bottom + 7))H@(N(plot.X(end)))V@(N(plot.Bottom + 3))" class="ri-bracket" stroke="@RunColor(cohort.RunNumber)" />
                        }
                    }
                }
                @foreach (var run in Runs)
                {
                    foreach (var segment in run.Trend.Segments)
                    {
                        <path d="@TrendPath(plot, segment)" class="ri-trend" stroke="@RunColor(run.RunNumber)" stroke-dasharray="@RunDash(run.RunNumber)" />
                    }
                    if (_showFit && run.Fit is { Points.Count: 2 } fit)
                    {
                        <line x1="@N(plot.X(fit.Points[0].X))" y1="@N(plot.Y(fit.Points[0].Y))" x2="@N(plot.X(fit.Points[1].X))" y2="@N(plot.Y(fit.Points[1].Y))" class="ri-fit" stroke="@RunColor(run.RunNumber)" />
                    }
                }
                @foreach (var point in Points)
                {
                    var color = RunColor(point.RunNumber);
                    var chosen = _chosen.Contains(point.Lap);
                    var x = plot.X(point.GreenExposure!.Value);
                    var y = plot.Y(Math.Clamp(point.LapTimeSeconds!.Value, plot.YMin, plot.YMax));
                    if (chosen) { <circle cx="@N(x)" cy="@N(y)" r="7" class="ri-ring" stroke="@color" /> }
                    <circle cx="@N(x)" cy="@N(y)" r="@(chosen ? "4" : "2.8")" fill="@(point.Eligible ? color : "var(--surface-1)")" stroke="@color"
                            class="ri-dot @(point.Eligible ? null : "excluded")" tabindex="0" data-lap="@point.Lap"
                            @onmouseenter="() => _hover = point" @onfocus="() => _hover = point"
                            aria-label="@LapLabel(point)"><title>@LapLabel(point)</title></circle>
                }
            </svg>
        }
    </div>
    @if (Selected is { } selected)
    {
        <div class="ri-runs-foot">
            <strong>@selected.Title <b class="@PaceTone(selected)">@PaceResult(selected)</b></strong>
            @foreach (var cohort in new[] { selected.Baseline, selected.Compared })
            {
                <span class="ri-cohort-key">
                    <svg width="16" height="8" aria-hidden="true"><line x1="0" y1="4" x2="16" y2="4" stroke="@RunColor(cohort.RunNumber)" stroke-width="2.5" stroke-dasharray="@RunDash(cohort.RunNumber)" /></svg>
                    <b>@CohortIdentity(cohort)</b> · @CohortExposure(cohort)@if (cohort.FuelStartGallons is { } fuel) { <text> · @fuel.ToString("0.0", CultureInfo.CurrentCulture) gal</text> }
                </span>
            }
            <small>Rings mark the compared laps. Lines are a five-lap median of recorded laps, including traffic; hollow dots are excluded from clean comparison.</small>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public RaceInvestigation Investigation { get; set; } = null!;
    [Parameter] public RaceInvestigationComparison? Selected { get; set; }

    private bool _showFit;
    private RaceInvestigationLap? _hover;
    private HashSet<int> _chosen = [];
    private IReadOnlyList<RaceRunView> Runs => Investigation.Runs ?? [];
    private IReadOnlyList<RaceInvestigationLap> Points { get; set; } = [];

    protected override void OnParametersSet()
    {
        Points = Investigation.Laps.Where(lap => lap.PlotPace && lap.GreenExposure is not null && lap.LapTimeSeconds is > 0).ToArray();
        _chosen = Selected is null ? [] : Selected.Baseline.LapNumbers.Concat(Selected.Compared.LapNumbers).ToHashSet();
        if (_hover is not null && Points.All(point => point.Lap != _hover.Lap)) _hover = null;
    }

    private PlotScale Scale
    {
        get
        {
            var times = Points.Select(point => point.LapTimeSeconds!.Value).ToArray();
            var min = times.Min();
            var max = times.Max();
            var pad = Math.Max(.08, (max - min) * .06);
            var exposure = Points.Max(point => point.GreenExposure!.Value);
            return new PlotScale(44, 18, Math.Max(60, Width - 56), Math.Max(60, Height - 18 - 40), 0, Math.Max(1, exposure * 1.02), min - pad, max + pad);
        }
    }

    private static string TrendPath(PlotScale plot, IReadOnlyList<RaceTrendPoint> segment) =>
        string.Concat(segment.Select((point, index) => $"{(index == 0 ? 'M' : 'L')}{N(plot.X(point.X))},{N(plot.Y(Math.Clamp(point.Y, plot.YMin, plot.YMax)))} "));

    private string Readout => _hover is { } lap ? LapLabel(lap) : "Point to a lap for its time and exposure";

    private static string LapLabel(RaceInvestigationLap lap) =>
        $"Lap {lap.Lap} · Run {lap.RunNumber} · {LapTime(lap.LapTimeSeconds)} s · {Exposure(lap.GreenExposure)}{(lap.Eligible ? "" : " · " + Reasons(lap.ExclusionReasons))}";

    private static string RunTitle(RaceRunView run) =>
        $"Observed trend covers {run.Trend.CoveredLapCount} of {run.PlottedLapCount} plotted laps; breaks at {string.Join(", ", run.Trend.Gaps.Select(gap => $"{gap.AfterLap}–{gap.BeforeLap} ({gap.Reason.Replace('_', ' ')})"))}."
            .Replace("breaks at .", "no breaks.");
}
