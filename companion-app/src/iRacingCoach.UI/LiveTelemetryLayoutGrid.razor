@implements IAsyncDisposable
@using System.Collections.Concurrent
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS

<section @ref="_studioElement"
         class="live-layout-studio @(_editing ? "editing" : "viewing") @(_toolboxOpen ? "toolbox-open" : "toolbox-closed")"
         data-live-layout-studio
         aria-label="Live telemetry dashboard editor"
         @onkeydown="HandleStudioKeyDown">
    <div class="live-layout-main">
        <div class="live-layout-toolbar">
            <label class="live-layout-picker">
                <span class="sr-only">Dashboard layout</span>
                <select value="@Active.Id" @onchange="ChangeLayout" aria-label="Dashboard layout">
                    @foreach (var choice in Choices)
                    {
                        <option value="@choice.Layout.Id">@choice.Layout.Name</option>
                    }
                </select>
            </label>

            <span class="live-layout-state" title="Live iRacing connection state">
                <span class="status-orb @(Snapshot.Connected ? "ready" : "neutral")" aria-hidden="true"></span>
                <span>@(Snapshot.Connected ? $"{Snapshot.Flag} - Lap {Snapshot.Lap}" : "Waiting for iRacing")</span>
            </span>

            <div class="live-layout-toolbar-actions">
                @if (_editing)
                {
                    <button class="icon-button" disabled="@(_undo.Count == 0)" title="Undo layout change" aria-label="Undo layout change" @onclick="Undo"><ProductIcon Name="undo" Size="17" /></button>
                    <button class="icon-button" disabled="@(_redo.Count == 0)" title="Redo layout change" aria-label="Redo layout change" @onclick="Redo"><ProductIcon Name="redo" Size="17" /></button>
                }
                <button class="icon-button" title="@(State.Settings.LiveMonitor.Visible ? "Hide telemetry popout" : "Open telemetry popout")" aria-label="@(State.Settings.LiveMonitor.Visible ? "Hide telemetry popout" : "Open telemetry popout")" @onclick="State.ToggleLiveMonitor"><ProductIcon Name="monitor" Size="17" /></button>
                @if (_editing)
                {
                    <button @ref="_toolboxToggleElement" class="button secondary compact toolbox-toggle" @onclick="ToggleToolbox" aria-expanded="@_toolboxOpen" aria-controls="live-telemetry-toolbox">
                        <ProductIcon Name="setup" Size="16" /> @(_toolboxOpen ? "Hide tools" : "Show tools")
                    </button>
                }
                <button class="button @(_editing ? "primary" : "secondary") compact toolbox-done" @onclick="ToggleCustomize">
                    <ProductIcon Name="@(_editing ? "check" : "setup")" Size="16" /> @(_editing ? "Done" : "Customize")
                </button>
            </div>
        </div>

        <div class="live-layout-viewport" data-live-grid-viewport>
            <div class="live-layout-grid"
                 data-live-grid
                 data-columns="@Active.Columns"
                 data-rows="@Active.Rows"
                 style="--live-columns:@Active.Columns;--live-rows:@Active.Rows"
                 aria-label="@($"{Active.Name}, {Active.Columns} columns by {Active.Rows} rows")">
            @if (_editing)
            {
                @for (var row = 0; row < Active.Rows; row++)
                {
                    @for (var column = 0; column < Active.Columns; column++)
                    {
                        <span class="live-grid-cell" style="grid-row:@(row + 1);grid-column:@(column + 1)" aria-hidden="true"></span>
                    }
                }
            }

            @if (Active.Tiles.Count == 0)
            {
                <div class="live-grid-empty">
                    <ProductIcon Name="plus" Size="22" />
                    <strong>Build your dashboard</strong>
                    <span>Drag telemetry from the Toolbox onto this grid.</span>
                </div>
            }

                @foreach (var tile in Active.Tiles.OrderBy(item => item.Row).ThenBy(item => item.Column))
                {
                var definition = LiveTelemetryCatalog.Get(tile.MetricId);
                var reading = Read(tile);
                var tileSelected = _selectedTileId == tile.Id;
                <article @key="tile.Id"
                         class="live-layout-tile style-@StyleClass(tile.DisplayStyle) @(!reading.Available ? "unavailable" : null) @(tileSelected ? "selected" : null)"
                         style="@TileStyle(tile, definition)"
                         data-live-tile
                         data-tile-id="@tile.Id"
                         data-metric-name="@definition.Name"
                         data-row="@tile.Row"
                         data-column="@tile.Column"
                         data-row-span="@tile.RowSpan"
                         data-column-span="@tile.ColumnSpan"
                         tabindex="@(_editing ? "-1" : "0")"
                         role="group"
                         aria-label="@TileAccessibleName(definition, reading, tile)"
                         title="@TileTitle(definition, reading)"
                         @onclick="() => SelectTile(tile.Id)">
                    <header class="live-tile-header">
                        @if (_editing)
                        {
                            <button type="button" class="live-tile-drag-handle" data-live-drag-tile aria-label="Move @definition.Name" title="Drag to move @definition.Name" @onclick="() => SelectTile(tile.Id)" @onclick:stopPropagation="true" @onkeydown="args => HandleTileKeyDown(tile.Id, args)">
                                <ProductIcon Name="grip" Size="15" />
                                <span class="live-tile-heading">@definition.Name</span>
                            </button>
                            <div class="live-tile-actions">
                                <button type="button" class="live-tile-action" aria-label="Configure @definition.Name" title="Widget display settings" aria-expanded="@(_openTileMenuId == tile.Id)" @onclick="() => ToggleTileMenu(tile.Id)" @onclick:stopPropagation="true"><ProductIcon Name="chevron-down" Size="15" /></button>
                                <button type="button" class="live-tile-action remove" aria-label="Remove @definition.Name" title="Remove widget" @onclick="() => RemoveTile(tile.Id)" @onclick:stopPropagation="true"><ProductIcon Name="trash" Size="15" /></button>
                            </div>
                            <span class="live-tile-heading live-tile-heading-compact" aria-hidden="true">@definition.Name</span>
                        }
                        else
                        {
                            <span class="live-tile-heading">@definition.Name</span>
                        }
                    </header>

                    @if (_editing && _openTileMenuId == tile.Id)
                    {
                        <div class="live-tile-quick-menu" role="group" aria-label="@($"{definition.Name} display settings")" @onclick:stopPropagation="true">
                            <div class="quick-menu-heading"><strong>Widget style</strong><button type="button" class="live-tile-action" aria-label="Close widget settings" @onclick="() => ToggleTileMenu(tile.Id)"><ProductIcon Name="close" Size="14" /></button></div>
                            <label>Display
                                <select value="@tile.DisplayStyle" @onchange="args => ChangeTileStyle(tile.Id, args)">
                                    @foreach (var style in definition.Styles) { <option value="@style">@StyleLabel(style)</option> }
                                </select>
                            </label>
                            @if (UsesAccent(tile.DisplayStyle))
                            {
                                <fieldset class="tile-color-field"><legend>Color</legend><div class="tile-color-options">@foreach (var accent in AccentOptions) { <button type="button" class="tile-color-swatch @accent.Value @(tile.Accent == accent.Value ? "active" : null)" style="--swatch-color:@AccentToken(accent.Value)" title="@accent.Label" aria-label="@($"Use {accent.Label.ToLowerInvariant()} color")" aria-pressed="@(tile.Accent == accent.Value)" @onclick="() => SetTileAccent(tile.Id, accent.Value)"></button> }</div></fieldset>
                            }
                            @if (tile.DisplayStyle == LiveMonitorDisplayStyle.Trend)
                            {
                                <label>Chart history
                                    <select value="@tile.TrendDuration" @onchange="args => ChangeTileTrend(tile.Id, args)">@foreach (var duration in LiveTelemetryCatalog.TrendDurations(tile.MetricId)) { <option value="@duration">@TrendLabel(duration)</option> }</select>
                                </label>
                            }
                        </div>
                    }

                    <div class="live-tile-content">
                        @if (tile.DisplayStyle == LiveMonitorDisplayStyle.Trend)
                        {
                            <div class="live-tile-chart">
                                <canvas data-live-trend-chart
                                        data-live-trend-id="@tile.Id"
                                        role="img"
                                        aria-label="@($"{definition.Name} {TrendLabel(tile.TrendDuration)} chart")"></canvas>
                                @if (reading.Available)
                                {
                                    <div class="live-tile-chart-value"><span class="live-tile-value">@reading.DisplayValue</span>@if (!string.IsNullOrWhiteSpace(reading.Unit) && reading.Unit != "time") { <span class="live-tile-unit">@reading.Unit</span> }</div>
                                }
                                else
                                {
                                    <span class="live-tile-missing live-tile-chart-missing"><strong>@reading.DisplayValue</strong><small>@reading.AvailabilityMessage</small></span>
                                }
                            </div>
                        }
                        else if (!reading.Available)
                        {
                            <span class="live-tile-missing"><strong>@reading.DisplayValue</strong><small>@reading.AvailabilityMessage</small></span>
                        }
                        else if (tile.DisplayStyle == LiveMonitorDisplayStyle.Gauge && reading.NumericValue.HasValue)
                        {
                            <div class="live-tile-gauge">
                                <svg viewBox="0 0 100 66" role="img" aria-label="@($"{definition.Name}: {reading.DisplayValue} {reading.Unit}")"><path class="gauge-track" d="M12 56 A38 38 0 0 1 88 56" pathLength="100" /><path class="gauge-value" d="M12 56 A38 38 0 0 1 88 56" pathLength="100" stroke-dasharray="@GaugeDash(reading)" /></svg>
                                <span class="live-tile-value">@reading.DisplayValue</span>
                                @if (!string.IsNullOrWhiteSpace(reading.Unit) && reading.Unit != "time") { <span class="live-tile-unit">@reading.Unit</span> }
                            </div>
                        }
                        else if (tile.DisplayStyle == LiveMonitorDisplayStyle.Bar && reading.NumericValue.HasValue)
                        {
                            <div class="live-tile-number-line"><span class="live-tile-value">@reading.DisplayValue</span>@if (!string.IsNullOrWhiteSpace(reading.Unit) && reading.Unit != "time") { <span class="live-tile-unit">@reading.Unit</span> }</div>
                            <span class="live-tile-bar" role="meter" aria-valuemin="@(reading.Minimum ?? 0)" aria-valuemax="@(reading.Maximum ?? 100)" aria-valuenow="@reading.NumericValue"><i style="width:@PercentToken(MeterPercent(reading))%"></i></span>
                        }
                        else
                        {
                            <div class="live-tile-number-line @(tile.DisplayStyle == LiveMonitorDisplayStyle.Status || !reading.NumericValue.HasValue ? "textual" : null)"><span class="live-tile-value">@reading.DisplayValue</span>@if (reading.NumericValue.HasValue && !string.IsNullOrWhiteSpace(reading.Unit) && reading.Unit != "time") { <span class="live-tile-unit">@reading.Unit</span> }</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(reading.SecondaryValue)) { <small class="live-tile-secondary">@reading.SecondaryValue</small> }
                    </div>

                    @if (_editing)
                    {
                        @foreach (var edge in ResizeEdges)
                        {
                            <span class="live-tile-resize-handle edge-@edge" data-live-resize="@edge" aria-hidden="true"></span>
                        }
                    }
                    </article>
                }
            </div>
        </div>
    </div>

    <div class="live-toolbox-backdrop @(_toolboxOpen ? "open" : null)" aria-hidden="true"></div>
    <aside id="live-telemetry-toolbox"
           class="live-toolbox @(_toolboxOpen ? "open" : null)"
           aria-hidden="@(!_toolboxOpen)"
           aria-label="Live telemetry toolbox">
            <header class="live-toolbox-heading">
                <div><span class="eyebrow">Live telemetry</span><h2>Customize dashboard</h2><p>Drag, resize, and tune each widget.</p></div>
                <button class="icon-button" aria-label="Hide telemetry toolbox" title="Hide toolbox" @onclick="CloseToolbox"><ProductIcon Name="close" Size="17" /></button>
            </header>

            <div class="live-toolbox-body">
                <section class="toolbox-layout-section">
                    <div class="toolbox-section-heading"><div><span class="toolbox-kicker">Dashboard</span><strong>@Active.Name</strong></div><span>@Active.Columns x @Active.Rows</span></div>
                    @if (!ActiveChoice.IsFactory)
                    {
                        <label>Name<input value="@Active.Name" maxlength="40" @onchange="RenameLayout" /></label>
                    }
                    <div class="toolbox-grid-controls">
                        <label>Columns<select value="@Active.Columns" @onchange="ChangeColumns">@for (var value = 1; value <= 8; value++) { <option value="@value">@value</option> }</select></label>
                        <label>Rows<select value="@Active.Rows" @onchange="ChangeRows">@for (var value = 1; value <= 8; value++) { <option value="@value">@value</option> }</select></label>
                    </div>
                    <div class="toolbox-actions">
                        <button title="Create a new dashboard" @onclick="NewLayout"><ProductIcon Name="plus" Size="15" /> New</button>
                        <button title="Duplicate this dashboard" @onclick="DuplicateLayout"><ProductIcon Name="duplicate" Size="15" /> Duplicate</button>
                        <button disabled="@ActiveChoice.IsFactory" title="Restore the default widgets" @onclick="ResetLayout"><ProductIcon Name="reset" Size="15" /> Reset</button>
                        <button class="danger" disabled="@ActiveChoice.IsFactory" title="Delete this custom dashboard" @onclick="DeleteLayout"><ProductIcon Name="trash" Size="15" /> Delete</button>
                    </div>
                </section>

                @if (SelectedTile is { } selected)
                {
                    var selectedDefinition = LiveTelemetryCatalog.Get(selected.MetricId);
                    <section class="toolbox-inspector-section">
                        <div class="toolbox-section-heading"><div><span class="toolbox-kicker">Selected widget</span><strong>@selectedDefinition.Name</strong></div><span>@selected.ColumnSpan x @selected.RowSpan</span></div>
                        <div class="tile-style-picker" role="group" aria-label="Display style">
                            @foreach (var style in selectedDefinition.Styles)
                            {
                                <button class="@(selected.DisplayStyle == style ? "active" : null)" aria-pressed="@(selected.DisplayStyle == style)" @onclick="() => SetTileStyle(selected.Id, style)"><ProductIcon Name="@StyleIcon(style)" Size="17" /><span>@StyleLabel(style)</span></button>
                            }
                        </div>
                        <div class="toolbox-grid-controls">
                            @if (selectedDefinition.Units.Count > 1)
                            {
                                <label>Unit<select value="@selected.Unit" @onchange="args => ChangeTileUnit(selected.Id, args)">@foreach (var unit in selectedDefinition.Units) { <option value="@unit">@(string.IsNullOrWhiteSpace(unit) ? "None" : unit)</option> }</select></label>
                            }
                            <label>Decimals<select value="@selected.Precision" @onchange="args => ChangeTilePrecision(selected.Id, args)">@for (var value = 0; value <= 3; value++) { <option value="@value">@value</option> }</select></label>
                        </div>
                        @if (UsesAccent(selected.DisplayStyle))
                        {
                            <fieldset class="tile-color-field"><legend>Widget color</legend><div class="tile-color-options large">@foreach (var accent in AccentOptions) { <button type="button" class="tile-color-swatch @accent.Value @(selected.Accent == accent.Value ? "active" : null)" style="--swatch-color:@AccentToken(accent.Value)" title="@accent.Label" aria-label="@($"Use {accent.Label.ToLowerInvariant()} color")" aria-pressed="@(selected.Accent == accent.Value)" @onclick="() => SetTileAccent(selected.Id, accent.Value)"></button> }</div></fieldset>
                        }
                        @if (selected.DisplayStyle == LiveMonitorDisplayStyle.Trend)
                        {
                            <label>Chart history<select value="@selected.TrendDuration" @onchange="args => ChangeTileTrend(selected.Id, args)">@foreach (var duration in LiveTelemetryCatalog.TrendDurations(selected.MetricId)) { <option value="@duration">@TrendLabel(duration)</option> }</select></label>
                        }
                        <button class="toolbox-remove-widget" @onclick="() => RemoveTile(selected.Id)"><ProductIcon Name="trash" Size="16" /> Remove widget</button>
                    </section>
                }

                <section class="toolbox-metric-catalog">
                    <div class="toolbox-section-heading"><div><span class="toolbox-kicker">Widget library</span><strong>Add telemetry</strong></div><span>@FilteredCatalog.Count</span></div>
                    <label class="toolbox-search"><span class="sr-only">Search telemetry catalog</span><ProductIcon Name="search" Size="16" /><input type="search" placeholder="Search speed, fuel, gaps..." @bind="_metricSearch" @bind:event="oninput" /></label>
                    <div class="toolbox-metric-list">
                        @if (FilteredCatalog.Count == 0)
                        {
                            <div class="toolbox-search-empty"><strong>No matching telemetry</strong><span>Try a shorter name or source.</span></div>
                        }
                        @foreach (var metric in FilteredCatalog)
                        {
                            var catalogReading = LiveTelemetryCatalog.Read(metric.Id, State.LiveState, metric.DefaultUnit, metric.DefaultPrecision);
                            <article class="toolbox-metric-card" data-live-catalog-item data-live-drag-metric="@metric.Id" data-metric-id="@metric.Id" data-metric-name="@metric.Name" title="Drag @metric.Name onto the grid">
                                <span class="metric-drag-handle" aria-hidden="true"><ProductIcon Name="grip" Size="15" /></span>
                                <div><strong>@metric.Name</strong><small title="@(catalogReading.Available ? metric.Description : catalogReading.AvailabilityMessage)">@SourceLabel(metric.Source) · @(catalogReading.Available ? $"{catalogReading.DisplayValue}{(string.IsNullOrWhiteSpace(catalogReading.Unit) || catalogReading.Unit == "time" ? string.Empty : $" {catalogReading.Unit}")}" : catalogReading.AvailabilityMessage)</small></div>
                                <button type="button" class="metric-add-button" data-live-no-drag aria-label="Add @metric.Name to the first available grid space" title="Add to dashboard" @onclick="() => AddMetric(metric.Id)"><ProductIcon Name="plus" Size="16" /></button>
                            </article>
                        }
                    </div>
                </section>
            </div>

            <footer class="live-toolbox-footer">
                <span><kbd>Alt</kbd> + arrow moves</span><span><kbd>Shift</kbd> + arrow resizes</span><span><kbd>Del</kbd> removes</span>
            </footer>
    </aside>
</section>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;

    private readonly List<LayoutSnapshot> _undo = [];
    private readonly List<LayoutSnapshot> _redo = [];
    private readonly ConcurrentQueue<PendingTrendFrame> _pendingTrendFrames = new();
    private ElementReference _studioElement;
    private ElementReference _toolboxToggleElement;
    private DotNetObjectReference<LiveTelemetryLayoutGrid>? _dotNetReference;
    private bool _editing;
    private bool _toolboxOpen;
    private bool _jsReady;
    private bool _tileChartsReady;
    private bool _disposed;
    private int _trendDrainScheduled;
    private string _metricSearch = string.Empty;
    private string _editorMessage = "Changes save automatically.";
    private string? _selectedTileId;
    private string? _openTileMenuId;
    private string? _lastKnownLayoutSignature;
    private string? _configuredInteractionSignature;
    private string? _configuredTrendSignature;

    private LiveRaceSnapshot Snapshot => State.LiveState.Snapshot;
    private LiveMonitorLayout Preferences => State.Settings.LiveMonitor;
    private IReadOnlyList<LiveMonitorLayoutChoice> Choices => LiveMonitorLayouts.Choices(Preferences);
    private LiveMonitorLayoutChoice ActiveChoice => LiveMonitorLayouts.Active(Preferences);
    private LiveMonitorNamedLayout Active => ActiveChoice.Layout;
    private LiveMonitorTile? SelectedTile => Active.Tiles.FirstOrDefault(tile => tile.Id == _selectedTileId);
    private IReadOnlyList<LiveTelemetryMetricDefinition> FilteredCatalog => LiveTelemetryCatalog.All
        .Where(item => string.IsNullOrWhiteSpace(_metricSearch) || item.Name.Contains(_metricSearch, StringComparison.OrdinalIgnoreCase) || SourceLabel(item.Source).Contains(_metricSearch, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    protected override void OnInitialized() => State.LiveTelemetryFrame += OnLiveTelemetryFrame;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var layoutSignature = LayoutSignature();
        if (_lastKnownLayoutSignature is not null && !string.Equals(_lastKnownLayoutSignature, layoutSignature, StringComparison.Ordinal))
        {
            _undo.Clear();
            _redo.Clear();
            _editorMessage = "Dashboard changed in the telemetry popout; undo history was refreshed.";
        }
        _lastKnownLayoutSignature = layoutSignature;

        var interactionSignature = $"{layoutSignature}|{_editing}|{State.Settings.UseReducedMotion}";
        if (!_jsReady)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("iracingCoachLiveTelemetryLayout.initialize", _studioElement, _dotNetReference, InteractionOptions());
            _jsReady = true;
            _configuredInteractionSignature = interactionSignature;
        }
        else if (!string.Equals(_configuredInteractionSignature, interactionSignature, StringComparison.Ordinal))
        {
            await JS.InvokeVoidAsync("iracingCoachLiveTelemetryLayout.configure", _studioElement, InteractionOptions());
            _configuredInteractionSignature = interactionSignature;
        }

        var trendSignature = $"{layoutSignature}|{State.LiveState.SourceTickRate}|{State.LiveState.SessionEpoch}|{State.Settings.UseReducedMotion}";
        if (!_tileChartsReady || !string.Equals(_configuredTrendSignature, trendSignature, StringComparison.Ordinal))
        {
            await JS.InvokeVoidAsync("iracingCoachLiveTelemetryTileCharts.configure", _studioElement, TrendConfigurations(), TrendOptions());
            _tileChartsReady = true;
            _configuredTrendSignature = trendSignature;
            ScheduleTrendDrain();
        }
    }

    private object InteractionOptions() => new { editing = _editing, reducedMotion = State.Settings.UseReducedMotion, rows = Active.Rows, columns = Active.Columns };
    private LiveTelemetryMetricReading Read(LiveMonitorTile tile) => LiveTelemetryCatalog.Read(tile.MetricId, State.LiveState, tile.Unit, tile.Precision, tile.TrendDuration);

    private object[] TrendConfigurations() => Active.Tiles
        .Where(tile => tile.DisplayStyle == LiveMonitorDisplayStyle.Trend)
        .Select(tile =>
        {
            var definition = LiveTelemetryCatalog.Get(tile.MetricId);
            var reading = Read(tile);
            return (object)new
            {
                id = tile.Id,
                metricId = tile.MetricId,
                unit = tile.Unit,
                duration = tile.TrendDuration.ToString(),
                shape = definition.TrendShape == LiveMonitorTrendShape.Step ? "step" : "continuous",
                minimum = reading.Minimum,
                maximum = reading.Maximum,
                seed = TrendSeed(tile)
            };
        })
        .ToArray();

    private object[] TrendSeed(LiveMonitorTile tile)
    {
        var history = State.LiveState.History ?? [];
        if (history.Count == 0) return [];
        IEnumerable<LiveTracePoint> selected = history;
        var seconds = tile.TrendDuration switch
        {
            LiveMonitorTrendDuration.Seconds15 => 15,
            LiveMonitorTrendDuration.Seconds30 => 30,
            LiveMonitorTrendDuration.Seconds60 => 60,
            _ => 0
        };
        if (seconds > 0)
        {
            var cutoff = history[^1].At - TimeSpan.FromSeconds(seconds);
            selected = history.Where(point => point.At >= cutoff);
        }
        else
        {
            var latestIndex = -1;
            double? latestProgress = null;
            for (var index = history.Count - 1; index >= 0; index--)
            {
                if (LapProgress(history[index]) is not { } progress) continue;
                latestIndex = index;
                latestProgress = progress;
                break;
            }
            if (latestIndex >= 0 && latestProgress.HasValue)
            {
                var sessionStart = 0;
                var laterProgress = latestProgress.Value;
                for (var index = latestIndex - 1; index >= 0; index--)
                {
                    if (LapProgress(history[index]) is not { } progress) continue;
                    if (progress > laterProgress + .25)
                    {
                        sessionStart = index + 1;
                        break;
                    }
                    laterProgress = progress;
                }
                var lapCount = tile.TrendDuration == LiveMonitorTrendDuration.ThreeLaps ? 3 : 1;
                var cutoff = latestProgress.Value - lapCount;
                selected = history.Skip(sessionStart).Where(point => LapProgress(point) is { } progress && progress >= cutoff);
            }
        }
        return selected
            .Select(point => new { Point = point, Value = LiveTelemetryCatalog.TrendValue(tile.MetricId, point, tile.Unit) })
            .Select(item => (object)new
            {
                value = item.Value,
                lap = item.Point.Lap,
                lapDistancePercent = item.Point.LapDistancePercent,
                atUnixMilliseconds = item.Point.At.ToUnixTimeMilliseconds()
            })
            .ToArray();
    }

    private object TrendOptions(long? sessionEpoch = null) => new
    {
        sourceRate = State.LiveState.SourceTickRate > 0 ? State.LiveState.SourceTickRate : 60,
        sessionEpoch = sessionEpoch ?? State.LiveState.SessionEpoch,
        reducedMotion = State.Settings.UseReducedMotion
    };

    private void OnLiveTelemetryFrame(LiveTracePoint frame)
    {
        if (_disposed) return;
        _pendingTrendFrames.Enqueue(new PendingTrendFrame(frame, State.LiveState.SessionEpoch));
        while (_pendingTrendFrames.Count > 1200 && _pendingTrendFrames.TryDequeue(out _)) { }
        ScheduleTrendDrain();
    }

    private void ScheduleTrendDrain()
    {
        if (_disposed || Interlocked.Exchange(ref _trendDrainScheduled, 1) != 0) return;
        _ = InvokeAsync(DrainTrendFramesAsync);
    }

    private async Task DrainTrendFramesAsync()
    {
        try
        {
            if (!_tileChartsReady) return;
            while (!_disposed)
            {
                var sessionEpoch = State.LiveState.SessionEpoch;
                var frames = new List<LiveTracePoint>(90);
                while (frames.Count < 90 && _pendingTrendFrames.TryDequeue(out var pending))
                    if (pending.SessionEpoch == sessionEpoch) frames.Add(pending.Frame);
                if (frames.Count == 0) break;
                var tiles = Active.Tiles.Where(tile => tile.DisplayStyle == LiveMonitorDisplayStyle.Trend).ToArray();
                if (tiles.Length == 0) continue;
                var payload = frames.Select(frame => new
                {
                    atUnixMilliseconds = frame.At.ToUnixTimeMilliseconds(),
                    lap = frame.Lap,
                    lapDistancePercent = frame.LapDistancePercent,
                    values = tiles.ToDictionary(tile => tile.Id, tile => LiveTelemetryCatalog.TrendValue(tile.MetricId, frame, tile.Unit), StringComparer.Ordinal)
                }).ToArray();
                await JS.InvokeVoidAsync("iracingCoachLiveTelemetryTileCharts.append", _studioElement, payload, TrendOptions(sessionEpoch));
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) when (_disposed) { }
        finally
        {
            Volatile.Write(ref _trendDrainScheduled, 0);
            if (!_pendingTrendFrames.IsEmpty && _tileChartsReady && !_disposed) ScheduleTrendDrain();
        }
    }
    private void ToggleCustomize() { if (_editing) FinishCustomize(); else StartCustomize(); }
    private void StartCustomize() { _editing = true; _toolboxOpen = true; }
    private void ToggleToolbox() { _toolboxOpen = !_toolboxOpen; if (!_toolboxOpen) _openTileMenuId = null; }
    private async Task CloseToolbox()
    {
        _toolboxOpen = false;
        _openTileMenuId = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await _toolboxToggleElement.FocusAsync();
    }
    private void FinishCustomize() { _editing = false; _toolboxOpen = false; _openTileMenuId = null; _selectedTileId = null; }
    private void SelectTile(string id) { if (!_editing) return; if (_openTileMenuId != id) _openTileMenuId = null; _selectedTileId = id; }
    private void ToggleTileMenu(string id) { _selectedTileId = id; _openTileMenuId = _openTileMenuId == id ? null : id; }
    private async Task HandleStudioKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !_editing) return;
        if (_openTileMenuId is not null) _openTileMenuId = null;
        else if (_toolboxOpen) await CloseToolbox();
        else FinishCustomize();
    }

    private void ChangeLayout(ChangeEventArgs args)
    {
        var next = args.Value?.ToString() ?? LiveMonitorLayout.FactoryDefaultId;
        if (next == Preferences.ActiveLayoutId) return;
        var before = Capture();
        Preferences.ActiveLayoutId = next;
        CompleteMutation(before, "Dashboard switched.");
        _selectedTileId = null;
        _openTileMenuId = null;
    }

    private void NewLayout() { var before = Capture(); LiveMonitorLayouts.Create(Preferences); CompleteMutation(before, "New dashboard created."); _selectedTileId = null; }
    private void DuplicateLayout() { var before = Capture(); LiveMonitorLayouts.Duplicate(Preferences); CompleteMutation(before, "Dashboard duplicated."); _selectedTileId = null; }
    private void ResetLayout()
    {
        var before = Capture();
        if (!LiveMonitorLayouts.ResetActive(Preferences))
        {
            _editorMessage = "Factory dashboards are already at their default layout.";
            State.Notify(_editorMessage);
            return;
        }
        CompleteMutation(before, "Dashboard reset.");
        _selectedTileId = null;
    }
    private void DeleteLayout() { var before = Capture(); if (LiveMonitorLayouts.DeleteActive(Preferences)) { CompleteMutation(before, "Dashboard deleted."); _selectedTileId = null; } }

    private void RenameLayout(ChangeEventArgs args)
    {
        var name = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(name) || string.Equals(name, Active.Name, StringComparison.Ordinal)) return;
        var before = Capture();
        LiveMonitorLayouts.EnsureEditable(Preferences).Name = name;
        CompleteMutation(before, "Dashboard renamed.");
    }

    private void ChangeRows(ChangeEventArgs args) => ResizeGrid(Parse(args, Active.Rows), Active.Columns);
    private void ChangeColumns(ChangeEventArgs args) => ResizeGrid(Active.Rows, Parse(args, Active.Columns));
    private void ResizeGrid(int rows, int columns)
    {
        TryMutation(() => LiveMonitorLayouts.TryResizeGrid(LiveMonitorLayouts.EnsureEditable(Preferences), rows, columns, out _), $"Grid resized to {columns} x {rows}.", "Those dimensions cannot hold every widget.");
    }

    private void AddMetric(string id)
    {
        string? tileId = null;
        if (TryMutation(() => LiveMonitorLayouts.TryAddMetric(LiveMonitorLayouts.EnsureEditable(Preferences), id, out tileId), $"{LiveTelemetryCatalog.Get(id).Name} added.", "The grid is full."))
            _selectedTileId = tileId;
    }

    private void RemoveTile(string id)
    {
        if (TryMutation(() => LiveMonitorLayouts.RemoveTile(LiveMonitorLayouts.EnsureEditable(Preferences), id), "Widget removed.", "That widget is no longer present."))
        {
            if (_selectedTileId == id) _selectedTileId = null;
            if (_openTileMenuId == id) _openTileMenuId = null;
        }
    }

    private void ChangeTileStyle(string id, ChangeEventArgs args)
    {
        if (Enum.TryParse<LiveMonitorDisplayStyle>(args.Value?.ToString(), out var style)) SetTileStyle(id, style);
    }

    private void SetTileStyle(string id, LiveMonitorDisplayStyle style)
    {
        var definition = DefinitionForTile(id);
        if (definition is null || !definition.Styles.Contains(style)) return;
        MutateTile(id, tile => tile.DisplayStyle = style, $"Display changed to {StyleLabel(style)}.");
    }

    private void ChangeTileUnit(string id, ChangeEventArgs args)
    {
        var unit = args.Value?.ToString() ?? string.Empty;
        var definition = DefinitionForTile(id);
        if (definition is not null && definition.Units.Contains(unit)) MutateTile(id, tile => tile.Unit = unit, "Unit updated.");
    }

    private void ChangeTilePrecision(string id, ChangeEventArgs args)
    {
        var precision = Math.Clamp(Parse(args, 0), 0, 3);
        MutateTile(id, tile => tile.Precision = precision, "Precision updated.");
    }

    private void ChangeTileTrend(string id, ChangeEventArgs args)
    {
        if (!Enum.TryParse<LiveMonitorTrendDuration>(args.Value?.ToString(), out var duration)) return;
        var metricId = Active.Tiles.FirstOrDefault(tile => tile.Id == id)?.MetricId;
        if (metricId is not null && LiveTelemetryCatalog.TrendDurations(metricId).Contains(duration)) MutateTile(id, tile => tile.TrendDuration = duration, $"Chart history set to {TrendLabel(duration)}.");
    }

    private void SetTileAccent(string id, string accent)
    {
        if (AccentOptions.All(option => option.Value != accent)) return;
        MutateTile(id, tile => tile.Accent = accent, $"Widget color set to {AccentOptions.First(option => option.Value == accent).Label.ToLowerInvariant()}.");
    }

    private void MutateTile(string id, Action<LiveMonitorTile> update, string message)
    {
        TryMutation(() =>
        {
            var tile = LiveMonitorLayouts.EnsureEditable(Preferences).Tiles.FirstOrDefault(item => item.Id == id);
            if (tile is null) return false;
            update(tile);
            return true;
        }, message, "That widget is no longer present.");
    }

    [JSInvokable]
    public async Task<bool> CommitTilePlacement(string tileId, int row, int column, int rowSpan, int columnSpan)
    {
        var result = false;
        await InvokeAsync(() =>
        {
            var current = Active.Tiles.FirstOrDefault(tile => tile.Id == tileId);
            if (current is not null && current.Row == row && current.Column == column && current.RowSpan == rowSpan && current.ColumnSpan == columnSpan) { result = true; return; }
            result = TryMutation(() => LiveMonitorLayouts.TryPlaceTile(LiveMonitorLayouts.EnsureEditable(Preferences), tileId, row, column, rowSpan, columnSpan), $"Widget snapped to column {column + 1}, row {row + 1}, size {columnSpan} x {rowSpan}.", "That footprint cannot fit in this grid.");
            if (result) _selectedTileId = tileId;
            StateHasChanged();
        });
        return result;
    }

    [JSInvokable]
    public async Task<bool> DropMetric(string metricId, int row, int column)
    {
        var result = false;
        await InvokeAsync(() =>
        {
            string? tileId = null;
            result = TryMutation(() => LiveMonitorLayouts.TryAddMetric(LiveMonitorLayouts.EnsureEditable(Preferences), metricId, row, column, out tileId), $"{LiveTelemetryCatalog.Get(metricId).Name} added at column {column + 1}, row {row + 1}.", "That widget cannot fit in this grid.");
            if (result) _selectedTileId = tileId;
            StateHasChanged();
        });
        return result;
    }

    [JSInvokable]
    public async Task<bool> ReplaceMetric(string tileId, string metricId)
    {
        var result = false;
        await InvokeAsync(() =>
        {
            var current = Active.Tiles.FirstOrDefault(tile => tile.Id == tileId);
            if (current is null || !LiveTelemetryCatalog.TryGet(current.MetricId, out var replaced) || !LiveTelemetryCatalog.TryGet(metricId, out var replacement)) return;
            if (string.Equals(current.MetricId, metricId, StringComparison.Ordinal)) { result = true; return; }
            result = TryMutation(
                () => LiveMonitorLayouts.TryReplaceMetric(LiveMonitorLayouts.EnsureEditable(Preferences), tileId, metricId),
                $"{replaced.Name} replaced with {replacement.Name}.",
                "That widget is no longer available.");
            if (result) _selectedTileId = tileId;
            StateHasChanged();
        });
        return result;
    }

    [JSInvokable]
    public async Task<bool> ReplaceTile(string sourceTileId, string targetTileId)
    {
        var result = false;
        await InvokeAsync(() =>
        {
            var source = Active.Tiles.FirstOrDefault(tile => tile.Id == sourceTileId);
            var target = Active.Tiles.FirstOrDefault(tile => tile.Id == targetTileId);
            if (source is null || target is null || source.Id == target.Id) return;
            var sourceName = LiveTelemetryCatalog.Get(source.MetricId).Name;
            var targetName = LiveTelemetryCatalog.Get(target.MetricId).Name;
            result = TryMutation(
                () => LiveMonitorLayouts.TryReplaceTile(LiveMonitorLayouts.EnsureEditable(Preferences), sourceTileId, targetTileId),
                $"{targetName} replaced with {sourceName}.",
                "Those widgets are no longer available.");
            if (result) _selectedTileId = sourceTileId;
            StateHasChanged();
        });
        return result;
    }

    private void HandleTileKeyDown(string tileId, KeyboardEventArgs args)
    {
        if (!_editing) return;
        if (args.Key == "Delete") { RemoveTile(tileId); return; }
        if (args.Key is not ("ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown")) return;
        var tile = Active.Tiles.FirstOrDefault(item => item.Id == tileId);
        if (tile is null) return;
        var horizontal = args.Key == "ArrowRight" ? 1 : args.Key == "ArrowLeft" ? -1 : 0;
        var vertical = args.Key == "ArrowDown" ? 1 : args.Key == "ArrowUp" ? -1 : 0;
        if (args.ShiftKey)
            _ = TryMutation(() => LiveMonitorLayouts.TryPlaceTile(LiveMonitorLayouts.EnsureEditable(Preferences), tileId, tile.Row, tile.Column, tile.RowSpan + vertical, tile.ColumnSpan + horizontal), "Widget resized with the keyboard.", "That keyboard resize cannot fit.");
        else if (args.AltKey)
            _ = TryMutation(() => LiveMonitorLayouts.TryPlaceTile(LiveMonitorLayouts.EnsureEditable(Preferences), tileId, tile.Row + vertical, tile.Column + horizontal, tile.RowSpan, tile.ColumnSpan), "Widget moved with the keyboard.", "That keyboard move cannot fit.");
    }

    private bool TryMutation(Func<bool> mutation, string successMessage, string failureMessage)
    {
        var before = Capture();
        if (!mutation())
        {
            Restore(before);
            _editorMessage = failureMessage;
            State.Notify(failureMessage);
            return false;
        }
        CompleteMutation(before, successMessage);
        return true;
    }

    private void CompleteMutation(LayoutSnapshot before, string message)
    {
        _undo.Add(before);
        if (_undo.Count > 40) _undo.RemoveAt(0);
        _redo.Clear();
        _editorMessage = message;
        Save();
    }

    private void Undo()
    {
        if (_undo.Count == 0) return;
        _redo.Add(Capture());
        var previous = _undo[^1];
        _undo.RemoveAt(_undo.Count - 1);
        Restore(previous);
        _selectedTileId = null;
        _openTileMenuId = null;
        _editorMessage = "Layout change undone.";
        Save();
    }

    private void Redo()
    {
        if (_redo.Count == 0) return;
        _undo.Add(Capture());
        var next = _redo[^1];
        _redo.RemoveAt(_redo.Count - 1);
        Restore(next);
        _selectedTileId = null;
        _openTileMenuId = null;
        _editorMessage = "Layout change restored.";
        Save();
    }

    private LayoutSnapshot Capture() => new(Preferences.ActiveLayoutId, Preferences.UserLayouts.Select(LiveMonitorLayouts.Clone).ToList());
    private void Restore(LayoutSnapshot snapshot) { Preferences.ActiveLayoutId = snapshot.ActiveLayoutId; Preferences.UserLayouts = snapshot.UserLayouts.Select(LiveMonitorLayouts.Clone).ToList(); }
    private void Save() { _lastKnownLayoutSignature = LayoutSignature(); State.SaveLiveMonitorPreferences(); }
    private LiveTelemetryMetricDefinition? DefinitionForTile(string id) { var metricId = Active.Tiles.FirstOrDefault(tile => tile.Id == id)?.MetricId; return metricId is not null && LiveTelemetryCatalog.TryGet(metricId, out var definition) ? definition : null; }
    private string LayoutSignature() => LiveMonitorLayouts.EditorSignature(Preferences);

    private static int Parse(ChangeEventArgs args, int fallback) => int.TryParse(args.Value?.ToString(), out var value) ? value : fallback;
    private static string SourceLabel(LiveMonitorMetricSource source) => source switch { LiveMonitorMetricSource.Recorded => "Recorded", LiveMonitorMetricSource.Calculated => "Calculated", _ => "Coach" };
    private static string TileTitle(LiveTelemetryMetricDefinition definition, LiveTelemetryMetricReading reading) => reading.Available ? definition.Description : reading.AvailabilityMessage;
    private static string TileAccessibleName(LiveTelemetryMetricDefinition definition, LiveTelemetryMetricReading reading, LiveMonitorTile tile) => $"{definition.Name}, {reading.DisplayValue}{(string.IsNullOrWhiteSpace(reading.Unit) ? string.Empty : $" {reading.Unit}")}, {StyleLabel(tile.DisplayStyle)} widget, column {tile.Column + 1}, row {tile.Row + 1}, size {tile.ColumnSpan} by {tile.RowSpan}";
    private static bool UsesAccent(LiveMonitorDisplayStyle style) => style is LiveMonitorDisplayStyle.Gauge or LiveMonitorDisplayStyle.Bar or LiveMonitorDisplayStyle.Trend;
    private static string StyleLabel(LiveMonitorDisplayStyle style) => style switch { LiveMonitorDisplayStyle.Trend => "Chart", LiveMonitorDisplayStyle.Status => "Status", LiveMonitorDisplayStyle.Gauge => "Gauge", LiveMonitorDisplayStyle.Bar => "Bar", _ => "Number" };
    private static string StyleIcon(LiveMonitorDisplayStyle style) => style switch { LiveMonitorDisplayStyle.Trend => "chart", LiveMonitorDisplayStyle.Gauge => "gauge", LiveMonitorDisplayStyle.Bar => "bar", LiveMonitorDisplayStyle.Status => "status", _ => "number" };
    private static string StyleClass(LiveMonitorDisplayStyle style) => style == LiveMonitorDisplayStyle.Trend ? "chart" : style.ToString().ToLowerInvariant();
    private static string StyleSummary(LiveTelemetryMetricDefinition definition) => string.Join(", ", definition.Styles.Select(StyleLabel));
    private static string TrendLabel(LiveMonitorTrendDuration duration) => duration switch { LiveMonitorTrendDuration.Seconds15 => "15 seconds", LiveMonitorTrendDuration.Seconds30 => "30 seconds", LiveMonitorTrendDuration.Seconds60 => "60 seconds", LiveMonitorTrendDuration.OneLap => "1 lap", LiveMonitorTrendDuration.ThreeLaps => "3 laps", _ => duration.ToString() };
    private static double? LapProgress(LiveTracePoint point) => point.Lap is { } lap
        ? lap + Math.Clamp(point.LapDistancePercent ?? 0, 0, 1)
        : null;
    private static double MeterPercent(LiveTelemetryMetricReading reading) { var min = reading.Minimum ?? 0; var max = reading.Maximum ?? 100; return Math.Clamp((reading.NumericValue.GetValueOrDefault() - min) / Math.Max(.0001, max - min) * 100, 0, 100); }
    private static string GaugeDash(LiveTelemetryMetricReading reading) => $"{PercentToken(MeterPercent(reading))} 100";
    private static string PercentToken(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string TileStyle(LiveMonitorTile tile, LiveTelemetryMetricDefinition definition) => $"grid-column:{tile.Column + 1} / span {tile.ColumnSpan};grid-row:{tile.Row + 1} / span {tile.RowSpan};--tile-accent:{TileAccent(tile, definition)}";
    private static string TileAccent(LiveMonitorTile tile, LiveTelemetryMetricDefinition definition) => tile.Accent != "default" ? AccentToken(tile.Accent) : definition.Id switch { "speed" => "var(--telemetry-speed)", "throttle" => "var(--telemetry-throttle)", "brake" => "var(--telemetry-brake)", "steering" => "var(--telemetry-steering)", "fuel" or "fuel-laps" => "var(--telemetry-fuel)", _ => "var(--accent)" };
    private static string AccentToken(string accent) => accent switch { "blue" => "var(--telemetry-speed)", "green" => "var(--telemetry-throttle)", "amber" => "var(--telemetry-fuel)", "coral" => "var(--telemetry-brake)", "violet" => "var(--telemetry-steering)", _ => "var(--accent)" };

    private static string TrendPath(IReadOnlyList<double> values, LiveMonitorTrendShape shape)
    {
        var points = Downsample(values, 112);
        var min = points.Min(point => point.Value);
        var max = points.Max(point => point.Value);
        if (Math.Abs(max - min) < .0001) { min -= .5; max += .5; }
        static string Token(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
        var path = new List<string>(shape == LiveMonitorTrendShape.Step ? points.Count * 2 : points.Count);
        for (var index = 0; index < points.Count; index++)
        {
            var x = points[index].Index * 100d / Math.Max(1, values.Count - 1);
            var y = 41 - (points[index].Value - min) / (max - min) * 38;
            if (index == 0) path.Add($"M{Token(x)},{Token(y)}");
            else if (shape == LiveMonitorTrendShape.Step) { path.Add($"H{Token(x)}"); path.Add($"V{Token(y)}"); }
            else path.Add($"L{Token(x)},{Token(y)}");
        }
        return string.Join(" ", path);
    }

    private static IReadOnlyList<TrendPoint> Downsample(IReadOnlyList<double> values, int bucketCount)
    {
        if (values.Count <= bucketCount * 2) return values.Select((value, index) => new TrendPoint(index, value)).ToArray();
        var result = new List<TrendPoint>(bucketCount * 2 + 2) { new(0, values[0]) };
        for (var bucket = 0; bucket < bucketCount; bucket++)
        {
            var start = 1 + (int)((values.Count - 2L) * bucket / bucketCount);
            var end = 1 + (int)((values.Count - 2L) * (bucket + 1) / bucketCount);
            if (end <= start) continue;
            var minIndex = start; var maxIndex = start;
            for (var index = start + 1; index < end; index++) { if (values[index] < values[minIndex]) minIndex = index; if (values[index] > values[maxIndex]) maxIndex = index; }
            if (minIndex < maxIndex) { result.Add(new(minIndex, values[minIndex])); result.Add(new(maxIndex, values[maxIndex])); }
            else if (maxIndex < minIndex) { result.Add(new(maxIndex, values[maxIndex])); result.Add(new(minIndex, values[minIndex])); }
            else result.Add(new(minIndex, values[minIndex]));
        }
        result.Add(new(values.Count - 1, values[^1]));
        return result;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        State.LiveTelemetryFrame -= OnLiveTelemetryFrame;
        if (_tileChartsReady)
        {
            try { await JS.InvokeVoidAsync("iracingCoachLiveTelemetryTileCharts.dispose", _studioElement); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        if (_jsReady)
        {
            try { await JS.InvokeVoidAsync("iracingCoachLiveTelemetryLayout.dispose", _studioElement); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        _dotNetReference?.Dispose();
    }

