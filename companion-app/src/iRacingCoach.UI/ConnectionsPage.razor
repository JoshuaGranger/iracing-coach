@if (!Embedded)
{
    <div class="page-heading compact-heading"><div><span class="eyebrow">Settings</span><h1>Connections</h1></div></div>
}

<div class="connection-grid">
    <section class="surface-card connection-card" aria-labelledby="chatgpt-connection">
        <div class="connection-heading">
            <div><span class="eyebrow">Coaching explanations</span><h2 id="chatgpt-connection">ChatGPT</h2></div>
            <span class="status-label @(State.CoachEngine.ChatGptConnected ? "success" : State.CoachEngine.Installed ? "neutral" : "warning")">@(State.CoachEngine.ChatGptConnected ? "Connected" : "Not connected")</span>
        </div>
        <p>@CoachEngineMessage</p>
        @if (!State.CoachEngine.Installed || State.CoachEngine.Status is "repair" or "unavailable")
        {
            <button class="button secondary" @onclick="State.RepairInstallation">Repair installation</button>
        }
        @if (!string.IsNullOrWhiteSpace(State.CoachEngine.VerificationCode))
        {
            <div class="verification-code"><span>Verification code</span><strong>@State.CoachEngine.VerificationCode</strong></div>
        }
        @if (State.CoachEngine.Installed && State.CoachEngine.Running && !State.CoachEngine.ChatGptConnected)
        {
            <div class="button-row"><button class="button primary" @onclick="() => State.ConnectChatGptAsync()">Connect ChatGPT</button><button class="button secondary" @onclick="() => State.ConnectChatGptAsync(true)">Use a verification code</button></div>
        }
    </section>

    <section class="surface-card connection-card" aria-labelledby="garage61-connection">
        <div class="connection-heading">
            <div><span class="eyebrow">Reference laps</span><h2 id="garage61-connection">Garage61</h2></div>
            <span class="status-label @(State.Garage61.Available ? "success" : State.Garage61.Configured ? "warning" : "neutral")">@State.Garage61StatusLabel</span>
        </div>
        <p>@Garage61Message</p>
        <details class="settings-disclosure"><summary>Connection checks</summary>
        <dl class="connection-facts" aria-label="Garage61 connection checks">
            <div><dt>Credential</dt><dd>@Axis(State.Garage61.Credential)</dd></div>
            <div><dt>Authentication</dt><dd>@Axis(State.Garage61.Authentication)</dd></div>
            <div><dt>Permission</dt><dd>@Axis(State.Garage61.Permission)</dd></div>
            <div><dt>Availability</dt><dd>@Axis(State.Garage61.Availability)</dd></div>
        </dl>
        </details>
        <label class="connection-secret"><span>Personal access token<small>Saved for this Windows account.</small></span><input type="password" autocomplete="off" spellcheck="false" placeholder="@(State.Garage61.Configured ? "Enter a new token to replace the saved connection" : "Paste your Garage61 token")" @bind="State.Garage61KeyInput" @bind:event="oninput" /></label>
        <div class="button-row">
            <button class="button primary" disabled="@string.IsNullOrWhiteSpace(State.Garage61KeyInput)" @onclick="() => State.ConnectGarage61Async()">Connect Garage61</button>
            @if (State.Garage61.Configured) { <button class="button secondary" @onclick="() => State.DisconnectGarage61Async()">Disconnect</button> }
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    [Parameter] public bool Embedded { get; set; }
    private string CoachEngineMessage => !State.CoachEngine.Installed
        ? "Repair the installation to connect ChatGPT."
        : State.CoachEngine.Running ? State.CoachEngine.Message : "Coach Engine is restarting.";
    private string Garage61Message => State.Garage61.Message;
    private static string Axis(string value) => value.Replace('_', ' ') switch
    {
        "saved" => "Saved",
        "absent" => "Not saved",
        "valid" => "Valid",
        "rejected" => "Rejected",
        "granted" => "Granted",
        "denied" => "Denied",
        "available" => "Available",
        "unreachable" => "Unreachable",
        "timed out" => "Timed out",
        "insufficient scope" => "Scope needed",
        "unverified" => "Not checked",
        var label => label.Length == 0 ? "Not checked" : char.ToUpperInvariant(label[0]) + label[1..]
    };
}
