@inject CompanionState State

<section class="race-technical-data" data-analysis-section="technical" aria-label="Technical race data">
    @if (ActiveInvestigation is null)
    {
        <div class="technical-overview" data-technical-overview>
            <button type="button" class="technical-overview-card pit" data-technical-card="pit" @onclick='() => OpenInvestigation("pit")'>
                <span class="technical-card-heading"><span><ProductIcon Name="strategy" Size="17" />Pit strategy</span><span class="technical-card-heading-status"><span class="technical-state @PitStateClass">@PitState</span><ProductIcon Name="chevron-right" Size="15" /></span></span>
                <strong>@PitSummary</strong>
                <span class="technical-card-metrics @MetricDensityClass(PitCardMetrics.Count)" data-metric-count="@PitCardMetrics.Count">
                    @foreach (var metric in PitCardMetrics)
                    {
                        <span class="technical-card-metric @metric.Tone" data-group="@metric.Group" title="@MetricTooltip(metric)" aria-label="@MetricAriaLabel(metric)">
                            <small>@metric.Label</small><b>@metric.Value</b>
                        </span>
                    }
                </span>
                <span class="technical-card-foot"><b>What to carry forward</b><span>@PitTakeaway</span></span>
            </button>

            <button type="button" class="technical-overview-card tires" data-technical-card="tires" @onclick='() => OpenInvestigation("tires")'>
                <span class="technical-card-heading"><span><ProductIcon Name="tire" Size="17" />Tire management</span><span class="technical-card-heading-status"><span class="technical-state @TireStateClass">@TireState</span><ProductIcon Name="chevron-right" Size="15" /></span></span>
                <strong>@TireSummary</strong>
                <span class="technical-card-metrics @MetricDensityClass(TireCardMetrics.Count)" data-metric-count="@TireCardMetrics.Count">
                    @foreach (var metric in TireCardMetrics)
                    {
                        <span class="technical-card-metric @metric.Tone" data-group="@metric.Group" title="@MetricTooltip(metric)" aria-label="@MetricAriaLabel(metric)">
                            <small>@metric.Label</small><b>@metric.Value</b>
                        </span>
                    }
                </span>
                <span class="technical-card-foot"><b>What to carry forward</b><span>@TireTakeaway</span></span>
            </button>

            <button type="button" class="technical-overview-card fuel" data-technical-card="fuel" @onclick='() => OpenInvestigation("fuel")'>
                <span class="technical-card-heading"><span><ProductIcon Name="fuel" Size="17" />Fuel management</span><span class="technical-card-heading-status"><span class="technical-state @FuelStateClass">@FuelState</span><ProductIcon Name="chevron-right" Size="15" /></span></span>
                <strong>@FuelSummary</strong>
                <span class="technical-card-metrics @MetricDensityClass(FuelCardMetrics.Count)" data-metric-count="@FuelCardMetrics.Count">
                    @foreach (var metric in FuelCardMetrics)
                    {
                        <span class="technical-card-metric @metric.Tone" data-group="@metric.Group" title="@MetricTooltip(metric)" aria-label="@MetricAriaLabel(metric)">
                            <small>@metric.Label</small><b>@metric.Value</b>
                        </span>
                    }
                </span>
                <span class="technical-card-foot"><b>What to carry forward</b><span>@FuelTakeaway</span></span>
            </button>

            <button type="button" class="technical-overview-card racecraft" data-technical-card="racecraft" @onclick='() => OpenInvestigation("racecraft")'>
                <span class="technical-card-heading"><span><ProductIcon Name="analysis" Size="17" />Racecraft &amp; pace</span><span class="technical-card-heading-status"><span class="technical-state @PaceStateClass">@PaceState</span><ProductIcon Name="chevron-right" Size="15" /></span></span>
                <strong>@PaceSummary</strong>
                <span class="technical-card-metrics @MetricDensityClass(RacecraftCardMetrics.Count)" data-metric-count="@RacecraftCardMetrics.Count">
                    @foreach (var metric in RacecraftCardMetrics)
                    {
                        <span class="technical-card-metric @metric.Tone" data-group="@metric.Group" title="@MetricTooltip(metric)" aria-label="@MetricAriaLabel(metric)">
                            <small>@metric.Label</small><b>@metric.Value</b>
                        </span>
                    }
                </span>
                @if (Garage61Laps.Count > 0)
                {
                    <span class="technical-card-reference"><small>Reference pace</small><b>@ReferencePaceSummary</b></span>
                }
                <span class="technical-card-foot"><b>What to carry forward</b><span>@PaceTakeaway</span></span>
            </button>
        </div>
    }
    else
    {
        <div class="technical-investigation" data-technical-investigation="@ActiveInvestigation">
            <header class="technical-investigation-header">
                <button type="button" class="technical-back" data-technical-back @onclick="CloseInvestigation"><span aria-hidden="true">&larr;</span> Back</button>
                <div><span class="eyebrow">Technical data</span><h2>@InvestigationTitle</h2></div>
                <span class="technical-investigation-summary">@InvestigationSummary</span>
            </header>

            <div class="technical-investigation-content @MetricDensityClass(ActiveMetrics.Count)">
                <section class="technical-complete-findings" data-technical-complete-findings>
                    <header><span>Race findings</span><strong>@ActiveTakeaway</strong></header>
                    @if (ActiveMetrics.Count == 0)
                    {
                        <p class="technical-findings-empty">No supported finding is available for this category.</p>
                    }
                    else
                    {
                        <div class="technical-findings-list @MetricDensityClass(ActiveMetrics.Count)" data-metric-count="@ActiveMetrics.Count">
                            @foreach (var metric in ActiveMetrics)
                            {
                                <article class="@MetricTone(metric)" title="@MetricDetailTooltip(metric)" aria-label="@MetricDetailAriaLabel(metric)">
                                    <header><span class="technical-finding-group">@MetricGroupLabel(metric)</span><div><span>@metric.Label</span><strong>@metric.Value</strong></div></header>
                                    @if (!string.IsNullOrWhiteSpace(metric.Detail)) { <p>@metric.Detail</p> }
                                    @if (!string.IsNullOrWhiteSpace(metric.Action)) { <small><b>Next lap</b>@metric.Action</small> }
                                </article>
                            }
                        </div>
                    }
                </section>
                <div class="technical-investigation-visual">
            @switch (ActiveInvestigation)
            {
                case "pit":
                    <div class="technical-investigation-body pit-investigation">
                        @if (PitRuns.Count == 0)
                        {
                            <div class="technical-no-stop-story" data-technical-no-stop>
                                <div class="technical-decision-dial"><strong>0</strong><span>recorded stops</span></div>
                                <div class="technical-decision-copy">
                                    <span class="eyebrow">What happened</span>
                                    <h3>@NoStopHeadline</h3>
                                    <p>@NoStopExplanation</p>
                                    <div class="technical-decision-facts">
                                        <span><small>Race distance</small><b>@ScheduledDistance</b></span>
                                        <span><small>Longest green run</small><b>@LongestRun</b></span>
                                        <span><small>Fuel range</small><b>@FuelRange</b></span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <nav class="technical-record-selector" aria-label="Recorded pit stops">
                                @foreach (var run in PitRuns)
                                {
                                    <button type="button" class="@(_selectedRunNumber == run.Number ? "selected" : null)" aria-pressed="@(_selectedRunNumber == run.Number ? "true" : "false")" @onclick="() => SelectRun(run.Number)"><span>After run @run.Number</span><b>@PitLap(run)</b></button>
                                }
                            </nav>
                            @if (SelectedPitRun is { } pitRun)
                            {
                                <div class="technical-pit-timeline" aria-label="Recorded pit-service timeline">
                                    <span class="technical-pit-timeline-label">Start</span>
                                    <i></i>
                                    @foreach (var recordedRun in PitRuns)
                                    {
                                        <b style="--pit-at:@PitPosition(recordedRun)" title="@PitTimelineTitle(recordedRun)"><span>@PitCall(recordedRun)</span></b>
                                    }
                                    <span class="technical-pit-timeline-label finish">Finish</span>
                                </div>
                                <div class="technical-pit-review">
                                    <section class="technical-tire-call" data-tire-call="@TireCallKey(pitRun)">
                                        <header><span>Tire call</span><strong>@TireCallLabel(pitRun)</strong></header>
                                        <div class="technical-tire-call-car" aria-label="@TireCallAriaLabel(pitRun)">
                                            @foreach (var corner in TireCornerOrder)
                                            {
                                                <span class="@(TireChanged(pitRun, corner) ? "changed" : "kept")" data-corner="@corner"><b>@corner</b><small>@(TireChanged(pitRun, corner) ? "changed" : "kept")</small></span>
                                            }
                                            <i aria-hidden="true"></i>
                                        </div>
                                        <footer>@ChangedTires(pitRun)</footer>
                                    </section>
                                    <div class="technical-detail-grid">
                                        <article class="technical-detail-hero"><span>Service window</span><strong>@Duration(pitRun.PitStop?.ServiceSeconds)</strong><small>@PitLap(pitRun)</small></article>
                                        <article><span>Fuel added</span><strong>@Gallons(pitRun.PitStop?.FuelAddedGallons)</strong></article>
                                        <article><span>Pit-cycle positions</span><strong>@Positions(pitRun.PitStop?.PitCyclePositionChange)</strong></article>
                                        <article><span>Damage repair</span><strong>@Duration(pitRun.PitStop?.DamageRepairedSeconds)</strong></article>
                                        <article><span>Penalty service</span><strong>@Duration(pitRun.PitStop?.PenaltyServedSeconds)</strong></article>
                                        <article><span>Fuel range after stop</span><strong>@Laps(pitRun.PitStop?.EstimatedFuelLapsRemaining)</strong></article>
                                        <article><span>Race laps remaining</span><strong>@Laps(pitRun.PitStop?.RaceLapsRemainingAfterStop)</strong></article>
                                        <article><span>Flag at stop</span><strong>@(pitRun.EndedUnderCaution is true ? "Caution" : pitRun.EndedUnderCaution is false ? "Green" : "Unknown")</strong></article>
                                    </div>
                                    @if (TwoVsFourMetrics.Count > 0)
                                    {
                                        <section class="technical-two-vs-four" data-two-vs-four="supported">
                                            <header><span>Two tires vs four</span><strong>Both calls happened in this race</strong></header>
                                            <div>
                                                @foreach (var metric in TwoVsFourMetrics)
                                                {
                                                    <span class="@MetricTone(metric)"><small>@metric.Label</small><b>@metric.Value</b><em>@metric.Detail</em></span>
                                                }
                                            </div>
                                        </section>
                                    }
                                    else if (HasTwoAndFourCalls)
                                    {
                                        <section class="technical-two-vs-four unavailable" data-two-vs-four="inconclusive">
                                            <header><span>Two tires vs four</span><strong>No like-for-like result</strong></header>
                                            <p>Both call types occurred, but the following pace, position, wear, or service context was not complete enough to state which call performed better.</p>
                                        </section>
                                    }
                                    else if (HasConfirmedTireCall)
                                    {
                                        <section class="technical-two-vs-four unavailable" data-two-vs-four="single-call">
                                            <header><span>Two tires vs four</span><strong>No direct race result</strong></header>
                                            <p>This race exercised only one confirmed call type. The selected stop remains useful on its own, but it does not establish whether two or four tires was faster overall.</p>
                                        </section>
                                    }
                                </div>
                            }
                        }
                    </div>
                    break;
                case "tires":
                    <div class="technical-investigation-body tire-investigation">
                        <div class="technical-tire-investigation-shell @(TireDriverMetrics.Count > 0 ? "with-dynamics" : null)">
                            <section class="technical-tire-source measured" data-tire-source="measured">
                                <header><strong>Tire condition at stop</strong></header>
                                @if (TireStops.Count == 0)
                                {
                                    <TechnicalUnavailable Title="No tire condition available" Detail="This race did not produce a completed outer, middle, and inner tire reading." Action="Use the dynamics panel for immediate technique review; a completed stop will add physical tire condition next time." />
                                }
                                else
                                {
                                    <nav class="technical-record-selector" aria-label="Tire snapshots">
                                        @foreach (var run in TireStops)
                                        {
                                            <button type="button" class="@(_selectedRunNumber == run.Number ? "selected" : null)" aria-pressed="@(_selectedRunNumber == run.Number ? "true" : "false")" @onclick="() => SelectRun(run.Number)"><span>@PitLap(run)</span><b>@LowestTire(run)</b></button>
                                        }
                                    </nav>
                                    @if (SelectedTireRun?.PitStop is { } pit)
                                    {
                                        <div class="technical-tire-grid">
                                            @foreach (var tire in TireConditions(pit))
                                            {
                                                <article class="technical-tire-card">
                                                    <header><strong>@tire.Corner</strong><span>@(ChangedAtStop(SelectedTireRun, tire.Corner) ? "Changed" : "Kept")</span></header>
                                                    <div class="technical-tire-bands" aria-label="@tire.Corner wear outer middle inner">
                                                        @foreach (var band in TireBands(tire))
                                                        {
                                                            <span><small>@band.Label</small><b>@Percent(band.Value)</b></span>
                                                        }
                                                    </div>
                                                    <footer>
                                                        <span class="technical-tire-vital"><small>Carcass</small><b>@Temperature(AverageBand(tire.CarcassTemperatureF))</b></span>
                                                        <span class="technical-tire-vital"><small>Surface</small><b>@Temperature(AverageBand(tire.SurfaceTemperatureF))</b></span>
                                                        <span class="technical-tire-vital"><small>Pressure</small><b>@Pressure(tire.PressurePsi)</b></span>
                                                    </footer>
                                                </article>
                                            }
                                        </div>
                                    }
                                }
                            </section>
                            <section class="technical-tire-source predicted" data-tire-source="predicted">
                                <header><strong>Next-run outlook</strong></header>
                                @if (!PredictionAvailable)
                                {
                                    <TechnicalUnavailable Title="Tire estimate unavailable" Detail="@PredictionUnavailableReason" Action="Complete more comparable green-flag runs with tire endpoints to improve this estimate." />
                                }
                                else if (Workspace.TirePrediction is { } prediction)
                                {
                                    <div class="technical-prediction-summary">
                                        <span><small>Estimated life</small><b>@PredictionNumber(prediction.LapsRemaining, "laps")</b></span>
                                        <span><small>Pace cost</small><b>@PredictionRange(prediction.PaceCostSeconds, prediction.PaceCostLowSeconds, prediction.PaceCostHighSeconds, "s")</b></span>
                                        <span><small>Capability pace</small><b>@PredictionPace(prediction)</b></span>
                                        <span><small>Confidence</small><b>@PredictionConfidence(prediction)</b></span>
                                    </div>
                                    <div class="technical-predicted-tires">
                                        @foreach (var tire in prediction.Tires)
                                        {
                                            <article><strong>@tire.Corner</strong>@foreach (var band in PredictionBands(tire)) { <span><small>@band.Label</small><b>@PredictionBand(band.Value)</b></span> }</article>
                                        }
                                    </div>
                                }
                            </section>
                            @if (TireDriverMetrics.Count > 0)
                            {
                                <section class="technical-tire-source dynamics" data-tire-dynamics>
                                    <header><strong>Dynamics &amp; balance</strong></header>
                                    <div class="technical-dynamics-grid">
                                        @foreach (var metric in TireDriverMetrics)
                                        {
                                            <article class="@MetricTone(metric)">
                                                <span><small>@metric.Label</small><b>@metric.Value</b></span>
                                                <i aria-hidden="true"><b></b></i>
                                                @if (!string.IsNullOrWhiteSpace(metric.Action)) { <p>@metric.Action</p> }
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                    break;
                case "fuel":
                    <div class="technical-investigation-body fuel-investigation">
                        @if (FuelRuns.Count == 0 && !Workspace.Strategy.GreenFuelGallonsPerLap.HasValue)
                        {
                            <TechnicalUnavailable Title="Fuel use unavailable" Detail="No stint consumption or per-lap fuel estimate is available for this race." Action="Complete green-flag laps with fuel level available to calculate consumption and range." />
                        }
                        else
                        {
                            <section class="technical-fuel-decision" data-fuel-decision>
                                <div>
                                    <span class="eyebrow">Race-distance decision</span>
                                    <h3>@FuelDecisionHeadline</h3>
                                    <p>@FuelDecisionExplanation</p>
                                </div>
                                <div class="technical-fuel-distance" style="--fuel-distance:@FuelDistancePercent">
                                    <span><b>@ScheduledDistance</b><small>scheduled</small></span>
                                    <i><b></b><em></em></i>
                                    <span><b>@FuelRange</b><small>estimated range</small></span>
                                </div>
                            </section>
                            <div class="technical-fuel-summary">
                                <article><span>Green-lap use</span><strong>@FuelPerGreenLap</strong></article>
                                <article><span>Caution-lap use</span><strong>@Gallons(Workspace.Strategy.CautionFuelGallonsPerLap)</strong></article>
                                <article><span>All-green range</span><strong>@FuelRange</strong></article>
                                <article><span>Minimum stops</span><strong>@(AuthoritativeFuelStops?.ToString() ?? "—")</strong></article>
                            </div>
                            <div class="technical-bar-list" aria-label="Fuel consumed by run">
                                @foreach (var run in FuelRuns)
                                {
                                    <div><span>Run @run.Number</span><i><b style="width:@FuelBarWidth(run)"></b></i><strong>@Gallons(run.FuelUsedGallons)</strong><small>@run.GreenLaps green</small></div>
                                }
                            </div>
                        }
                    </div>
                    break;
                default:
                    <div class="technical-investigation-body pace-investigation">
                        @if (ComparableRuns.Count > 0)
                        {
                            <nav class="technical-record-selector" aria-label="Comparable runs">
                                @foreach (var run in ComparableRuns)
                                {
                                    <button type="button" class="@(_selectedRunNumber == run.Number ? "selected" : null)" aria-pressed="@(_selectedRunNumber == run.Number ? "true" : "false")" @onclick="() => SelectRun(run.Number)"><span>Run @run.Number</span><b>@PaceTrend(run)</b></button>
                                }
                            </nav>
                        }
                        <section class="technical-racecraft-story" data-racecraft-story>
                        @if (ComparableRuns.Count == 0)
                        {
                            <div class="technical-racecraft-no-comparison" data-racecraft-no-comparison>
                                <TechnicalUnavailable Title="Clean-run pace comparison unavailable" Detail="Cautions, pit laps, or missing timing prevented a comparable early-to-late run." Action="Use the race-pace and controls findings below now; a multi-lap green run will add the early-to-late vector next time." />
                            </div>
                        }
                        else if (SelectedComparableRun is { } paceRun)
                        {
                            <div class="technical-pace-vector @PaceDirectionClass(paceRun)">
                                <span><small>Early</small><strong>@LapTime(paceRun.EarlyAverageLapSeconds)</strong></span>
                                <i aria-hidden="true"><b></b></i>
                                <em>@Delta(paceRun.EarlyToLateDeltaSeconds)</em>
                                <span><small>Late</small><strong>@LapTime(paceRun.LateAverageLapSeconds)</strong></span>
                                <span class="technical-pace-vector-context"><b>@paceRun.GreenLaps green laps</b><small>@PaceTrend(paceRun)</small></span>
                            </div>
                        }
                        @if (RacecraftMetricGroups.Count > 0)
                        {
                            <div class="technical-racecraft-groups">
                                @foreach (var group in RacecraftMetricGroups)
                                {
                                    <article>
                                        <header>@GroupTitle(group.Key)</header>
                                        <div>
                                            @foreach (var metric in group.Metrics)
                                            {
                                                <span class="@MetricTone(metric)"><small>@metric.Label</small><b>@metric.Value</b></span>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        </section>
                        @if (Garage61Laps.Count > 0)
                        {
                            <section class="technical-reference-laps" data-garage61-references>
                                <header>
                                    <span>Comparable reference laps</span>
                                    @if (State.Garage61ReferenceActionVisible)
                                    {
                                        <button type="button" class="technical-reference-action" disabled="@State.IsGarage61ReferenceSyncing" @onclick="FindGarage61ReferencesAsync">@(State.IsGarage61ReferenceSyncing ? "Refreshing…" : "Refresh")</button>
                                    }
                                </header>
                                <div>
                                    @foreach (var reference in Garage61Laps)
                                    {
                                        <article>
                                            <span>@ReferenceRole(reference)</span>
                                            <strong>@LapTime(reference.LapTimeSeconds)</strong>
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                        else if (State.Garage61ReferenceActionVisible)
                        {
                            <section class="technical-reference-empty" data-garage61-reference-action>
                                <span><strong>Comparable reference laps</strong><small>Find laps that can sharpen this race comparison.</small></span>
                                <button type="button" class="technical-reference-action" disabled="@State.IsGarage61ReferenceSyncing" @onclick="FindGarage61ReferencesAsync">@(State.IsGarage61ReferenceSyncing ? "Finding…" : "Find reference laps")</button>
                            </section>
                        }
                        @if (State.Garage61ReferenceMessage.Length > 0)
                        {
                            <p class="technical-reference-message" role="status">@State.Garage61ReferenceMessage</p>
                        }
                    </div>
                    break;
            }
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    [Parameter, EditorRequired] public RaceCard Card { get; set; } = null!;

    private string? ActiveInvestigation { get; set; }
    private int? _selectedRunNumber;

    private IReadOnlyList<AnalysisRun> PitRuns => Workspace.Runs.Where(run => run.PitStop is not null).OrderBy(run => run.Number).ToArray();
    private IReadOnlyList<AnalysisRun> TireStops => PitRuns.Where(run => run.PitStop is { } pit && (pit.TireConditions?.Count > 0 || LegacyWear(pit).Any(value => value.HasValue))).ToArray();
    private IReadOnlyList<AnalysisRun> FuelRuns => Workspace.Runs.Where(run => run.FuelUsedGallons.HasValue).OrderBy(run => run.Number).ToArray();
    private IReadOnlyList<AnalysisRun> ComparableRuns => Workspace.Runs.Where(run => run.ComparisonEligible && (run.EarlyAverageLapSeconds.HasValue || run.LateAverageLapSeconds.HasValue)).OrderBy(run => run.Number).ToArray();
    private AnalysisRun? SelectedPitRun => PitRuns.FirstOrDefault(run => run.Number == _selectedRunNumber) ?? PitRuns.FirstOrDefault();
    private AnalysisRun? SelectedTireRun => TireStops.FirstOrDefault(run => run.Number == _selectedRunNumber) ?? TireStops.FirstOrDefault();
    private AnalysisRun? SelectedComparableRun => ComparableRuns.FirstOrDefault(run => run.Number == _selectedRunNumber) ?? ComparableRuns.FirstOrDefault();
    private AnalysisRun? LongestGreenRun => Workspace.Runs.OrderByDescending(run => run.GreenLaps).FirstOrDefault();
    private AnalysisRun? RepresentativePaceRun => ComparableRuns.OrderByDescending(run => run.GreenLaps).ThenBy(run => run.Number).FirstOrDefault();
    private AnalysisRun? LowestRemainingTireRun => Workspace.Runs.Where(run => run.TireRemainingPercent.HasValue).OrderBy(run => run.TireRemainingPercent).FirstOrDefault();
    private AnalysisTechnicalInsight? PitInsight => Insight("pit");
    private AnalysisTechnicalInsight? TireInsight => Insight("tires");
    private AnalysisTechnicalInsight? FuelInsight => Insight("fuel");
    private AnalysisTechnicalInsight? RacecraftInsight => Insight("racecraft");
    private AnalysisTechnicalInsight? Insight(string key) => Workspace.TechnicalInsights?.FirstOrDefault(item => item.Key.Equals(key, StringComparison.OrdinalIgnoreCase));
    private AnalysisTechnicalInsight? ActiveInsight => ActiveInvestigation switch { "pit" => PitInsight, "tires" => TireInsight, "fuel" => FuelInsight, "racecraft" => RacecraftInsight, _ => null };
    private IReadOnlyList<AnalysisTechnicalMetric> ActiveMetrics => ActiveInsight?.Metrics ?? [];
    private IReadOnlyList<AnalysisTechnicalMetric> TwoVsFourMetrics => ActiveMetrics.Where(metric => metric.Label.StartsWith("2 vs 4", StringComparison.OrdinalIgnoreCase)).ToArray();
    private IReadOnlyList<AnalysisTechnicalMetric> TireDriverMetrics => ActiveMetrics.Where(metric => metric.Group is "tire events" or "driver load" or "balance" or "pace").ToArray();
    private IReadOnlyList<MetricGroup> RacecraftMetricGroups => ActiveMetrics
        .GroupBy(metric => string.IsNullOrWhiteSpace(metric.Group) ? "race" : metric.Group, StringComparer.OrdinalIgnoreCase)
        .Select(group => new MetricGroup(group.Key, group.ToArray()))
        .ToArray();
    private string ActiveTakeaway => InsightTakeaway(ActiveInsight) ?? "Open the detail view to review the available race data.";
    private double? FastestCleanSeconds => Workspace.Traces.Where(trace => trace.IsComparable() && trace.LapTimeSeconds.HasValue).Select(trace => trace.LapTimeSeconds).Min();
    private int IncidentPoints => (Workspace.Damage.Incidents ?? []).Sum(incident => incident.Points);
    private static IReadOnlyList<string> TireCornerOrder { get; } = ["LF", "RF", "LR", "RR"];
    private bool HasConfirmedTireCall => PitRuns.Any(run => run.PitStop?.TiresChanged is { Count: 2 or 4 });
    private bool HasTwoAndFourCalls => PitRuns.Any(run => run.PitStop?.TiresChanged?.Count == 2)
        && PitRuns.Any(run => run.PitStop?.TiresChanged?.Count == 4);
    private string PitSummary => PitRuns.Count switch { 0 => "No stop", 1 => "One stop", _ => $"{PitRuns.Count} stops" };
    private string LongestRun => LongestGreenRun is null ? "—" : $"{LongestGreenRun.GreenLaps} laps";
    private string RecordedServiceTime { get { var total = PitRuns.Sum(run => run.PitStop?.ServiceSeconds ?? 0); return Duration(total > 0 ? total : null); } }
    private string TireSummary => TireStops.Count > 0 ? "Pit-stop tire condition" : "No tire snapshot";
    private string MostTireWearReading => MostRecordedTireWear() is { } value ? $"{value:0.0}%" : "—";
    private int TireChangeCount => PitRuns.Sum(run => run.PitStop?.TiresChanged?.Count ?? 0);
    private string FuelSummary => Workspace.Strategy.GreenFuelGallonsPerLap.HasValue ? "Fuel baseline available" : FuelRuns.Count > 0 ? "Consumption by run" : "Fuel use unavailable";
    private string FuelPerGreenLap => Gallons(Workspace.Strategy.GreenFuelGallonsPerLap);
    private RacePlanDecisionView? FuelPlan => Workspace.Strategy.FuelPlan;
    private bool FuelPlanUsable => FuelPlan is { IsUsable: true };
    private bool NoStopAuthorized => FuelPlan is { IsUsable: true, MinimumStops: 0, NoStopLanguagePermitted: true };
    private int? AuthoritativeFuelStops => FuelPlanUsable ? FuelPlan?.MinimumStops : null;
    private string FuelRange => Laps(FuelPlan?.AllGreenRangeLaps);
    private string FuelReserve => FuelPlan?.ReserveFuelLiters is { } reserveLiters
        ? Gallons(reserveLiters / 3.785411784)
        : "—";
    private int DisplayLapLimit => Workspace.DeclaredLapLimit > 0 ? Workspace.DeclaredLapLimit : Workspace.ScheduledLaps;
    private double DisplayTimeLimitMinutes => Workspace.DeclaredTimeLimitMinutes > 0 ? Workspace.DeclaredTimeLimitMinutes : Workspace.ScheduledMinutes;
    private string ScheduledDistance => (DisplayLapLimit, DisplayTimeLimitMinutes) switch
    {
        (> 0, > 0) => $"{DisplayLapLimit} laps / {DisplayTimeLimitMinutes:0.#} minutes configured",
        (> 0, _) => $"{DisplayLapLimit} laps",
        (_, > 0) => $"{DisplayTimeLimitMinutes:0.#} minutes",
        _ => "Distance unavailable"
    };
    private string NoStopHeadline => NoStopAuthorized
        ? "The race fit inside the fuel window"
        : "No service decision was exercised";
    private string NoStopExplanation => NoStopAuthorized
        ? $"The backend decision carried a {FuelPlan!.FinalStintMarginLaps:0.0}-lap final-stint margin and permitted no-stop language. Tire-call performance cannot be compared because no service was recorded."
        : "No pit service was recorded, so there is no measured two-tire, four-tire, fuel-only, or pit-cycle outcome to compare for this race.";
    private string FuelDecisionHeadline => NoStopAuthorized
        ? $"Stay out: backend margin {FuelPlan!.FinalStintMarginLaps:0.0} laps"
        : AuthoritativeFuelStops is > 0 and var stops
            ? $"Plan at least {stops} fuel stop{(stops == 1 ? string.Empty : "s")}"
            : "Use the race burn as the next planning baseline";
    private string FuelDecisionExplanation => NoStopAuthorized
        ? $"For this backend-owned decision, protect the transported {FuelPlan!.FinalStintMarginLaps:0.0}-lap final-stint margin and reassess only if live consumption rises."
        : AuthoritativeFuelStops is > 0
            ? $"The backend decision requires {AuthoritativeFuelStops} stop{(AuthoritativeFuelStops == 1 ? string.Empty : "s")}. Use its equal-stint targets and the recorded run bars below; do not re-decide from the displayed range."
            : FuelPlan?.UnavailableReason ?? "The race supplied a consumption baseline, but the authoritative fuel decision is unavailable.";
    private string FuelDistancePercent
    {
        get
        {
            var range = FuelPlan?.AllGreenRangeLaps ?? 0;
            var scheduled = Math.Max(Workspace.ScheduledLaps, 0);
            var scale = Math.Max(range, scheduled);
            var percent = scale <= 0 ? 0 : Math.Clamp(scheduled / scale * 100, 0, 100);
            return percent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
        }
    }
    private string PaceSummary => ComparableRuns.Count > 0 ? $"{ComparableRuns.Count} clean run comparison{(ComparableRuns.Count == 1 ? string.Empty : "s")}" : "No clean run comparison";
    private string ReferencePaceSummary => Garage61Laps.Count == 0
        ? "—"
        : $"{LapTime(Garage61Laps.Min(lap => lap.LapTimeSeconds))} · {Garage61Laps.Count} lap{(Garage61Laps.Count == 1 ? string.Empty : "s")}";
    private string FastestCleanLap => LapTime(FastestCleanSeconds);
    private string IncidentSummary => (Workspace.Damage.Incidents ?? []).Count == 0 ? "None" : $"x{IncidentPoints}";
    private string InvestigationTitle => ActiveInvestigation switch { "pit" => "Pit strategy", "tires" => "Tire condition", "fuel" => "Fuel use", _ => "Racecraft & pace" };
    private string InvestigationSummary => ActiveInvestigation switch { "pit" => PitSummary, "tires" => TireSummary, "fuel" => FuelSummary, _ => PaceSummary };
    private string PitState => InsightRating(PitInsight) ?? (AuthoritativeFuelStops switch
    {
        { } minimum when Workspace.PitStops <= minimum => "On all-green target",
        { } minimum when Workspace.PitStops == minimum + 1 => "One extra stop",
        { } minimum when Workspace.PitStops > minimum => $"{Workspace.PitStops - minimum} extra stops",
        _ => PitRuns.Count > 0 ? "Available" : "Unavailable"
    });
    private string PitStateClass => InsightStateClass(PitInsight) ?? (PitState switch { "On all-green target" => "positive", "Available" => "neutral", "Unavailable" => "unavailable", _ => "attention" });
    private string PitTakeaway => InsightTakeaway(PitInsight) ?? (AuthoritativeFuelStops is { } minimum
        ? Workspace.PitStops <= minimum
            ? $"{Workspace.PitStops} stop{(Workspace.PitStops == 1 ? string.Empty : "s")}; the all-green target was {minimum}."
            : $"Review the {Workspace.PitStops - minimum} stop difference from the all-green target."
        : PitRuns.Count > 0 ? $"Start with the {Duration(PitRuns.Max(run => run.PitStop?.ServiceSeconds ?? 0))} longest service window." : "No stop outcome can be evaluated.");
    private string TireState => InsightRating(TireInsight) ?? (LowestRemainingTireRun?.TireRemainingPercent switch { >= 70 => "Strong margin", >= 45 => "Moderate margin", < 45 => "Low margin", _ => TireStops.Count > 0 ? "Snapshots available" : "Unavailable" });
    private string TireStateClass => InsightStateClass(TireInsight) ?? (TireState switch { "Strong margin" => "positive", "Moderate margin" or "Snapshots available" => "neutral", "Low margin" => "attention", _ => "unavailable" });
    private string TireTakeaway => InsightTakeaway(TireInsight) ?? (LowestRemainingTireRun is { } run
        ? $"{run.TireName} was lowest at {run.TireRemainingPercent:0.0}% remaining."
        : TireStops.Count > 0 ? "Use the stop snapshots to compare inner, middle, and outer condition." : "No tire-condition outcome can be evaluated.");
    private string FuelState => InsightRating(FuelInsight) ?? (NoStopAuthorized
        ? "Full-race range"
        : AuthoritativeFuelStops is > 0
            ? "Stop required"
            : FuelPlan?.AllGreenRangeLaps.HasValue == true
                ? "Consumption available"
                : FuelRuns.Count > 0 ? "Consumption available" : "Unavailable");
    private string FuelStateClass => InsightStateClass(FuelInsight) ?? (FuelState switch { "Full-race range" => "positive", "Stop required" => "attention", "Consumption available" => "neutral", _ => "unavailable" });
    private string FuelTakeaway => InsightTakeaway(FuelInsight) ?? (AuthoritativeFuelStops is { } minimum
        ? $"All-green target: {minimum} stop{(minimum == 1 ? string.Empty : "s")} plus {FuelReserve} reserve."
        : FuelRuns.Count > 0 ? $"Run {FuelRuns.MaxBy(run => run.FuelUsedGallons)?.Number} used the most fuel." : "No fuel outcome can be evaluated.");
    private string PaceState => InsightRating(RacecraftInsight) ?? (RepresentativePaceRun?.PaceSlopeSecondsPerLap switch { > .02 => "Falling off", < -.01 => "Improving", not null => "Stable", _ => ComparableRuns.Count > 0 ? "Comparable" : "Unavailable" });
    private string PaceStateClass => InsightStateClass(RacecraftInsight) ?? (PaceState switch { "Stable" or "Improving" => "positive", "Comparable" => "neutral", "Falling off" => "attention", _ => "unavailable" });
    private string PaceTakeaway => InsightTakeaway(RacecraftInsight) ?? (RepresentativePaceRun is { } run
        ? $"Run {run.Number}: {PaceTrend(run)} across {run.GreenLaps} green laps."
        : "No clean run is long enough for a pace outcome.");

    private IReadOnlyList<CardMetric> PitCardMetrics => CardMetrics(PitInsight,
        new("Stops", Workspace.PitStops.ToString(), "measured"), new("Longest run", LongestRun, "derived"), new("Service", RecordedServiceTime, "measured"));
    private IReadOnlyList<CardMetric> TireCardMetrics => CardMetrics(TireInsight,
        new("Snapshots", TireStops.Count.ToString(), "measured"), new("Most wear", MostTireWearReading, "measured"), new("Changed", TireChangeCount.ToString(), "measured"));
    private IReadOnlyList<CardMetric> FuelCardMetrics => CardMetrics(FuelInsight,
        new("Green lap", FuelPerGreenLap, "measured"), new("Range", FuelRange, "derived"), new("Reserve", FuelReserve, "calculated"));
    private IReadOnlyList<CardMetric> RacecraftCardMetrics => CardMetrics(RacecraftInsight,
        new("Fastest clean", FastestCleanLap, "measured"), new("Comparable runs", ComparableRuns.Count.ToString(), "derived"), new("Incidents", IncidentSummary, "measured"));
    private static IReadOnlyList<CardMetric> CardMetrics(AnalysisTechnicalInsight? insight, params CardMetric[] fallback)
    {
        var metrics = insight?.Metrics.Select(metric => new CardMetric(
            metric.Label,
            metric.Value,
            metric.Evidence.ToString().ToLowerInvariant(),
            metric.Detail,
            metric.Tone,
            metric.Action,
            metric.Group)).ToList() ?? [];
        if (metrics.Count == 0)
        {
            metrics.AddRange(fallback);
        }
        return metrics;
    }
    private static string? InsightRating(AnalysisTechnicalInsight? insight)
    {
        if (insight is null) return null;
        var value = insight.Rating.Length > 0 ? insight.Rating : insight.Status;
        return value.Trim().ToLowerInvariant() switch
        {
            "available" or "measured" or "recorded" or "derived" or "calculated" or "baseline" => null,
            _ => Humanize(value)
        };
    }
    private static string? InsightStateClass(AnalysisTechnicalInsight? insight)
    {
        if (insight is null) return null;
        if (insight.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase)) return "unavailable";
        return insight.Rating.Trim().ToLowerInvariant() switch
        {
            "attention" or "loss" or "short" or "tight" => "attention",
            "gain" or "stable" or "safe" => "positive",
            "" or "available" or "measured" or "recorded" or "derived" or "calculated" or "baseline" => null,
            _ => "neutral"
        };
    }
    private static string? InsightTakeaway(AnalysisTechnicalInsight? insight) => string.IsNullOrWhiteSpace(insight?.Takeaway) ? null : insight.Takeaway;
    private static string MetricTone(AnalysisTechnicalMetric metric) => metric.Tone is "positive" or "attention" ? metric.Tone : "neutral";
    private static string MetricDensityClass(int count) => count switch { <= 4 => "metric-density-sparse", <= 9 => "metric-density-standard", _ => "metric-density-dense" };
    private static string MetricTooltip(CardMetric metric) => string.Join(" · ", new[] { metric.Detail, metric.Action }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private static string MetricAriaLabel(CardMetric metric) => string.Join(". ", new[] { $"{metric.Label}: {metric.Value}", metric.Detail, metric.Action }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private static string MetricDetailTooltip(AnalysisTechnicalMetric metric) => string.Join(" · ", new[] { metric.Detail, metric.Action }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private static string MetricDetailAriaLabel(AnalysisTechnicalMetric metric) => string.Join(". ", new[] { $"{metric.Label}: {metric.Value}", metric.Detail, metric.Action }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private static string MetricGroupLabel(AnalysisTechnicalMetric metric) => GroupTitle(metric.Group);
    private static string GroupTitle(string value) => string.IsNullOrWhiteSpace(value) ? "Race" : Humanize(value);
    private static string Humanize(string value) => string.IsNullOrWhiteSpace(value) ? "Available" : char.ToUpperInvariant(value[0]) + value[1..].Replace('-', ' ').Replace('_', ' ');

    private bool PredictionAvailable => Workspace.TirePrediction is { } prediction
        && !prediction.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase)
        && (prediction.Tires.Count > 0 || prediction.LapsRemaining.HasValue || prediction.PaceCostSeconds.HasValue || prediction.CapabilityPaceSeconds.HasValue);
    private string PredictionUnavailableReason => Workspace.TirePrediction?.Reason is { Length: > 0 } reason ? reason : "More comparable tire endpoints and green-run history are needed.";
    private static string PredictionNumber(double? value, string unit) => value.HasValue ? $"{value.Value:0.0} {unit}" : "—";
    private static string PredictionRange(double? value, double? low, double? high, string unit)
    {
        if (!value.HasValue) return "—";
        return low.HasValue && high.HasValue ? $"{value.Value:0.000} {unit} ({low.Value:0.000}–{high.Value:0.000})" : $"{value.Value:0.000} {unit}";
    }
    private static string PredictionPace(AnalysisTireLearningPrediction prediction) => PredictionRange(prediction.CapabilityPaceSeconds, prediction.CapabilityPaceLowSeconds, prediction.CapabilityPaceHighSeconds, "s");
    private static string PredictionConfidence(AnalysisTireLearningPrediction prediction) => string.IsNullOrWhiteSpace(prediction.Confidence) ? "Unrated" : Humanize(prediction.Confidence);
    private static IReadOnlyList<(string Label, AnalysisTireBandPrediction? Value)> PredictionBands(AnalysisTireCornerPrediction tire) =>
        new[] { "outer", "middle", "inner" }.Select(key => (key[..1].ToUpperInvariant(), tire.Bands.TryGetValue(key, out var value) ? value : null)).ToArray();
    private static string PredictionBand(AnalysisTireBandPrediction? band)
    {
        if (band?.RemainingPercent is not { } value) return "—";
        return band.LowPercent.HasValue && band.HighPercent.HasValue ? $"{value:0.0}% ({band.LowPercent:0.0}–{band.HighPercent:0.0})" : $"{value:0.0}%";
    }
    private IReadOnlyList<AnalysisGarage61ReferenceLap> Garage61Laps => Workspace.Garage61References is { } references
        && !references.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase) ? references.Laps.Where(lap => lap.LapTimeSeconds.HasValue).ToArray() : [];
    private static string ReferenceRole(AnalysisGarage61ReferenceLap reference) => string.IsNullOrWhiteSpace(reference.ComparisonRole) ? "Reference" : Humanize(reference.ComparisonRole);
    private Task FindGarage61ReferencesAsync() => State.SyncGarage61ReferencesAsync();

    private void OpenInvestigation(string key)
    {
        ActiveInvestigation = key;
        _selectedRunNumber = key switch
        {
            "pit" => PitRuns.FirstOrDefault()?.Number,
            "tires" => TireStops.FirstOrDefault()?.Number,
            "racecraft" => ComparableRuns.FirstOrDefault()?.Number,
            _ => null
        };
    }

    private void CloseInvestigation() { ActiveInvestigation = null; _selectedRunNumber = null; }
    private void SelectRun(int number) => _selectedRunNumber = number;
    private static string PitLap(AnalysisRun run) => run.Laps.Count == 0 ? "Lap —" : $"Lap {run.Laps.Max()}";
    private string PitPosition(AnalysisRun run)
    {
        var pitLap = run.Laps.Count == 0 ? 0 : run.Laps.Max();
        var raceLaps = Math.Max(Workspace.ScheduledLaps, Workspace.Laps.Select(lap => lap.Lap).DefaultIfEmpty(0).Max());
        var percent = raceLaps <= 0 ? 0 : Math.Clamp(pitLap / (double)raceLaps * 100, 0, 100);
        return percent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }
    private static string PitCall(AnalysisRun run) => run.PitStop?.TiresChanged?.Count switch
    {
        2 => "2 tires",
        4 => "4 tires",
        > 0 => $"{run.PitStop.TiresChanged.Count} tires",
        _ when (run.PitStop?.FuelAddedGallons ?? 0) > 0 => "Fuel only",
        _ => "Service"
    };
    private static string PitTimelineTitle(AnalysisRun run) => $"{PitLap(run)} · {PitCall(run)} · {Duration(run.PitStop?.ServiceSeconds)}";
    private static bool TireChanged(AnalysisRun run, string corner) => run.PitStop?.TiresChanged?.Contains(corner, StringComparer.OrdinalIgnoreCase) == true;
    private static string TireCallKey(AnalysisRun run) => run.PitStop?.TiresChanged is { } tires ? tires.Count switch
    {
        4 => "four",
        2 when tires.Contains("RF", StringComparer.OrdinalIgnoreCase) && tires.Contains("RR", StringComparer.OrdinalIgnoreCase) => "right-side",
        2 when tires.Contains("LF", StringComparer.OrdinalIgnoreCase) && tires.Contains("LR", StringComparer.OrdinalIgnoreCase) => "left-side",
        2 => "two",
        > 0 => "partial",
        _ => "none"
    } : "none";
    private static string TireCallLabel(AnalysisRun run) => TireCallKey(run) switch
    {
        "four" => "Four tires",
        "right-side" => "Right-side tires",
        "left-side" => "Left-side tires",
        "two" => "Two tires",
        "partial" => "Partial tire service",
        _ => "No confirmed tire change"
    };
    private static string TireCallAriaLabel(AnalysisRun run) => $"{TireCallLabel(run)}. {string.Join(", ", TireCornerOrder.Select(corner => $"{corner} {(TireChanged(run, corner) ? "changed" : "kept")}"))}.";
    private static string ChangedTires(AnalysisRun run) => run.PitStop?.TiresChanged is { Count: > 0 } tires ? string.Join(", ", tires) : "No change confirmed";
    private static string Gallons(double? value) => value.HasValue ? $"{value.Value:0.000} gal" : "—";
    private static string Laps(double? value) => value.HasValue ? $"{value.Value:0.0} laps" : "—";
    private static string Positions(double? value) => value.HasValue ? $"{value.Value:+0;-0;0} positions" : "—";
    private static string Duration(double? value) => value.HasValue && value.Value > 0 ? $"{value.Value:0.0} s" : "—";
    private static string Percent(double? value) => value.HasValue ? $"{value.Value:0.0}%" : "—";
    private static string Pressure(double? value) => value.HasValue ? $"{value.Value:0.0} psi" : "—";
    private static string Temperature(double? value) => value.HasValue ? $"{value.Value:0}°F" : "—";
    private static double? AverageBand(AnalysisTireBands bands)
    {
        var values = new[] { bands.Outer, bands.Middle, bands.Inner }.Where(value => value.HasValue).Select(value => value!.Value).ToArray();
        return values.Length == 0 ? null : values.Average();
    }
    private static string LapTime(double? value) => value.HasValue ? TimeSpan.FromSeconds(value.Value).ToString(@"m\:ss\.fff") : "—";
    private static string Delta(double? value) => value.HasValue ? $"{value.Value:+0.000;-0.000;0.000} s" : "—";
    private static string PaceTrend(AnalysisRun run) => run.PaceSlopeSecondsPerLap switch { > .01 => $"+{run.PaceSlopeSecondsPerLap:0.000} s/lap", < -.01 => $"{run.PaceSlopeSecondsPerLap:0.000} s/lap", not null => "Stable", _ => "—" };
    private static string LowestTire(AnalysisRun run) => run.TireRemainingPercent.HasValue ? $"{run.TireName} {run.TireRemainingPercent:0.0}%" : "—";
    private string FuelBarWidth(AnalysisRun run)
    {
        var maximum = FuelRuns.Select(item => item.FuelUsedGallons ?? 0).DefaultIfEmpty(0).Max();
        return maximum <= 0 ? "0%" : $"{Math.Clamp((run.FuelUsedGallons ?? 0) / maximum * 100, 0, 100):0.#}%";
    }
    private static string PaceDirectionClass(AnalysisRun run) => run.EarlyToLateDeltaSeconds switch { > .01 => "slower", < -.01 => "faster", _ => "stable" };
    private double? MostRecordedTireWear() => TireStops
        .SelectMany(run => TireConditions(run.PitStop!))
        .SelectMany(tire => TireBands(tire))
        .Select(band => band.Value)
        .Where(value => value.HasValue)
        .Select(value => value!.Value)
        .DefaultIfEmpty(double.NaN)
        .Max() is var value && !double.IsNaN(value) ? value : null;
    private static IEnumerable<double?> LegacyWear(AnalysisPitStop pit) => [pit.LeftFrontTireWearPercent, pit.RightFrontTireWearPercent, pit.LeftRearTireWearPercent, pit.RightRearTireWearPercent];
    private static bool ChangedAtStop(AnalysisRun? run, string corner) => run?.PitStop?.TiresChanged?.Contains(corner, StringComparer.OrdinalIgnoreCase) == true;
    private static IReadOnlyList<AnalysisTireCondition> TireConditions(AnalysisPitStop pit)
    {
        if (pit.TireConditions is { Count: > 0 }) return new[] { "LF", "RF", "LR", "RR" }.Where(pit.TireConditions.ContainsKey).Select(key => pit.TireConditions[key]).ToArray();
        var empty = new AnalysisTireBands(null, null, null);
        return new[]
        {
            new AnalysisTireCondition("LF", pit.LeftFrontTireWearPercent, empty, empty, empty, null, string.Empty),
            new AnalysisTireCondition("RF", pit.RightFrontTireWearPercent, empty, empty, empty, null, string.Empty),
            new AnalysisTireCondition("LR", pit.LeftRearTireWearPercent, empty, empty, empty, null, string.Empty),
            new AnalysisTireCondition("RR", pit.RightRearTireWearPercent, empty, empty, empty, null, string.Empty)
        }.Where(tire => tire.AverageWearPercent.HasValue).ToArray();
    }
    private static IReadOnlyList<(string Label, double? Value)> TireBands(AnalysisTireCondition tire)
    {
        if (tire.WearPercent is { Outer: null, Middle: null, Inner: null }) return [("Avg", tire.AverageWearPercent)];
        var right = tire.Corner is "RF" or "RR";
        return right
            ? [("I", tire.WearPercent.Inner), ("M", tire.WearPercent.Middle), ("O", tire.WearPercent.Outer)]
            : [("O", tire.WearPercent.Outer), ("M", tire.WearPercent.Middle), ("I", tire.WearPercent.Inner)];
    }
    private sealed record CardMetric(string Label, string Value, string Evidence, string Detail = "", string Tone = "neutral", string Action = "", string Group = "");
    private sealed record MetricGroup(string Key, IReadOnlyList<AnalysisTechnicalMetric> Metrics);
}
