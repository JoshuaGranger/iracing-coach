@if (_creating)
{
    <button class="back-button" @onclick="() => _creating = false">← Setup library</button>
    <StartingTunePage State="State" />
}
else
{
    var visibleSetups = VisibleSetups;
    var selectedSetup = visibleSetups.FirstOrDefault(item => item.Id == State.SelectedSetupId) ?? visibleSetups.FirstOrDefault();
    <div class="setup-library-page">
        <header class="page-heading compact-heading">
            <div><span class="eyebrow">Setups</span><h1>Your setup library</h1></div>
            <button class="button primary" @onclick="NewSetup">Find a baseline</button>
        </header>
        @if (!string.IsNullOrWhiteSpace(State.SetupCatalogWarning))
        {
            <p class="status-label warning" role="status">@State.SetupCatalogWarning</p>
        }
        @if (!string.IsNullOrWhiteSpace(State.SetupCopyMessage))
        {
            <p role="status">@State.SetupCopyMessage</p>
        }
        <section class="surface-card setup-library-toolbar" aria-label="Filter setups">
            <label>Search<input type="search" placeholder="Name, car, track…" @bind="State.SetupSearch" @bind:event="oninput" /></label>
            <label>Car<select @bind="State.SetupCarFilter"><option value="">All cars</option>@foreach (var value in Cars) { <option>@value</option> }</select></label>
            <label>Track<select @bind="State.SetupTrackFilter"><option value="">All tracks</option>@foreach (var value in Tracks) { <option>@value</option> }</select></label>
            <label>Season<select @bind="State.SetupSeasonFilter"><option value="">All seasons</option>@foreach (var value in Seasons) { <option>@value</option> }</select></label>
            <span>@visibleSetups.Count setup@(visibleSetups.Count == 1 ? "" : "s")</span>
        </section>
        @if (visibleSetups.Count == 0)
        {
            <section class="surface-card"><div class="empty-state"><ProductIcon Name="wrench" Size="24" /><h2>@(State.Setups.Count == 0 ? "No setups yet" : "No matching setups")</h2><p>@(State.Setups.Count == 0 ? "Analyze a recording to add the setup you drove, or find a baseline for your next session." : "Clear the filters to see the rest of your library.")</p>@if (State.Setups.Count == 0) { <button class="button secondary" @onclick='() => State.Navigate("analysis")'>Review a recording</button> } else { <button class="button secondary" @onclick="ClearFilters">Clear filters</button> }</div></section>
        }
        else
        {
            <div class="setup-library-workspace">
                <section class="surface-card setup-library-list" aria-label="Setup library">
                    @foreach (var setup in visibleSetups)
                    {
                        var evidence = State.SetupEvidenceRaces(setup);
                        <button class="setup-library-row @(selectedSetup?.Id == setup.Id ? "selected" : null)" aria-pressed="@(selectedSetup?.Id == setup.Id ? "true" : "false")" @onclick="() => Select(setup)">
                            <span class="setup-library-row-top"><strong>@setup.Name</strong><small>@SourceLabel(setup)</small></span>
                            <span>@setup.Car · @(setup.Track.Length > 0 ? setup.Track : "Track unspecified")</span>
                            <small>@ValuesSummary(setup) · @evidence.Count linked recording@(evidence.Count == 1 ? "" : "s") · @(setup.Season.Length > 0 ? setup.Season : "Season unknown")</small>
                        </button>
                    }
                </section>
                @if (selectedSetup is { } selected)
                {
                    var linked = State.SetupEvidenceRaces(selected);
                    <section class="surface-card setup-library-detail">
                        <div class="setup-detail-heading"><div><span class="eyebrow">@SourceLabel(selected)</span><h2>@selected.Name</h2><p>@selected.Car · @selected.Track</p></div><span class="status-label">@selected.Role</span></div>
                        <div class="button-row">
                            <button class="button primary" disabled="@(linked.Count == 0 || _tuning)" title="@(linked.Count == 0 ? "Analyze a recording made with this setup first" : "Use a linked recording to test a setup change")" @onclick="() => Tune(selected)">@(_tuning ? "Opening…" : "Tune this setup")</button>
                        </div>
                        <p class="setup-source-note">@selected.Note
                            <span class="setup-file-actions"><button type="button" class="ri-link" @onclick="() => ShowSource(selected)">Open folder</button>@if (IsSetupFile(selected)) { <button type="button" class="ri-link" @onclick="() => SaveCopy(selected)">Save a copy</button> }</span></p>
                        @if (linked.Count > 0)
                        {
                            <div class="setup-linked-races"><h3>Recorded performance</h3><p>Values from each linked recording. Weather, fuel, traffic and driving can affect comparisons.</p>
                            @foreach (var race in linked)
                            {
                                <article><div><strong>@race.Track · @race.Date</strong><small>@race.SetupType setup · @race.Layout</small></div><div><span>Clean best</span><b>@Seconds(race.Overview?.BestCleanLapSeconds)</b></div><div><span>Pace change</span><b>@Signed(race.Overview?.PaceSlopeSecondsPerLap)</b></div><div><span>Lowest tire</span><b>@Percent(race.Overview?.LowestTireRemainingPercent)</b></div><button class="button secondary compact" @onclick="() => State.OpenRaceFromHomeAsync(race)">Analyze</button></article>
                            }
                            </div>
                        }
                        else
                        {
                            <div class="setup-evidence-empty"><strong>No recording uses this setup yet</strong><p>Record a run with this setup, then analyze it to compare handling and pace.</p><button class="button secondary compact" @onclick='() => State.Navigate("analysis")'>Review a recording</button></div>
                        }
                        <div class="setup-values-heading"><h3>Setup values</h3><label>Compare with<select @bind="State.CompareSetupId" disabled="@(selected.Fields.Count == 0)" title="@(selected.Fields.Count == 0 ? "This setup's values are unknown, so it can't be compared." : null)"><option value="">No comparison</option>@foreach (var candidate in CompareCandidates(State.Setups, selected)) { <option value="@candidate.Id">@ComparisonLabel(candidate)</option> }</select></label></div>
                        @if (selected.Fields.Count > 0 && selected.ValuesNote.Length > 0)
                        {
                            <p class="setup-source-note" data-values-source="@selected.ValuesSource">@selected.ValuesNote</p>
                        }
                        @if (selected.Fields.Count == 0)
                        {
                            <p class="setup-source-note" data-values-unknown>@(selected.ValuesNote.Length > 0 ? selected.ValuesNote : "Values unknown for this setup.")</p>
                        }
                        else if (Comparison(selected) is { } comparison)
                        {
                            var rows = Differences(selected, comparison).ToArray();
                            var changed = rows.Where(row => row.Kind == RowKind.Changed).ToArray();
                            var unknown = rows.Where(row => row.Kind == RowKind.Unknown).ToArray();
                            var identical = rows.Where(row => row.Kind == RowKind.Identical).ToArray();
                            <p class="setup-diff-summary" data-setup-diff><b>@changed.Length changed</b> · <b>@unknown.Length unknown</b> · @identical.Length identical
                                <button type="button" class="ri-link" aria-pressed="@(_showIdentical ? "true" : "false")" @onclick="() => _showIdentical = !_showIdentical">@(_showIdentical ? "Hide identical" : "Show all values")</button></p>
                            <table class="setup-values-table"><thead><tr><th>Setting</th><th>Selected setup<br />@ComparisonLabel(selected)</th><th>Comparison setup<br />@ComparisonLabel(comparison)</th></tr></thead><tbody>
                            @foreach (var row in changed) { <tr class="changed" data-row="changed"><th>@row.Label</th><td>@row.Left</td><td>@row.Right</td></tr> }
                            @foreach (var row in unknown) { <tr class="unknown" data-row="unknown" title="Missing or unreadable on one side; never treated as equal."><th>@row.Label</th><td>@row.Left</td><td>@row.Right</td></tr> }
                            @if (_showIdentical) { foreach (var row in identical) { <tr data-row="identical"><th>@row.Label</th><td>@row.Left</td><td>@row.Right</td></tr> } }
                            </tbody></table>
                            @if (changed.Length == 0 && unknown.Length == 0) { <p class="setup-source-note">Every readable setting matches.</p> }
                            @if (selected.Fields.Concat(comparison.Fields).Any(field => SetupReadings.IsRunReading(field.Key))) { <p class="setup-source-note">Tire readings from a recorded run are not setup values and are not compared.</p> }
                        }
                        else
                        {
                            @foreach (var group in selected.Fields.GroupBy(field => field.Group))
                            {
                                <details class="setup-values-group" open><summary>@group.Key <span>@group.Count()</span></summary><dl>@foreach (var field in group) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }</dl></details>
                            }
                        }
                        @if (CompareExclusions(State.Setups, selected) is { Count: > 0 } excluded)
                        {
                            <details class="setup-values-group" data-compare-excluded open="@(excluded.Count <= 3)"><summary>Not offered for comparison <span>@excluded.Count same-car setup@(excluded.Count == 1 ? "" : "s")</span></summary>
                                <dl>@foreach (var item in excluded) { <div data-excluded-setup="@item.Setup.Id"><dt>@item.Setup.Name</dt><dd>@item.Reason</dd></div> }</dl></details>
                        }
                    </section>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private bool _creating;
    private bool _tuning;
    private IReadOnlyList<LocalSetup> VisibleSetups => State.FilteredSetups.ToArray();
    private LocalSetup? Selected => VisibleSetups.FirstOrDefault(item => item.Id == State.SelectedSetupId) ?? VisibleSetups.FirstOrDefault();
    private IEnumerable<string> Cars => State.Setups.Select(item => item.Car).Where(value => value.Length > 0).Distinct().Order();
    private IEnumerable<string> Tracks => State.Setups.Select(item => item.Track).Where(value => value.Length > 0).Distinct().Order();
    private IEnumerable<string> Seasons => State.Setups.Select(item => item.Season.Length > 0 ? item.Season : "Unknown").Distinct().OrderDescending();
    protected override void OnParametersSet() { if (Selected is { } setup) State.SelectedSetupId = setup.Id; }
    private void Select(LocalSetup setup) { State.SelectedSetupId = setup.Id; State.CompareSetupId = string.Empty; }
    private void NewSetup() { if (Selected is { } setup) State.SelectedSetupId = setup.Id; State.OpenStartingTune(); _creating = true; }
    private void ClearFilters() { State.SetupSearch = State.SetupCarFilter = State.SetupTrackFilter = State.SetupSeasonFilter = string.Empty; }
    private void ShowSource(LocalSetup setup) { State.SelectedSetupId = setup.Id; State.OpenSelectedSetupFolder(); }
    private Task SaveCopy(LocalSetup setup) { State.SelectedSetupId = setup.Id; return State.CopySelectedSetupAsync(); }
    private async Task Tune(LocalSetup setup)
    {
        _tuning = true;
        try
        {
            // The recording whose values this setup shows, so tuning and the values agree.
            var race = State.SetupTuningRace(setup);
            var target = race is null ? setup : TuningSetup(State.Setups, setup, race.AnalysisPath);
            await State.BeginSetupTuningAsync(target.Id, race is null || target.Id == setup.Id ? null : race.Id);
        }
        finally { _tuning = false; }
    }

    /// <summary>
    /// Tuning starts from a recording's own embedded setup. A setup file linked to
    /// that recording tunes through the recording's setup, whose fingerprint the
    /// analysis carries; the file's bytes are never the tuning baseline.
    /// </summary>
    public static LocalSetup TuningSetup(IEnumerable<LocalSetup> setups, LocalSetup setup, string? analysisPath) =>
        !IsSetupFile(setup) || string.IsNullOrWhiteSpace(analysisPath) ? setup
        : setups.FirstOrDefault(item => item.Id != setup.Id && !IsSetupFile(item)
            && (item.AnalysisPaths ?? []).Any(path => string.Equals(path, analysisPath, StringComparison.OrdinalIgnoreCase))) ?? setup;

    private static string ValuesSummary(LocalSetup setup) => setup.Fields.Count == 0 ? "Values unknown"
        : setup.ValuesSource == "recording" ? $"{setup.Fields.Count} values from a recording" : $"{setup.Fields.Count} values";

    /// <summary>Other setups of the same car whose values are known and comparable with this one's.</summary>
    public static IReadOnlyList<LocalSetup> CompareCandidates(IEnumerable<LocalSetup> setups, LocalSetup setup) => SetupComparability.Candidates(setups, setup);

    /// <summary>Every other setup of this car that is not offered for comparison, named with its reason (SU-011).</summary>
    public static IReadOnlyList<SetupComparisonExclusion> CompareExclusions(IEnumerable<LocalSetup> setups, LocalSetup setup) => SetupComparability.Exclusions(setups, setup);
    private static bool IsSetupFile(LocalSetup setup) => System.IO.Path.GetExtension(setup.StoPath).Equals(".sto", StringComparison.OrdinalIgnoreCase);
    private static string SourceLabel(LocalSetup setup) => IsSetupFile(setup) ? "Local .sto" : "Recorded telemetry";
    private static string Seconds(double? value) => value is { } v ? $"{v:0.000}s" : "—";
    private static string Signed(double? value) => value is { } v ? $"{v:+0.000;-0.000;0.000}s/lap" : "—";
    private static string Percent(double? value) => value is { } v ? $"{v:0.0}%" : "—";
    private LocalSetup? Comparison(LocalSetup setup) => CompareCandidates(State.Setups, setup).FirstOrDefault(item => item.Id == State.CompareSetupId);
    private string ComparisonLabel(LocalSetup setup)
    {
        var dates = State.SetupEvidenceRaces(setup).Select(race => race.Date)
            .Where(date => !string.IsNullOrWhiteSpace(date)).Distinct().ToArray();
        return dates.Length > 0 ? $"{setup.Name} · {string.Join(" / ", dates)}" : $"{setup.Name} · {SourceLabel(setup)}";
    }
    private bool _showIdentical;
    public enum RowKind { Changed, Unknown, Identical }

    /// <summary>
    /// Changed and unknown settings lead; a value missing or unreadable on either side
    /// is unknown, never equal. Values are compared as displayed, units included.
    /// </summary>
    public static IEnumerable<(string Label, string Left, string Right, RowKind Kind)> Differences(LocalSetup left, LocalSetup right)
    {
        // A recording's tire readings describe its run, not the garage setup.
        var keys = left.Fields.Select(field => field.Key).Concat(right.Fields.Select(field => field.Key)).Distinct()
            .Where(key => !SetupReadings.IsRunReading(key));
        foreach (var key in keys)
        {
            var a = left.Fields.FirstOrDefault(field => field.Key == key); var b = right.Fields.FirstOrDefault(field => field.Key == key);
            var leftValue = Normalized(a?.Value);
            var rightValue = Normalized(b?.Value);
            var kind = leftValue is null || rightValue is null ? RowKind.Unknown
                : string.Equals(leftValue, rightValue, StringComparison.OrdinalIgnoreCase) ? RowKind.Identical : RowKind.Changed;
            yield return ($"{(a ?? b)!.Group} · {(a ?? b)!.Label}", a?.Value is { Length: > 0 } shownLeft ? shownLeft : "—", b?.Value is { Length: > 0 } shownRight ? shownRight : "—", kind);
        }
    }

    private static string? Normalized(string? value)
    {
        var text = string.Join(' ', (value ?? string.Empty).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return text.Length == 0 || text is "—" or "-" or "n/a" or "N/A" ? null : text;
    }
}
