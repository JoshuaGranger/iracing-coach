<div class="page-heading compact-heading">
    <div><span class="eyebrow">Setups</span><h1>Starting tune</h1></div>
</div>

<section class="surface-card form-panel starting-tune" aria-labelledby="starting-tune-heading">
    <div class="card-header"><div><span class="eyebrow">Step @State.StartingTuneStep of 4</span><h2 id="starting-tune-heading">@StartingTuneHeading</h2></div></div>
    <div class="progress-rail" aria-label="Starting Tune progress">
        @foreach (var step in new[] { (1, "Event"), (2, "Source"), (3, "Checks"), (4, "Run") })
        {
            <button class="@(State.StartingTuneStep == step.Item1 ? "active" : State.StartingTuneStep > step.Item1 ? "done" : null)" disabled="@(step.Item1 > 1 && State.StartingTunePackage is null)" @onclick="() => State.SetStartingTuneStep(step.Item1)"><span>@step.Item1</span>@step.Item2</button>
        }
    </div>
    @if (State.StartingTuneStep == 1)
    {
        <div class="form-grid two-column">
            <label>Season<input @bind="State.StartingTuneSeason" placeholder="2026S3" /></label>
            <label>Session<select @bind="State.StartingTunePurpose"><option>Race</option><option>Qualifying</option></select></label>
            <label>Car<input @bind="State.StartingTuneCar" placeholder="Exact iRacing car" /></label>
            <label>Track<input @bind="State.StartingTuneTrack" placeholder="Exact track and layout" /></label>
        </div>
        <button class="button primary" disabled="@State.StartingTuneBusy" @onclick="BuildStartingTune">@(State.StartingTuneBusy ? "Finding source…" : "Find starting point")</button>
    }
    else if (State.StartingTunePackage is { } package)
    {
        @if (State.StartingTuneStep == 2)
        {
            <div class="source-details"><div><span>Source</span><strong>@package.Source</strong></div><div><span>Setup</span><strong>@package.Donor</strong></div><div><span>Car</span><strong>@package.Car</strong></div><div><span>Track</span><strong>@package.Track</strong></div></div>
            <p class="section-copy">@package.Confirmation @package.DonorReason</p>
            @if (package.Risks.Count > 0) { <details class="evidence-details"><summary>Cautions</summary><ul>@foreach (var risk in package.Risks) { <li>@risk</li> }</ul></details> }
            <div class="workflow-actions"><button class="button secondary" @onclick="State.ResetStartingTune">Change event</button><button class="button primary" @onclick="() => State.SetStartingTuneStep(3)">Review checks</button></div>
        }
        else if (State.StartingTuneStep == 3)
        {
            <div class="source-details"><div><span>Purpose</span><strong>@package.Purpose</strong></div><div><span>Season</span><strong>@package.Season</strong></div><div><span>Status</span><strong>@package.Status</strong></div></div>
            <ol class="baseline-checks">@foreach (var check in package.BaselineChecks) { <li>@check</li> }</ol>
            <details class="evidence-details"><summary>Technical record</summary><p class="mono">@package.Fingerprint</p></details>
            <div class="workflow-actions"><button class="button secondary" @onclick="() => State.SetStartingTuneStep(2)">Back</button><button class="button primary" @onclick="() => State.SetStartingTuneStep(4)">Baseline run</button></div>
        }
        else
        {
            <div class="baseline-run-card"><ProductIcon Name="race" Size="22" /><div><h2>Run five clean laps</h2><p>Use the unchanged setup, then analyze the session and give feedback by corner.</p></div></div>
            <div class="workflow-actions"><button class="button secondary" @onclick="() => State.SetStartingTuneStep(3)">Back</button><button class="button primary" @onclick="OpenTuning">Open tuning</button></div>
        }
    }
    @if (!string.IsNullOrWhiteSpace(State.SetupMessage)) { <p class="fine-print">@State.SetupMessage</p> }
</section>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private string StartingTuneHeading => State.StartingTuneStep switch { 1 => "Choose the event", 2 => "Confirm the source", 3 => "Verify the baseline", _ => "Record the baseline" };
    private Task BuildStartingTune() => State.BuildStartingTuneAsync();
    private void OpenTuning() => State.Navigate("tuning");
}
