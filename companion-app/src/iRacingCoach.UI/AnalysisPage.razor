@if (State.AnalysisWorkspaceOpen)
{
    @if (State.CurrentAnalysis is { } analysis && State.CurrentRaceCard is { } card)
    {
        <AnalysisWorkspacePage State="State" Workspace="analysis" Card="card" />
    }
    else
    {
        <div class="analysis-opening analysis-workspace-page">
            <header class="analysis-context-bar">
                <button class="back-button" @onclick="State.CloseAnalysisWorkspace">← Sessions</button>
                <div class="analysis-event-title"><span class="eyebrow">Recorded session</span><h1>@SelectedTrack</h1><p>@SelectedContext</p></div>
            </header>
            @if (State.AnalysisLoading)
            {
                <section class="telemetry-workspace analysis-telemetry-loading" aria-live="polite" aria-busy="true">
                    <div><span class="activity-spinner" aria-hidden="true"></span><strong>Loading telemetry</strong><span>@State.AnalysisMessage</span></div>
                    <div class="telemetry-loading-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                </section>
            }
            else
            {
                <section class="surface-card analysis-opening-card" aria-live="polite">
                    <span class="eyebrow">Recording not opened</span>
                    <h1>Telemetry could not be loaded</h1>
                    <p>@(string.IsNullOrWhiteSpace(State.AnalysisMessage) ? "This recording did not contain enough supported data to open." : State.AnalysisMessage)</p>
                    <div class="button-row"><button class="button primary" @onclick="() => State.ReanalyzeRaceAsync()">Retry</button>@if (State.AnalysisError is not null) { <span class="support-reference">Reference @State.AnalysisError.Id</span> }</div>
                </section>
            }
        </div>
    }
}
else
{
    <SessionsPage State="State" />
}

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private string SelectedTrack => State.SelectedRaceSession?.Track ?? "recorded session";
    private string SelectedContext => State.SelectedRaceSession is { } race ? string.Join(" · ", new[] { race.Car, race.Layout, race.Date, race.SessionType }.Where(value => !string.IsNullOrWhiteSpace(value))) : string.Empty;
}
