@if (State.AnalysisWorkspaceOpen)
{
    @if (State.CurrentAnalysis is { } analysis && State.CurrentRaceCard is { } card)
    {
        <AnalysisWorkspacePage State="State" Workspace="analysis" Card="card" />
    }
    else
    {
        <div class="analysis-opening analysis-workspace-page">
            <header class="analysis-context-bar">
                <button class="back-button" @onclick="State.CloseAnalysisWorkspace">← Races</button>
                <div class="analysis-event-title"><span class="eyebrow">Recorded race</span><h1>@SelectedTrack</h1><p>@SelectedContext</p></div>
            </header>
            @if (State.AnalysisLoading)
            {
                <section class="telemetry-workspace analysis-telemetry-loading" aria-live="polite" aria-busy="true">
                    <div><span class="activity-spinner" aria-hidden="true"></span><strong>Loading telemetry</strong><span>@State.AnalysisMessage</span></div>
                    <div class="telemetry-loading-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                </section>
            }
            else
            {
                <section class="surface-card analysis-opening-card" aria-live="polite">
                    <span class="eyebrow">Recording not opened</span>
                    <h1>Telemetry could not be loaded</h1>
                    <p>@(string.IsNullOrWhiteSpace(State.AnalysisMessage) ? "This recording did not contain enough supported data to open." : State.AnalysisMessage)</p>
                    <div class="button-row"><button class="button primary" @onclick="() => State.ReanalyzeRaceAsync()">Retry</button>@if (State.LastRecoverableError is not null) { <span class="support-reference">Reference @State.LastRecoverableError.Id</span> }</div>
                </section>
            }
        </div>
    }
}
else
{
    <div class="page-heading compact-heading race-list-heading">
        <div><span class="eyebrow">Race analysis</span><h1>Race events</h1><p>Select an event to open its telemetry workspace.</p></div>
    </div>

    <section class="race-events" aria-labelledby="race-events-heading">
        <div class="race-list-toolbar">
            <div><h2 id="race-events-heading">Recorded races</h2><span>@State.FilteredEventGroups.Count() events</span></div>
            @if (HasRaceEvents)
            {
                <label class="search-field"><span class="sr-only">Search races</span><input type="search" placeholder="Search track, car, or series" @bind="State.RaceSearchText" @bind:event="oninput" /></label>
                @if (State.AvailableRaceFilters.Count > 1)
                {
                    <label class="filter-field"><span class="sr-only">Filter races</span><select @bind="State.RaceFilter">@foreach (var filter in State.AvailableRaceFilters) { <option value="@filter">@FilterLabel(filter)</option> }</select></label>
                }
            }
        </div>

        @if (!State.FilteredEventGroups.Any())
        {
            <div class="empty-state race-browser-empty"><span class="empty-icon"><ProductIcon Name="analysis" Size="22" /></span><h3>@(HasRaceEvents ? "No matching races" : "No race recordings yet")</h3><p>@(HasRaceEvents ? "Clear the search or change the filter." : "A completed recorded Race session will appear here automatically.")</p>@if (HasRaceEvents) { <button class="button secondary" @onclick="ClearFilters">Clear filters</button> }</div>
        }
        else
        {
            <div class="race-event-table" role="list">
                <div class="race-event-columns race-analysis-columns" aria-hidden="true"><span>Event</span><span>Result</span><span>Race laps</span><span>Best / run</span><span>Pace</span><span>Tire / load</span></div>
                @foreach (var group in State.FilteredEventGroups)
                {
                    var race = RaceSession(group);
                    if (race is null) { continue; }
                    var overview = race.Overview;
                    <button class="race-event-row race-analysis-row" role="listitem" @onclick="() => OpenEvent(group)" title="Open @group.Track race analysis">
                        <span class="event-main"><strong>@group.Track</strong><small>@EventSubtitle(group, race)</small></span>
                        <span class="event-result">@Result(race)</span>
                        <span class="event-race-shape race-condition-stat"><strong><i class="metric-dot green"></i>@Metric(overview?.GreenLaps) green</strong><small><i class="metric-dot yellow"></i>@Metric(overview?.CautionLaps) caution</small></span>
                        <span class="event-long-run"><strong>@BestLap(overview)</strong><small>@RunSummary(overview)</small></span>
                        <span class="event-pace"><strong class="@PaceClass(overview)">@PaceTrend(overview)</strong><small>@Consistency(overview)</small></span>
                        <span class="event-tire" title="@TireDetail(overview)"><strong>@TireMetric(overview)</strong><small>@TireMetricNote(overview)</small></span>
                    </button>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private bool HasRaceEvents => State.EventGroups.OfType<RaceEventGroup>().Any(group => group.Sessions?.OfType<RecentRace>().Any(session => session.IsRace) == true);
    private string SelectedTrack => State.SelectedRaceSession?.Track ?? "recorded race";
    private string SelectedContext => State.SelectedRaceSession is { } race ? string.Join(" · ", new[] { race.Car, race.Layout, race.Date }.Where(value => !string.IsNullOrWhiteSpace(value))) : string.Empty;
    private void ClearFilters() { State.RaceSearchText = string.Empty; State.RaceFilter = RaceBrowserFilter.All; }
    private static RecentRace? RaceSession(RaceEventGroup group) => group.Sessions?.OfType<RecentRace>().FirstOrDefault(session => session.IsRace);
    private Task OpenEvent(RaceEventGroup group) => RaceSession(group) is { } race ? State.OpenRaceAsync(race) : Task.CompletedTask;
    private static string EventSubtitle(RaceEventGroup group, RecentRace race)
    {
        var setup = string.IsNullOrWhiteSpace(group.SetupType) ? string.Empty : $"{group.SetupType} setup";
        var parts = new[] { group.Date, group.Layout, group.Car, setup, race.Series, group.EventScope }.Where(value => !string.IsNullOrWhiteSpace(value));
        return string.Join(" · ", parts);
    }
    private static string Result(RecentRace race) => (race.StartPosition, race.FinishPosition) switch
    {
        (> 0, > 0) => $"P{race.StartPosition} → P{race.FinishPosition}",
        (_, > 0) => $"P{race.FinishPosition}",
        _ => "—"
    };
    private static string Metric(int? value) => value is > 0 ? value.Value.ToString() : "—";
    private static string Plural(int? value, string noun) => value is > 0 ? $"{value} {noun}{(value == 1 ? string.Empty : "s")}" : $"No {noun}s";
    private static string BestLap(RaceOverview? overview) => overview?.BestCleanLapSeconds is > 0 ? FormatLap(overview.BestCleanLapSeconds.Value) : "—";
    private static string FormatLap(double seconds) => TimeSpan.FromSeconds(seconds).ToString(seconds >= 60 ? "m\\:ss\\.fff" : "s\\.fff");
    private static string RunSummary(RaceOverview? overview) => $"{Metric(overview?.LongestGreenRun)} green max · {Plural(overview?.Runs, "run")} · {Plural(overview?.PitStops, "stop")}";
    private static string PaceTrend(RaceOverview? overview) => overview?.PaceSlopeSecondsPerLap switch
    {
        > .005 => $"+{overview.PaceSlopeSecondsPerLap:0.000} s/lap",
        < -.005 => $"{overview.PaceSlopeSecondsPerLap:0.000} s/lap",
        not null => "Stable",
        _ => "—"
    };
    private static string PaceClass(RaceOverview? overview) => overview?.PaceSlopeSecondsPerLap switch { > .02 => "pace-falloff", < -.005 => "pace-improving", not null => "pace-stable", _ => string.Empty };
    private static string Consistency(RaceOverview? overview) => overview?.PaceConsistencyPercent is { } value ? $"{value:0.0}% variation" : "—";
    private static string TireMetric(RaceOverview? overview) => overview?.LowestTireRemainingPercent is { } remaining
        ? $"{overview.LowestTireName} {remaining:0.0}%"
        : overview?.ControlLoadChangePercent is { } load ? $"{load:0}% load change" : "—";
    private static string TireMetricNote(RaceOverview? overview) => overview?.FuelUsedGallons is { } fuel
        ? $"{fuel:0.00} gal fuel"
        : overview?.LowestTireRemainingPercent.HasValue == true ? "Lowest at a stop" : overview?.ControlLoadChangePercent.HasValue == true ? "Brake / steering" : string.Empty;
    private static string TireDetail(RaceOverview? overview)
    {
        var evidence = overview?.LowestTireRemainingPercent is { } remaining
            ? $"Lowest recorded tire: {overview.LowestTireName} {remaining:0.0}% remaining."
            : overview?.ControlLoadChangePercent is { } load ? $"Largest recorded early-to-late brake or steering change: {load:0.0}%." : "No supported tire or control-load reading was recorded.";
        return overview?.FuelUsedGallons is { } fuel ? $"{evidence} Recorded fuel used: {fuel:0.00} gal." : evidence;
    }
    private static string FilterLabel(RaceBrowserFilter filter) => filter switch { RaceBrowserFilter.All => "All races", RaceBrowserFilter.HostedLeague => "Hosted / League", RaceBrowserFilter.Fixed => "Fixed setup", RaceBrowserFilter.Open => "Open setup", RaceBrowserFilter.NeedsAnalysis => "Needs analysis", _ => filter.ToString() };
}
