<div class="page-heading compact-heading settings-heading">
    <div><span class="eyebrow">Settings</span><h1>App and data</h1></div>
    @if (!State.Settings.FirstRunComplete)
    {
        <button class="button secondary" @onclick='() => State.Navigate("first-run")'>Continue setup</button>
    }
</div>

@{ var issues = State.SettingsIssues; }
<section class="settings-status @(issues.Count == 0 ? "ok" : "attention")" data-settings-status aria-live="polite">
    @if (issues.Count == 0)
    {
        <ProductIcon Name="check" Size="16" />
        <span><strong>Local analysis is ready.</strong> It works without ChatGPT, Garage61 or the internet.</span>
    }
    else
    {
        <strong>Needs attention</strong>
        <ul>
            @foreach (var issue in issues)
            {
                <li data-issue="@issue.Recovery">
                    <span><b>@issue.Label</b><small>@issue.Detail</small></span>
                    @switch (issue.Recovery)
                    {
                        case SettingsRecovery.Repair: <button type="button" class="button secondary compact" @onclick="State.RepairInstallation">Repair installation</button> break;
                        case SettingsRecovery.CheckAgain: <button type="button" class="button secondary compact" @onclick="CheckAgain">Check again</button> break;
                        case SettingsRecovery.Folders: <button type="button" class="button secondary compact" @onclick="ShowFolders">Correct folder</button> break;
                        case SettingsRecovery.Backup: <button type="button" class="button secondary compact" @onclick="OpenBackupGuide">Check copy</button> break;
                        case SettingsRecovery.Logs: <button type="button" class="button secondary compact" @onclick="State.OpenLogs">Open logs</button> break;
                    }
                </li>
            }
        </ul>
    }
</section>

<div class="settings-hub-grid">
    <section class="surface-card settings-hub-card" aria-labelledby="storage-heading">
        <div class="settings-hub-heading">
            <div><ProductIcon Name="setup" Size="18" /><h2 id="storage-heading">Data</h2></div>
            <span class="status-label @(State.IRacingDetected ? "success" : "warning")">@(State.IRacingDetected ? "Ready" : "Check folders")</span>
        </div>
        <div class="settings-summary-list">
            <div><span>Coach folder</span><strong title="@State.Settings.CoachHome">@CoachFolderName</strong></div>
            <div><span>iRacing files</span><strong>@(State.IRacingDetected ? "Found" : "Not found")</strong></div>
        </div>
        <details class="settings-disclosure" open="@_foldersOpen">
            <summary>Folder locations</summary>
            <div class="settings-rows compact-paths">
                <label><span>Coach folder<small>Preferences, analysis, history, and setup copies</small></span><input value="@State.Settings.CoachHome" readonly /></label>
                <label><span>iRacing Documents<small>Telemetry, replays, and saved setups</small></span><input @bind="State.Settings.IRacingRoot" @bind:event="oninput" /></label>
                <label><span>iRacing installation<small>Cars, tracks, and version metadata; read only</small></span><input @bind="State.Settings.IRacingInstallRoot" @bind:event="oninput" /></label>
            </div>
        </details>
    </section>

    <section class="surface-card settings-hub-card" aria-labelledby="portable-copy-heading">
        <div class="settings-hub-heading">
            <div><ProductIcon Name="duplicate" Size="18" /><h2 id="portable-copy-heading">Move or back up</h2></div>
            <button class="button primary compact" @onclick="OpenBackupGuide">Prepare copy</button>
        </div>
        <p class="settings-card-copy">Copy race history, recordings, preferences and tuning work to another drive or PC.</p>
        @if (State.Archive is not null)
        {
            <div class="settings-summary-list">
                <div><span>Coach data</span><strong>@State.Archive.Restored.TotalItems items</strong></div>
                <div><span>Protected connections</span><strong>Reconnect per PC</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(PortableSummary))
            {
                <small class="settings-footnote">@PortableSummary</small>
            }
        }
        @if (State.BackupPreparation is not null)
        {
            <div class="settings-result @(State.BackupPreparation.SafeToCopy ? "success" : "warning")">
                <ProductIcon Name="@(State.BackupPreparation.SafeToCopy ? "check" : "info")" Size="16" />
                <div><strong>@(State.BackupPreparation.SafeToCopy ? "Ready to copy" : "Not ready")</strong><span>@State.BackupPreparation.Message</span></div>
            </div>
        }
        @if (State.Archive is not null && State.Archive.Restored.UnresolvedSources > 0)
        {
            <button class="text-button settings-locate" @onclick="State.RequestLocateRawTelemetry">Find @State.Archive.Restored.UnresolvedSources missing telemetry file@(State.Archive.Restored.UnresolvedSources == 1 ? null : "s")</button>
        }
    </section>

    <section class="surface-card settings-hub-card" aria-labelledby="behavior-heading">
        <div class="settings-hub-heading"><div><ProductIcon Name="settings" Size="18" /><h2 id="behavior-heading">App behavior</h2></div></div>
        <fieldset class="theme-color-field">
            <legend>Theme color</legend>
            <div class="theme-color-row">
                <div class="theme-color-options" role="group" aria-label="Theme color">
                    @foreach (var color in ThemeColors.Choices)
                    {
                        var selected = string.Equals(ThemeColors.Normalize(State.Settings.ThemeColor), color.Id, StringComparison.Ordinal);
                        <button type="button"
                                class="theme-color-swatch @ThemeColors.CssClass(color.Id) @(selected ? "active" : null)"
                                aria-label="@color.Name"
                                aria-pressed="@(selected ? "true" : "false")"
                                title="@color.Name"
                                @onclick="() => State.SetThemeColor(color.Id)">
                            @if (selected)
                            {
                                <ProductIcon Name="check" Size="13" />
                            }
                        </button>
                    }
                    <label class="theme-color-custom @CustomThemeClass" title="Custom color">
                        <input type="color"
                               value="@State.Settings.CustomThemeColor"
                               aria-label="Choose custom theme color"
                               @oninput="HandleCustomThemeColor" />
                        @if (CustomThemeSelected)
                        {
                            <ProductIcon Name="check" Size="13" />
                        }
                    </label>
                </div>
                <strong>@ThemeColors.Get(State.Settings.ThemeColor, State.Settings.CustomThemeColor).Name</strong>
            </div>
        </fieldset>
        <div class="settings-toggle-stack">
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.LaunchAtSignIn" /><span><strong>Open when I sign in</strong><small>Starts minimized and watches for completed recordings.</small></span></label>
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.UseReducedMotion" /><span><strong>Reduce motion</strong><small>Turns off nonessential transitions and interpolation.</small></span></label>
        </div>
    </section>

    <section class="surface-card settings-hub-card" aria-labelledby="live-monitor-heading">
        <div class="settings-hub-heading">
            <div><ProductIcon Name="monitor" Size="18" /><h2 id="live-monitor-heading">Telemetry popout</h2></div>
            <span class="settings-layout-name" data-popout-dashboard title="The dashboard the popout shows; choose or edit it on the Live page."><small>Dashboard</small>@LiveMonitorLayouts.Active(State.Settings.LiveMonitor).Layout.Name</span>
        </div>
        <label class="settings-inline-field"><span>Show / hide hotkey</span><input placeholder="Ctrl+Shift+L" @bind="State.Settings.LiveMonitor.GlobalHotkey" @bind:event="oninput" /></label>
        <div class="settings-toggle-stack compact">
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.LiveMonitor.SafeGlanceEnabled" /><span><strong>Delay coaching through corners</strong><small>Show routine cues on straights, under caution or in the pits. Urgent warnings appear immediately.</small></span></label>
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.LiveMonitor.ReopenOnConnect" /><span><strong>Open with iRacing</strong><small>Show the popout when live telemetry connects.</small></span></label>
        </div>
    </section>
</div>

<section class="surface-card settings-accordion @(_connectionsOpen ? "open" : null)">
        <button class="settings-accordion-toggle" aria-expanded="@(_connectionsOpen ? "true" : "false")" @onclick="ToggleConnections">
        <span><ProductIcon Name="connections" Size="17" /><strong>Connections</strong></span>
        <small>@State.ConnectionsSummary</small>
        <ProductIcon Name="chevron-down" Size="16" />
    </button>
        <div class="settings-accordion-body" aria-hidden="@(_connectionsOpen ? "false" : "true")" inert="@(_connectionsOpen ? null : string.Empty)">
        <div><ConnectionsPage State="State" Embedded="true" /></div>
    </div>
</section>

@* The save bar appears only for real edits; folder and restore status stays a quiet line. *@
@if (State.SettingsDirty)
{
    <div class="settings-savebar compact-savebar" data-settings-savebar role="region" aria-label="Unsaved settings">
        <div><strong>Unsaved changes</strong><span>@State.SettingsEditMessage</span></div>
        <div class="settings-save-actions"><button class="button secondary" disabled="@(!State.SettingsWritable)" @onclick="State.ResetSettings">Restore defaults</button><button class="button primary" disabled="@(!State.SettingsWritable)" @onclick="State.SaveSettings">Save</button></div>
    </div>
}
else
{
    <div class="settings-quiet-status" data-settings-quiet role="status">
        <span>@State.SettingsMessage</span>
        <button type="button" class="text-button" disabled="@(!State.SettingsWritable)" @onclick="State.ResetSettings">Restore defaults</button>
    </div>
}

<DiagnosticsPage State="State" />

@if (_backupGuideOpen)
{
    <div class="settings-guide-backdrop" role="presentation" @onclick="CloseBackupGuide">
        <section class="settings-guide" role="dialog" aria-modal="true" aria-labelledby="backup-guide-title" @onclick:stopPropagation="true">
            <header>
                <div><ProductIcon Name="duplicate" Size="19" /><div><span class="eyebrow">Move or back up</span><h2 id="backup-guide-title">Prepare the Coach folder</h2></div></div>
                <button class="icon-button" aria-label="Close" @onclick="CloseBackupGuide"><ProductIcon Name="close" Size="17" /></button>
            </header>
            <p>Copy your race history, settings, tire data, and tuning work. Reconnect ChatGPT and Garage61 on the destination PC.</p>
            <ol class="settings-guide-stages" aria-label="Preparation stages">
                <li class="@StageClass(1)"><span>1</span><div><strong>Review</strong><small>Confirm the folder and what will move.</small></div></li>
                <li class="@StageClass(2)"><span>2</span><div><strong>Check</strong><small>Finish writes and verify every Coach file.</small></div></li>
                <li class="@StageClass(3)"><span>3</span><div><strong>Copy</strong><small>Copy the whole Coach folder when it is ready.</small></div></li>
            </ol>
            <div class="settings-guide-location"><span>Coach folder</span><strong>@State.Settings.CoachHome</strong></div>
            @if (State.BackupPreparation is not null && _backupStage >= 3)
            {
                <div class="settings-result @(State.BackupPreparation.SafeToCopy ? "success" : "warning")">
                    <ProductIcon Name="@(State.BackupPreparation.SafeToCopy ? "check" : "info")" Size="16" />
                    <div><strong>@(State.BackupPreparation.SafeToCopy ? "Ready to copy" : "Needs attention")</strong><span>@State.BackupPreparation.Message</span></div>
                </div>
            }
            <footer>
                <button class="button secondary" @onclick="CloseBackupGuide">Close</button>
                @if (_backupStage < 3 || State.BackupPreparation is { SafeToCopy: false })
                {
                    <button class="button primary" disabled="@_backupPreparing" @onclick="PrepareCoachFolder">
                        @(_backupPreparing ? "Checking Coach folder…" : "Check and prepare")
                    </button>
                }
            </footer>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;

    private bool _connectionsOpen;
    private bool _foldersOpen;
    private bool _backupGuideOpen;
    private bool _backupPreparing;
    private int _backupStage = 1;
    private bool CustomThemeSelected => string.Equals(ThemeColors.Normalize(State.Settings.ThemeColor), ThemeColors.CustomId, StringComparison.Ordinal);
    private string CustomThemeClass => CustomThemeSelected ? "active" : string.Empty;

    protected override void OnParametersSet()
    {
        if (State.ConsumeConnectionsNavigationRequest()) _connectionsOpen = true;
    }

    private void ToggleConnections() => _connectionsOpen = !_connectionsOpen;
    private void ShowFolders() => _foldersOpen = true;
    private Task CheckAgain() => State.RunHealthCheckAsync();
    private string CoachFolderName => System.IO.Path.GetFileName(State.Settings.CoachHome.TrimEnd(System.IO.Path.DirectorySeparatorChar, System.IO.Path.AltDirectorySeparatorChar)) is { Length: > 0 } name ? name : State.Settings.CoachHome;
    private void OpenBackupGuide() { _backupStage = State.BackupPreparation?.SafeToCopy == true ? 3 : 1; _backupGuideOpen = true; }
    private void CloseBackupGuide() { if (!_backupPreparing) _backupGuideOpen = false; }
    private void HandleCustomThemeColor(ChangeEventArgs args) => State.SetCustomThemeColor(args.Value?.ToString() ?? ThemeColors.DefaultCustomHex);

    private async Task PrepareCoachFolder()
    {
        if (_backupPreparing) return;
        _backupPreparing = true;
        _backupStage = 2;
        await InvokeAsync(StateHasChanged);
        try
        {
            await State.PrepareBackupAsync();
            _backupStage = 3;
        }
        finally
        {
            _backupPreparing = false;
        }
    }

    private string StageClass(int stage) => stage < _backupStage ? "complete" : stage == _backupStage ? "active" : string.Empty;

    private string PortableSummary => State.Archive is null ? string.Empty : string.Join(" · ", new[]
    {
        (State.Archive.Restored.Reports, "report", "reports"),
        (State.Archive.Restored.SeasonalBundles, "season file", "season files"),
        (State.Archive.Restored.Setups, "setup", "setups"),
        (State.Archive.Restored.TuningExperiments, "tuning file", "tuning files"),
        (State.Archive.Restored.TireModels, "tire model", "tire models"),
        (State.Archive.Restored.DriverModels, "driver model", "driver models"),
        (State.Archive.Restored.AiCoachingFiles, "coaching record", "coaching records")
    }.Where(item => item.Item1 > 0).Select(item => $"{item.Item1} {(item.Item1 == 1 ? item.Item2 : item.Item3)}"));
}
