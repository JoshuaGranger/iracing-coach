<div class="page-heading compact-heading settings-heading">
    <div><span class="eyebrow">Settings</span><h1>App and data</h1></div>
</div>

<div class="settings-hub-grid">
    <section class="surface-card settings-hub-card" aria-labelledby="storage-heading">
        <div class="settings-hub-heading">
            <div><ProductIcon Name="setup" Size="18" /><h2 id="storage-heading">Data</h2></div>
            <span class="status-label @(State.IRacingDetected ? "success" : "warning")">@(State.IRacingDetected ? "Ready" : "Check folders")</span>
        </div>
        <div class="settings-summary-list">
            <div><span>Coach folder</span><strong>Portable</strong></div>
            <div><span>iRacing files</span><strong>@(State.IRacingDetected ? "Found" : "Not found")</strong></div>
        </div>
        <details class="settings-disclosure">
            <summary>Folder locations</summary>
            <div class="settings-rows compact-paths">
                <label><span>Coach folder<small>Preferences, analysis, history, and setup copies</small></span><input value="@State.Settings.CoachHome" readonly /></label>
                <label><span>iRacing Documents<small>Telemetry, replays, and saved setups</small></span><input @bind="State.Settings.IRacingRoot" @bind:event="oninput" /></label>
                <label><span>iRacing installation<small>Cars, tracks, and version metadata; read only</small></span><input @bind="State.Settings.IRacingInstallRoot" @bind:event="oninput" /></label>
                <label><span>Coach archive<small>Derived analysis and tuning history</small></span><input value="@State.Settings.ArchiveRoot" readonly /></label>
            </div>
        </details>
    </section>

    <section class="surface-card settings-hub-card" aria-labelledby="portable-copy-heading">
        <div class="settings-hub-heading">
            <div><ProductIcon Name="duplicate" Size="18" /><h2 id="portable-copy-heading">Backup or move PCs</h2></div>
            <button class="button primary compact" @onclick="() => State.PrepareBackupAsync()">Prepare copy</button>
        </div>
        <p class="settings-card-copy">Checks the Coach folder and tells you when it is safe to copy.</p>
        @if (State.Archive is not null)
        {
            <div class="settings-summary-list">
                <div><span>Portable data</span><strong>@State.Archive.Restored.TotalItems items</strong></div>
                <div><span>Protected connections</span><strong>Reconnect per PC</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(PortableSummary))
            {
                <small class="settings-footnote">@PortableSummary</small>
            }
        }
        @if (State.BackupPreparation is not null)
        {
            <div class="settings-result @(State.BackupPreparation.SafeToCopy ? "success" : "warning")">
                <ProductIcon Name="@(State.BackupPreparation.SafeToCopy ? "check" : "info")" Size="16" />
                <div><strong>@(State.BackupPreparation.SafeToCopy ? "Safe to copy" : "Not ready")</strong><span>@State.BackupPreparation.Message</span></div>
            </div>
        }
        @if (State.Archive is not null && State.Archive.Restored.UnresolvedSources > 0)
        {
            <button class="text-button settings-locate" @onclick="State.RequestLocateRawTelemetry">Find @State.Archive.Restored.UnresolvedSources missing telemetry file@(State.Archive.Restored.UnresolvedSources == 1 ? null : "s")</button>
        }
    </section>

    <section class="surface-card settings-hub-card" aria-labelledby="behavior-heading">
        <div class="settings-hub-heading"><div><ProductIcon Name="settings" Size="18" /><h2 id="behavior-heading">App behavior</h2></div></div>
        <fieldset class="theme-color-field">
            <legend>Theme color</legend>
            <div class="theme-color-row">
                <div class="theme-color-options" role="group" aria-label="Theme color">
                    @foreach (var color in ThemeColors.Choices)
                    {
                        var selected = string.Equals(ThemeColors.Normalize(State.Settings.ThemeColor), color.Id, StringComparison.Ordinal);
                        <button type="button"
                                class="theme-color-swatch @ThemeColors.CssClass(color.Id) @(selected ? "active" : null)"
                                aria-label="@color.Name"
                                aria-pressed="@selected"
                                title="@color.Name"
                                @onclick="() => State.SetThemeColor(color.Id)">
                            @if (selected)
                            {
                                <ProductIcon Name="check" Size="13" />
                            }
                        </button>
                    }
                </div>
                <strong>@ThemeColors.Get(State.Settings.ThemeColor).Name</strong>
            </div>
        </fieldset>
        <div class="settings-toggle-stack">
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.LaunchAtSignIn" /><span><strong>Open when I sign in</strong><small>Starts minimized and watches for completed recordings.</small></span></label>
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.UseReducedMotion" /><span><strong>Reduce motion</strong><small>Turns off nonessential transitions and interpolation.</small></span></label>
        </div>
    </section>

    <section class="surface-card settings-hub-card" aria-labelledby="live-monitor-heading">
        <div class="settings-hub-heading">
            <div><ProductIcon Name="monitor" Size="18" /><h2 id="live-monitor-heading">Telemetry popout</h2></div>
            <strong class="settings-layout-name">@LiveMonitorLayouts.Active(State.Settings.LiveMonitor).Layout.Name</strong>
        </div>
        <label class="settings-inline-field"><span>Show / hide hotkey</span><input placeholder="Ctrl+Shift+L" @bind="State.Settings.LiveMonitor.GlobalHotkey" @bind:event="oninput" /></label>
        <div class="settings-toggle-stack compact">
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.LiveMonitor.SafeGlanceEnabled" /><span><strong>Safe-glance cues</strong><small>Hold ordinary cue changes for safer moments.</small></span></label>
            <label class="toggle-row"><input type="checkbox" @bind="State.Settings.LiveMonitor.ReopenOnConnect" /><span><strong>Open with iRacing</strong><small>Show the popout when live telemetry connects.</small></span></label>
        </div>
    </section>
</div>

<details class="surface-card settings-connections-disclosure">
    <summary><span><ProductIcon Name="connections" Size="17" /><strong>Connections</strong></span><small>Garage61 and optional coaching</small></summary>
    <ConnectionsPage State="State" Embedded="true" />
</details>

<div class="settings-savebar compact-savebar">
    <div><strong>Portable preferences</strong><span>@State.SettingsMessage</span></div>
    <div class="settings-save-actions"><button class="button secondary" @onclick="State.ResetSettings">Restore defaults</button><button class="button primary" @onclick="State.SaveSettings">Save</button></div>
</div>

<DiagnosticsPage State="State" />

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;

    private string PortableSummary => State.Archive is null ? string.Empty : string.Join(" · ", new[]
    {
        (State.Archive.Restored.Reports, "report", "reports"),
        (State.Archive.Restored.SeasonalBundles, "season file", "season files"),
        (State.Archive.Restored.Setups, "setup", "setups"),
        (State.Archive.Restored.TuningExperiments, "tuning file", "tuning files"),
        (State.Archive.Restored.TireModels, "tire model", "tire models"),
        (State.Archive.Restored.DriverModels, "driver model", "driver models"),
        (State.Archive.Restored.AiCoachingFiles, "coaching record", "coaching records")
    }.Where(item => item.Item1 > 0).Select(item => $"{item.Item1} {(item.Item1 == 1 ? item.Item2 : item.Item3)}"));
}
