<section class="race-coach-panel" aria-label="Ask about this race">
    <header><div><h3>Ask about this race</h3><p>@Workspace.Track · @Workspace.Car</p></div></header>
    @if (!State.CoachEngine.ChatGptConnected)
    {
        <p>Connect ChatGPT to ask follow-up questions about this recording.</p>
        <button class="button secondary" @onclick='() => State.Navigate("connections")'>Connect ChatGPT</button>
    }
    else
    {
        <div class="coach-question-suggestions" role="group" aria-label="Suggested race questions">
            @foreach (var question in Questions)
            {
                <button type="button" disabled="@IsThisRaceCoaching" @onclick="() => ChooseQuestion(question)">@question</button>
            }
        </div>
        <label for="race-coach-question">Your question</label>
        <textarea id="race-coach-question" rows="3" @bind="State.CoachQuestion" @bind:event="oninput" disabled="@IsThisRaceCoaching" placeholder="Why did I lose pace after my last stop?"></textarea>
        <div class="workflow-actions">
            @if (IsThisRaceCoaching)
            {
                <span role="status">Reviewing this race…</span>
                <button class="button secondary" @onclick="State.CancelCoachRequest">Cancel</button>
            }
            else
            {
                <button class="button primary" disabled="@string.IsNullOrWhiteSpace(State.CoachQuestion)" @onclick="Ask">Ask</button>
            }
        </div>
    }
    @if (State.CoachAnswerAnalysisId == Workspace.AnalysisId && !string.IsNullOrWhiteSpace(State.CoachAnswer))
    {
        <RaceCoachAnswer Answer="State.CoachAnswer" />
    }
    @if (History.Count > 0)
    {
        <details class="evidence-details"><summary>Earlier questions about this race (@History.Count)</summary>
            @foreach (var answer in History)
            {
                <article><h4>@answer.Question</h4><RaceCoachAnswer Answer="answer.Response" /></article>
            }
        </details>
    }
</section>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    private bool IsThisRaceCoaching => State.IsCoaching && State.CoachAnswerAnalysisId == Workspace.AnalysisId;
    private static readonly string[] Questions = ["Why did I lose pace?", "What should I do differently next time?", "Did track conditions change?"];
    private IReadOnlyList<PortableCoachingRecord> History => State.CoachingHistory
        .Where(item => item.WorkflowKey == $"race:{State.SelectedRaceSessionId}")
        .Take(8).ToArray();
    private void ChooseQuestion(string question) => State.CoachQuestion = question;
    private Task Ask() => State.AskRaceCoachAsync();
}
