    private MapPoint ProjectVectorPoint(AnalysisVectorPoint point, double? percent = null)
    {
        if (_vectorProjection is not { } projection) return new MapPoint(Wrap(percent ?? point.LapPercent ?? 0), point.X, point.Y);
        return new MapPoint(Wrap(percent ?? point.LapPercent ?? 0), 300 + (point.X - projection.CenterX) * projection.Scale, 180 + (point.Y - projection.CenterY) * projection.Scale);
    }
    private MapLine? ProjectVectorLine(AnalysisVectorLine? line)
    {
        if (line is null) return null;
        var first = ProjectVectorPoint(line.A); var second = ProjectVectorPoint(line.B);
        return new(first.X, first.Y, second.X, second.Y);
    }
    private string VectorPath(IReadOnlyList<AnalysisVectorPoint>? points) => points is not { Count: >= 2 } ? string.Empty : SvgPath(points.Select(point => ProjectVectorPoint(point)).ToArray(), false);
    private static IEnumerable<AnalysisVectorPoint> VectorLinePoints(AnalysisVectorLine? line) => line is null ? [] : [line.A, line.B];
    private static VectorProjection? CreateVectorProjection(IReadOnlyList<AnalysisVectorPoint> points)
    {
        if (points.Count == 0) return null;
        var minimumX = points.Min(point => point.X); var maximumX = points.Max(point => point.X);
        var minimumY = points.Min(point => point.Y); var maximumY = points.Max(point => point.Y);
        var scale = Math.Min(500 / Math.Max(.0001, maximumX - minimumX), 300 / Math.Max(.0001, maximumY - minimumY));
        return new VectorProjection((minimumX + maximumX) / 2, (minimumY + maximumY) / 2, scale);
    }
    private static bool IsCompleteTrackShape(IReadOnlyList<TrackShapePoint> points)
    {
        if (points.Count < 3) return false;
        var ordered = points
            .Where(point => double.IsFinite(point.LapPercent) && double.IsFinite(point.X) && double.IsFinite(point.Y))
            .OrderBy(point => Wrap(point.LapPercent))
            .ToArray();
        if (ordered.Length < 3) return false;
        var maximumGap = Wrap(ordered[0].LapPercent) + 1 - Wrap(ordered[^1].LapPercent);
        for (var index = 1; index < ordered.Length; index++)
            maximumGap = Math.Max(maximumGap, Wrap(ordered[index].LapPercent) - Wrap(ordered[index - 1].LapPercent));
        var width = ordered.Max(point => point.X) - ordered.Min(point => point.X);
        var height = ordered.Max(point => point.Y) - ordered.Min(point => point.Y);
        var span = Math.Max(width, height);
        var closure = Math.Sqrt(Math.Pow(ordered[0].X - ordered[^1].X, 2) + Math.Pow(ordered[0].Y - ordered[^1].Y, 2));
        return maximumGap <= .05 && span > 0 && closure <= span * .15;
    }
    private MapLine? InferredStartFinishLine()
    {
        if (TrackPoints.Count < 3) return null;
        var center = PointAt(0); var before = PointAt(.995); var after = PointAt(.005);
        var dx = after.X - before.X; var dy = after.Y - before.Y; var length = Math.Sqrt(dx * dx + dy * dy);
        if (length < .001) return new(center.X, center.Y - 16, center.X, center.Y + 16);
        var nx = -dy / length * 16; var ny = dx / length * 16;
        return new(center.X - nx, center.Y - ny, center.X + nx, center.Y + ny);
    }
    private MapPoint PointAt(double percent)
    {
        var points = TrackPoints; var target = Wrap(percent);
        for (var index = 0; index < points.Count; index++)
        {
            var first = points[index]; var second = points[(index + 1) % points.Count];
            var end = second.Percent <= first.Percent ? second.Percent + 1 : second.Percent;
            var adjusted = target < first.Percent ? target + 1 : target;
            if (adjusted > end + .000001) continue;
            var amount = Math.Abs(end - first.Percent) < .000001 ? 0 : (adjusted - first.Percent) / (end - first.Percent);
            return new(target, first.X + (second.X - first.X) * amount, first.Y + (second.Y - first.Y) * amount);
        }
        return points[0];
    }

    private bool CanInterpolateFrameTransition(AnalysisReplayFrame current, AnalysisReplayFrame next, int carIndex)
    {
        var gap = next.SessionTimeSeconds - current.SessionTimeSeconds;
        var recordedRate = Replay?.SampleRateHz;
        var sampleRate = recordedRate is > 0 ? recordedRate.Value : 2;
        var limit = Math.Clamp(2.5 / sampleRate, .25, 2);
        return Replay?.Interpolation.StartsWith("linear", StringComparison.OrdinalIgnoreCase) == true
            && ParticipantHasReplayData(carIndex)
            && gap > 0
            && gap <= limit
            && string.Equals(current.SessionState, next.SessionState, StringComparison.OrdinalIgnoreCase);
    }

    private static bool TemporalCoverageIsUsable(AnalysisReplayTemporalCoverage? coverage) => coverage is null
        || (!coverage.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase)
            && coverage.RecordedFrameCount is not < 2
            && coverage.RecordedFraction is not <= 0);

    private bool ParticipantHasReplayData(int carIndex)
    {
        if (_participantCoverage.Count == 0) return true;
        return _participantCoverage.TryGetValue(carIndex, out var coverage)
            && !coverage.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase)
            && coverage.RecordedFrameCount is not < 2
            && coverage.RecordedFraction is not <= 0;
    }

    private static bool CoverageStatusIsComplete(string status) =>
        status.Equals("complete", StringComparison.OrdinalIgnoreCase)
        || status.Equals("usable", StringComparison.OrdinalIgnoreCase)
        || status.Equals("recorded", StringComparison.OrdinalIgnoreCase);

    private static bool ParticipantCoverageIsComplete(AnalysisReplayParticipantCoverage coverage) =>
        CoverageStatusIsComplete(coverage.Status)
        && coverage.RecordedFraction is not < .999
        && (coverage.SegmentCount is null || coverage.RecordedSegmentCount == coverage.SegmentCount);

    private async Task TogglePlayback()
    {
        Playing = !Playing;
        var generation = ++_playbackGeneration;
        if (!Playing) return;
        if (PlaybackFraction >= .999) PlaybackFraction = 0;
        var previous = DateTimeOffset.UtcNow;
        while (Playing && generation == _playbackGeneration && !_playbackCancellation.IsCancellationRequested)
        {
            var now = DateTimeOffset.UtcNow;
            var elapsed = (now - previous).TotalSeconds;
            previous = now;
            PlaybackFraction = Math.Clamp(PlaybackFraction + elapsed * PlaybackSpeed / ReplayDurationSeconds, 0, 1);
            if (PlaybackFraction >= 1) Playing = false;
            await InvokeAsync(StateHasChanged);
            try { await Task.Delay(16, _playbackCancellation.Token); } catch (OperationCanceledException) { break; }
        }
    }
    private void Seek(ChangeEventArgs args)
    {
        Playing = false;
        _playbackGeneration++;
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value)) PlaybackFraction = Math.Clamp(value / 1000, 0, 1);
    }
    private void ChangePlaybackSpeed(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && PlaybackSpeeds.Contains(value)) PlaybackSpeed = value;
    }
    private void SeekToTime(double seconds) { Playing = false; _playbackGeneration++; PlaybackFraction = Math.Clamp((seconds - ReplayStartSeconds) / ReplayDurationSeconds, 0, 1); }
    private void SeekToLap(int lap)
    {
        var player = PlayerCarIndex;
        var frame = Frames.FirstOrDefault(item => player.HasValue && item.Cars.Any(car => car.CarIndex == player && DisplayLap(car) is { } recordedLap && recordedLap >= lap));
        if (frame is not null) SeekToTime(frame.SessionTimeSeconds);
    }
    private void SeekToLeaderLap(int lap)
    {
        var frame = Frames.FirstOrDefault(item => ClassLeader(item) is { } leader && DisplayLap(leader) is { } recordedLap && recordedLap >= lap);
        if (frame is not null) SeekToTime(frame.SessionTimeSeconds);
    }
    private void PreviousLap() { if (CurrentLapNumber is { } lap) SeekToLap(Math.Max(1, lap - 1)); }
    private void NextLap() { if (CurrentLapNumber is { } lap) SeekToLap(lap + 1); }
    private int FrameIndexAt(double sessionTime)
    {
        var low = 0; var high = Frames.Count - 1;
        while (low < high)
        {
            var middle = (low + high + 1) / 2;
            if (Frames[middle].SessionTimeSeconds <= sessionTime) low = middle; else high = middle - 1;
        }
        return low;
    }

