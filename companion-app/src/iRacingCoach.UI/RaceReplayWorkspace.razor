    private void RebuildReplayMapCache()
    {
        _geometryBounds = CompleteVectorGeometry is { } vector
            ? vector.MainPath.Concat(vector.PitLane).Concat(vector.PitEntryPath).Concat(vector.PitExitPath)
                .Concat(VectorLinePoints(vector.StartFinishLine)).Concat(VectorLinePoints(vector.PitCommitmentLine)).Concat(VectorLinePoints(vector.PitMergeLine)).ToArray()
            : [];
        _vectorProjection = CreateVectorProjection(_geometryBounds);
        if (CompleteVectorGeometry is { } mapped)
            _trackPoints = mapped.MainPath.Select((point, index) => ProjectVectorPoint(point, point.LapPercent ?? index / (double)mapped.MainPath.Count)).ToArray();
        else if (HasCompleteTrackShape)
        {
            var minX = Workspace.TrackShape.Min(point => point.X); var maxX = Workspace.TrackShape.Max(point => point.X);
            var minY = Workspace.TrackShape.Min(point => point.Y); var maxY = Workspace.TrackShape.Max(point => point.Y);
            var scale = Math.Min(500 / Math.Max(.0001, maxX - minX), 300 / Math.Max(.0001, maxY - minY));
            _trackPoints = Workspace.TrackShape.OrderBy(point => point.LapPercent).Select(point => new MapPoint(Wrap(point.LapPercent), 300 + (point.X - (minX + maxX) / 2) * scale, 180 - (point.Y - (minY + maxY) / 2) * scale)).ToArray();
        }
        else _trackPoints = [];
        _trackPath = SvgPath(TrackPoints, HasTrackGeometry);
        _pitLanePath = VectorPath(CompleteVectorGeometry?.PitLane);
        _pitEntryPath = VectorPath(CompleteVectorGeometry?.PitEntryPath);
        _pitExitPath = VectorPath(CompleteVectorGeometry?.PitExitPath);
        _pitCommitmentLine = ProjectVectorLine(CompleteVectorGeometry?.PitCommitmentLine);
        _pitMergeLine = ProjectVectorLine(CompleteVectorGeometry?.PitMergeLine);
        _startFinishLine = CompleteVectorGeometry?.StartFinishLine is { } recorded ? ProjectVectorLine(recorded) : InferredStartFinishLine();
        var points = CompleteVectorGeometry is not null ? _geometryBounds.Select(point => ProjectVectorPoint(point)).ToArray() : TrackPoints;
        if (points.Count == 0) { _trackViewBox = "0 0 600 360"; return; }
        const double pad = 34;
        var minimumX = points.Min(point => point.X); var maximumX = points.Max(point => point.X);
        var minimumY = points.Min(point => point.Y); var maximumY = points.Max(point => point.Y);
        _trackViewBox = $"{F(minimumX - pad)} {F(minimumY - pad)} {F(maximumX - minimumX + 2 * pad)} {F(maximumY - minimumY + 2 * pad)}";
    }
    private IReadOnlyList<MapPoint> TrackPoints => _trackPoints ?? [];
    private IReadOnlyList<AnalysisVectorPoint> GeometryBounds => _geometryBounds;
    private string TrackPath => _trackPath;
    private string PitLanePath => _pitLanePath;
