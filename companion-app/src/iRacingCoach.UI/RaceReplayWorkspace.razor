@using System.Globalization
@implements IAsyncDisposable

<section class="race-replay-workspace" data-analysis-section="replay" data-race-replay aria-label="Race replay">
    @if (!ReplayAvailable)
    {
        <div class="replay-unavailable" data-replay-unavailable>
            <ProductIcon Name="replay" Size="26" />
            <div><h2>Race replay is unavailable</h2><p>@ReplayUnavailableReason</p></div>
        </div>
    }
    else
    {
        <div class="replay-layout">
            <aside class="replay-leader-rail" data-replay-leader-rail aria-label="@($"{LeaderScopeLabel} laps")">
                <header><span class="eyebrow">@LeaderScopeLabel</span><strong>Lap history</strong></header>
                @if (CurrentClassLeader is { } leader)
                {
                    <div class="replay-leader-row leader" data-replay-leader-row data-car-index="@leader.CarIndex" style="@($"--replay-car-color:{leader.Color}")">
                        <b>@Position(leader.State.OverallPosition)</b>
                        <span class="replay-car-number">@leader.Number</span>
                        <span class="replay-driver"><strong>@leader.Driver</strong><small>@leader.ClassName</small></span>
                        <span class="replay-lap">@LapLabel(leader.State)</span>
                    </div>
                    @if (CurrentLeaderLap.HasValue)
                    {
                        <div class="replay-leader-lap-list" data-replay-leader-lap-list>
                            @foreach (var lap in LeaderLapWindow)
                            {
                                <button type="button" class="@(lap == CurrentLeaderLap ? "current" : null)" data-replay-leader-lap="@lap" aria-current="@(lap == CurrentLeaderLap ? "true" : null)" @onclick="() => SeekToLeaderLap(lap)">
                                    <span>Lap @lap</span><b>@(lap == CurrentLeaderLap ? CurrentFlagSummary : string.Empty)</b>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="replay-rail-unavailable" data-replay-unavailable="leader-laps"><ProductIcon Name="info" Size="15" /><span>Leader lap count was not recorded at this moment.</span></div>
                    }
                }
                else
                {
                    <div class="replay-rail-unavailable" data-replay-unavailable="leader-order"><ProductIcon Name="info" Size="15" /><span>Leader-lap order was not recorded at this moment.</span></div>
                }
            </aside>

            <main class="replay-stage">
                <section class="replay-map-card" data-replay-map>
                    <header>
                        <div><span class="eyebrow">Track</span><strong>@Workspace.Track <span>@Workspace.Layout</span></strong></div>
                        <span class="replay-map-status">@CurrentFlagSummary · @CurrentLapLabel · @((CurrentLapPercent * 100).ToString("0.0"))%</span>
                    </header>
                    <svg class="replay-track-map" viewBox="@TrackViewBox" role="img" aria-label="Full-field race replay track map">
                        <path d="@TrackPath" class="replay-track-ribbon-halo" />
                        <path d="@TrackPath" class="replay-track-ribbon" data-map-layer="main" />
                        @if (!string.IsNullOrWhiteSpace(PitLanePath))
                        {
                            <path d="@PitLanePath" class="replay-pit-road-halo" />
                            <path d="@PitLanePath" class="replay-pit-road" data-map-layer="pit-road" />
                        }
                        @if (!string.IsNullOrWhiteSpace(PitEntryPath)) { <path d="@PitEntryPath" class="replay-pit-entry" data-map-layer="pit-entry" /> }
                        @if (!string.IsNullOrWhiteSpace(PitExitPath)) { <path d="@PitExitPath" class="replay-pit-exit" data-map-layer="pit-exit" /> }
                        @if (PitCommitmentLine is { } commitment)
                        {
                            <line x1="@F(commitment.X1)" y1="@F(commitment.Y1)" x2="@F(commitment.X2)" y2="@F(commitment.Y2)" class="replay-pit-commitment entry" data-map-layer="commitment" />
                        }
                        @if (PitMergeLine is { } merge)
                        {
                            <line x1="@F(merge.X1)" y1="@F(merge.Y1)" x2="@F(merge.X2)" y2="@F(merge.Y2)" class="replay-pit-commitment exit" data-map-layer="commitment" />
                        }
                        @if (StartFinishLine is { } line)
                        {
                            <line x1="@F(line.X1)" y1="@F(line.Y1)" x2="@F(line.X2)" y2="@F(line.Y2)" class="replay-start-line-halo" />
                            <line x1="@F(line.X1)" y1="@F(line.Y1)" x2="@F(line.X2)" y2="@F(line.Y2)" class="replay-start-line" data-map-layer="start-finish" />
                        }
                        @foreach (var car in RenderedCars)
                        {
                            <g class="replay-car-marker @(car.IsPlayer ? "player" : null) @(car.IsClassLeader ? "class-leader" : null) @(car.IsOverallLeader ? "overall-leader" : null)"
                               data-replay-car="@car.CarIndex" data-player="@Aria(car.IsPlayer)" data-class-leader="@Aria(car.IsClassLeader)"
                               style="@($"--replay-car-color:{car.Color}")" transform="translate(@F(car.Point.X) @F(car.Point.Y))">
                                <circle r="@(car.IsPlayer || car.IsClassLeader ? 13 : 10)" class="replay-car-halo" />
                                <circle r="@(car.IsPlayer || car.IsClassLeader ? 10 : 7.5)" class="replay-car-body" />
                                <svg:text text-anchor="middle" dominant-baseline="central">@car.Number</svg:text>
                            </g>
                        }
                    </svg>
                    <div class="replay-map-key">
                        <span><i class="player"></i>You</span><span><i class="leader"></i>Class leader</span><span>Car color = class</span>
                        @if (ReplayCoverageLabel is { } coverageLabel)
                        {
                            <span class="replay-coverage-note" title="@ReplayCoverageDetails">@coverageLabel</span>
                        }
                    </div>
                </section>

                <section class="replay-comparison" data-replay-comparison>
                    <header><span class="eyebrow">Known comparison</span><strong>@LeaderScopeLabel and you</strong></header>
                    @if (PlayerComparison is not null)
                    {
                        <div class="replay-comparison-table">
                            <div class="replay-comparison-head"><span></span><b>@LeaderScopeLabel @PlayerComparison.LeaderNumber</b><b>You</b></div>
                            @foreach (var row in ComparisonRows)
                            {
                                <div class="replay-comparison-row"><span>@row.Label</span><b>@row.Leader</b><b>@row.Player</b></div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="replay-comparison-unavailable" data-replay-unavailable="comparison">Leader-to-driver comparison is not known at this moment.</div>
                    }
                </section>

                <section class="replay-session-data" data-replay-grid>
                    <header><span class="eyebrow">Race grid</span><strong>Recorded running order</strong></header>
                    <div class="replay-grid-table">
                        <div class="replay-grid-head"><span>Pos</span><span>Car</span><span>Lap</span><span>State</span></div>
                        @foreach (var row in GridRows)
                        {
                            <div class="replay-grid-row @(row.IsPlayer ? "player" : null)" data-car-index="@row.CarIndex" style="@($"--replay-car-color:{row.Color}")">
                                <b>@Position(row.State.OverallPosition)</b>
                                <span><i></i><strong>@row.Number</strong> @row.Driver</span>
                                <strong>@LapNumberText(row.State)</strong>
                                <small>@CarState(row.State)</small>
                            </div>
                        }
                    </div>
                    @if (AtChecker)
                    {
                        <div class="replay-event-timeline compact" data-replay-timeline aria-label="Recorded race events">
                            @foreach (var item in TimelineEvents)
                            {
                                <button type="button" @onclick="() => SeekToTime(item.SessionTimeSeconds)"><span class="@item.Kind"></span><b>@Clock(item.SessionTimeSeconds - ReplayStartSeconds)</b><small>@item.Label</small></button>
                            }
                        </div>
                    }
                </section>

                <footer class="replay-playback" data-replay-playback>
                    <button type="button" class="replay-skip" title="Previous lap" aria-label="Previous lap" disabled="@(!CurrentLapNumber.HasValue)" @onclick="PreviousLap"><ProductIcon Name="chevron-left" Size="16" /></button>
                    <button type="button" class="replay-play" title="@(Playing ? "Pause replay" : "Play replay")" aria-label="@(Playing ? "Pause replay" : "Play replay")" aria-pressed="@Playing" @onclick="TogglePlayback"><ProductIcon Name="@(Playing ? "pause" : "play")" Size="18" /></button>
                    <button type="button" class="replay-skip" title="Next lap" aria-label="Next lap" disabled="@(!CurrentLapNumber.HasValue)" @onclick="NextLap"><ProductIcon Name="chevron-right" Size="16" /></button>
                    <span class="replay-time">@PlaybackTime</span>
                    <div class="replay-scrubber">
                        <div class="replay-flag-strip" data-replay-flag-timeline aria-hidden="true">
                            @foreach (var segment in FlagSegments) { <i class="@segment.Kind" style="@($"left:{segment.Left:0.###}%;width:{segment.Width:0.###}%")"></i> }
                            <b style="@($"left:{PlaybackFraction * 100:0.###}%")"></b>
                        </div>
                        <input type="range" min="0" max="1000" step="1" value="@PlaybackSlider" @oninput="Seek" aria-label="Replay position" />
                    </div>
                    <span class="replay-time">@TotalReplayTime</span>
                    <label class="replay-speed"><span class="sr-only">Playback speed</span><select value="@PlaybackSpeed.ToString("0.0", CultureInfo.InvariantCulture)" @onchange="ChangePlaybackSpeed" aria-label="Playback speed">@foreach (var speed in PlaybackSpeeds) { <option value="@speed.ToString("0.0", CultureInfo.InvariantCulture)">@speed.ToString("0.#")&times;</option> }</select></label>
                </footer>
            </main>

            <aside class="replay-telemetry" data-replay-telemetry>
                <header>
                    <div><span class="eyebrow">Your telemetry</span><strong>One-lap trace</strong></div>
                    <div class="replay-telemetry-header-actions">
                        <span class="replay-current-lap">@(CurrentTrace is null ? "Unavailable" : $"Lap {CurrentTrace.Lap}")</span>
                        @if (FastestTrace is { } fastestReference)
                        {
                            <button type="button" class="replay-reference-toggle @(ShowFastestReference ? "active" : null)" data-replay-reference-toggle
                                    aria-pressed="@ShowFastestReference" title="Compare with fastest clean recorded lap @fastestReference.Lap" @onclick="ToggleFastestReference">
                                <i aria-hidden="true"></i><span>Fastest</span>
                            </button>
                        }
                    </div>
                </header>
                @if (CurrentTrace is null)
                {
                    <div class="replay-telemetry-unavailable" data-replay-unavailable="player-telemetry">Your synchronized lap telemetry is not available at this replay position.</div>
                }
                else
                {
                    @foreach (var chart in ReplayCharts)
                    {
                        <article class="replay-telemetry-chart" data-replay-chart="@chart.Id">
                            <header><span><b>@chart.Label</b><small>@chart.Unit</small></span>
                                @if (chart.Id == "brake" && HasAbsData)
                                {
                                    <label class="replay-abs-toggle" data-replay-abs-toggle title="Color explicitly recorded ABS intervention yellow"><input type="checkbox" @bind="ShowAbs" /><span>ABS</span></label>
                                }
                            </header>
                            <svg viewBox="0 0 360 94" preserveAspectRatio="none" role="img" aria-label="@chart.Label trace for lap @CurrentTrace.Lap">
                                <line x1="0" y1="47" x2="360" y2="47" class="replay-chart-grid" />
                                @if (ShowFastestReference && FastestTrace is { } reference)
                                {
                                    <path d="@ReplayChartPath(reference, chart.Id)" class="replay-reference-trace" />
                                }
                                <path d="@ReplayChartPath(CurrentTrace, chart.Id)" class="replay-current-trace" />
                                @if (chart.Id == "brake" && ShowAbs && HasAbsData)
                                {
                                    @foreach (var path in AbsTracePaths(CurrentTrace))
                                    {
                                        <path d="@path" class="replay-abs-trace" />
                                    }
                                }
                                <line x1="@F(CurrentLapPercent * 360)" y1="3" x2="@F(CurrentLapPercent * 360)" y2="91" class="replay-telemetry-cursor" />
                            </svg>
                            <footer>
                                <span>@ChartValue(chart.Id)</span>
                                @if (ShowFastestReference && FastestTrace is { } footerReference)
                                {
                                    <small>Fastest @footerReference.Lap · dotted</small>
                                }
                            </footer>
                        </article>
                    }
                }
            </aside>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;

    private readonly CancellationTokenSource _playbackCancellation = new();
    private bool Playing { get; set; }
    private bool ShowAbs { get; set; }
    private bool ShowFastestReference { get; set; } = true;
    private double PlaybackFraction { get; set; }
    private double PlaybackSpeed { get; set; } = 1;
    private string? _analysisId;
    private AnalysisWorkspace? _workspaceReference;
    private IReadOnlyList<MapPoint>? _trackPoints;
    private IReadOnlyList<AnalysisVectorPoint> _geometryBounds = [];
    private VectorProjection? _vectorProjection;
    private string _trackPath = string.Empty;
    private string _pitLanePath = string.Empty;
    private string _pitEntryPath = string.Empty;
    private string _pitExitPath = string.Empty;
    private string _trackViewBox = "0 0 600 360";
    private MapLine? _pitCommitmentLine;
    private MapLine? _pitMergeLine;
    private MapLine? _startFinishLine;
    private IReadOnlyList<AnalysisReplayFrame> _frames = [];
    private IReadOnlyDictionary<int, AnalysisReplayParticipant> _participants = new Dictionary<int, AnalysisReplayParticipant>();
    private IReadOnlyDictionary<int, AnalysisReplayParticipantCoverage> _participantCoverage = new Dictionary<int, AnalysisReplayParticipantCoverage>();
    private IReadOnlyDictionary<int, AnalysisLapTrace> _tracesByLap = new Dictionary<int, AnalysisLapTrace>();
    private IReadOnlyDictionary<int, IReadOnlyList<PitEvent>> _pitEventsByCar = new Dictionary<int, IReadOnlyList<PitEvent>>();
    private IReadOnlyList<TimelineItem> _timelineEvents = [];
    private IReadOnlyList<FlagSegment> _flagSegments = [];
    private AnalysisLapTrace? _fastestTrace;
    private int? _playerCarIndex;
    private int _maximumLeaderLap;
    private int _playbackGeneration;
    private bool _hasRecordedCars;
    private bool _hasPlayerFrame;
    private readonly Dictionary<(int CurrentLap, int TraceLap, string Signal, bool ReferenceVisible), string> _replayChartPathCache = [];
    private readonly Dictionary<(int CurrentLap, string Signal, bool ReferenceVisible), (double Minimum, double Maximum)> _replayChartRangeCache = [];
    private readonly Dictionary<int, IReadOnlyList<string>> _absTracePathCache = [];
    private HashSet<int> _absAvailableLaps = [];

    private static readonly double[] PlaybackSpeeds = [0.5, 1, 2, 4, 10];
    private static readonly string[] ClassColors = ["#61dca3", "#f6c85f", "#8f7df6", "#ee6f7c", "#56c8e8", "#f09452", "#c174df", "#77c65d"];
    private static readonly (string Label, string[] Aliases)[] TireCorners =
    [
        ("LF", ["LF", "left-front", "left front"]),
        ("RF", ["RF", "right-front", "right front"]),
        ("LR", ["LR", "left-rear", "left rear"]),
        ("RR", ["RR", "right-rear", "right rear"])
    ];
    private static readonly ReplayChart[] ReplayCharts =
    [
        new("speed", "Speed", "mph"),
        new("throttle", "Throttle", "%"),
        new("brake", "Brake", "%"),
        new("steering", "Steering", "left / right")
    ];

    protected override void OnParametersSet()
    {
        if (_analysisId == Workspace.AnalysisId && ReferenceEquals(_workspaceReference, Workspace)) return;
        _analysisId = Workspace.AnalysisId;
        _workspaceReference = Workspace;
        Playing = false;
        _playbackGeneration++;
        PlaybackFraction = 0;
        PlaybackSpeed = 1;
        ShowAbs = false;
        ShowFastestReference = true;
        _trackPoints = null;
        RebuildReplayCache();
    }

    private void RebuildReplayCache()
    {
        var replay = Workspace.Replay;
        _frames = replay?.Frames
            .Where(frame => double.IsFinite(frame.SessionTimeSeconds))
            .OrderBy(frame => frame.SessionTimeSeconds)
            .ToArray() ?? [];
        _participants = replay?.Participants
            .GroupBy(participant => participant.CarIndex)
            .ToDictionary(group => group.Key, group => group.Last())
            ?? new Dictionary<int, AnalysisReplayParticipant>();
        _participantCoverage = replay?.ParticipantCoverage?
            .GroupBy(item => item.CarIndex)
            .ToDictionary(group => group.Key, group => group.Last())
            ?? new Dictionary<int, AnalysisReplayParticipantCoverage>();
        _playerCarIndex = replay?.PlayerCarIndex
            ?? replay?.Participants.FirstOrDefault(participant => participant.IsPlayer)?.CarIndex;
        _hasRecordedCars = _frames.Any(frame => frame.Cars.Count > 0);
        _hasPlayerFrame = _playerCarIndex is { } playerIndex
            && ParticipantHasReplayData(playerIndex)
            && _frames.Any(frame => frame.Cars.Any(car => car.CarIndex == playerIndex));
        _tracesByLap = Workspace.Traces
            .GroupBy(trace => trace.Lap)
            .ToDictionary(group => group.Key, group => group.MaxBy(trace => trace.Points.Count)!);
        _fastestTrace = Workspace.Traces
            .Where(trace => trace.IsComparable() && trace.LapTimeSeconds.HasValue && trace.Points.Count > 0)
            .OrderBy(trace => trace.LapTimeSeconds)
            .FirstOrDefault();
        _absAvailableLaps = Workspace.Traces.Where(trace => trace.Points.Any(IsAbsActive)).Select(trace => trace.Lap).ToHashSet();
        _replayChartPathCache.Clear();
        _replayChartRangeCache.Clear();
        _absTracePathCache.Clear();
        _pitEventsByCar = BuildPitEventIndex();
        _maximumLeaderLap = _frames
            .Select(ClassLeader)
            .Where(state => state is not null)
            .Select(state => DisplayLap(state!))
            .Where(lap => lap.HasValue)
            .Select(lap => lap!.Value)
            .DefaultIfEmpty(0)
            .Max();
        _timelineEvents = BuildTimelineEvents();
        _flagSegments = BuildFlagSegments();
        RebuildReplayMapCache();
    }

    private IReadOnlyDictionary<int, IReadOnlyList<PitEvent>> BuildPitEventIndex()
    {
        var events = new Dictionary<int, List<PitEvent>>();
        var previousPitState = new Dictionary<int, PitRoadObservation>();
        for (var frameIndex = 0; frameIndex < _frames.Count; frameIndex++)
        {
            foreach (var car in _frames[frameIndex].Cars)
            {
                if (!car.OnPitRoad.HasValue) continue;
                var onPitRoad = car.OnPitRoad.Value;
                if (previousPitState.TryGetValue(car.CarIndex, out var previous)
                    && previous.FrameIndex == frameIndex - 1
                    && ReplayFramesAreContinuous(previous.FrameIndex, frameIndex)
                    && !previous.OnPitRoad
                    && onPitRoad)
                {
                    if (RecordedLapCount(car) is not { } recordedLapCount) continue;
                    if (!events.TryGetValue(car.CarIndex, out var carEvents)) events[car.CarIndex] = carEvents = [];
                    carEvents.Add(new PitEvent(frameIndex, recordedLapCount));
                }
                previousPitState[car.CarIndex] = new(frameIndex, onPitRoad);
            }
        }
        return events.ToDictionary(pair => pair.Key, pair => (IReadOnlyList<PitEvent>)pair.Value.ToArray());
    }

    private bool ReplayFramesAreContinuous(int previousFrameIndex, int currentFrameIndex)
    {
        if (previousFrameIndex < 0 || currentFrameIndex <= previousFrameIndex || currentFrameIndex >= _frames.Count) return false;
        var gap = _frames[currentFrameIndex].SessionTimeSeconds - _frames[previousFrameIndex].SessionTimeSeconds;
        var recordedRate = Replay?.SampleRateHz;
        var sampleRate = recordedRate is > 0 ? recordedRate.Value : 2;
        var limit = Math.Clamp(2.5 / sampleRate, .25, 2);
        return gap > 0 && gap <= limit;
    }

    private IReadOnlyList<TimelineItem> BuildTimelineEvents()
    {
        var events = new List<TimelineItem>();
        var flags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        PitRoadObservation? playerPit = null;
        string? sessionState = null;
        for (var frameIndex = 0; frameIndex < _frames.Count; frameIndex++)
        {
            var frame = _frames[frameIndex];
            foreach (var label in frame.GlobalFlagLabels.Where(label => !flags.Contains(label)))
                events.Add(new(frame.SessionTimeSeconds, FlagKind(label), FriendlyFlag(label)));
            flags = frame.GlobalFlagLabels.ToHashSet(StringComparer.OrdinalIgnoreCase);
            if (!string.Equals(frame.SessionState, sessionState, StringComparison.OrdinalIgnoreCase) && IsSignificantState(frame.SessionState))
                events.Add(new(frame.SessionTimeSeconds, FlagKind(frame.SessionState), FriendlySessionState(frame.SessionState)));
            sessionState = frame.SessionState;
            var currentPit = _playerCarIndex is { } player ? frame.Cars.FirstOrDefault(car => car.CarIndex == player)?.OnPitRoad : null;
            if (currentPit.HasValue
                && playerPit is { } previous
                && previous.FrameIndex == frameIndex - 1
                && ReplayFramesAreContinuous(previous.FrameIndex, frameIndex)
                && currentPit.Value != previous.OnPitRoad)
                events.Add(new(frame.SessionTimeSeconds, "pit", currentPit.Value ? "You entered pit road" : "You exited pit road"));
            if (currentPit.HasValue) playerPit = new(frameIndex, currentPit.Value);
        }
        return events
            .GroupBy(item => (Math.Round(item.SessionTimeSeconds, 2), item.Label))
            .Select(group => group.First())
            .OrderBy(item => item.SessionTimeSeconds)
            .ToArray();
    }

    private IReadOnlyList<FlagSegment> BuildFlagSegments()
    {
        if (_frames.Count == 0) return [];
        var segments = new List<FlagSegment>();
        var kind = FrameFlagKind(_frames[0]);
        var started = _frames[0].SessionTimeSeconds;
        foreach (var frame in _frames.Skip(1))
        {
            var nextKind = FrameFlagKind(frame);
            if (nextKind == kind) continue;
            segments.Add(FlagSegmentBetween(started, frame.SessionTimeSeconds, kind));
            started = frame.SessionTimeSeconds;
            kind = nextKind;
        }
        segments.Add(FlagSegmentBetween(started, _frames[^1].SessionTimeSeconds, kind));
        return segments;
    }

    private AnalysisRaceReplay? Replay => Workspace.Replay;
    private IReadOnlyList<AnalysisReplayFrame> Frames => _frames;
    private int? PlayerCarIndex => _playerCarIndex;
    private AnalysisTrackGeometry? CompleteVectorGeometry => Workspace.VectorGeometry is
    {
        MainPath.Count: >= 3,
        Quality.MainLoopComplete: true
    } vector && !vector.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase) ? vector : null;
    private bool HasCompleteTrackShape => IsCompleteTrackShape(Workspace.TrackShape);
    private bool HasTrackGeometry => CompleteVectorGeometry is not null || HasCompleteTrackShape;
    private bool ReplayAvailable => Replay is { } replay
        && (replay.Status.Equals("usable", StringComparison.OrdinalIgnoreCase) || replay.Status.Equals("partial", StringComparison.OrdinalIgnoreCase))
        && TemporalCoverageIsUsable(replay.TemporalCoverage)
        && replay.Participants.Count > 0
        && Frames.Count > 1
        && _hasRecordedCars
        && PlayerCarIndex.HasValue
        && replay.Participants.Any(participant => participant.CarIndex == PlayerCarIndex.Value)
        && _hasPlayerFrame
        && HasTrackGeometry;
    private string ReplayUnavailableReason
    {
        get
        {
            if (Replay is null) return "Full-field timing and car-position frames were not recorded for this race.";
            var stated = Replay.UnavailableReasons.FirstOrDefault(reason => !string.IsNullOrWhiteSpace(reason));
            if (!string.IsNullOrWhiteSpace(stated)) return HumanizeReplayUnavailableReason(stated);
            var coverage = Replay.Coverage.FirstOrDefault(item => item.Status.Equals("unavailable", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.Reason));
            if (coverage?.Reason is { Length: > 0 } reason) return HumanizeReplayUnavailableReason(reason);
            if (!TemporalCoverageIsUsable(Replay.TemporalCoverage)) return "Too little of the race timeline was recorded to replay it reliably.";
            if (PlayerCarIndex is { } player && !ParticipantHasReplayData(player)) return "Your car was not recorded often enough to synchronize this replay.";
            if (!HasTrackGeometry) return "Recorded track geometry is not available for this race.";
            return "The recording does not contain synchronized full-field replay frames.";
        }
    }

    private static string HumanizeReplayUnavailableReason(string reason)
    {
        var text = reason.Trim();
        if (text.Contains("CarIdxLapDistPct", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include full-field car positions.";
        if (text.Contains("CarIdxLapCompleted", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("CarIdxLap", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's lap count.";
        if (text.Contains("CarIdxClassPosition", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's class position.";
        if (text.Contains("CarIdxPosition", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's running position.";
        if (text.Contains("CarIdxOnPitRoad", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's pit-road status.";
        if (text.Contains("CarIdxTrackSurface", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's track location.";
        if (text.Contains("CarIdxPaceFlags", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's private flag status.";
        if (text.Contains("CarIdxLastLapTime", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's last-lap time.";
        if (text.Contains("CarIdxBestLapTime", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include every car's best-lap time.";
        if (text.Contains("DriverInfo", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include the driver roster needed to identify the cars.";
        if (text.Contains("PlayerCarIdx", StringComparison.OrdinalIgnoreCase))
            return "This recording does not identify your car in the field.";
        if (text.Contains("SessionTime", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include the race clock needed for replay.";
        if (text.Contains("SessionState", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include the race-state timing needed for replay.";
        if (text.Contains("SessionFlags", StringComparison.OrdinalIgnoreCase))
            return "This recording does not include the flag timeline needed for replay.";
        return text;
    }

