    private string ReplayChartPath(AnalysisLapTrace trace, string signal)
    {
        var currentLap = CurrentTrace?.Lap ?? trace.Lap;
        var cacheKey = (currentLap, trace.Lap, signal, ShowFastestReference);
        if (_replayChartPathCache.TryGetValue(cacheKey, out var cached)) return cached;
        if (trace.Points.Count == 0) return string.Empty;
        var values = trace.Points.Select(point => ChartSignal(point, signal)).ToArray();
        var recorded = values.Where(value => value.HasValue && double.IsFinite(value.Value)).Select(value => value!.Value).ToArray();
        if (recorded.Length == 0) return string.Empty;
        var (min, max) = ReplayChartRange(currentLap, signal);
        if (max - min < .001) { min -= .5; max += .5; }
        var commands = new List<string>();
        var segmentStarted = false;
        for (var index = 0; index < trace.Points.Count; index++)
        {
            if (!values[index].HasValue || !double.IsFinite(values[index]!.Value) || !double.IsFinite(trace.Points[index].LapPercent))
            {
                segmentStarted = false;
                continue;
            }
            var x = Math.Clamp(trace.Points[index].LapPercent, 0, 1) * 360;
            var y = 88 - Math.Clamp((values[index]!.Value - min) / (max - min), 0, 1) * 78;
            commands.Add($"{(segmentStarted ? "L" : "M")}{F(x)} {F(y)}");
            segmentStarted = true;
        }
        return _replayChartPathCache[cacheKey] = string.Join(" ", commands);
    }
    private (double Minimum, double Maximum) ReplayChartRange(int currentLap, string signal)
    {
        var key = (currentLap, signal, ShowFastestReference);
        if (_replayChartRangeCache.TryGetValue(key, out var cached)) return cached;
        if (signal is "throttle" or "brake") return _replayChartRangeCache[key] = (0, 1);
        var traces = new[] { CurrentTrace, ShowFastestReference ? FastestTrace : null }.Where(trace => trace is not null).Distinct().Cast<AnalysisLapTrace>();
        var values = traces.SelectMany(trace => trace.Points).Select(point => ChartSignal(point, signal))
            .Where(value => value.HasValue && double.IsFinite(value.Value)).Select(value => value!.Value).ToArray();
        if (values.Length == 0) return _replayChartRangeCache[key] = (-.5, .5);
        if (signal == "steering")
        {
            var magnitude = Math.Max(.1, values.Max(Math.Abs));
            return _replayChartRangeCache[key] = (-magnitude, magnitude);
        }
        var minimum = values.Min();
        var maximum = values.Max();
        if (maximum - minimum < .001) { minimum -= .5; maximum += .5; }
        return _replayChartRangeCache[key] = (minimum, maximum);
    }
    private string ChartValue(string signal)
    {
        var value = CurrentPoint is null ? null : ChartSignal(CurrentPoint, signal);
        return signal switch
        {
            "speed" => value.HasValue ? $"{value:0} mph" : "—",
            "throttle" or "brake" => value.HasValue ? $"{value * 100:0}%" : "—",
            "steering" => value.HasValue ? $"{Math.Abs(value.Value * 180 / Math.PI):0.0}° {(value < 0 ? "left" : "right")}" : "—",
            _ => "—"
        };
    }
    private static double? ChartSignal(AnalysisTracePoint point, string signal) => signal switch { "speed" => point.SpeedMph, "throttle" => point.Throttle, "brake" => point.Brake, "steering" => point.SteeringRadians, _ => null };
    private static double? Additional(AnalysisTracePoint point, string id) => point.AdditionalSignals is not null && point.AdditionalSignals.TryGetValue(id, out var value) ? value : null;
    private static bool IsAbsActive(AnalysisTracePoint point) => Additional(point, "abs-active").GetValueOrDefault() > .5;
    private static AnalysisTracePoint? NearestTracePoint(IReadOnlyList<AnalysisTracePoint> points, double percent)
    {
        if (points.Count == 0) return null;
        var low = 0;
        var high = points.Count - 1;
        while (low <= high)
        {
            var middle = low + (high - low) / 2;
            var value = points[middle].LapPercent;
            if (value < percent) low = middle + 1;
            else if (value > percent) high = middle - 1;
            else return points[middle];
        }
        if (low <= 0) return points[0];
        if (low >= points.Count) return points[^1];
        return Math.Abs(points[low].LapPercent - percent) < Math.Abs(points[low - 1].LapPercent - percent)
            ? points[low]
            : points[low - 1];
    }
    private IReadOnlyList<string> AbsTracePaths(AnalysisLapTrace trace)
    {
        if (_absTracePathCache.TryGetValue(trace.Lap, out var cached)) return cached;
        var paths = new List<string>();
        var commands = new List<string>();
        foreach (var point in trace.Points)
        {
            var active = IsAbsActive(point);
            if (active)
            {
                var x = Math.Clamp(point.LapPercent, 0, 1) * 360;
                var y = 88 - Math.Clamp(point.Brake ?? 0, 0, 1) * 78;
                commands.Add($"{(commands.Count == 0 ? "M" : "L")}{F(x)} {F(y)}");
            }
            else if (commands.Count > 0)
            {
                paths.Add(string.Join(" ", commands));
                commands.Clear();
            }
        }
        if (commands.Count > 0) paths.Add(string.Join(" ", commands));
        return _absTracePathCache[trace.Lap] = paths.ToArray();
    }

    private AnalysisReplayParticipant? Participant(int carIndex) => Participants.TryGetValue(carIndex, out var participant) ? participant : null;
    private static int? RecordedLapCount(AnalysisReplayCarState car) => car.CompletedLaps is >= 0
        ? car.CompletedLaps
        : car.Lap is >= 0 ? car.Lap : null;
    private static double? CarDistance(AnalysisReplayCarState car) => RecordedLapCount(car) is { } laps && double.IsFinite(car.LapPercent)
        ? laps + Wrap(car.LapPercent)
        : null;
    private static int? DisplayLap(AnalysisReplayCarState car) => car.Lap is > 0
        ? car.Lap
        : car.CompletedLaps is >= 0 ? car.CompletedLaps + 1 : null;
    private static string LapLabel(AnalysisReplayCarState car) => DisplayLap(car) is { } lap ? $"L{lap}" : "—";
    private static string LapNumberText(AnalysisReplayCarState car) => DisplayLap(car)?.ToString(CultureInfo.InvariantCulture) ?? "—";
    private static string CarNumber(AnalysisReplayParticipant? participant, int carIndex) => !string.IsNullOrWhiteSpace(participant?.CarNumber) ? participant.CarNumber! : carIndex.ToString(CultureInfo.InvariantCulture);
    private static string ClassColor(AnalysisReplayParticipant? participant)
    {
        var key = participant?.ClassId ?? StableClassHash(participant?.ClassName ?? "unknown");
        return ClassColors[Math.Abs(key == int.MinValue ? 0 : key) % ClassColors.Length];
    }
    private static int StableClassHash(string value)
    {
        unchecked
        {
            uint hash = 2166136261;
            foreach (var character in value)
            {
                hash ^= char.ToUpperInvariant(character);
                hash *= 16777619;
            }
            return (int)hash;
        }
    }
    private static string CarState(AnalysisReplayCarState car) => car.OnPitRoad == true ? "Pit road" : !string.IsNullOrWhiteSpace(car.TrackSurfaceLabel) ? car.TrackSurfaceLabel! : "On track";
    private static string Position(int? value) => value.HasValue && value.Value > 0 ? value.Value.ToString(CultureInfo.InvariantCulture) : "—";
    private static string ReplayLapTime(double? seconds) => seconds is > 0 ? TimeSpan.FromSeconds(seconds.Value).ToString(@"m\:ss\.fff") : "—";
    private static bool IsChecker(string label) => label.Contains("check", StringComparison.OrdinalIgnoreCase);
    private static bool IsSignificantState(string state) => state.Contains("race", StringComparison.OrdinalIgnoreCase) || state.Contains("green", StringComparison.OrdinalIgnoreCase) || state.Contains("check", StringComparison.OrdinalIgnoreCase) || state.Contains("cool", StringComparison.OrdinalIgnoreCase);
    private static string FlagKind(string label) => label.Contains("yellow", StringComparison.OrdinalIgnoreCase) || label.Contains("caution", StringComparison.OrdinalIgnoreCase) ? "caution" : IsChecker(label) ? "checker" : label.Contains("pit", StringComparison.OrdinalIgnoreCase) ? "pit" : "flag";
    private static string FrameFlagKind(AnalysisReplayFrame frame) => frame.GlobalFlagLabels.Any(label => label.Contains("yellow", StringComparison.OrdinalIgnoreCase) || label.Contains("caution", StringComparison.OrdinalIgnoreCase)) ? "caution" : frame.GlobalFlagLabels.Any(IsChecker) || frame.SessionState.Contains("check", StringComparison.OrdinalIgnoreCase) ? "checker" : frame.GlobalFlagLabels.Any(label => label.Contains("white", StringComparison.OrdinalIgnoreCase)) ? "white" : frame.GlobalFlagLabels.Any(label => label.Contains("green", StringComparison.OrdinalIgnoreCase)) || frame.SessionState.Contains("race", StringComparison.OrdinalIgnoreCase) ? "green" : "neutral";
    private static string FriendlyFlag(string label) => label.Replace('_', ' ').Trim();
    private static string FriendlySessionState(string state) => string.IsNullOrWhiteSpace(state) ? "Session state not recorded" : state.Replace('_', ' ').Trim();
    private static string SvgPath(IReadOnlyList<MapPoint> points, bool close)
    {
        if (points.Count == 0) return string.Empty;
        var value = $"M {F(points[0].X)} {F(points[0].Y)}";
        for (var index = 1; index < points.Count; index++) value += $" L {F(points[index].X)} {F(points[index].Y)}";
        return close ? value + " Z" : value;
    }
    private static string Clock(double seconds) => TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss");
    private static double Wrap(double value) { var wrapped = value % 1; return wrapped < 0 ? wrapped + 1 : wrapped; }
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Aria(bool value) => value ? "true" : "false";

    public ValueTask DisposeAsync()
    {
        Playing = false;
        _playbackCancellation.Cancel();
        _playbackCancellation.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed record ReplayChart(string Id, string Label, string Unit);
    private sealed record ReplayCarDisplay(int CarIndex, string Number, string Driver, string ClassName, string Color, AnalysisReplayCarState State, bool IsPlayer, bool IsLeader);
    private sealed record ReplayCarMarker(int CarIndex, string Number, string Color, MapPoint Point, bool IsPlayer, bool IsClassLeader, bool IsOverallLeader);
    private sealed record ReplayComparison(string LeaderNumber, int LeaderLap, int? PlayerPosition, int PlayerLap, string Distance);
    private sealed record ComparisonRow(string Label, string Leader, string Player);
    private sealed record TimelineItem(double SessionTimeSeconds, string Kind, string Label);
    private sealed record FlagSegment(double Left, double Width, string Kind);
    private sealed record PitEvent(int FrameIndex, int CompletedLap);
    private sealed record PitRoadObservation(int FrameIndex, bool OnPitRoad);
    private sealed record MapPoint(double Percent, double X, double Y);
    private sealed record MapLine(double X1, double Y1, double X2, double Y2);
    private sealed record VectorProjection(double CenterX, double CenterY, double Scale);
}
