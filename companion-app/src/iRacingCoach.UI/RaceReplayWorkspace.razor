            return CurrentFrame.Cars.Where(car => ParticipantHasReplayData(car.CarIndex) && double.IsFinite(car.LapPercent)).Select(car =>
            {
                var participant = Participant(car.CarIndex);
                var distance = Wrap(car.LapPercent);
                if (next.TryGetValue(car.CarIndex, out var upcoming) && double.IsFinite(upcoming.LapPercent) && CanInterpolateFrameTransition(CurrentFrame, NextFrame, car.CarIndex))
                {
                    var nextDistance = Wrap(upcoming.LapPercent);
                    if (nextDistance < distance - .65) nextDistance += 1;
                    if (nextDistance >= distance && nextDistance - distance < .35) distance += (nextDistance - distance) * CurrentFrameBlend;
                }
                return new ReplayCarMarker(
                    car.CarIndex,
                    CarNumber(participant, car.CarIndex),
                    ClassColor(participant),
                    PointAt(Wrap(distance)),
                    car.CarIndex == PlayerCarIndex,
                    car.ClassPosition == 1,
                    car.OverallPosition == 1);
            }).ToArray();
