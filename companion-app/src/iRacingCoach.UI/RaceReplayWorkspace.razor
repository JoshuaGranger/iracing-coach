    private int? LapsSincePit(int carIndex)
    {
        var current = CurrentFrame.Cars.FirstOrDefault(car => car.CarIndex == carIndex);
        if (current is null || RecordedLapCount(current) is not { } currentLapCount || !_pitEventsByCar.TryGetValue(carIndex, out var events) || events.Count == 0) return null;
        var low = 0;
        var high = events.Count - 1;
        var found = -1;
        while (low <= high)
        {
            var middle = low + (high - low) / 2;
            if (events[middle].FrameIndex <= CurrentFrameIndex) { found = middle; low = middle + 1; }
            else high = middle - 1;
        }
        if (found < 0) return null;
        return Math.Max(0, currentLapCount - events[found].CompletedLap);
    }

