<div class="first-run-shell">
    <div class="first-run-intro"><h1>Set up iRacing Coach</h1></div>

    <ol class="setup-progress" aria-label="Setup progress">
        @foreach (var step in Steps) { <li class="@(State.SetupStep == step.Number ? "active" : State.SetupStep > step.Number ? "complete" : "")"><span>@if (State.SetupStep > step.Number) { <ProductIcon Name="check" Size="15" /> } else { @step.Number }</span><strong>@step.Label</strong></li> }
    </ol>

    <section class="surface-card first-run-card">
        @switch (State.SetupStep)
        {
            case 1:
                <span class="eyebrow">Step 1 of 5</span><h2>@(State.IRacingDetected ? "iRacing is ready" : "Detect iRacing")</h2><p>@(State.IRacingDetected ? "These folders provide telemetry, saved setups, and the Coach app data." : "We’ll find your iRacing Documents folder, installation, telemetry, saved setups, and Coach folder.")</p>
                @if (State.Archive is not null && State.Archive.Restored.TotalItems > 0)
                {
                    <div class="ready-callout"><span><ProductIcon Name="check" Size="19" /></span><div><strong>Existing Coach folder restored</strong><small>@State.Archive.Restored.TotalItems saved items found. Your race history is ready.</small></div></div>
                }
                <div class="detection-row"><span class="status-orb @(State.IRacingDetected ? "ready" : "neutral")"></span><div><strong>@(State.IRacingDetected ? "iRacing Documents found" : "Ready to look")</strong><small>@(State.IRacingDetected ? "Telemetry and setup folders are available" : "Detection is read only")</small></div></div>
                <button class="button primary" @onclick="State.DetectIRacing">@(State.IRacingDetected ? "Continue" : "Detect iRacing")</button>
                @if (!State.IRacingDetected)
                {
                    <button class="button secondary" @onclick='() => State.Navigate("settings")'>Choose folders</button>
                    <p class="fine-print">Set the iRacing Documents folder in Settings, save, then continue setup.</p>
                }
                break;
            case 2:
                <span class="eyebrow">Step 2 of 5</span><h2>Connect ChatGPT</h2><p>Ask follow-up questions about an analyzed race. You can connect later in Settings.</p>
                <div class="connection-summary"><span class="status-orb @(State.CoachEngine.ChatGptConnected ? "ready" : State.CoachEngine.Running ? "neutral" : "warning")"></span><strong>@(State.CoachEngine.ChatGptConnected ? "Connected" : "Not connected")</strong><small>@CoachEngineMessage</small></div>
                @if (State.CoachEngine.ChatGptConnected)
                {
                    <button class="button primary" @onclick="State.ContinueSetupWithoutConnection">Continue</button>
                }
                else if (!State.CoachEngine.Installed || State.CoachEngine.Status is "repair" or "unavailable")
                {
                    <div class="button-row"><button class="button primary" @onclick="State.RepairInstallation">Repair installation</button><button class="button ghost" @onclick="State.ContinueSetupWithoutConnection">Do this later</button></div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(State.CoachEngine.VerificationCode)) { <div class="verification-code"><span>Verification code</span><strong>@State.CoachEngine.VerificationCode</strong></div> }
                    <div class="button-row"><button class="button primary" @onclick="() => State.ConnectChatGptAsync()">Connect ChatGPT</button><button class="button secondary" @onclick="() => State.ConnectChatGptAsync(true)">Use verification code</button><button class="button ghost" @onclick="State.ContinueSetupWithoutConnection">Do this later</button></div>
                }
                break;
            case 3:
                <span class="eyebrow">Step 3 of 5</span><h2>Connect Garage61</h2><p>Add reference laps from your Garage61 account. You can connect later in Settings.</p>
                @if (State.Garage61.Configured)
                {
                    <div class="connection-summary"><span class="status-orb @(State.Garage61.Available ? "ready" : "neutral")"></span><strong>@State.Garage61StatusLabel</strong><small>@State.Garage61.Message</small></div>
                    <button class="button primary" @onclick="State.ContinueSetupWithoutConnection">Continue</button>
                }
                else
                {
                    <label class="connection-secret"><span>Garage61 personal access token</span><input type="password" autocomplete="off" spellcheck="false" placeholder="Paste token" @bind="State.Garage61KeyInput" @bind:event="oninput" /></label>
                    <div class="button-row"><button class="button primary" disabled="@(string.IsNullOrWhiteSpace(State.Garage61KeyInput))" @onclick="() => State.ConnectGarage61Async()">Connect Garage61</button><button class="button ghost" @onclick="State.ContinueSetupWithoutConnection">Do this later</button></div>
                }
                break;
            case 4:
                <span class="eyebrow">Step 4 of 5</span><h2>Verify installation</h2><p>Check Race Analysis, Coach Engine, the Coach folder, and detected iRacing folders.</p>
                <div class="verification-list"><div><span class="status-orb @(State.IRacingDetected ? "ready" : "warning")"></span><strong>iRacing data</strong><small>@(State.IRacingDetected ? "Found" : "Needs attention")</small></div><div><span class="status-orb @(State.CoachEngine.Installed ? "ready" : "warning")"></span><strong>Coach Engine</strong><small>@(State.CoachEngine.Installed ? "Installed" : "Repair required")</small></div><div><span class="status-orb ready"></span><strong>Coach folder</strong><small>Ready</small></div></div>
                <button class="button primary" @onclick="() => State.VerifyInstallationAsync()">Verify installation</button>
                break;
            default:
                <span class="eyebrow">Step 5 of 5</span><h2>Setup complete</h2>
                <p>New recordings will appear on Home. Start an iRacing session to use live telemetry.</p>
                <button class="button primary" @onclick="State.CompleteFirstRun">Open iRacing Coach</button>
                break;
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private static readonly (int Number, string Label)[] Steps = [(1, "iRacing"), (2, "ChatGPT"), (3, "Garage61"), (4, "Verify"), (5, "Ready")];
    private string CoachEngineMessage => !State.CoachEngine.Installed
        ? "Repair the installation to connect ChatGPT."
        : State.CoachEngine.Running ? State.CoachEngine.Message : "Coach Engine is starting.";
}
