<div class="analysis-workspace-page">
    <header class="analysis-context-bar">
        <button class="back-button" @onclick="State.CloseAnalysisWorkspace" aria-label="Back to race history">← Races</button>
        <div class="analysis-event-title">
            <span class="eyebrow">Recorded race</span>
            <h1>@Workspace.Track <span>@Workspace.Layout</span></h1>
            <p>@Workspace.Car · @Workspace.SetupType · @Workspace.RecordedLaps laps · @Workspace.Runs.Count runs · @Workspace.PitStops pit stops</p>
        </div>
        <div class="analysis-context-actions">
            @if (EventSessions.Count > 1)
            {
                <div class="event-session-switch" role="group" aria-label="Event session">
                    @foreach (var session in EventSessions)
                    {
                        <button class="segmented @(session.Id == State.SelectedRaceSessionId ? "selected" : null)" aria-pressed="@(session.Id == State.SelectedRaceSessionId)" @onclick="() => ShowEventSession(session)">@SessionName(session)</button>
                    }
                </div>
            }
            @if (Workspace.Grades.Count > 0) { <span class="analysis-grade-chip"><small>Race grade</small><strong>@Workspace.OverallGrade</strong></span> }
        </div>
    </header>

    @if (Workspace.Grades.Count > 0)
    {
        <details class="grade-drawer">
            <summary><span>Grades</span>@foreach (var grade in Workspace.Grades) { <span class="grade-summary-item @(grade.Available ? null : "unavailable")"><b>@grade.Label</b><strong>@grade.Grade</strong></span> }</summary>
            <div class="grade-categories">
                @foreach (var grade in Workspace.Grades)
                {
                    <article class="@(grade.Available ? null : "grade-unavailable")" title="@grade.Limitation"><div><span>@grade.Label</span><strong>@grade.Grade</strong></div><p>@grade.Explanation</p><small><b>Next:</b> @grade.Improvement</small>
                        <details class="grade-audit"><summary>How this was graded</summary><dl><div><dt>Score</dt><dd>@(grade.Score.HasValue ? grade.Score.Value.ToString("0.0") : "Excluded — insufficient evidence")</dd></div><div><dt>Evidence</dt><dd>@grade.Evidence</dd></div><div><dt>Calibration</dt><dd>@grade.Calibration</dd></div><div><dt>Provenance</dt><dd>@grade.Provenance</dd></div></dl><p><b>Inputs:</b> @string.Join("; ", grade.Inputs ?? [])</p><p><b>Limitation:</b> @grade.Limitation</p></details>
                    </article>
                }
            </div>
        </details>
    }

    @if (IsRaceWorkspace)
    {
        <div class="event-session-switch analysis-data-switch" role="tablist" aria-label="Race analysis section">
            <button class="segmented @(RaceDataSection == "telemetry" ? "selected" : null)" role="tab" aria-selected="@(RaceDataSection == "telemetry")" @onclick='() => RaceDataSection = "telemetry"'>Telemetry</button>
            <button class="segmented @(RaceDataSection == "review" ? "selected" : null)" role="tab" aria-selected="@(RaceDataSection == "review")" @onclick='() => RaceDataSection = "review"'>Race review</button>
        </div>
    }

    <div class="@(IsRaceWorkspace ? "race-data-workspace" : "analysis-one-screen")">
        @if (!IsRaceWorkspace || RaceDataSection == "telemetry")
        {
            <main class="analysis-primary-column race-telemetry-page">
                @if (!IsRaceWorkspace)
                {
                    <section class="analysis-focus-strip" aria-label="What matters from this session">
                        <div class="analysis-bottom-line"><span>Fastest clean lap</span><strong>@FastestCleanLap</strong></div>
                        @foreach (var action in Card.Actions.Where(UsefulAction).Take(2))
                        {
                            <article title="@action.Claim.Text"><b>@action.Label</b><span>@action.Claim.Text</span></article>
                        }
                    </section>
                }

                <TelemetryWorkspace Workspace="Workspace" />
            </main>
        }

        @if (!IsRaceWorkspace || RaceDataSection == "review")
        {
            <section class="@(IsRaceWorkspace ? "race-review-page" : "qualifying-review-shell")">
                @if (IsRaceWorkspace)
                {
                    <section class="analysis-focus-strip" aria-label="What matters from this race">
                        <div class="analysis-bottom-line"><span>Fastest clean lap</span><strong>@FastestCleanLap</strong></div>
                        @foreach (var action in Card.Actions.Where(UsefulAction).Take(2))
                        {
                            <article title="@action.Claim.Text"><b>@action.Label</b><span>@action.Claim.Text</span></article>
                        }
                    </section>
                }

                <aside class="@(IsRaceWorkspace ? "analysis-review-grid" : "analysis-insight-rail")" aria-label="Race summary">
            <section class="analysis-insight-card race-shape-card">
                <div class="insight-heading"><div><span class="eyebrow">Race shape</span><h2>At a glance</h2></div></div>
                <div class="insight-stat-grid">
                    <div class="green"><span>Green laps</span><strong>@GreenLaps</strong></div>
                    <div class="yellow"><span>Caution laps</span><strong>@CautionLaps</strong></div>
                    <div class="pace"><span>Longest run</span><strong>@LongestRun</strong></div>
                    <div class="tire"><span>@TireHeading</span><strong>@TireReading</strong></div>
                </div>
                @if (LongestRunDetail is { } run)
                {
                    <div class="compact-run-trend"><span>Pace trend</span><strong class="@TrendClass(run.PaceSlopeSecondsPerLap)">@Trend(run.PaceSlopeSecondsPerLap)</strong><small>@RunChange(run)</small></div>
                }
            </section>

            @if (HasStrategy)
            {
                <section class="analysis-insight-card strategy-card">
                    <div class="insight-heading"><div><span class="eyebrow">Fuel &amp; stops</span><h2>Strategy</h2></div></div>
                    <dl class="compact-fact-list">
                        @if (Workspace.Strategy.GreenFuelGallonsPerLap.HasValue) { <div><dt>Green-lap fuel</dt><dd>@Workspace.Strategy.GreenFuelGallonsPerLap.Value.ToString("0.000") gal</dd></div> }
                        @if (Workspace.Strategy.AllGreenRangeLaps.HasValue) { <div><dt>All-green range</dt><dd>@Workspace.Strategy.AllGreenRangeLaps.Value.ToString("0.0") laps</dd></div> }
                        @if (Workspace.Strategy.MinimumStopsAllGreen.HasValue) { <div><dt>Minimum stops</dt><dd>@Workspace.Strategy.MinimumStopsAllGreen</dd></div> }
                        <div><dt>Recorded stops</dt><dd>@Workspace.PitStops</dd></div>
                    </dl>
                    @if (Workspace.Strategy.EqualStintPitTargets.Count > 0) { <div class="compact-pit-window"><span>Equal-stint window</span><strong>@string.Join(" · ", Workspace.Strategy.EqualStintPitTargets.Select(lap => $"Lap {lap}"))</strong></div> }
                </section>
            }

            @if (CornerAreas.Count > 0)
            {
                <section class="analysis-insight-card corner-card">
                    <div class="insight-heading"><div><span class="eyebrow">Track areas</span><h2>Corner comparison</h2></div><span class="insight-help" tabindex="0" title="These areas are detected from steering and lateral load. They are numbered when the recording does not provide official corner names.">?</span></div>
                    <div class="compact-corner-list">
                        @foreach (var corner in CornerAreas)
                        {
                            <article><strong>@corner.Label</strong><span><b>Early</b>@corner.Early</span><span><b>Late</b>@corner.Late</span></article>
                        }
                    </div>
                </section>
            }

            @if (HasPitActivity)
            {
                <section class="analysis-insight-card incident-card">
                    <div class="insight-heading"><div><span class="eyebrow">Race interruptions</span><h2>Pit &amp; repairs</h2></div></div>
                    <dl class="compact-fact-list">
                        <div><dt>Pit-road episodes</dt><dd>@Workspace.Damage.PitRoadEpisodes</dd></div>
                        @if (Workspace.Damage.TowEpisodes > 0) { <div><dt>Tows</dt><dd>@Workspace.Damage.TowEpisodes</dd></div> }
                        @if (Workspace.Damage.RepairEpisodes > 0) { <div><dt>Repairs</dt><dd>@Workspace.Damage.RepairEpisodes</dd></div> }
                        @if (Workspace.Damage.FastRepairUses > 0) { <div><dt>Fast repairs</dt><dd>@Workspace.Damage.FastRepairUses</dd></div> }
                    </dl>
                    @if (PitTimeline.Count > 0) { <small class="pit-lap-list">Pit laps @LapRange(PitTimeline.Select(lap => lap.Lap).ToArray())</small> }
                </section>
            }
                </aside>
            </section>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    [Parameter, EditorRequired] public RaceCard Card { get; set; } = null!;
    private string RaceDataSection { get; set; } = "telemetry";
    private string? _analysisId;
    private RecentRace? SelectedEventSession => EventSessions.FirstOrDefault(session => session.Id == State.SelectedRaceSessionId);
    private bool IsRaceWorkspace => SelectedEventSession is { } session
        ? !session.IsQualifying
        : string.Equals(Workspace.SessionType, "Race", StringComparison.OrdinalIgnoreCase);
    protected override void OnParametersSet()
    {
        if (_analysisId == Workspace.AnalysisId) return;
        _analysisId = Workspace.AnalysisId;
        RaceDataSection = "telemetry";
    }
    private IReadOnlyList<RecentRace> EventSessions => State.EventGroups.OfType<RaceEventGroup>().FirstOrDefault(group => group.Sessions?.OfType<RecentRace>().Any(session => session.Id == State.SelectedRaceSessionId) == true)?.Sessions?.OfType<RecentRace>().Where(session => session.IsRace || session.IsQualifying).GroupBy(session => session.IsQualifying ? "qualifying" : "race").Select(group => group.First()).OrderBy(session => session.IsQualifying ? 0 : 1).ToArray() ?? [];
    private Task ShowEventSession(RecentRace session) => session.Id == State.SelectedRaceSessionId ? Task.CompletedTask : State.AnalyzeRaceAsync(session);
    private static string SessionName(RecentRace session) => session.IsQualifying ? "Qualifying" : "Race";
    private static string LapRange(IReadOnlyList<int> laps) => laps.Count == 0 ? "—" : laps.Count == 1 ? laps[0].ToString() : $"{laps.Min()}–{laps.Max()}";
    private string FastestCleanLap
    {
        get
        {
            var traceTime = Workspace.Traces.Where(IsClean).MinBy(trace => trace.LapTimeSeconds ?? double.MaxValue)?.LapTimeSeconds;
            var lapTime = Workspace.Laps.Where(IsClean).MinBy(lap => lap.LapTimeSeconds ?? double.MaxValue)?.LapTimeSeconds;
            return LapTime(traceTime ?? lapTime);
        }
    }
    private int GreenLaps => Workspace.Runs.Sum(run => run.GreenLaps);
    private int CautionLaps => Workspace.Runs.Sum(run => run.CautionLaps);
    private AnalysisRun? LongestRunDetail => Workspace.Runs.OrderByDescending(run => run.GreenLaps).FirstOrDefault();
    private string LongestRun => LongestRunDetail is { } run ? $"{run.GreenLaps} green" : "—";
    private AnalysisRun? LowestTireRun => Workspace.Runs.Where(run => run.TireRemainingPercent.HasValue).OrderBy(run => run.TireRemainingPercent).FirstOrDefault();
    private string TireHeading => LowestTireRun is not null ? "Lowest tire" : "Tire reading";
    private string TireReading => LowestTireRun is { } run ? $"{run.TireName} {run.TireRemainingPercent:0.0}%" : "—";
    private bool HasStrategy => Workspace.Strategy.GreenFuelGallonsPerLap.HasValue || Workspace.Strategy.AllGreenRangeLaps.HasValue || Workspace.PitStops > 0;
    private bool HasPitActivity => Workspace.Damage.PitRoadEpisodes > 0 || Workspace.Damage.TowEpisodes > 0 || Workspace.Damage.RepairEpisodes > 0 || Workspace.Damage.FastRepairUses > 0;
    private IReadOnlyList<AnalysisLap> PitTimeline => Workspace.Laps.Where(lap => lap.Lap > 0 && lap.PitTimeSeconds is > 0).ToArray();
    private IReadOnlyList<CornerComparison> CornerAreas => BuildCornerAreas();
    private static bool IsClean(AnalysisLapTrace trace) => trace.Complete && trace.PitTimeSeconds.GetValueOrDefault() <= 0 && !trace.FlagState.Contains("yellow", StringComparison.OrdinalIgnoreCase) && !trace.FlagState.Contains("caution", StringComparison.OrdinalIgnoreCase);
    private static bool IsClean(AnalysisLap lap) => lap.Complete && !lap.Confounded && lap.PitTimeSeconds.GetValueOrDefault() <= 0 && !lap.FlagState.Contains("yellow", StringComparison.OrdinalIgnoreCase) && !lap.FlagState.Contains("caution", StringComparison.OrdinalIgnoreCase);
    private static bool UsefulAction(RaceAction action) => CapabilityRegistry.IsSupported(action.Claim)
        && !string.IsNullOrWhiteSpace(action.Label)
        && !string.IsNullOrWhiteSpace(action.Claim.Text)
        && !action.Claim.Text.Contains("match this wear pattern", StringComparison.OrdinalIgnoreCase)
        && !action.Claim.Text.Contains("before assigning cause", StringComparison.OrdinalIgnoreCase)
        && !action.Claim.Text.Contains("repeatability check", StringComparison.OrdinalIgnoreCase);
    private static string Trend(double? value) => value is null ? "—" : value > .005 ? $"+{value:0.000} s/lap" : value < -.005 ? $"{value:0.000} s/lap" : "Stable";
    private static string TrendClass(double? value) => value switch { > .02 => "pace-falloff", < -.005 => "pace-improving", not null => "pace-stable", _ => string.Empty };
    private static string LapTime(double? value) => value.HasValue ? TimeSpan.FromSeconds(value.Value).ToString(@"m\:ss\.fff") : "—";
    private static string RunChange(AnalysisRun run)
    {
        var parts = new List<string>();
        if (run.EarlyToLateDeltaSeconds.HasValue) parts.Add($"{run.EarlyToLateDeltaSeconds.Value:+0.000;-0.000;0.000} s early to late");
        if (run.TireRemainingPercent.HasValue) parts.Add($"{run.TireName} {run.TireRemainingPercent.Value:0.0}% left");
        return string.Join(" · ", parts);
    }
    private IReadOnlyList<CornerComparison> BuildCornerAreas()
    {
        if (Workspace.Segments.Count == 0 || Workspace.Traces.Count == 0) return [];
        var ordered = Workspace.Traces.Where(trace => trace.Points.Count > 0).OrderBy(trace => trace.Lap).ToArray();
        if (ordered.Length == 0) return [];
        var phaseSize = Math.Max(1, (int)Math.Ceiling(ordered.Length / 3d));
        return Workspace.Segments.Take(4).Select(zone => new CornerComparison(
            FriendlyZone(zone), ZoneSummary(ordered.Take(phaseSize), zone), ZoneSummary(ordered.Skip(Math.Max(0, ordered.Length - phaseSize)), zone))).ToArray();
    }
    private static string FriendlyZone(TrackSegment zone) => string.IsNullOrWhiteSpace(zone.Label) || zone.Label.StartsWith("Load zone", StringComparison.OrdinalIgnoreCase) ? $"Corner area {zone.Number}" : zone.Label;
    private static string ZoneSummary(IEnumerable<AnalysisLapTrace> traces, TrackSegment zone)
    {
        var points = traces.SelectMany(trace => trace.Points).Where(point => zone.WrapsStartFinish ? point.LapPercent >= zone.StartPercent || point.LapPercent <= zone.EndPercent : point.LapPercent >= zone.StartPercent && point.LapPercent <= zone.EndPercent).ToArray();
        if (points.Length == 0) return "No samples";
        var speed = points.Where(point => point.SpeedMph.HasValue).Select(point => point.SpeedMph!.Value).DefaultIfEmpty().Average();
        var brake = points.Where(point => point.Brake.HasValue).Select(point => point.Brake!.Value).DefaultIfEmpty().Average() * 100;
        return $"{speed:0} mph · {brake:0}% brake";
    }
    private sealed record CornerComparison(string Label, string Early, string Late);
}
