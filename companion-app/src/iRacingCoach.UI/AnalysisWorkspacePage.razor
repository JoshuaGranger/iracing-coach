<div class="analysis-workspace-page">
    @if (IsRaceWorkspace)
    {
        <header class="analysis-context-bar race-analysis-toolbar ri-toolbar">
            <button class="back-button race-analysis-back" @onclick="State.CloseAnalysisWorkspace" aria-label="Back to sessions" title="Back to sessions"><span aria-hidden="true">←</span><span>Sessions</span></button>
            <div class="ri-title"><h1>@Workspace.Track <span>@Workspace.Layout</span></h1><p>@ContextSummary</p></div>
            <nav class="ri-tabs" role="tablist" aria-label="Race analysis view">
                @foreach (var (id, label) in TestDay is null ? PrimaryViews : TestDayViews)
                {
                    <button class="ri-tab @(RaceDataSection == id ? "selected" : null)" role="tab" aria-selected="@(RaceDataSection == id ? "true" : "false")" data-view="@id" @onclick="() => ShowView(id)">@label</button>
                }
                <span class="ri-tab-divider" aria-hidden="true"></span>
                @foreach (var (id, label) in SecondaryViews)
                {
                    <button class="ri-tab secondary @(RaceDataSection == id ? "selected" : null)" role="tab" aria-selected="@(RaceDataSection == id ? "true" : "false")" data-view="@id" @onclick="() => ShowView(id)">@label</button>
                }
            </nav>
            <div class="analysis-context-actions race-session-actions">
                <button type="button" class="ri-tab secondary" aria-expanded="@(_coachOpen ? "true" : "false")" @onclick="() => _coachOpen = !_coachOpen">Ask</button>
                @if (EventSessions.Count > 1)
                {
                    <div class="event-session-switch" role="group" aria-label="Event session">
                        @foreach (var session in EventSessions)
                        {
                            <button class="segmented @(session.Id == State.SelectedRaceSessionId ? "selected" : null)" aria-pressed="@(session.Id == State.SelectedRaceSessionId ? "true" : "false")" @onclick="() => ShowEventSession(session)">@SessionName(session)</button>
                        }
                    </div>
                }
            </div>
        </header>
    }
    else
    {
        <header class="analysis-context-bar">
            <button class="back-button" @onclick="State.CloseAnalysisWorkspace" aria-label="Back to race history">← Races</button>
            <div class="analysis-event-title">
                <h1>@Workspace.Track <span>@Workspace.Layout</span></h1>
                <p>@ContextSummary</p>
            </div>
            <div class="analysis-context-actions">
                @if (EventSessions.Count > 1)
                {
                    <div class="event-session-switch" role="group" aria-label="Event session">
                        @foreach (var session in EventSessions)
                        {
                                    <button class="segmented @(session.Id == State.SelectedRaceSessionId ? "selected" : null)" aria-pressed="@(session.Id == State.SelectedRaceSessionId ? "true" : "false")" @onclick="() => ShowEventSession(session)">@SessionName(session)</button>
                        }
                    </div>
                }
                @if (Workspace.Grades.Count > 0) { <span class="analysis-grade-chip"><small>Session grade</small><strong>@Workspace.OverallGrade</strong></span> }
            </div>
        </header>
    }

    @if (_coachOpen)
    {
        <aside class="race-coach-drawer" aria-label="Race questions">
            <button type="button" class="technical-back" @onclick="() => _coachOpen = false">Close</button>
            <RaceCoachPanel State="State" Workspace="Workspace" />
        </aside>
    }

    @if (!IsRaceWorkspace && Workspace.Grades.Count > 0)
    {
        <details class="grade-drawer">
            <summary><span>Grades</span>@foreach (var grade in Workspace.Grades) { <span class="grade-summary-item @(grade.Available ? null : "unavailable")"><b>@grade.Label</b><strong>@grade.Grade</strong></span> }</summary>
            <div class="grade-categories">
                @foreach (var grade in Workspace.Grades)
                {
                    <article class="@(grade.Available ? null : "grade-unavailable")"
                             data-grade-score="@grade.Score"
                             data-grade-evidence="@grade.Evidence"
                             data-grade-calibration="@grade.Calibration"
                             data-grade-provenance="@grade.Provenance"
                             data-grade-inputs="@string.Join("; ", grade.Inputs ?? [])"
                             data-grade-limitation="@grade.Limitation">
                        <div><span>@grade.Label</span><strong>@grade.Grade</strong></div><p>@grade.Explanation</p><small><b>Next:</b> @grade.Improvement</small>
                    </article>
                }
            </div>
        </details>
    }

    <div class="@(IsRaceWorkspace ? "race-data-workspace" : "analysis-one-screen")">
        @if (IsRaceWorkspace && RaceDataSection is "race" or "runs" or "sections")
        {
            @if (RaceDataSection == "race" && TestDay is { } day)
            {
                var current = string.Equals(State.CurrentTestDayId, day.TestDayId, StringComparison.OrdinalIgnoreCase);
                <TestDayView Group="day" Review="State.TestDayReviewFor(day)" State="State" OpenSessionId="@State.SelectedRaceSessionId"
                             Loading="@(current && State.TestDayLoading)" Message="@(current ? State.TestDayMessage : "")"
                             OnLoad="() => State.LoadTestDayAsync(day)" OnOpenRun="OpenTestDayRun"
                             SelectedRunNumber="TestDaySelectedRun(day)" SelectedRunNumberChanged="run => SelectTestDayRun(day, run)" />
            }
            else if (Workspace.Investigation is { } investigation)
            {
                <RaceInvestigationView Investigation="investigation" Geometry="Workspace.VectorGeometry" State="State" AnalysisId="@Workspace.AnalysisId"
                                       View="@RaceDataSection" ComparisonId="@Selection.ComparisonId" SectionId="@Selection.SectionId"
                                       OfflineTesting="OfflineTestingSession" TestDayAvailable="@(TestDay is not null)"
                                       OnSelectionChanged="ChangeSelection" OnOpenTraces="InspectFinding" OnRefresh="RefreshAnalysis" />
            }
            else
            {
                <div class="ri-empty ri-panel"><strong>No investigation in this analysis</strong><span>Refresh the analysis to compare runs and sections.</span><button type="button" class="ri-button" @onclick="RefreshAnalysis">Refresh analysis</button></div>
            }
        }
        @if (!IsRaceWorkspace || RaceDataSection == "traces" || _telemetryVisited)
        {
            <main class="analysis-primary-column race-telemetry-page" style="@(IsRaceWorkspace && RaceDataSection != "traces" ? "display:none" : null)">
                @if (!IsRaceWorkspace)
                {
                    <section class="analysis-focus-strip" aria-label="What matters from this session">
                        <div class="analysis-bottom-line"><span>Fastest clean lap</span><strong>@FastestCleanLap</strong></div>
                        @foreach (var action in Card.Actions.Where(UsefulAction).Take(2))
                        {
                            <article title="@action.Claim.Text"><b>@action.Label</b><span>@action.Claim.Text</span></article>
                        }
                    </section>
                }

                <TelemetryWorkspace State="State" Workspace="Workspace" IsRaceWorkspace="IsRaceWorkspace" Inspection="_inspection" OnReturnToFindings="ReturnToFindings" Visible="@(!IsRaceWorkspace || RaceDataSection == "traces")" />
            </main>
        }

        @if (!IsRaceWorkspace || RaceDataSection == "details" || _technicalVisited)
        {
            <section class="@(IsRaceWorkspace ? "race-review-page" : "qualifying-review-shell")" style="@(IsRaceWorkspace && RaceDataSection != "details" ? "display:none" : null)">
                @if (IsRaceWorkspace)
                {
                    <RaceTechnicalData Workspace="Workspace" Card="Card" OnInspect="InspectFinding" Visible="@(!IsRaceWorkspace || RaceDataSection == "details")" />
                }
                else
                {
                <aside class="analysis-insight-rail" aria-label="Session summary">
            <section class="analysis-insight-card race-shape-card">
                <div class="insight-heading"><div><span class="eyebrow">Race shape</span><h2>At a glance</h2></div></div>
                <div class="insight-stat-grid">
                    <div class="green"><span>Green laps</span><strong>@GreenLaps</strong></div>
                    <div class="yellow"><span>Caution laps</span><strong>@CautionLaps</strong></div>
                    <div class="pace"><span>Longest run</span><strong>@LongestRun</strong></div>
                    <div class="tire"><span>@TireHeading</span><strong>@TireReading</strong></div>
                </div>
                @if (LongestComparableRunDetail is { } run)
                {
                    <div class="compact-run-trend"><span>Pace trend</span><strong class="@TrendClass(run.PaceSlopeSecondsPerLap)">@Trend(run.PaceSlopeSecondsPerLap)</strong><small>@RunChange(run)</small></div>
                }
            </section>

            @if (HasStrategy)
            {
                <section class="analysis-insight-card strategy-card">
                    <div class="insight-heading"><div><span class="eyebrow">Fuel &amp; stops</span><h2>Strategy</h2></div></div>
                    <dl class="compact-fact-list">
                        @if (Workspace.Strategy.GreenFuelGallonsPerLap.HasValue) { <div><dt>Green-lap fuel</dt><dd>@Workspace.Strategy.GreenFuelGallonsPerLap.Value.ToString("0.000") gal</dd></div> }
                        @if (Workspace.Strategy.AllGreenRangeLaps.HasValue) { <div><dt>All-green range</dt><dd>@Workspace.Strategy.AllGreenRangeLaps.Value.ToString("0.0") laps</dd></div> }
                        @if (Workspace.Strategy.MinimumStopsAllGreen.HasValue) { <div><dt>Minimum stops</dt><dd>@Workspace.Strategy.MinimumStopsAllGreen</dd></div> }
                        <div><dt>Recorded stops</dt><dd>@Workspace.PitStops</dd></div>
                    </dl>
                    @if (Workspace.Strategy.EqualStintPitTargets.Count > 0) { <div class="compact-pit-window"><span>Equal-stint window</span><strong>@string.Join(" · ", Workspace.Strategy.EqualStintPitTargets.Select(lap => $"Lap {lap}"))</strong></div> }
                </section>
            }

            @if (CornerAreas.Count > 0)
            {
                <section class="analysis-insight-card corner-card">
                    <div class="insight-heading"><div><span class="eyebrow">Track areas</span><h2>Corner comparison</h2></div><span class="insight-help" tabindex="0" title="These areas are detected from steering and lateral load. They are numbered when the recording does not provide official corner names.">?</span></div>
                    <div class="compact-corner-list">
                        @foreach (var corner in CornerAreas)
                        {
                            <article><strong>@corner.Label</strong><span><b>Early</b>@corner.Early</span><span><b>Late</b>@corner.Late</span></article>
                        }
                    </div>
                </section>
            }

            @if (HasPitActivity)
            {
                <section class="analysis-insight-card incident-card">
                    <div class="insight-heading"><div><span class="eyebrow">Race interruptions</span><h2>Pit &amp; repairs</h2></div></div>
                    <dl class="compact-fact-list">
                        <div><dt>Pit-road episodes</dt><dd>@Workspace.Damage.PitRoadEpisodes</dd></div>
                        @if (Workspace.Damage.TowEpisodes > 0) { <div><dt>Tows</dt><dd>@Workspace.Damage.TowEpisodes</dd></div> }
                        @if (Workspace.Damage.RepairEpisodes > 0) { <div><dt>Repairs</dt><dd>@Workspace.Damage.RepairEpisodes</dd></div> }
                        @if (Workspace.Damage.FastRepairUses > 0) { <div><dt>Fast repairs</dt><dd>@Workspace.Damage.FastRepairUses</dd></div> }
                    </dl>
                    @if (PitTimeline.Count > 0) { <small class="pit-lap-list">Pit laps @LapRange(PitTimeline.Select(lap => lap.Lap).ToArray())</small> }
                </section>
            }
                </aside>
                }
            </section>
        }

        @if (IsRaceWorkspace && RaceDataSection == "replay")
        {
            <RaceReplayWorkspace Workspace="Workspace" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    [Parameter, EditorRequired] public AnalysisWorkspace Workspace { get; set; } = null!;
    [Parameter, EditorRequired] public RaceCard Card { get; set; } = null!;
    private static readonly (string Id, string Label)[] PrimaryViews = [("race", "Race"), ("runs", "Runs"), ("sections", "Sections")];
    /// <summary>A stint of a test day keeps its own Runs and Sections; the first view compares the day's runs.</summary>
    private static readonly (string Id, string Label)[] TestDayViews = [("race", "Test day"), ("runs", "Runs"), ("sections", "Sections")];
    private static readonly (string Id, string Label)[] SecondaryViews = [("traces", "Traces"), ("replay", "Replay"), ("details", "Details")];
    private bool _telemetryVisited;
    private bool _technicalVisited;
    private bool _coachOpen;
    private RaceInvestigationInspection? _inspection;
    private InvestigationBookmark Selection => State.InvestigationSelection;
    /// <summary>The retained view; an investigation opens on Race unless the driver was elsewhere.</summary>
    private string RaceDataSection => Selection.View;
    private void ShowView(string view)
    {
        _telemetryVisited |= view == "traces";
        _technicalVisited |= view == "details";
        State.SetInvestigationSelection(view, Selection.ComparisonId, Selection.SectionId);
    }
    private void ChangeSelection((string View, string? ComparisonId, string? SectionId) selection)
    {
        _telemetryVisited |= selection.View == "traces";
        State.SetInvestigationSelection(selection.View, selection.ComparisonId, selection.SectionId);
    }
    private void InspectFinding(RaceInvestigationInspection inspection)
    {
        _inspection = inspection with { };
        ShowView("traces");
    }
    private void ReturnToFindings() => ShowView(Workspace.Investigation is null ? "details" : "sections");
    private Task RefreshAnalysis() => State.ReanalyzeRaceAsync();
    private string? _analysisId;
    private IReadOnlyList<RaceReviewCornerSummary> _cornerAreas = [];
    private RecentRace? SelectedEventSession => EventSessions.FirstOrDefault(session => session.Id == State.SelectedRaceSessionId);
    /// <summary>The open stint's test day (two or more stints), or null.</summary>
    private RaceEventGroup? TestDay => State.TestDayGroupFor(State.SelectedRaceSession);
    private bool IsRaceWorkspace => TestDay is not null || (SelectedEventSession is { } session
        ? !session.IsQualifying
        : string.Equals(Workspace.SessionType, "Race", StringComparison.OrdinalIgnoreCase));
    private string ContextSummary => TestDay is not null && State.SelectedRaceSession is { } stint
        ? string.Join(" · ", new[] { Workspace.Car, string.IsNullOrWhiteSpace(Workspace.SetupType) ? null : $"{Workspace.SetupType} setup", stint.Date, stint.SessionType, stint.TestDayRunNumber is { } run ? $"run {run} of {TestDay.Sessions.Count}" : null }.Where(value => !string.IsNullOrWhiteSpace(value)))
        : IsRaceWorkspace
        ? string.Join(" · ", new[] { Workspace.Car, string.IsNullOrWhiteSpace(Workspace.SetupType) ? null : $"{Workspace.SetupType} setup", SelectedEventSession?.Date, SelectedEventSession is { IsRace: false } practice ? practice.SessionType : null }.Where(value => !string.IsNullOrWhiteSpace(value)))
        : string.Join(" · ", new[] { Workspace.Car, Workspace.SetupType, $"{Workspace.RecordedLaps} laps" }.Where(value => !string.IsNullOrWhiteSpace(value)));
    protected override void OnParametersSet()
    {
        if (_analysisId == Workspace.AnalysisId) return;
        _analysisId = Workspace.AnalysisId;
        _inspection = null;
        _coachOpen = false;
        _technicalVisited = RaceDataSection == "details";
        _telemetryVisited = !IsRaceWorkspace || RaceDataSection == "traces";
        _cornerAreas = RaceReviewMetrics.BuildCornerSummaries(Workspace);
    }
    private IReadOnlyList<RecentRace> EventSessions => State.EventGroups.OfType<RaceEventGroup>().FirstOrDefault(group => group.Sessions?.OfType<RecentRace>().Any(session => session.Id == State.SelectedRaceSessionId) == true)?.Sessions?.OfType<RecentRace>().Where(session => session.IsRace || session.IsQualifying).GroupBy(session => session.IsQualifying ? "qualifying" : "race").Select(group => group.First()).OrderBy(session => session.IsQualifying ? 0 : 1).ToArray() ?? [];
    private Task ShowEventSession(RecentRace session) => session.Id == State.SelectedRaceSessionId ? Task.CompletedTask : State.AnalyzeRaceAsync(session);
    /// <summary>"Show run N's laps in Runs": open that run's recording, then show its laps.</summary>
    private async Task OpenTestDayRun(RecentRace session)
    {
        await State.OpenTestDayRunAsync(session);
        if (string.Equals(State.SelectedRaceSessionId, session.Id, StringComparison.Ordinal)) ShowView("runs");
    }
    // The selected Test day row lives in the state, so it survives opening another run's recording.
    private int? TestDaySelectedRun(RaceEventGroup day) => State.TestDaySelectedRun(day);
    private void SelectTestDayRun(RaceEventGroup day, int? run) => State.SelectTestDayRun(day, run);
    /// <summary>Offline Testing laps read as caution in the recording analysis, which leaves Runs and Sections empty.</summary>
    private bool OfflineTestingSession =>
        (State.SelectedRaceSession?.SessionType ?? Workspace.SessionType)?.Contains("Offline Testing", StringComparison.OrdinalIgnoreCase) == true;
    private static string SessionName(RecentRace session) => session.IsQualifying ? "Qualifying" : "Race";
    private static string LapRange(IReadOnlyList<int> laps) => laps.Count == 0 ? "—" : laps.Count == 1 ? laps[0].ToString() : $"{laps.Min()}–{laps.Max()}";
    private string FastestCleanLap
    {
        get
        {
            var traceTime = Workspace.Traces.Where(IsClean).MinBy(trace => trace.LapTimeSeconds ?? double.MaxValue)?.LapTimeSeconds;
            var lapTime = Workspace.Laps.Where(IsClean).MinBy(lap => lap.LapTimeSeconds ?? double.MaxValue)?.LapTimeSeconds;
            return LapTime(traceTime ?? lapTime);
        }
    }
    private int GreenLaps => Workspace.Runs.Sum(run => run.GreenLaps);
    private int CautionLaps => Workspace.Runs.Sum(run => run.CautionLaps);
    private AnalysisRun? LongestRunDetail => Workspace.Runs.OrderByDescending(run => run.GreenLaps).FirstOrDefault();
    private AnalysisRun? LongestComparableRunDetail => Workspace.Runs.Where(run => run.ComparisonEligible).OrderByDescending(run => run.GreenLaps).FirstOrDefault();
    private string LongestRun => LongestRunDetail is { } run ? $"{run.GreenLaps} green" : "—";
    private AnalysisRun? LowestTireRun => Workspace.Runs.Where(run => run.TireRemainingPercent.HasValue).OrderBy(run => run.TireRemainingPercent).FirstOrDefault();
    private string TireHeading => LowestTireRun is not null ? "Lowest tire" : "Tire reading";
    private string TireReading => LowestTireRun is { } run ? $"{run.TireName} {run.TireRemainingPercent:0.0}%" : "—";
    private bool HasStrategy => Workspace.Strategy.GreenFuelGallonsPerLap.HasValue || Workspace.Strategy.AllGreenRangeLaps.HasValue || Workspace.PitStops > 0;
    private bool HasPitActivity => Workspace.Damage.PitRoadEpisodes > 0 || Workspace.Damage.TowEpisodes > 0 || Workspace.Damage.RepairEpisodes > 0 || Workspace.Damage.FastRepairUses > 0;
    private IReadOnlyList<AnalysisLap> PitTimeline => Workspace.Laps.Where(lap => lap.Lap > 0 && lap.PitTimeSeconds is > 0).ToArray();
    private IReadOnlyList<RaceReviewCornerSummary> CornerAreas => _cornerAreas;
    private bool IsClean(AnalysisLapTrace trace) => trace.IsComparable() && !(Workspace.Damage.Incidents ?? []).Any(incident => incident.Lap == trace.Lap && incident.Points > 0);
    private bool IsClean(AnalysisLap lap) => lap.IsComparable() && !(Workspace.Damage.Incidents ?? []).Any(incident => incident.Lap == lap.Lap && incident.Points > 0);
    private static bool UsefulAction(RaceAction action) => CapabilityRegistry.IsSupported(action.Claim)
        && !string.IsNullOrWhiteSpace(action.Label)
        && !string.IsNullOrWhiteSpace(action.Claim.Text)
        && !action.Claim.Text.Contains("match this wear pattern", StringComparison.OrdinalIgnoreCase)
        && !action.Claim.Text.Contains("before assigning cause", StringComparison.OrdinalIgnoreCase)
        && !action.Claim.Text.Contains("repeatability check", StringComparison.OrdinalIgnoreCase);
    private static string Trend(double? value) => value is null ? "—" : value > .005 ? $"+{value:0.000} s/lap" : value < -.005 ? $"{value:0.000} s/lap" : "Stable";
    private static string TrendClass(double? value) => value switch { > .02 => "pace-falloff", < -.005 => "pace-improving", not null => "pace-stable", _ => string.Empty };
    private static string LapTime(double? value) => value.HasValue ? TimeSpan.FromSeconds(value.Value).ToString(@"m\:ss\.fff") : "—";
    private static string RunChange(AnalysisRun run)
    {
        var parts = new List<string>();
        if (run.EarlyToLateDeltaSeconds.HasValue) parts.Add($"{run.EarlyToLateDeltaSeconds.Value:+0.000;-0.000;0.000} s early to late");
        if (run.TireRemainingPercent.HasValue) parts.Add($"{run.TireName} {run.TireRemainingPercent.Value:0.0}% left");
        return string.Join(" · ", parts);
    }
}
