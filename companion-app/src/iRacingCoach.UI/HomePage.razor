<div class="page-heading home-heading">
    <div><span class="eyebrow">Race desk</span><h1>@State.Greeting</h1><p>Recordings and live race data appear automatically.</p></div>
</div>

<section class="home-live-strip @(State.LiveState.Snapshot.Connected ? "connected" : "waiting")" aria-label="Live telemetry connection">
    <div class="home-live-status"><span class="status-orb @(State.LiveState.Snapshot.Connected ? "ready" : "neutral")"></span><div><strong>@State.LiveState.Snapshot.ConnectionLabel</strong><small>@(State.LiveState.Snapshot.Connected ? $"{State.LiveState.Snapshot.Flag} · {State.LiveState.Snapshot.PrimaryCue.Message}" : "Start iRacing when you are ready. Live monitoring stays local.")</small></div></div>
    <div class="home-live-actions"><button class="button primary compact" title="Open the always-on-top telemetry window" @onclick='() => State.SetLiveMonitorVisible(true)'>Open live telemetry</button></div>
</section>

@if (State.HomeDataReady)
{
<section aria-labelledby="workflows-title">
    <div class="section-heading"><div><span class="eyebrow">Workflows</span><h2 id="workflows-title">Start here</h2></div></div>
    <div class="workflow-grid">
        <button class="workflow-card analysis" @onclick='() => State.Navigate("analysis")'><span class="workflow-icon"><ProductIcon Name="analysis" Size="20" /></span><span class="workflow-copy"><strong>Review a race</strong><small>Turn a recording into clear coaching points</small></span><span class="arrow"><ProductIcon Name="arrow-right" Size="16" /></span></button>
        @if (State.IsCapabilityVisible(ProductCapability.RacePlanning))
        {
            <button class="workflow-card planning" @onclick='() => State.Navigate("planning")'><span class="workflow-icon"><ProductIcon Name="planning" Size="20" /></span><span class="workflow-copy"><strong>Plan the next race</strong><small>Use comparable races from your history</small></span><span class="arrow"><ProductIcon Name="arrow-right" Size="16" /></span></button>
        }
        <button class="workflow-card setup" @onclick='() => State.Navigate("setup")'><span class="workflow-icon"><ProductIcon Name="setup" Size="20" /></span><span class="workflow-copy"><strong>Find a starting tune</strong><small>Build from a real setup on this PC</small></span><span class="arrow"><ProductIcon Name="arrow-right" Size="16" /></span></button>
        @if (State.IsCapabilityVisible(ProductCapability.ProgressiveTuning))
        {
            <button class="workflow-card tuning" @onclick='() => State.Navigate("tuning")'><span class="workflow-icon"><ProductIcon Name="tuning" Size="20" /></span><span class="workflow-copy"><strong>Improve a setup</strong><small>Use feedback from an analyzed open-setup race</small></span><span class="arrow"><ProductIcon Name="arrow-right" Size="16" /></span></button>
        }
    </div>
</section>
}

@if (!State.HomeDataReady)
{
    <section class="recent-empty" aria-labelledby="recent-title">
        <span class="empty-icon"><ProductIcon Name="race" Size="22" /></span>
        <div><span class="eyebrow">Recent races</span><h2 id="recent-title">Loading recent races</h2><p>Checking your recorded iRacing sessions.</p></div>
    </section>
}
else if (State.Races.Count == 0)
{
    <section class="recent-empty @(AnalysisUnavailable ? "needs-attention" : "")" aria-labelledby="recent-title">
        <span class="empty-icon"><ProductIcon Name="@(AnalysisUnavailable ? "info" : "race")" Size="22" /></span>
        <div><span class="eyebrow">Recent races</span><h2 id="recent-title">@(AnalysisUnavailable ? "Race data could not be opened" : "No recorded races yet")</h2><p>@(AnalysisUnavailable ? "Open troubleshooting for the cause and recovery steps." : "Finish a recorded Race session in iRacing and it will appear here.")</p></div>
        @if (AnalysisUnavailable) { <button class="button secondary compact" @onclick="OpenEmptyAction">Open troubleshooting</button> }
    </section>
}
else
{
<section class="surface-card recent-card" aria-labelledby="recent-title">
    <div class="card-header recent-card-header"><h2 id="recent-title">Recent races</h2></div>
    <div class="race-list">
        @foreach (var race in State.Races.Take(6))
        {
            var overview = race.Overview;
            <button class="race-row home-race-row" @onclick="() => OpenRace(race)" title="Open @race.Track race analysis">
                <span class="track-avatar" aria-hidden="true">@Initials(race.Track)</span>
                <span class="race-main"><span class="race-title"><strong>@race.Track</strong><span>@race.Layout</span></span><small>@race.Car · @race.Date</small></span>
                <span class="race-stat result-stat"><span>Result</span><strong>@(HasResult(race) ? Result(race) : "—")</strong><small>@race.SetupType setup</small></span>
                <span class="race-stat race-condition-stat"><span>Race laps</span><strong><i class="metric-dot green"></i>@Metric(overview?.GreenLaps) green</strong><small><i class="metric-dot yellow"></i>@Metric(overview?.CautionLaps) caution</small></span>
                <span class="race-stat"><span>Best clean lap</span><strong>@BestLap(overview)</strong><small>@Metric(overview?.LongestGreenRun) green max · @Plural(overview?.PitStops, "stop")</small></span>
                <span class="race-stat pace-stat"><span>Pace trend</span><strong class="@PaceClass(overview)">@PaceTrend(overview)</strong><small>@Consistency(overview)</small></span>
                <span class="race-stat fuel-stat" title="@ComparisonDetail(overview)"><span>Fuel used</span><strong>@FuelStrong(overview)</strong><small>@TireOrControlDetail(overview)</small></span>
                <span class="race-row-arrow" aria-hidden="true"><ProductIcon Name="arrow-right" Size="16" /></span>
            </button>
        }
    </div>
</section>
}

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private bool AnalysisUnavailable => State.Health.Any(item => item.Id == "backend" && item.State == "unavailable");
    private void OpenEmptyAction() => State.OpenTroubleshooting();
    private Task OpenRace(RecentRace race) => State.OpenRaceFromHomeAsync(race);
    private static bool HasResult(RecentRace race) => race.StartPosition > 0 || race.FinishPosition > 0;
    private static string Result(RecentRace race) => (race.StartPosition, race.FinishPosition) switch
    {
        (> 0, > 0) => $"P{race.StartPosition} → P{race.FinishPosition}",
        (_, > 0) => $"Finished P{race.FinishPosition}",
        (> 0, _) => $"Started P{race.StartPosition}",
        _ => string.Empty
    };
    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
    private static string Metric(int? value) => value is > 0 ? value.Value.ToString() : "—";
    private static string Plural(int? value, string noun) => value is > 0 ? $"{value} {noun}{(value == 1 ? string.Empty : "s")}" : $"— {noun}s";
    private static string BestLap(RaceOverview? overview)
    {
        if (overview?.BestCleanLapSeconds is not > 0) return "—";
        var time = TimeSpan.FromSeconds(overview.BestCleanLapSeconds.Value);
        return time.TotalMinutes >= 1
            ? $"{(int)time.TotalMinutes}:{time.Seconds:00}.{time.Milliseconds:000}"
            : $"{time.Seconds}.{time.Milliseconds:000}";
    }
    private static string FuelUsed(RaceOverview? overview) => overview?.FuelUsedGallons is > 0 ? $"{overview.FuelUsedGallons:0.00} gal fuel" : "Fuel unavailable";
    // The rightmost column shows one consistent metric on every row - fuel used,
    // which race_summary supplies for essentially every race - instead of
    // flipping between a pit-only tire reading and a control-load proxy. The
    // tire/control reading, which only some races carry, moves to the detail
    // line where its absence is not a gap in the column header.
    private static string FuelStrong(RaceOverview? overview) => overview?.FuelUsedGallons is > 0 ? $"{overview.FuelUsedGallons:0.00} gal" : "—";
    private static string TireOrControlDetail(RaceOverview? overview) => overview?.LowestTireRemainingPercent is { } remaining
        ? $"{overview.LowestTireName} {remaining:0.0}% tire"
        : overview?.ControlLoadChangePercent is { } load
            ? $"{load:0}% control change"
            : "Tire reading at stops only";
    private static string PaceTrend(RaceOverview? overview) => overview?.PaceSlopeSecondsPerLap switch
    {
        > .005 => $"+{overview.PaceSlopeSecondsPerLap:0.000} s/lap",
        < -.005 => $"{overview.PaceSlopeSecondsPerLap:0.000} s/lap",
        not null => "Stable",
        _ => "—"
    };
    private static string PaceClass(RaceOverview? overview) => overview?.PaceSlopeSecondsPerLap switch { > .02 => "pace-falloff", < -.005 => "pace-improving", not null => "pace-stable", _ => string.Empty };
    private static string Consistency(RaceOverview? overview) => overview?.PaceConsistencyPercent is { } value ? $"{value:0.0}% lap variation" : "Variation unavailable";
    private static string TireMetricLabel(RaceOverview? overview) => overview?.LowestTireRemainingPercent.HasValue == true ? "Tire left" : overview?.ControlLoadChangePercent.HasValue == true ? "Control load" : "Tire use";
    private static string TireMetric(RaceOverview? overview) => overview?.LowestTireRemainingPercent is { } remaining ? $"{overview.LowestTireName} {remaining:0.0}%" : overview?.ControlLoadChangePercent is { } load ? $"{load:0}% change" : "—";
    private static string TireDetail(RaceOverview? overview) => overview?.LowestTireRemainingPercent is { } remaining ? $"Lowest recorded tire reading: {overview.LowestTireName} {remaining:0.0}% remaining at a pit stop." : overview?.ControlLoadChangePercent is { } load ? $"Largest early-to-late change in recorded brake or steering work: {load:0.0}%." : "No supported tire-service reading was recorded for this race.";
    private static string ComparisonDetail(RaceOverview? overview) => $"{TireDetail(overview)} {(overview?.FuelUsedGallons is > 0 ? $"Recorded fuel used: {overview.FuelUsedGallons:0.00} gal." : "Recorded fuel use is unavailable.")}";
}
