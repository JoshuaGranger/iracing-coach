<div class="race-coach-answer" role="status">@_presentation.Text</div>
@if (_presentation.References.Count > 0)
{
    <details class="evidence-details race-coach-references">
        <summary>Evidence references</summary>
        <ul>
            @foreach (var reference in _presentation.References)
            {
                <li><span>@reference.EvidenceClass</span><code>@reference.Id</code></li>
            }
        </ul>
    </details>
}

@code {
    [Parameter, EditorRequired] public string Answer { get; set; } = string.Empty;
    private string? _previous;
    private RaceCoachAnswerPresentation _presentation = new(string.Empty, []);

    protected override void OnParametersSet()
    {
        if (string.Equals(_previous, Answer, StringComparison.Ordinal)) return;
        _previous = Answer;
        _presentation = RaceCoachResponseValidator.ForPresentation(Answer);
    }
}
