@{
    var snapshot = State.LiveState.Snapshot;
}

<div class="page-heading compact-heading live-heading">
    <div><span class="eyebrow">Live telemetry</span><h1>Race dashboard</h1></div>
</div>

@if (!snapshot.Connected)
{
    <div class="inline-alert neutral-alert live-waiting" role="status"><span class="status-orb neutral"></span><div><strong>Waiting for iRacing</strong><span>Start a session and telemetry appears here automatically.</span></div></div>
}

<LiveTelemetryLayoutGrid State="State" />

<section class="live-driving-disclosure @(_tracesExpanded ? "open" : null)">
    <button type="button" class="live-driving-toggle" aria-expanded="@(_tracesExpanded ? "true" : "false")" aria-controls="live-driving-traces" @onclick="ToggleTraces">
        <ProductIcon Name="analysis" Size="16" />
        <span>Driving traces</span>
        <ProductIcon Name="chevron-down" Size="15" />
    </button>
    <div id="live-driving-traces" class="live-driving-body" aria-hidden="@(_tracesExpanded ? "false" : "true")" inert="@(_tracesExpanded ? null : string.Empty)">
        <div>
            @if (_tracesMounted)
            {
                <LiveTelemetryVisuals State="State" />
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
    private bool _tracesExpanded;
    private bool _tracesMounted;
    private int _traceTransition;

    private async Task ToggleTraces()
    {
        var transition = ++_traceTransition;
        if (_tracesExpanded)
        {
            _tracesExpanded = false;
            await InvokeAsync(StateHasChanged);
            if (!State.Settings.UseReducedMotion) await Task.Delay(500);
            if (transition != _traceTransition || _tracesExpanded) return;
            _tracesMounted = false;
            return;
        }

        _tracesMounted = true;
        await InvokeAsync(StateHasChanged);
        if (!State.Settings.UseReducedMotion) await Task.Delay(20);
        if (transition != _traceTransition) return;
        _tracesExpanded = true;
    }
}
