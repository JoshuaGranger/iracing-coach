@{
    var snapshot = State.LiveState.Snapshot;
}

<div class="page-heading compact-heading live-heading">
    <div><span class="eyebrow">Live telemetry</span><h1>Race dashboard</h1></div>
</div>

@if (!snapshot.Connected)
{
    <div class="inline-alert neutral-alert live-waiting"><span class="status-orb neutral"></span><div><strong>Waiting for iRacing</strong><span>The dashboard connects automatically when a session starts.</span></div></div>
}

<LiveTelemetryLayoutGrid State="State" />

<details class="live-driving-disclosure">
    <summary><ProductIcon Name="analysis" Size="16" /> Driving traces</summary>
    <LiveTelemetryVisuals State="State" />
</details>

@code {
    [Parameter, EditorRequired] public CompanionState State { get; set; } = null!;
}
