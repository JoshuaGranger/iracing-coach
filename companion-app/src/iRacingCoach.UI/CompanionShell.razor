@implements IDisposable
@using Microsoft.JSInterop
@inject CompanionState State
@inject IJSRuntime JS

<div class="app-shell top-nav @ThemeColors.CssClass(State.Settings.ThemeColor) @(State.Settings.UseReducedMotion ? "reduced-motion" : "") @(State.CurrentPage == "first-run" ? "first-run-mode" : "")"
     style="@ThemeColors.CssVariables(State.Settings.ThemeColor, State.Settings.CustomThemeColor)">
    @if (State.CurrentPage != "first-run")
    {
        <AppTopBar State="State" />
    }
    <main class="workspace" id="main-content" tabindex="-1">
        <section class="page-frame @(State.CurrentPage == "analysis" ? "analysis-page-frame" : null)" aria-live="polite">
            <CoachErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @switch (State.CurrentPage)
                    {
                        case "live": <LiveTelemetryPage State="State" /> break;
                        case "analysis": <AnalysisPage State="State" /> break;
                        case "planning": <PlanningPage State="State" /> break;
                        case "setup": <SetupPage State="State" /> break;
                        case "tuning": <TuningPage State="State" /> break;
                        case "connections": <ConnectionsPage State="State" /> break;
                        case "settings": <SettingsPage State="State" /> break;
                        case "first-run": <FirstRunPage State="State" /> break;
                        default: <SessionsPage State="State" /> break;
                    }
                </ChildContent>
                <ErrorContent Context="error">
                    <section class="surface-card recoverable-error" role="alert">
                        <span class="eyebrow">This view needs attention</span>
                        <h1>The app kept running</h1>
                        <p>That race or page contained data this view could not use. Your recordings were not changed.</p>
                        <div class="button-row">
                            <button class="button primary" @onclick="RecoverView">Retry view</button>
                            <button class="button secondary" @onclick="() => CopySupportDetails(error)">Copy support details</button>
                            <button class="button secondary" @onclick='() => State.Navigate("home")'>Return to sessions</button>
                        </div>
                        @if (State.LastRecoverableError is { } contained)
                        {
                            <small>Reference @contained.Id · @contained.OccurredUtc.ToLocalTime().ToString("g")</small>
                        }
                    </section>
                </ErrorContent>
            </CoachErrorBoundary>
        </section>
    </main>
    @* Finished work stays out of the way; running, failed or cancelled work keeps its tray. *@
    @if (State.JobTrayOpen || State.Jobs.Any(job => job.Status != "complete"))
    {
        <JobTray State="State" />
    }
    @if (!string.IsNullOrWhiteSpace(State.Toast))
    {
        <div class="toast" role="status"><span>@State.Toast</span><button aria-label="Dismiss notification" @onclick="State.DismissToast"><ProductIcon Name="close" Size="16" /></button></div>
    }
    else if (State.UnreadableAnalysisNotice is { } unreadableAnalyses)
    {
        @* One quiet notice for every saved analysis the catalog could not read; dismissing it is remembered. *@
        <div class="toast" role="status" data-unreadable-analyses><span>@unreadableAnalyses</span><button type="button" class="toast-action" @onclick="State.OpenLogs">Open logs</button><button type="button" aria-label="Dismiss notice" @onclick="State.DismissUnreadableAnalysisNotice"><ProductIcon Name="close" Size="16" /></button></div>
    }
</div>

@code {
    private string? _renderedPage;
    private CoachErrorBoundary? _errorBoundary;
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialization can include cataloging a large local race library. Start it
        // on the first render, but do not hold the Blazor circuit hostage while the
        // deterministic services finish: Settings and other local navigation must
        // remain immediately usable.
        if (firstRender) _ = Task.Run(InitializeStateAsync);
        if (!string.Equals(_renderedPage, State.CurrentPage, StringComparison.Ordinal))
        {
            _renderedPage = State.CurrentPage;
            await JS.InvokeVoidAsync("iracingCoach.scrollWorkspaceTop");
        }
    }
    private async Task InitializeStateAsync()
    {
        try
        {
            await State.InitializeAsync();
        }
        catch (Exception error)
        {
            State.ReportUnhandledException("app startup", error);
        }
    }
    private void RecoverView() { _errorBoundary?.Recover(); State.ClearRecoverableError(); }
    private async Task CopySupportDetails(Exception error)
    {
        var details = State.LastRecoverableError?.SupportDetails ?? $"Area: user interface\nType: {error.GetType().Name}\nApp: iRacing Coach";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", details);
        State.Notify("Support details copied.");
    }
    private void OnStateChanged() => InvokeAsync(() =>
    {
        if (_errorBoundary is not null && !string.Equals(_renderedPage, State.CurrentPage, StringComparison.Ordinal)) _errorBoundary.Recover();
        StateHasChanged();
    });
    public void Dispose() => State.Changed -= OnStateChanged;
}
