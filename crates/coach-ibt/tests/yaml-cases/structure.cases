%%% comments_spacing_and_line_endings
# leading comment
WeekendInfo:
   # indented comment
   TrackName: spaced value
   TrackID: 12
   Odd Key With Spaces: v
   Colon: a:b:c
   Url: http://example.invalid/x
   Hash: "#5" # not a comment for this parser
   Empty quotes: ''
   Single quote char: '
   Unicode: café ∆ 漢字
   Nbsp:  x
DriverInfo:
 DriverCarIdx: 2
 Drivers:
 - CarIdx: 2
   UserName: crlf name
%%% quoted_keys
"Quoted Key": 1
'Single': 2
"esc\"aped": 3
'a' 'b': 4
'it''s': 5
"[x]": 6
'bad\x4': 7
