#!/bin/sh
# Worker interpreter for the iRacing Coach image (COACH_PYTHON; contracts/server-config.md).
#
# Port phases 1 and 2 (decode, kernels) passed the parity gate, so this image runs them:
# contracts/worker-interface.md sections 2 and 7. coach-server starts every worker with a
# cleared environment and sets IRACING_COACH_NATIVE_STAGES empty (server/src/worker.rs,
# worker_env); it has no setting for the stages yet (W4 follow-up in
# docs/08-rewrite/acceptance/g1-native.md). Until it has, the image turns them on here, for
# every worker the server starts, and nothing else changes: same interpreter, arguments,
# process (exec keeps the pid, nice and oom_score_adj), roots and protocol.
#
# The file name starts with "python": the server finds the interpreter in its worker command by
# that prefix and runs it with -V for /api/v1/status python_version (server/src/app.rs).
#
# Back to pure Python: release with COACH_PYTHON=/usr/local/bin/python3.12.
IRACING_COACH_NATIVE_STAGES=decode,kernels
IRACING_COACH_NATIVE_BIN=/usr/local/bin/coach-analysis
export IRACING_COACH_NATIVE_STAGES IRACING_COACH_NATIVE_BIN
exec /usr/local/bin/python3.12 "$@"
