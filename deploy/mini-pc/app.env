# Release settings for g-house-app (never a secret). Paths are relative to the repository
# (DOCKERFILE, CONTEXT) or to the stack's data directory (RECOVERY_*).
DOCKERFILE=deploy/mini-pc/Dockerfile
CONTEXT=.
HEALTH_SERVICES=app
# The recovery point copies user data only (contracts/server-config.md section 2); spool,
# py, views and run are re-derivable or transient. g-house-stack refuses a listed path that
# does not exist: the first real-server release (615377c) created both.
RECOVERY_PATHS=db snapshots
RECOVERY_SQLITE=db/coach.sqlite3
