# Release settings for g-house-app (never a secret). Paths are relative to the repository
# (DOCKERFILE, CONTEXT) or to the stack's data directory (RECOVERY_*).
DOCKERFILE=deploy/mini-pc/Dockerfile
CONTEXT=.
HEALTH_SERVICES=app
# g-house-stack refuses a recovery path or SQLite file that does not exist yet. Until a
# released server has created db/coach.sqlite3 and snapshots/, the whole (small) data
# directory is the recovery set. Then, in a later release: RECOVERY_PATHS=db snapshots
# and RECOVERY_SQLITE=db/coach.sqlite3 (contracts/server-config.md section 2). The released
# image is still the wave-0 skeleton, which creates neither.
RECOVERY_PATHS=.
RECOVERY_SQLITE=
