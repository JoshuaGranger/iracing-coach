{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iRacing Coach test-day review v1",
  "description": "Result of the read-only review_test_day tool: every run (the laps between pit visits) of 1-12 archived recordings of one test day, in time order. Every lap-time, window, fall-off, verdict, setup-change, tire and next-change value is computed by the backend; a consumer displays them and never re-derives a verdict. A measurement that is absent is null (Not measured), never zero. Two runs are compared over their common clean length N: laps 2-5, the last five laps up to N (withheld below eight laps) and the fall-off over laps 2..N, each against a threshold built from the runs' lap-to-lap noise. Verdicts are faster, slower, within_scatter or not_comparable; there is no 'unchanged'. A recording without a timed lap is listed once in untimed_recordings and is not a run. Garage-sheet tire readings carry timing 'unverified' and are never attributed to the stint's stop. Objects may gain optional fields; consumers must preserve unknown fields and fail on a missing required field or another contract/schema_version. Numeric domains are stated here rather than encoded because the repository's bounded validator supports no numeric keywords.",
  "type": "object",
  "required": [
    "ok", "schema_version", "contract", "read_only", "run_count", "test_day_id", "car", "track",
    "windows", "screening", "verdict_rule", "comparability_rule", "runs", "next_change", "limitations"
  ],
  "properties": {
    "ok": { "const": true },
    "schema_version": { "const": 1 },
    "contract": { "const": "test-day-review-v1" },
    "read_only": { "const": true },
    "run_count": { "type": "integer", "description": "2 or more timed runs; equals the length of runs. At most 24: a longer day keeps its latest runs and says so in limitations." },
    "recording_count": { "type": "integer", "description": "Recordings (analysis.json files) reviewed, 1-12." },
    "test_day_id": { "type": ["string", "null"], "description": "The discovery test_day_id when every stint's analysis records the same one." },
    "untimed_recordings": {
      "type": "array",
      "description": "Recordings of the day with no timed lap (garage-only), listed once and never compared. Absent from older backends.",
      "items": {
        "type": "object",
        "required": ["recording", "analysis_id", "analysis_path", "recorded_at", "session_type", "setup_name", "reason"],
        "properties": {
          "recording": { "type": "integer", "description": "The recording's number on the day, 1 = oldest." },
          "analysis_id": { "type": ["string", "null"] },
          "analysis_path": { "type": ["string", "null"] },
          "recorded_at": { "type": ["string", "null"] },
          "session_type": { "type": ["string", "null"] },
          "setup_name": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "car": {
      "type": "object",
      "required": ["car_path", "car_name", "car_id"],
      "properties": {
        "car_path": { "type": ["string", "null"] },
        "car_name": { "type": ["string", "null"] },
        "car_id": { "type": ["integer", "string", "null"] }
      },
      "additionalProperties": true
    },
    "track": {
      "type": "object",
      "required": ["track_name", "track_config", "configuration_key"],
      "properties": {
        "track_name": { "type": ["string", "null"] },
        "track_config": { "type": ["string", "null"] },
        "configuration_key": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "windows": {
      "type": "object",
      "required": ["early", "late", "fall_off", "minimum_clean_laps"],
      "properties": {
        "early": { "$ref": "#/$defs/span" },
        "late": {
          "type": "object",
          "description": "available when any run reached eight clean laps. Each run's own late window is its last five clean-length laps from lap 6 on; a comparison uses the last five laps both runs reached, so first_run_lap and last_run_lap are null here.",
          "required": ["status", "first_run_lap", "last_run_lap", "label", "reason", "basis"],
          "properties": {
            "status": { "enum": ["available", "withheld"] },
            "first_run_lap": { "type": ["integer", "null"] },
            "last_run_lap": { "type": ["integer", "null"] },
            "label": { "type": ["string", "null"] },
            "reason": { "type": ["string", "null"] },
            "basis": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "fall_off": { "$ref": "#/$defs/span" },
        "minimum_clean_laps": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "screening": {
      "type": "object",
      "required": ["rule", "offline_flag_rule_runs", "offline_flag_rule"],
      "properties": {
        "rule": { "type": "string" },
        "offline_flag_rule_runs": { "type": "array", "items": { "type": "integer" } },
        "offline_flag_rule": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "verdict_rule": { "type": "object", "additionalProperties": true },
    "comparability_rule": { "type": "object", "additionalProperties": true },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
    "next_change": { "$ref": "#/$defs/card" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true,
  "$defs": {
    "span": {
      "type": "object",
      "required": ["first_run_lap", "last_run_lap", "label"],
      "properties": {
        "first_run_lap": { "type": "integer" },
        "last_run_lap": { "type": "integer" },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "bands": {
      "type": ["object", "null"],
      "required": ["inside", "middle", "outside"],
      "properties": {
        "inside": { "type": "number" },
        "middle": { "type": "number" },
        "outside": { "type": "number" }
      },
      "additionalProperties": true
    },
    "window": {
      "type": "object",
      "required": ["status", "first_run_lap", "last_run_lap", "label", "clean_lap_count", "laps", "median_s", "reason"],
      "properties": {
        "status": { "enum": ["measured", "not_measured"] },
        "first_run_lap": { "type": ["integer", "null"] },
        "last_run_lap": { "type": ["integer", "null"] },
        "label": { "type": ["string", "null"] },
        "clean_lap_count": { "type": "integer" },
        "laps": { "type": "array", "items": { "type": "integer" }, "description": "Recording lap numbers of the clean laps used." },
        "median_s": { "type": ["number", "null"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "fallOff": {
      "type": "object",
      "required": ["status", "method", "first_run_lap", "last_run_lap", "fit_lap_count", "laps", "equal_age", "slope_s_per_lap", "scatter_s", "reason"],
      "properties": {
        "status": { "enum": ["measured", "not_measured"] },
        "method": { "const": "ordinary_least_squares_on_run_lap" },
        "first_run_lap": { "type": "integer" },
        "last_run_lap": { "type": ["integer", "null"] },
        "fit_lap_count": { "type": "integer" },
        "laps": { "type": "array", "items": { "type": "integer" } },
        "equal_age": { "type": "boolean", "description": "True when the fit covers the run's whole clean length, laps 2 to its last clean lap. Two runs' equal-age fall-off is comparison.fall_off." },
        "slope_s_per_lap": { "type": ["number", "null"] },
        "intercept_s": { "type": ["number", "null"], "description": "Fitted lap time at run lap 0; the chart draws this same line." },
        "scatter_s": { "type": ["number", "null"], "description": "Residual standard deviation of the fit; shown, never a verdict threshold." },
        "reason": { "type": ["string", "null"], "description": "Why it is not measured; a run under eight clean laps is too short for fall-off." }
      },
      "additionalProperties": true
    },
    "noise": {
      "type": ["object", "null"],
      "required": ["status", "noise_s"],
      "description": "Lap-to-lap noise: 1.4826 x the median absolute deviation of consecutive clean-lap differences, divided by the square root of 2.",
      "properties": {
        "status": { "enum": ["measured", "not_measured"] },
        "noise_s": { "type": ["number", "null"] },
        "difference_count": { "type": "integer" },
        "first_run_lap": { "type": "integer", "description": "A run's differences start at lap 6, after the warm-up of laps 2-5." },
        "basis": { "enum": ["these_runs", "day", "these_runs_from_lap_2", null], "description": "A comparison's source: both runs from lap 6, else the whole day from lap 6, else both runs from lap 2." },
        "method": { "type": "string" },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "pairWindow": {
      "type": "object",
      "required": ["key", "label", "first_run_lap", "last_run_lap", "status", "verdict", "run_laps", "previous_laps", "current_laps", "previous_median_s", "current_median_s", "delta_s", "threshold_s", "standard_error_s", "reason"],
      "properties": {
        "key": { "enum": ["early", "late"] },
        "label": { "type": ["string", "null"] },
        "first_run_lap": { "type": ["integer", "null"] },
        "last_run_lap": { "type": ["integer", "null"] },
        "status": { "enum": ["measured", "not_measured", "withheld"], "description": "withheld: the late window of a pair whose common clean length is under eight laps." },
        "verdict": { "enum": ["faster", "slower", "within_scatter", null] },
        "run_laps": { "type": "array", "items": { "type": "integer" } },
        "previous_laps": { "type": "array", "items": { "type": "integer" } },
        "current_laps": { "type": "array", "items": { "type": "integer" } },
        "previous_median_s": { "type": ["number", "null"] },
        "current_median_s": { "type": ["number", "null"] },
        "delta_s": { "type": ["number", "null"] },
        "threshold_s": { "type": ["number", "null"] },
        "standard_error_s": { "type": ["number", "null"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "setupChange": {
      "type": "object",
      "required": ["status", "compared_with_run", "change_count", "changes", "unknown_count", "unknown_fields", "complete", "reason"],
      "properties": {
        "status": { "enum": ["first_run", "unchanged", "changed", "unknown", "not_recorded"], "description": "not_recorded: both runs are in one recording, which keeps one garage sheet." },
        "compared_with_run": { "type": ["integer", "null"] },
        "change_count": { "type": "integer", "description": "Garage adjustments changed; computed readouts are not counted." },
        "changes": {
          "type": "array",
          "description": "Garage adjustments that differ, as recorded.",
          "items": {
            "type": "object",
            "required": ["field", "label", "previous", "current", "delta", "unit"],
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "previous": { "type": ["string", "null"], "description": "As recorded in the garage sheet." },
              "current": { "type": ["string", "null"] },
              "delta": { "type": ["number", "null"], "description": "Current minus previous in the canonical unit." },
              "unit": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "readout_count": { "type": "integer", "description": "Computed garage readouts that differ; never counted in change_count." },
        "readouts": {
          "type": "array",
          "description": "Computed garage readouts (corner, cross and nose weight, ride heights, truck-arm preload, travel to coil bind) that differ. They follow the adjustments in changes and are never settings to revert or keep.",
          "items": {
            "type": "object",
            "required": ["field", "label", "previous", "current", "delta", "unit"],
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "previous": { "type": ["string", "null"] },
              "current": { "type": ["string", "null"] },
              "delta": { "type": ["number", "null"] },
              "unit": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "unknown_count": { "type": "integer" },
        "unknown_fields": { "type": "array", "items": { "type": "string" } },
        "complete": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "comparison": {
      "type": ["object", "null"],
      "description": "Null for run 1; otherwise this run against the previous run over their common clean length. The top-level verdict fields repeat the late window when it has 3+ laps clean in both runs, otherwise laps 2-5.",
      "required": [
        "compared_with_run", "verdict", "blocked_by", "basis", "window_label", "first_run_lap", "last_run_lap",
        "previous_median_s", "current_median_s", "delta_s", "threshold_s", "standard_error_s", "reasons", "flags", "summary"
      ],
      "properties": {
        "compared_with_run": { "type": "integer" },
        "verdict": { "enum": ["faster", "slower", "within_scatter", "not_comparable"] },
        "blocked_by": { "enum": ["conditions", "measurement", null] },
        "basis": { "enum": ["late_window", "early_window", null] },
        "window_label": { "type": ["string", "null"] },
        "first_run_lap": { "type": ["integer", "null"] },
        "last_run_lap": { "type": ["integer", "null"] },
        "run_laps": { "type": "array", "items": { "type": "integer" }, "description": "Laps of the run clean in both runs; both medians use exactly these ages. Empty when not comparable." },
        "previous_laps": { "type": "array", "items": { "type": "integer" }, "description": "The previous run's recording laps at run_laps." },
        "current_laps": { "type": "array", "items": { "type": "integer" }, "description": "This run's recording laps at run_laps." },
        "previous_median_s": { "type": ["number", "null"], "description": "Median of the previous run's laps at run_laps." },
        "current_median_s": { "type": ["number", "null"], "description": "Median of this run's laps at run_laps." },
        "delta_s": { "type": ["number", "null"], "description": "Current minus previous; null when not comparable." },
        "threshold_s": { "type": ["number", "null"], "description": "max(0.03 s, 2 x sqrt(2) x 1.2533 x noise / sqrt(n)) for the n laps clean in both runs." },
        "standard_error_s": { "type": ["number", "null"] },
        "common_run_laps": { "type": "integer", "description": "N: the shorter of the two runs' last clean laps." },
        "noise": { "$ref": "#/$defs/noise" },
        "windows": {
          "type": ["object", "null"],
          "description": "Laps 2-5 and the last five laps up to N, each with its own medians, threshold and verdict; null when conditions block the comparison.",
          "properties": {
            "early": { "$ref": "#/$defs/pairWindow" },
            "late": { "$ref": "#/$defs/pairWindow" }
          },
          "additionalProperties": true
        },
        "fall_off": {
          "type": ["object", "null"],
          "description": "Both runs' least-squares fall-off over laps 2..N; withheld when N is under eight laps.",
          "properties": {
            "status": { "enum": ["measured", "not_measured", "withheld"] },
            "first_run_lap": { "type": "integer" },
            "last_run_lap": { "type": ["integer", "null"] },
            "label": { "type": ["string", "null"] },
            "previous_slope_s_per_lap": { "type": ["number", "null"] },
            "current_slope_s_per_lap": { "type": ["number", "null"] },
            "delta_s_per_lap": { "type": ["number", "null"] },
            "threshold_s_per_lap": { "type": ["number", "null"] },
            "verdict": { "enum": ["more_fall_off", "less_fall_off", "within_scatter", null] },
            "reason": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "reason_codes": {
          "type": "array",
          "items": { "enum": ["car", "configuration", "configuration_missing", "fixed_setup", "setup_type_missing", "track_temperature", "track_temperature_missing", "fuel", "fuel_missing", "compound", "measurement", "scatter"] },
          "description": "One code per blocking reason, in the same order."
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "agreement": {
      "type": "object",
      "required": ["status", "max_temperature_delta_f", "max_tread_delta_percent"],
      "properties": {
        "status": { "enum": ["agree", "disagree", "not_compared"] },
        "disagrees_on": { "type": "array", "items": { "enum": ["temperature", "tread"] }, "description": "The readings that differ beyond their limit; empty unless status is disagree." },
        "max_temperature_delta_f": { "type": ["number", "null"] },
        "max_tread_delta_percent": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "stopCorner": {
      "type": ["object", "null"],
      "required": ["temperature_f", "tread_percent", "pressure_psi", "pressure_kind", "spread_f", "minimum_tread_percent"],
      "properties": {
        "temperature_f": { "$ref": "#/$defs/bands" },
        "tread_percent": { "$ref": "#/$defs/bands" },
        "pressure_psi": { "type": ["number", "null"] },
        "pressure_kind": { "type": ["string", "null"], "description": "cold_setting when the stall channel equals the run's set cold pressure within 0.25 psi: that is the setting, never a hot reading. Otherwise the channel kind (live or cold)." },
        "cold_pressure_psi": { "type": ["number", "null"], "description": "The run's set cold pressure from its garage sheet." },
        "hot_pressure_psi": { "type": ["number", "null"], "description": "Hot pressure at this stop from the next recording's garage sheet when its temperatures and tread match this stop; null otherwise." },
        "spread_f": { "type": ["number", "null"], "description": "Inside minus outside." },
        "minimum_tread_percent": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "sheetCorner": {
      "type": ["object", "null"],
      "required": ["temperature_f", "tread_percent", "hot_pressure_psi", "cold_pressure_psi", "spread_f", "minimum_tread_percent"],
      "properties": {
        "temperature_f": { "$ref": "#/$defs/bands" },
        "tread_percent": { "$ref": "#/$defs/bands" },
        "hot_pressure_psi": { "type": ["number", "null"] },
        "cold_pressure_psi": { "type": ["number", "null"] },
        "spread_f": { "type": ["number", "null"] },
        "minimum_tread_percent": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "corner": {
      "type": "object",
      "required": ["stop", "sheet", "sheet_vs_stop", "sheet_vs_previous_stop", "change_from_previous_stop"],
      "properties": {
        "stop": { "$ref": "#/$defs/stopCorner" },
        "sheet": { "$ref": "#/$defs/sheetCorner" },
        "sheet_vs_stop": { "$ref": "#/$defs/agreement" },
        "sheet_vs_previous_stop": { "$ref": "#/$defs/agreement" },
        "change_from_previous_stop": {
          "type": ["object", "null"],
          "required": ["temperature_f", "tread_percent"],
          "properties": {
            "temperature_f": { "$ref": "#/$defs/bands" },
            "tread_percent": { "$ref": "#/$defs/bands" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "tires": {
      "type": "object",
      "required": ["stop_reading", "sheet_reading", "corners"],
      "properties": {
        "stop_reading": {
          "type": "object",
          "required": ["status", "source", "measurement_status", "reason"],
          "properties": {
            "status": { "enum": ["measured", "not_measured"] },
            "source": { "const": "telemetry_pit_stall" },
            "temperature": { "const": "carcass", "description": "The stall temperatures are carcass temperatures (LFtempCL/CM/CR)." },
            "measurement_status": { "type": ["string", "null"] },
            "reason": { "type": ["string", "null"] },
            "hot_pressure": {
              "type": "object",
              "required": ["status", "source", "matched_run", "reason"],
              "properties": {
                "status": { "enum": ["measured", "not_measured"] },
                "source": { "enum": ["garage_sheet_next_recording", null] },
                "matched_run": { "type": ["integer", "null"], "description": "The run whose recording loaded the matching sheet." },
                "reason": { "type": ["string", "null"] },
                "note": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "sheet_reading": {
          "type": "object",
          "required": ["status", "source", "timing", "timing_note"],
          "properties": {
            "status": { "enum": ["recorded", "not_recorded"] },
            "source": { "const": "garage_sheet" },
            "timing": { "const": "unverified" },
            "timing_note": { "type": "string" },
            "uniform": { "type": "boolean", "description": "Every band of every recorded corner is equal: an untouched garage state." }
          },
          "additionalProperties": true
        },
        "corners": {
          "type": "object",
          "required": ["LF", "RF", "LR", "RR"],
          "properties": {
            "LF": { "$ref": "#/$defs/corner" },
            "RF": { "$ref": "#/$defs/corner" },
            "LR": { "$ref": "#/$defs/corner" },
            "RR": { "$ref": "#/$defs/corner" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "lap": {
      "type": "object",
      "required": ["lap", "run_lap", "lap_time_s", "eligible", "plotted", "exclusion_reasons", "label"],
      "properties": {
        "lap": { "type": "integer" },
        "run_lap": { "type": ["integer", "null"], "description": "1 = first lap of the measured run; null when run age is unknown." },
        "lap_time_s": { "type": ["number", "null"] },
        "eligible": { "type": "boolean" },
        "plotted": { "type": "boolean" },
        "exclusion_reasons": { "type": "array", "items": { "type": "string" } },
        "label": { "type": "string", "description": "For example 'Run 3 · lap 14'." }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "run", "analysis_id", "analysis_path", "recorded_at", "session_type", "test_day_id", "test_day_run",
        "offline_flag_rule_applied", "setup", "measured_run", "conditions", "early", "late", "fall_off",
        "setup_change", "comparison", "tires", "laps", "trend"
      ],
      "properties": {
        "run": { "type": "integer", "description": "The run's number on the day, 1 = oldest run; the table, chart labels and next-change text use it." },
        "recording": {
          "type": "object",
          "required": ["number", "analysis_id", "analysis_path", "recorded_at", "run_in_recording", "runs_in_recording"],
          "properties": {
            "number": { "type": "integer", "description": "1 = oldest recording reviewed." },
            "analysis_id": { "type": ["string", "null"] },
            "analysis_path": { "type": ["string", "null"] },
            "recorded_at": { "type": ["string", "null"] },
            "run_in_recording": { "type": ["integer", "null"], "description": "Null when the recording has no timed run." },
            "runs_in_recording": { "type": "integer" }
          },
          "additionalProperties": true
        },
        "analysis_id": { "type": ["string", "null"] },
        "analysis_path": { "type": ["string", "null"] },
        "recorded_at": { "type": ["string", "null"] },
        "session_type": { "type": ["string", "null"] },
        "test_day_id": { "type": ["string", "null"] },
        "test_day_run": { "type": ["integer", "null"] },
        "offline_flag_rule_applied": { "type": "boolean" },
        "setup": {
          "type": "object",
          "required": ["name", "fixed", "embedded", "garage_fingerprint"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "fixed": { "type": ["boolean", "null"] },
            "embedded": { "type": "boolean" },
            "garage_fingerprint": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "measured_run": {
          "type": ["object", "null"],
          "required": ["analysis_run", "first_lap", "last_lap", "run_laps", "other_run_count"],
          "properties": {
            "analysis_run": { "type": ["integer", "null"] },
            "first_lap": { "type": "integer" },
            "last_lap": { "type": "integer" },
            "run_laps": { "type": "integer" },
            "other_run_count": { "type": "integer" },
            "clean_run_laps": { "type": "integer", "description": "The run's last clean lap (its clean length)." }
          },
          "additionalProperties": true
        },
        "conditions": {
          "type": "object",
          "required": ["track_temp_f", "start_fuel_gal", "tire_compound", "tire_start"],
          "properties": {
            "track_temp_f": { "type": ["number", "null"] },
            "start_fuel_gal": { "type": ["number", "null"] },
            "tire_compound": { "type": ["string", "null"] },
            "tire_start": {
              "type": "object",
              "required": ["status", "initial_odometer_m", "detail"],
              "properties": {
                "status": { "enum": ["no_prior_distance", "possibly_used", "carried_over", "changed_before_run", "not_measured"] },
                "initial_odometer_m": { "type": ["object", "null"] },
                "detail": { "type": ["string", "null"] }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "early": { "$ref": "#/$defs/window" },
        "late": { "$ref": "#/$defs/window", "description": "This run's own last five clean-length laps from lap 6 on; not measured below eight clean laps." },
        "fall_off": { "$ref": "#/$defs/fallOff" },
        "noise": { "$ref": "#/$defs/noise" },
        "setup_change": { "$ref": "#/$defs/setupChange" },
        "comparison": { "$ref": "#/$defs/comparison" },
        "tires": { "$ref": "#/$defs/tires" },
        "laps": { "type": "array", "items": { "$ref": "#/$defs/lap" } },
        "trend": { "type": ["object", "null"], "description": "race_inspection.run_views output with x = run lap (x_axis 'run_lap'). Its fit is the run's fall-off over its clean laps 2 to its last clean lap (fit_basis 'fall_off'), null when fall-off is not measured." }
      },
      "additionalProperties": true
    },
    "card": {
      "type": "object",
      "required": ["kind", "title", "instruction", "based_on_runs", "changes", "ruleset_step", "success_rule", "evidence", "note"],
      "properties": {
        "kind": { "enum": ["revert", "return_to_setup", "keep", "keep_and_step", "isolate", "repeat", "repeat_comparable", "rebaseline"], "description": "rebaseline: the track temperature moved, so re-run the earlier setup under the latest run's conditions." },
        "title": { "type": "string" },
        "instruction": { "type": "string" },
        "based_on_runs": { "type": "array", "items": { "type": "integer" } },
        "changes": {
          "type": "array",
          "description": "Settings to apply for the next run. 'to' is null only for a one-garage-step suggestion whose step size is not verified.",
          "items": {
            "type": "object",
            "required": ["field", "label", "from", "to"],
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "from": { "type": ["string", "null"] },
              "to": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "ruleset_step": {
          "type": ["object", "null"],
          "required": ["ruleset_id", "setting_id", "direction", "instruction", "expected_effect", "risk", "step_verified"],
          "properties": {
            "ruleset_id": { "type": ["string", "null"] },
            "setting_id": { "type": ["string", "null"] },
            "direction": { "type": "string" },
            "instruction": { "type": ["string", "null"] },
            "expected_effect": { "type": ["string", "null"] },
            "risk": { "type": ["string", "null"] },
            "step_verified": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "success_rule": {
          "type": "object",
          "required": ["direction", "reference_run", "reference_median_s", "window_label", "first_run_lap", "last_run_lap", "threshold_s", "minimum_clean_laps", "text"],
          "properties": {
            "direction": { "enum": ["faster", "within", "measure"] },
            "reference_run": { "type": "integer" },
            "reference_median_s": { "type": ["number", "null"] },
            "window_label": { "type": "string" },
            "first_run_lap": { "type": ["integer", "null"] },
            "last_run_lap": { "type": ["integer", "null"] },
            "threshold_s": { "type": "number" },
            "minimum_clean_laps": { "type": "integer" },
            "text": { "type": "string" }
          },
          "additionalProperties": true
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
