{
  "schemaVersion": 1,
  "name": "mineral-glass-dark",
  "mode": "dark",
  "description": "A dark mineral-glass racing workstation with a restrained green cast, user-selectable interaction color, and vivid telemetry reserved for meaningful data.",
  "colors": {
    "app": "#101516",
    "navigation": "#13191A",
    "surface1": "#182022",
    "surface2": "#1E2729",
    "surface3": "#263033",
    "surfaceHover": "#2D393B",
    "borderSubtle": "#304043",
    "borderStrong": "#465A5E",
    "textPrimary": "#F1F3EF",
    "textSecondary": "#C2CAC8",
    "textMuted": "#94A19F",
    "textDisabled": "#687572",
    "accent": "#65D0B6",
    "accentFill": "#287565",
    "accentHover": "#328B78",
    "accentSubtle": "#17302C",
    "focus": "#91E8D3",
    "success": "#5DE59C",
    "warning": "#FFC857",
    "danger": "#FF6F7D",
    "info": "#66D5CE",
    "unavailable": "#8E98A5",
    "chartBackground": "#111819",
    "chartGrid": "#2B3B3D",
    "chartReference": "#5D7477",
    "shadow": "#0B0D0F80"
  },
  "evidence": {
    "measured": "#82AEEF",
    "derived": "#7FC5BC",
    "inferred": "#B99CE3",
    "proxy": "#D3AD67",
    "unavailable": "#8E98A5"
  },
  "telemetry": {
    "speed": "#61C8F5",
    "throttle": "#5DE59C",
    "brake": "#FF6F7D",
    "steering": "#C89CFF",
    "fuel": "#FFC857",
    "fasterDelta": "#6FC7C0",
    "slowerDelta": "#E08A80",
    "caution": "#D3AD67",
    "pitService": "#7993B5",
    "traffic": "#9B91C7",
    "tow": "#B38DD1",
    "repairConfounded": "#D98686",
    "target": "#E2BC70"
  },
  "typography": {
    "uiFamilies": ["Segoe UI Variable Text", "Segoe UI", "sans-serif"],
    "metricFamilies": ["Cascadia Mono", "Consolas", "monospace"],
    "bodyPx": 14,
    "bodyLinePx": 20,
    "compactPx": 12,
    "sectionTitlePx": 16,
    "pageTitlePx": 26,
    "metricPx": 22,
    "weights": [400, 500, 600]
  },
  "spacingPx": [4, 8, 12, 16, 20, 24, 28, 32],
  "radiiPx": {
    "control": 5,
    "card": 6,
    "panel": 8,
    "pill": 999
  },
  "motionMs": {
    "hover": 130,
    "structure": 500,
    "maximumTranslationPx": 2,
    "easing": "cubic-bezier(.2, 0, 0, 1)",
    "honorReducedMotion": true,
    "continuousStatusAnimationAllowed": false
  },
  "window": {
    "defaultWidthPx": 1440,
    "defaultHeightPx": 900,
    "minimumWidthPx": 900,
    "minimumHeightPx": 640,
    "expandedNavigationPx": 216,
    "collapsedNavigationPx": 64
  },
  "behavior": {
    "pureBlackOrWhiteSurfacesAllowed": false,
    "colorMayBeSoleInformationCarrier": false,
    "targetTraceRequiresUsableComparison": true,
    "continuousTireAgeRequiresBackendEvidence": true,
    "globalBlockingSpinnerAllowed": false
  }
}
