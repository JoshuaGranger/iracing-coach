{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.iracingcoach/contracts/dashboard-v1.schema.json",
  "title": "iRacing Coach companion dashboard v1",
  "type": "object",
  "required": [
    "ok",
    "contract_version",
    "generated_at",
    "read_only",
    "race_count",
    "races",
    "recent_analyses",
    "tuning_packages",
    "garage61",
    "capabilities"
  ],
  "properties": {
    "ok": { "const": true },
    "contract_version": { "const": 1 },
    "generated_at": { "type": "string" },
    "read_only": { "const": true },
    "latest_race": {
      "oneOf": [
        { "$ref": "#/$defs/dashboardRace" },
        { "type": "null" }
      ]
    },
    "race_count": { "type": "integer", "minimum": 0 },
    "races": { "type": "array", "items": { "$ref": "#/$defs/dashboardRace" } },
    "recent_analyses": { "type": "array", "items": { "$ref": "#/$defs/analysisIndex" } },
    "tuning_packages": { "type": "array", "items": { "$ref": "#/$defs/tuningPackageIndex" } },
    "garage61": {
      "type": "object",
      "required": ["credential_configured", "api_request_status", "local_status_only"],
      "properties": {
        "credential_configured": { "type": "boolean" },
        "api_request_status": { "type": "string" },
        "local_status_only": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": ["race_planning", "race_analysis", "race_card", "damage_repair_awareness", "starting_setup_package", "progressive_tuning"],
      "additionalProperties": { "type": "boolean" }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "required": [
        "kind", "valid", "group_id", "subsession_id", "session_id",
        "session_unique_id", "sim_session_num", "sim_session_type", "event_type",
        "is_race", "season_id", "series_id", "track_id", "track_name",
        "track_config_name", "car_id", "car_path", "is_fixed_setup",
        "start_time_unix", "end_time_unix", "start_time_utc", "end_time_utc",
        "time_source", "latest_mtime_unix", "file_count", "files"
      ],
      "properties": {
        "kind": { "const": "session" },
        "valid": { "const": true },
        "group_id": { "type": "string" },
        "subsession_id": { "type": ["integer", "string", "null"] },
        "session_id": { "type": ["integer", "string", "null"] },
        "session_unique_id": { "type": ["integer", "string", "null"] },
        "sim_session_num": { "type": ["integer", "null"] },
        "sim_session_type": { "type": ["string", "null"] },
        "event_type": { "type": ["string", "null"] },
        "is_race": { "type": "boolean" },
        "season_id": { "type": ["integer", "string", "null"] },
        "series_id": { "type": ["integer", "string", "null"] },
        "track_id": { "type": ["integer", "string", "null"] },
        "track_name": { "type": ["string", "null"] },
        "track_config_name": { "type": ["string", "null"] },
        "car_id": { "type": ["integer", "string", "null"] },
        "car_path": { "type": ["string", "null"] },
        "is_fixed_setup": { "type": ["boolean", "null"] },
        "start_time_unix": { "type": ["number", "null"] },
        "end_time_unix": { "type": ["number", "null"] },
        "start_time_utc": { "type": ["string", "null"] },
        "end_time_utc": { "type": ["string", "null"] },
        "time_source": { "type": "string" },
        "latest_mtime_unix": { "type": "number" },
        "file_count": { "type": "integer", "minimum": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "analysisSummary": {
      "type": "object",
      "required": [
        "scheduled_laps", "scheduled_minutes", "recorded_laps",
        "green_laps_estimated", "caution_laps_estimated", "pit_stops_detected",
        "runs_detected", "fuel_used_l", "fuel_used_gal"
      ],
      "additionalProperties": true
    },
    "dashboardAnalysis": {
      "type": "object",
      "required": [
        "analysis_id", "analyzed_at", "analysis_path", "report_path",
        "race_card_path", "analysis_available", "report_available",
        "race_card_available", "source_available", "summary"
      ],
      "properties": {
        "analysis_id": { "type": ["string", "null"] },
        "analyzed_at": { "type": ["string", "null"] },
        "analysis_path": { "type": ["string", "null"] },
        "report_path": { "type": ["string", "null"] },
        "race_card_path": { "type": ["string", "null"] },
        "analysis_available": { "type": ["boolean", "null"] },
        "report_available": { "type": ["boolean", "null"] },
        "race_card_available": { "type": ["boolean", "null"] },
        "source_available": { "type": ["boolean", "null"] },
        "summary": { "$ref": "#/$defs/analysisSummary" }
      },
      "additionalProperties": true
    },
    "dashboardRace": {
      "allOf": [
        { "$ref": "#/$defs/session" },
        {
          "type": "object",
          "required": ["analysis_status", "analysis"],
          "properties": {
            "analysis_status": { "enum": ["analyzed", "not_analyzed"] },
            "analysis": {
              "oneOf": [
                { "$ref": "#/$defs/dashboardAnalysis" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "analysisIndex": {
      "type": "object",
      "required": [
        "analysis_id", "analyzed_at", "session_start", "subsession_id", "session_id",
        "season_key", "car_key", "track_key", "setup_type", "race_length_key",
        "source_path", "report_path", "summary", "report_available", "analysis_available",
        "analysis_path", "race_card_available", "race_card_path", "source_available"
      ],
      "properties": {
        "summary": { "$ref": "#/$defs/analysisSummary" }
      },
      "additionalProperties": true
    },
    "tuningPackageIndex": {
      "type": "object",
      "required": [
        "package_id", "created_at", "updated_at", "season_key", "car_key",
        "track_key", "setup_type", "car_path", "track_name", "source_fingerprint",
        "status", "package_path"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
