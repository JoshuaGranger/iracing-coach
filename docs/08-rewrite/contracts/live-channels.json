    { "id": 6, "key": "flags_unknown", "priority": "information", "evidence": "unavailable", "template": "Race flag unavailable: flag-dependent coaching paused", "args": [] },
    { "id": 7, "key": "caution", "priority": "pit_service", "evidence": "measured", "template": "Caution: competitive gap trends paused", "args": [] },
    { "id": 8, "key": "pit_road", "priority": "pit_service", "evidence": "measured", "template": "Pit road: confirm service and speed", "args": [] },
    { "id": 9, "key": "gap_closing", "priority": "traffic", "evidence": "derived", "template": "Gap ahead closing: {0} s", "basis": "8-second scoring trend", "args": [{ "format": "fixed2" }] },
    { "id": 10, "key": "pace_outside", "priority": "pace", "evidence": "derived", "template": "Last lap outside the clean in-session target band", "args": [] },
    { "id": 11, "key": "braking_overshoot", "priority": "coaching", "evidence": "derived", "template": "Braking zone near {0}% lap: peak {1} above your clean baseline on {2} comparable laps", "args": [{ "format": "int" }, { "format": "percent0" }, { "format": "int" }] },
    { "id": 12, "key": "building_pace", "priority": "information", "evidence": "unavailable", "template": "Building your pace range · complete three clean laps", "args": [] },
    { "id": 13, "key": "no_action", "priority": "information", "evidence": "derived", "template": "No action: pace and race state within the supported band", "args": [] },
    { "id": 14, "key": "waiting", "priority": "information", "evidence": "unavailable", "template": "Waiting for iRacing", "args": [] },
    { "id": 15, "key": "paused", "priority": "information", "evidence": "measured", "template": "Live coaching paused", "args": [] }
  ],
  "unit_conversions": {
