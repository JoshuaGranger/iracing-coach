{
  "$comment": "Single source for live frame channels, enums, cue templates and the Live tile catalog. Generated into Rust (crates/coach-wire) and TS (web/src/gen). Channels are append-only; appending increments table_version. Rules and formulas come from spikes/live-stack.md sections 1-2 (C# LiveTelemetry.cs, LiveTelemetryCatalog.cs, LiveTruthPolicy.cs). Cue message text must equal the C# strings byte for byte; workstream W2 verifies every template and basis against companion-app source before its first release and corrects this file by contract change if needed.",
  "table_version": 1,
  "channels": [
    { "index": 0, "id": "speed", "type": "f32", "unit": "m/s", "source": "sdk:Speed" },
    { "index": 1, "id": "throttle", "type": "f32", "unit": "ratio", "source": "sdk:Throttle" },
    { "index": 2, "id": "brake", "type": "f32", "unit": "ratio", "source": "sdk:Brake" },
    { "index": 3, "id": "steering_wheel_angle", "type": "f32", "unit": "rad", "source": "sdk:SteeringWheelAngle" },
    { "index": 4, "id": "steering_road_wheel", "type": "f32", "unit": "rad", "source": "engine:wheel/ratio; absent when the ratio is unknown" },
    { "index": 5, "id": "steering_ratio", "type": "f32", "unit": "ratio", "source": "session:CarSetup SteeringRatio (LiveSteering rules)" },
    { "index": 6, "id": "gear", "type": "i8", "unit": "gear", "source": "sdk:Gear" },
    { "index": 7, "id": "rpm", "type": "f32", "unit": "rpm", "source": "sdk:RPM" },
    { "index": 8, "id": "yaw_rate", "type": "f32", "unit": "rad/s", "source": "sdk:YawRate" },
    { "index": 9, "id": "lateral_accel", "type": "f32", "unit": "m/s2", "source": "sdk:LatAccel" },
    { "index": 10, "id": "longitudinal_accel", "type": "f32", "unit": "m/s2", "source": "sdk:LongAccel" },
    { "index": 11, "id": "lap_dist_pct", "type": "f32", "unit": "ratio", "source": "sdk:LapDistPct, only in [0,1]" },
    { "index": 12, "id": "latitude", "type": "f64", "unit": "deg", "source": "sdk:Lat" },
    { "index": 13, "id": "longitude", "type": "f64", "unit": "deg", "source": "sdk:Lon" },
    { "index": 14, "id": "lap", "type": "u16", "unit": "lap", "source": "sdk:Lap + 1, minimum 1" },
    { "index": 15, "id": "laps_remaining", "type": "u16", "unit": "lap", "source": "sdk:SessionLapsRemainEx else SessionLapsRemain; sentinel rule; absent when unknown" },
    { "index": 16, "id": "position", "type": "u8", "unit": "position", "source": "sdk:PlayerCarPosition" },
    { "index": 17, "id": "class_position", "type": "u8", "unit": "position", "source": "sdk:PlayerCarClassPosition" },
    { "index": 18, "id": "flag_state", "type": "enum8", "enum": "flag_state", "source": "engine:LiveTruthPolicy" },
    { "index": 19, "id": "session_flags", "type": "u32", "unit": "bits", "source": "sdk:SessionFlags" },
    { "index": 20, "id": "abs_active", "type": "bool8", "source": "sdk:BrakeABSactive" },
    { "index": 21, "id": "brake_bias", "type": "f32", "unit": "%", "source": "sdk:dcBrakeBias" },
    { "index": 22, "id": "fuel", "type": "f32", "unit": "L", "source": "sdk:FuelLevel" },
    { "index": 23, "id": "fuel_pct", "type": "f32", "unit": "ratio", "source": "sdk:FuelLevelPct" },
    { "index": 24, "id": "fuel_laps_remaining", "type": "f32", "unit": "lap", "source": "engine:fuel / median burn" },
    { "index": 25, "id": "fuel_hard_limit_laps", "type": "u16", "unit": "lap", "source": "engine:hard limit" },
    { "index": 26, "id": "last_lap", "type": "f32", "unit": "s", "source": "sdk:LapLastLapTime > 0" },
    { "index": 27, "id": "leader_last_lap", "type": "f32", "unit": "s", "source": "sdk:CarIdxLastLapTime[overall P1]" },
    { "index": 28, "id": "ahead_gap", "type": "f32", "unit": "s", "source": "engine:BuildGap class P-1" },
    { "index": 29, "id": "ahead_gap_trend", "type": "enum8", "enum": "gap_trend", "source": "engine:BuildGap" },
    { "index": 30, "id": "behind_gap", "type": "f32", "unit": "s", "source": "engine:BuildGap class P+1" },
    { "index": 31, "id": "behind_gap_trend", "type": "enum8", "enum": "gap_trend", "source": "engine:BuildGap" },
    { "index": 32, "id": "leader_gap", "type": "f32", "unit": "s", "source": "engine:same-lap F2Time delta to overall P1; 0 when leader" },
    { "index": 33, "id": "pace_band_min", "type": "f32", "unit": "s", "source": "engine:pace band" },
    { "index": 34, "id": "pace_band_max", "type": "f32", "unit": "s", "source": "engine:pace band" },
    { "index": 35, "id": "run_phase", "type": "enum8", "enum": "run_phase", "source": "engine:green run laps" },
    { "index": 36, "id": "green_run_laps", "type": "u16", "unit": "lap", "source": "engine" },
    { "index": 37, "id": "mandatory_repair", "type": "f32", "unit": "s", "source": "sdk:PitRepairLeft" },
    { "index": 38, "id": "optional_repair", "type": "f32", "unit": "s", "source": "sdk:PitOptRepairLeft" },
    { "index": 39, "id": "on_pit_road", "type": "bool8", "source": "sdk:OnPitRoad" },
    { "index": 40, "id": "tow_active", "type": "bool8", "source": "sdk:PlayerCarTowTime > 0" },
    { "index": 41, "id": "track_temperature", "type": "f32", "unit": "C", "source": "sdk:TrackTempCrew else TrackTemp" },
    { "index": 42, "id": "air_temperature", "type": "f32", "unit": "C", "source": "sdk:AirTemp" },
    { "index": 43, "id": "incidents", "type": "u16", "unit": "count", "source": "sdk:PlayerCarMyIncidentCount else PlayerIncidents" },
    { "index": 44, "id": "pace_delta_to_leader", "type": "f32", "unit": "s", "source": "engine:LastLap - LeaderLastLap" }
  ],
  "types": { "f32": 4, "f64": 8, "u8": 1, "i8": 1, "u16": 2, "u32": 4, "bool8": 1, "enum8": 1 },
