# Local agent, test, and dependency state
/.agents/
/.pytest_cache/
/.validation-deps/
**/__pycache__/
*.py[cod]

# Portable user-owned state (never source control)
/data/
/logs/
/setups/
/backups/
/exports/
/portable-settings/
/user-library/
/settings.json
/archive-manifest.json
/portable-state.json

# Credentials and machine-local state
**/credentials/
**/auth.json
*.machine-local.json
**/.env
**/.env.*
**/*-key.txt
**/*.key
**/*.pfx
**/*.p12

# The desktop app was deleted in rewrite wave 4 (it lives in Git history); older
# checkouts may still hold its ignored build output, which must not show as new files.
/companion-app/
**/TestResults/
*.trx

# Personal telemetry is private. Only the named sanitized test fixtures are source.
*.ibt
!test-data/ibt/synthetic-race.ibt
!test-data/ibt/truncated-race.ibt

# Rewrite: Rust and web build output
/target/
node_modules/
/web/dist/
/web/playwright-report/
/web/test-results/
